/client/benilla-wotlk/

# a copy of mods/wu-mod.py that "Update sign-in and warm-up.bat" makes beside the portal before upload
/stream/wu-mod.py
# and the launcher's rules file, beside listings.py (List your mod)
/stream/upstream-rules.json

# the sync bundle Claude drops beside the labs 1.12 client tool (never committed)
labs/leyline-client-112/*.bundle

# working copies the steps manage inside the workspace (the move to Leyline, tools/workspace-move): .repos\leyline-public, .repos\leyline-launcher
/.repos/

# machine state: the control window's files (tools/control/control.py writes them; Claude writes claude-status.json
# here on the PC), every step's logs, and the GitHub cleanup plan / Discord tool's token and state
/logs/
/control/autopilot.json
/control/claude-status.json
/control/last-run.json
/control/last-check.json
# Leyline HQ (tools/hq/hq_sync.py): Claude's notes for HQ and the owner's notes to Claude stay on the PC
/control/hq-notes.json
/control/notes-from-owner.json
tools/github-cleanup/PLAN.json
tools/discord-leyline/token.txt
tools/discord-leyline/.leyline-state.json
