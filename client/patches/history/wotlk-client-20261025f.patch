diff --git a/crates/benilla-app/src/pipe_warm/mod.rs b/crates/benilla-app/src/pipe_warm/mod.rs
index f556c93b..159c0166 100644
--- a/crates/benilla-app/src/pipe_warm/mod.rs
+++ b/crates/benilla-app/src/pipe_warm/mod.rs
@@ -85,6 +85,16 @@ pub(crate) fn plugin(app: &mut App) {
     let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
         return;
     };
+    // Small mesh slabs (owner smoke 2026-10-25: Trial of the Champion → hearth to Dalaran went
+    // black). Bevy's default lets a general slab grow by 1.5× up to 512 MiB, and each growth needs
+    // the old and the new buffer alive at once; the 204 MB "general mesh slab 12" creation failed
+    // in the browser, and every later frame submitted an invalid command buffer. Capping slabs at
+    // 64 MiB keeps every growth step small enough for a browser's GPU process.
+    render_app.insert_resource(bevy::render::mesh::allocator::MeshAllocatorSettings {
+        max_slab_size: 64 * 1024 * 1024,
+        large_threshold: 32 * 1024 * 1024,
+        ..Default::default()
+    });
     render_app.insert_resource(PipeWatch(shared));
     render_app.add_systems(Render, watch_pipelines.in_set(RenderSystems::Cleanup));
 }
