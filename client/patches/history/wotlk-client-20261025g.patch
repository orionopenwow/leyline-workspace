diff --git a/crates/benilla-app/src/player/edit_mode.rs b/crates/benilla-app/src/player/edit_mode.rs
new file mode 100644
index 00000000..70ca7c9a
--- /dev/null
+++ b/crates/benilla-app/src/player/edit_mode.rs
@@ -0,0 +1,284 @@
+//! Leyline edit mode: step out of the character into a free-fly building camera.
+//!
+//! F7 (or the Builder window's switch) flips the `leylineEditMode` CVar; this module follows it.
+//! On, the body is parked where it stands and the camera flies free (WASD, Space/C, Ctrl 5×, mouse
+//! to look), the same free fly the client uses before the server places us. The server is told
+//! nothing: building itself goes through the realm's `.build` commands, which check every change.
+//! The camera stays within [`EDIT_RADIUS`] of the body, so edit mode is a building view and not a
+//! way to scout. Off, the camera seats back on the body as usual.
+
+use super::camera::FlyCam;
+use super::Player;
+use crate::cvars::Cvars;
+use bevy::prelude::*;
+
+/// The CVar the Builder window and F7 share; the UI hides itself while it reads `1`.
+pub(crate) const EDIT_CVAR: &str = "leylineEditMode";
+/// How far (yards) the edit camera may go from the parked body.
+pub(crate) const EDIT_RADIUS: f32 = 120.0;
+/// The toggle key. Unbound in the stock 3.3.5a bindings.
+pub(crate) const EDIT_KEY: KeyCode = KeyCode::F7;
+
+/// Whether edit mode is on this frame, for the systems that act differently while building.
+#[derive(Resource, Default, Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) struct EditMode {
+    pub(crate) on: bool,
+}
+
+/// Follows the CVar (and F7) into [`EditMode`] and the free-fly detach. Runs before `control`.
+pub(super) fn sync_edit_mode(
+    keys: Res<ButtonInput<KeyCode>>,
+    capture: Res<crate::ui_script::UiKeyboardCapture>,
+    cvars: Option<ResMut<Cvars>>,
+    mut edit: ResMut<EditMode>,
+    mut player: ResMut<Player>,
+) {
+    let Some(mut cvars) = cvars else {
+        return;
+    };
+    let cvar_on = cvars.flag(EDIT_CVAR).unwrap_or(false);
+    // Not in control of a body (loading, a new character, a session end): edit mode is off, and a
+    // saved `1` from an earlier session must not open the next one in the editor.
+    if !player.active {
+        if cvar_on {
+            let _ = cvars.set(EDIT_CVAR, "0");
+        }
+        if edit.on {
+            edit.on = false;
+        }
+        return;
+    }
+    let mut want = cvar_on;
+    if !capture.typing && keys.just_pressed(EDIT_KEY) {
+        want = !want;
+        let _ = cvars.set(EDIT_CVAR, if want { "1" } else { "0" });
+    }
+    if want != edit.on {
+        edit.on = want;
+        player.detached = want;
+        info!("edit mode {}", if want { "on: free camera, body parked" } else { "off: back in the body" });
+    }
+}
+
+/// Keeps the edit camera within [`EDIT_RADIUS`] of the parked body. Runs after `control`.
+pub(super) fn clamp_edit_camera(
+    edit: Res<EditMode>,
+    player: Res<Player>,
+    mut cam: Query<&mut Transform, With<FlyCam>>,
+) {
+    if !edit.on {
+        return;
+    }
+    let Ok(mut t) = cam.single_mut() else {
+        return;
+    };
+    t.translation = clamp_to(t.translation, player.pos, EDIT_RADIUS);
+}
+
+/// `p` pulled back onto the sphere of `radius` around `centre` when it is outside it.
+fn clamp_to(p: Vec3, centre: Vec3, radius: f32) -> Vec3 {
+    let off = p - centre;
+    if off.length() > radius {
+        centre + off.normalize() * radius
+    } else {
+        p
+    }
+}
+
+/// Grab key: pick up the selected prop and carry it on the cursor; again (or a click) to drop it.
+pub(crate) const GRAB_KEY: KeyCode = KeyCode::KeyG;
+/// Turn the carried prop 15 degrees left / right.
+pub(crate) const TURN_LEFT: KeyCode = KeyCode::KeyQ;
+pub(crate) const TURN_RIGHT: KeyCode = KeyCode::KeyE;
+/// Put the carried prop back where it was.
+pub(crate) const CANCEL_KEY: KeyCode = KeyCode::Backspace;
+const TURN_STEP_DEG: f32 = 15.0;
+
+/// The prop the builder last clicked in edit mode, and the carry in progress.
+#[derive(Resource, Default)]
+pub(crate) struct EditGrab {
+    /// The last clicked GameObject (the server is told to select it; it refuses props not ours).
+    pub(crate) entity: Option<Entity>,
+    pub(crate) guid: Option<u64>,
+    /// Carrying: the pose to put back on cancel, and the turn so far in degrees.
+    carry: Option<(Transform, f32)>,
+}
+
+/// The counter part of a GameObject guid, as the realm's `GetGUIDLow` reads it.
+fn guid_counter(guid: u64) -> u64 {
+    guid & 0x00FF_FFFF
+}
+
+/// Calls the edit HUD (WrathUnleashedUI's EditMode.lua) if it is loaded.
+fn call_hud(script: Option<&benilla_ui::script::UiScript>, chunk: &str) {
+    if let Some(script) = script {
+        crate::ui_script::run_or_warn(script, chunk);
+    }
+}
+
+/// Clicks, grab, turn and drop while editing. A click hands the HUD the ground point and the prop
+/// under the cursor (it decides: place the prop chosen in the palette, or select the clicked one);
+/// G carries the selected prop on the cursor, Q/E turn it, a click or G drops it (sent to the
+/// realm as an exact place, which it checks), X puts it back.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn edit_tools(
+    edit: Res<EditMode>,
+    mut clicks: MessageReader<benilla_world::interact::WorldClick>,
+    hovered: Res<crate::target::HoveredObject>,
+    occlusion: Res<crate::target::PickOcclusion>,
+    keys: Res<ButtonInput<KeyCode>>,
+    capture: Res<crate::ui_script::UiKeyboardCapture>,
+    mut grab: ResMut<EditGrab>,
+    mut transforms: Query<&mut Transform, Without<FlyCam>>,
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+) {
+    let script = script.as_deref();
+    if !edit.on {
+        clicks.clear();
+        if let Some((start, _)) = grab.carry.take() {
+            if let Some(mut t) = grab.entity.and_then(|e| transforms.get_mut(e).ok()) {
+                *t = start;
+            }
+        }
+        return;
+    }
+    let typing = capture.typing;
+    let pressed = |k: KeyCode| !typing && keys.just_pressed(k);
+    let point = occlusion.point;
+
+    // Carrying: follow the cursor's ground point, turn on Q/E.
+    if let Some((start, mut turn)) = grab.carry {
+        if pressed(TURN_LEFT) {
+            turn += TURN_STEP_DEG;
+        }
+        if pressed(TURN_RIGHT) {
+            turn -= TURN_STEP_DEG;
+        }
+        grab.carry = Some((start, turn));
+        if let Some(mut t) = grab.entity.and_then(|e| transforms.get_mut(e).ok()) {
+            if let Some(p) = point {
+                t.translation = p;
+            }
+            t.rotation = Quat::from_rotation_y(turn.to_radians()) * start.rotation;
+        }
+        if pressed(CANCEL_KEY) {
+            if let Some(mut t) = grab.entity.and_then(|e| transforms.get_mut(e).ok()) {
+                *t = start;
+            }
+            grab.carry = None;
+            call_hud(script, "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Note then E.Note('Put back.') end");
+            clicks.clear();
+            return;
+        }
+        let drop = pressed(GRAB_KEY) || clicks.read().count() > 0;
+        if drop {
+            grab.carry = None;
+            let at = grab
+                .entity
+                .and_then(|e| transforms.get(e).ok())
+                .map(|t| t.translation)
+                .or(point);
+            if let Some(at) = at {
+                let w = benilla_assets::coords::bevy_to_wow(at);
+                call_hud(
+                    script,
+                    &format!(
+                        "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Drop then E.Drop({:.3}, {:.3}, {:.3}, {:.1}) end",
+                        w[0], w[1], w[2], turn
+                    ),
+                );
+            }
+        }
+        return;
+    }
+
+    // Not carrying: G picks the selection up.
+    if pressed(GRAB_KEY) {
+        if let Some(e) = grab.entity {
+            if let Ok(t) = transforms.get(e) {
+                grab.carry = Some((*t, 0.0));
+                call_hud(script, "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Note then E.Note('Carrying: move the mouse, Q/E to turn, click or G to drop, Backspace to put back.') end");
+            }
+        } else {
+            call_hud(script, "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Note then E.Note('Click one of your props first, then G to carry it.') end");
+        }
+    }
+
+    // A click: tell the HUD where, and which prop (if any) was under the cursor.
+    for _ in clicks.read() {
+        let go = hovered.target.zip(hovered.guid);
+        if let Some((e, g)) = go {
+            grab.entity = Some(e);
+            grab.guid = Some(g);
+        }
+        let pt = point
+            .map(|p| {
+                let w = benilla_assets::coords::bevy_to_wow(p);
+                format!("{:.3}, {:.3}, {:.3}", w[0], w[1], w[2])
+            })
+            .unwrap_or_else(|| "nil, nil, nil".into());
+        let low = go.map_or("nil".to_string(), |(_, g)| guid_counter(g).to_string());
+        call_hud(
+            script,
+            &format!(
+                "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Clicked then E.Clicked({pt}, {low}) end"
+            ),
+        );
+    }
+}
+
+/// Draws the edit view's markers: a gold ring and a facing arrow on the selected prop (cyan while
+/// carried), and a small ring where the cursor meets the ground, which is where a click places.
+pub(super) fn edit_gizmos(
+    edit: Res<EditMode>,
+    grab: Res<EditGrab>,
+    occlusion: Res<crate::target::PickOcclusion>,
+    globals: Query<&GlobalTransform>,
+    mut gizmos: Gizmos,
+) {
+    if !edit.on {
+        return;
+    }
+    let flat = Quat::from_rotation_arc(Vec3::Z, Vec3::Y);
+    if let Some(p) = occlusion.point {
+        gizmos
+            .circle(Isometry3d::new(p + Vec3::Y * 0.05, flat), 0.35, Color::srgba(1.0, 1.0, 1.0, 0.8))
+            .resolution(24);
+    }
+    let Some(gt) = grab.entity.and_then(|e| globals.get(e).ok()) else {
+        return;
+    };
+    let carrying = grab.carry.is_some();
+    let color = if carrying {
+        Color::srgb(0.22, 0.74, 0.97)
+    } else {
+        Color::srgb(0.89, 0.72, 0.36)
+    };
+    let at = gt.translation();
+    gizmos.circle(Isometry3d::new(at + Vec3::Y * 0.05, flat), 1.4, color).resolution(48);
+    gizmos.circle(Isometry3d::new(at + Vec3::Y * 0.05, flat), 1.55, color).resolution(48);
+    // The prop's facing, flat on the ground.
+    let fwd = (gt.rotation() * Vec3::NEG_Z).with_y(0.0).normalize_or_zero();
+    if fwd != Vec3::ZERO {
+        gizmos.arrow(at + Vec3::Y * 0.1, at + Vec3::Y * 0.1 + fwd * 2.2, color);
+    }
+    gizmos.line(at, at + Vec3::Y * 2.5, color);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_camera_stays_within_the_radius() {
+        let c = Vec3::new(10.0, 0.0, 0.0);
+        assert_eq!(clamp_to(Vec3::new(20.0, 0.0, 0.0), c, 50.0), Vec3::new(20.0, 0.0, 0.0));
+        let far = clamp_to(Vec3::new(210.0, 0.0, 0.0), c, 50.0);
+        assert!((far - Vec3::new(60.0, 0.0, 0.0)).length() < 1e-4);
+    }
+
+    #[test]
+    fn the_guid_counter_is_the_low_24_bits() {
+        assert_eq!(guid_counter(0xF110_0007_6D00_1234), 0x00_1234);
+    }
+}
