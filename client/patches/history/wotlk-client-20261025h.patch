-/// carried), and a small ring where the cursor meets the ground, which is where a click places.
+/// The world-space box around an entity's meshes (itself and every descendant with bounds).
+fn world_bounds(
+    root: Entity,
+    children: &Query<&Children>,
+    bounds: &Query<(&bevy::camera::primitives::Aabb, &GlobalTransform)>,
+) -> Option<(Vec3, Vec3)> {
+    let mut lo = Vec3::splat(f32::MAX);
+    let mut hi = Vec3::splat(f32::MIN);
+    let mut any = false;
+    let mut stack = vec![root];
+    let mut seen = 0;
+    while let Some(e) = stack.pop() {
+        seen += 1;
+        if seen > 512 {
+            break;
+        }
+        if let Ok((aabb, gt)) = bounds.get(e) {
+            let c = Vec3::from(aabb.center);
+            let h = Vec3::from(aabb.half_extents);
+            for i in 0..8 {
+                let corner = c + Vec3::new(
+                    if i & 1 == 0 { -h.x } else { h.x },
+                    if i & 2 == 0 { -h.y } else { h.y },
+                    if i & 4 == 0 { -h.z } else { h.z },
+                );
+                let w = gt.transform_point(corner);
+                lo = lo.min(w);
+                hi = hi.max(w);
+            }
+            any = true;
+        }
+        if let Ok(kids) = children.get(e) {
+            stack.extend(kids.iter());
+        }
+    }
+    any.then_some((lo, hi))
+}
