+//! Plays every hole of a course by brute-force search, stroke by stroke, and prints how many
+//! strokes the best found line takes: a playability check for course authors.
+//! `cargo run --release -p benilla-mode --example golf_probe [course-file]`
+use benilla_mode::golf::{self, End, Shot};
+
+fn main() {
+    let text = match std::env::args().nth(1) {
+        Some(p) => std::fs::read_to_string(p).expect("course file"),
+        None => golf::MEADOW_NINE.to_string(),
+    };
+    let course = golf::parse(&text).unwrap_or_else(|e| panic!("{e}"));
+    println!("{} by {} (par {})", course.title, course.author, course.par());
+    for h in &course.holes {
+        let mut ball = h.tee_ball();
+        let mut strokes = 0;
+        let mut done = false;
+        while strokes < 8 && !done {
+            strokes += 1;
+            let mut best: Option<(f32, Shot, golf::Outcome)> = None;
+            for a in (0..3600).step_by(10) {
+                for pm in (100..=1000).step_by(30) {
+                    let shot = Shot { angle_t: a, power_m: pm };
+                    let o = golf::simulate(h, ball, shot, 0);
+                    let d = if o.end == End::Holed { -1.0 } else if o.end.penalty() { 1e9 } else {
+                        let dx = o.rest.x - h.cup.x; let dz = o.rest.z - h.cup.z; let dy = o.rest.y - h.cup.y;
+                        (dx * dx + dz * dz + 4.0 * dy * dy).sqrt()
+                    };
+                    if best.as_ref().is_none_or(|b| d < b.0) { best = Some((d, shot, o)); }
+                }
+            }
+            let (d, shot, o) = best.unwrap();
+            println!("  hole {} stroke {strokes}: aim {} power {} -> {:?} (left {:.2} yd, {} ticks)", h.number, shot.angle_t, shot.power_m, o.end, d.max(0.0), o.frames.len());
+            done = o.end == End::Holed;
+            ball = o.rest;
+        }
+        println!("hole {} {} par {}: {} {}", h.number, h.name, h.par, strokes, if done { "holed" } else { "NOT HOLED" });
+    }
+}
