+//! The minigolf determinism probe as a bare wasm module: `fingerprint_hi`/`fingerprint_lo` export
+//! `benilla_mode::golf::fingerprint()`, which `scripts/golf-determinism.sh` compares to the pin.
+#[no_mangle]
+pub extern "C" fn fingerprint_hi() -> u32 {
+    (benilla_mode::golf::fingerprint() >> 32) as u32
+}
+#[no_mangle]
+pub extern "C" fn fingerprint_lo() -> u32 {
+    benilla_mode::golf::fingerprint() as u32
+}
