+/// A piece's centre and rotation at a phase tick: the same arithmetic the simulation uses.
+fn piece_pose(piece: &Piece, phase: i64) -> (V3, Rot) {
+    match (piece.shape, piece.motion) {
+        (Shape::Block { yaw_t, pitch_t, .. }, Motion::Still) => (piece.center, Rot::yaw_pitch(yaw_t, pitch_t)),
+        (Shape::Block { yaw_t, .. }, Motion::Spin { deg_per_s }) => {
+            let ang = (deg_per_s as i64 * 10 * phase).div_euclid(golf::TICK_HZ as i64);
+            (piece.center, Rot::yaw_pitch(ang.rem_euclid(3600) as i32 + yaw_t, 0))
+        }
+        (Shape::Block { yaw_t, pitch_t, .. }, Motion::Slide { travel, period }) => {
+            let p = period as i64;
+            let half = p / 2;
+            let k = phase.rem_euclid(p);
+            let u = if k < half { k } else { p - k };
+            (piece.center + travel * (u as f32 / half as f32), Rot::yaw_pitch(yaw_t, pitch_t))
+        }
+        (Shape::Post { .. }, _) => (piece.center, Rot::IDENTITY),
+    }
+}
+
+fn spawn_ball(golf: &mut Golf, commands: &mut Commands, meshes: &mut Assets<Mesh>, materials: &mut Assets<StandardMaterial>, name: &str, color: usize, at: V3) {
+    let Some(root) = golf.root else {
+        return;
+    };
+    let mesh = golf.ball_mesh.get_or_insert_with(|| meshes.add(ball_mesh())).clone();
+    let [r, g, b] = BALL_COLORS[color % BALL_COLORS.len()];
+    let mat = materials.add(StandardMaterial { base_color: Color::linear_rgb(r, g, b), unlit: true, ..default() });
+    if let Some(old) = golf.balls.remove(name) {
+        commands.entity(old.entity).despawn();
+    }
+    let e = commands
+        .spawn((Name::new(format!("golf ball {name}")), Mesh3d(mesh), MeshMaterial3d(mat), Transform::from_translation(golf.world(at)), ChildOf(root)))
+        .id();
+    golf.balls.insert(name.to_string(), Ball { entity: e, pos: at, sink_at: None });
+}
