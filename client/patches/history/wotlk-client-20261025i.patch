+//! Leyline minigolf, the first mode on the play layer.
+//!
+//! The course, the balls and the aim live only on the clients of the players in a session; the
+//! realm (`ov_golf.lua`) only orders turns, counts strokes and relays each shot's integer input.
+//! Every client then plays the shot through [`benilla_mode::golf::simulate`], which is
+//! bit-identical on every platform, so all players see the same roll without any ball positions on
+//! the wire. The HUD (`WrathUnleashedUI/Golf.lua`) drives this module through one Lua function:
+//!
+//! ```text
+//! LeylineGolf("load <wowX> <wowY> <wowZ> <orientation>\n<course text>")   course at a world spot
+//! LeylineGolf("hole <n>")                       build hole n (1-based), fly over it
+//! LeylineGolf("ball <name> <color> <x> <y> <z>")  show a ball (hole-local yards)
+//! LeylineGolf("hide <name>")
+//! LeylineGolf("aim <name> [angle]")             the local player's turn: A/D aim, hold Space
+//! LeylineGolf("noaim")
+//! LeylineGolf("shot <name> <x> <y> <z> <angle> <power> <phase>")  play a shot for everyone
+//! LeylineGolf("phase <tick>")                   where spinners and sliders are now
+//! LeylineGolf("end")                            remove everything
+//! LeylineGolf("state")  -> "aiming=1 power=523 angle=1234 rolling=0 hole=3 charging=0"
+//! ```
+//!
+//! and calls back `WrathUnleashedUI.Golf.OnShoot(angle, power)` when the local player releases a
+//! shot, and `WrathUnleashedUI.Golf.OnRest(name, end, x, y, z, hash)` when a roll finishes.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+use benilla_mode::detmath::{Rot, V3};
+use benilla_mode::golf::{self, Course, End, Hole, Motion, Piece, Shape, Shot, Surface, BALL_R, CUP_R};
+use bevy::asset::RenderAssetUsages;
+use bevy::mesh::{Indices, PrimitiveTopology};
+use bevy::prelude::*;
+
+use crate::player::camera::FlyCam;
+use crate::player::Player;
+
+/// The course is drawn this far above where the session started, on a stone plinth, so uneven
+/// ground doesn't poke through the turf. Only the drawing moves; the simulation is hole-local.
+const LIFT: f32 = 0.35;
+/// Aim turn rate (tenths of a degree per second); Shift turns a fifth as fast.
+const AIM_RATE: f32 = 900.0;
+/// One full power swing up and back down (seconds).
+const CHARGE_CYCLE: f32 = 1.8;
+/// Ticks of path the aim preview shows.
+const PREVIEW_TICKS: u32 = 42;
+const FLYOVER_SECS: f32 = 2.6;
+const BALL_COLORS: [[f32; 3]; 8] = [
+    [0.97, 0.97, 0.95],
+    [1.0, 0.55, 0.12],
+    [0.25, 0.8, 1.0],
+    [1.0, 0.4, 0.75],
+    [1.0, 0.88, 0.2],
+    [0.55, 1.0, 0.3],
+    [0.7, 0.5, 1.0],
+    [1.0, 0.3, 0.25],
+];
+
+// ------------------------------------------------------------------------------------------------
+// The Lua bridge
+
+#[derive(Default)]
+struct Bridge {
+    inbox: Vec<String>,
+    snapshot: String,
+}
+
+static BRIDGE: Mutex<Bridge> = Mutex::new(Bridge { inbox: Vec::new(), snapshot: String::new() });
+
+fn bridge() -> std::sync::MutexGuard<'static, Bridge> {
+    BRIDGE.lock().unwrap_or_else(|p| p.into_inner())
+}
+
+/// Installs `LeylineGolf(text)` into each new UI VM.
+fn install_bridge(script: Option<NonSend<benilla_ui::script::UiScript>>, mut installed: Local<u64>) {
+    let Some(script) = script else {
+        return;
+    };
+    if *installed == script.session() {
+        return;
+    }
+    *installed = script.session();
+    let made = script.lua().create_function(|_, text: String| {
+        let mut b = bridge();
+        if text == "state" {
+            return Ok(b.snapshot.clone());
+        }
+        if text.len() <= golf::MAX_TEXT + 256 && b.inbox.len() < 256 {
+            b.inbox.push(text);
+            Ok("ok".to_string())
+        } else {
+            Ok("busy".to_string())
+        }
+    });
+    match made {
+        Ok(f) => {
+            if let Err(e) = script.lua().globals().set("LeylineGolf", f) {
+                error!("golf: installing LeylineGolf: {e}");
+            }
+        }
+        Err(e) => error!("golf: creating LeylineGolf: {e}"),
+    }
+}
+
+fn call_hud(script: Option<&benilla_ui::script::UiScript>, call: &str) {
+    if let Some(script) = script {
+        crate::ui_script::run_or_warn(
+            script,
+            &format!("if WrathUnleashedUI and WrathUnleashedUI.Golf then WrathUnleashedUI.Golf.{call} end"),
+        );
+    }
+}
+
+/// A Lua string literal for a player name (letters only reach here, but quote safely anyway).
+fn lua_str(s: &str) -> String {
+    let clean: String = s.chars().filter(|c| c.is_alphanumeric() || *c == ' ' || *c == '-').take(24).collect();
+    format!("\"{clean}\"")
+}
+
+// ------------------------------------------------------------------------------------------------
+// State
+
+struct Ball {
+    entity: Entity,
+    pos: V3,
+    /// Holed: the ball is hidden once this time passes.
+    sink_at: Option<f32>,
+}
+
+struct Aim {
+    name: String,
+    angle: f32,
+    power: f32,
+    charging: Option<f32>,
+}
+
+struct Roll {
+    name: String,
+    outcome: golf::Outcome,
+    start: f32,
+    phase: i64,
+}
+
+#[derive(Clone)]
+struct Mats {
+    solid: Handle<StandardMaterial>,
+    glass: Handle<StandardMaterial>,
+    cloth: Handle<StandardMaterial>,
+}
+
+/// The session as this client shows it.
+#[derive(Resource, Default)]
+pub(crate) struct Golf {
+    course: Option<Course>,
+    origin: Vec3,
+    yaw: f32,
+    hole: usize,
+    root: Option<Entity>,
+    movers: Vec<(Entity, Piece)>,
+    flag: Option<Entity>,
+    balls: HashMap<String, Ball>,
+    aim: Option<Aim>,
+    roll: Option<Roll>,
+    /// Phase tick `.0` was current at time `.1` (seconds).
+    phase: (i64, f32),
+    flyover: Option<f32>,
+    cam: Option<Transform>,
+    zoom: f32,
+    confetti: Option<(f32, Vec3)>,
+    mats: Option<Mats>,
+    ball_mesh: Option<Handle<Mesh>>,
+}
+
+impl Golf {
+    fn active(&self) -> bool {
+        self.course.is_some()
+    }
+    fn hole(&self) -> Option<&Hole> {
+        self.course.as_ref().and_then(|c| c.holes.get(self.hole))
+    }
+    fn basis(&self) -> Quat {
+        Quat::from_rotation_y(self.yaw)
+    }
+    /// Hole-local yards to the world.
+    fn world(&self, p: V3) -> Vec3 {
+        self.origin + self.basis() * Vec3::new(p.x, p.y + LIFT, -p.z)
+    }
+    /// A hole-local direction to the world.
+    fn world_dir(&self, d: V3) -> Vec3 {
+        self.basis() * Vec3::new(d.x, d.y, -d.z)
+    }
+    /// A hole-local rotation to a world rotation for a mesh built with z flipped ([`Geo`]).
+    fn world_rot(&self, r: &Rot) -> Quat {
+        let s = [1.0, 1.0, -1.0];
+        let m = |i: usize, j: usize| s[i] * s[j] * r.m[i][j];
+        let mat = Mat3::from_cols(
+            Vec3::new(m(0, 0), m(1, 0), m(2, 0)),
+            Vec3::new(m(0, 1), m(1, 1), m(2, 1)),
+            Vec3::new(m(0, 2), m(1, 2), m(2, 2)),
+        );
+        self.basis() * Quat::from_mat3(&mat).normalize()
+    }
+    fn phase_now(&self, now: f32) -> i64 {
+        self.phase.0 + ((now - self.phase.1).max(0.0) * golf::TICK_HZ as f32) as i64
+    }
+}
+
+// ------------------------------------------------------------------------------------------------
+// Geometry: built in piece-local yards with z flipped (to Bevy's handedness), vertex-lit.
+
+#[derive(Default)]
+struct Geo {
+    pos: Vec<[f32; 3]>,
+    nrm: Vec<[f32; 3]>,
+    col: Vec<[f32; 4]>,
+    idx: Vec<u32>,
+}
+
+/// The light baked into vertex colours (the world has no Bevy lights): a high sun from front-left.
+fn shade(n: Vec3) -> f32 {
+    let l = Vec3::new(-0.35, 0.86, 0.37).normalize();
+    0.58 + 0.42 * n.dot(l).max(0.0)
+}
+
+fn flip(v: Vec3) -> Vec3 {
+    Vec3::new(v.x, v.y, -v.z)
+}
+
+impl Geo {
+    /// A flat quad from hole-local corners (any winding) facing hole-local `n`.
+    fn quad(&mut self, c: [Vec3; 4], n: Vec3, rgb: [f32; 3]) {
+        let n = flip(n);
+        let s = shade(n);
+        let base = self.pos.len() as u32;
+        for p in c {
+            self.pos.push(flip(p).to_array());
+            self.nrm.push(n.to_array());
+            self.col.push([rgb[0] * s, rgb[1] * s, rgb[2] * s, 1.0]);
+        }
+        let p = |i: u32| Vec3::from(self.pos[(base + i) as usize]);
+        // The diagonals' cross: right for degenerate quads (fans, triangles) too.
+        let geo_n = (p(2) - p(0)).cross(p(3) - p(1));
+        if geo_n.dot(n) >= 0.0 {
+            self.idx.extend([base, base + 1, base + 2, base, base + 2, base + 3]);
+        } else {
+            self.idx.extend([base, base + 2, base + 1, base, base + 3, base + 2]);
+        }
+    }
+
+    /// A box centred on the origin. `top` paints the top face (stripes, speckle); `sides` the rest.
+    fn block(&mut self, h: Vec3, top: impl Fn(f32, f32) -> [f32; 3], sides: [f32; 3], bottom: bool) {
+        // Top: strips 1 yd long along z, so stripes and speckle have somewhere to live.
+        let strips = ((h.z * 2.0).ceil() as i32).clamp(1, 60);
+        let cols = ((h.x * 2.0 / 1.2).ceil() as i32).clamp(1, 20);
+        for i in 0..strips {
+            let z0 = -h.z + 2.0 * h.z * i as f32 / strips as f32;
+            let z1 = -h.z + 2.0 * h.z * (i + 1) as f32 / strips as f32;
+            for j in 0..cols {
+                let x0 = -h.x + 2.0 * h.x * j as f32 / cols as f32;
+                let x1 = -h.x + 2.0 * h.x * (j + 1) as f32 / cols as f32;
+                let rgb = top((x0 + x1) * 0.5, (z0 + z1) * 0.5);
+                self.quad(
+                    [Vec3::new(x0, h.y, z0), Vec3::new(x1, h.y, z0), Vec3::new(x1, h.y, z1), Vec3::new(x0, h.y, z1)],
+                    Vec3::Y,
+                    rgb,
+                );
+            }
+        }
+        let (x, y, z) = (h.x, h.y, h.z);
+        self.quad([Vec3::new(x, -y, -z), Vec3::new(x, y, -z), Vec3::new(x, y, z), Vec3::new(x, -y, z)], Vec3::X, sides);
+        self.quad([Vec3::new(-x, -y, -z), Vec3::new(-x, y, -z), Vec3::new(-x, y, z), Vec3::new(-x, -y, z)], -Vec3::X, sides);
+        self.quad([Vec3::new(-x, -y, z), Vec3::new(x, -y, z), Vec3::new(x, y, z), Vec3::new(-x, y, z)], Vec3::Z, sides);
+        self.quad([Vec3::new(-x, -y, -z), Vec3::new(x, -y, -z), Vec3::new(x, y, -z), Vec3::new(-x, y, -z)], -Vec3::Z, sides);
+        if bottom {
+            self.quad([Vec3::new(-x, -y, -z), Vec3::new(x, -y, -z), Vec3::new(x, -y, z), Vec3::new(-x, -y, z)], -Vec3::Y, sides);
+        }
+    }
+
+    /// An upright cylinder from y = 0 to `h`, bands of colour up its side, a cap on top.
+    fn post(&mut self, r: f32, h: f32, band: impl Fn(usize) -> [f32; 3], cap: [f32; 3]) {
+        let seg = 20;
+        let bands = ((h / 0.14).round() as usize).max(1);
+        for b in 0..bands {
+            let y0 = h * b as f32 / bands as f32;
+            let y1 = h * (b + 1) as f32 / bands as f32;
+            for i in 0..seg {
+                let a0 = std::f32::consts::TAU * i as f32 / seg as f32;
+                let a1 = std::f32::consts::TAU * (i + 1) as f32 / seg as f32;
+                let (p0, p1) = (Vec3::new(a0.cos() * r, 0.0, a0.sin() * r), Vec3::new(a1.cos() * r, 0.0, a1.sin() * r));
+                let mid = ((a0 + a1) * 0.5).cos();
+                let n = Vec3::new(mid, 0.0, ((a0 + a1) * 0.5).sin());
+                self.quad([p0 + Vec3::Y * y0, p1 + Vec3::Y * y0, p1 + Vec3::Y * y1, p0 + Vec3::Y * y1], n, band(b));
+            }
+        }
+        for i in 0..seg {
+            let a0 = std::f32::consts::TAU * i as f32 / seg as f32;
+            let a1 = std::f32::consts::TAU * (i + 1) as f32 / seg as f32;
+            let c = Vec3::Y * h;
+            self.quad(
+                [c, c, c + Vec3::new(a1.cos() * r, 0.0, a1.sin() * r), c + Vec3::new(a0.cos() * r, 0.0, a0.sin() * r)],
+                Vec3::Y,
+                cap,
+            );
+        }
+    }
+
+    fn mesh(self) -> Mesh {
+        Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::RENDER_WORLD)
+            .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, self.pos)
+            .with_inserted_attribute(Mesh::ATTRIBUTE_NORMAL, self.nrm)
+            .with_inserted_attribute(Mesh::ATTRIBUTE_COLOR, self.col)
+            .with_inserted_indices(Indices::U32(self.idx))
+    }
+}
+
+/// A cheap stable hash for per-cell colour variation.
+fn jitter(x: f32, z: f32) -> f32 {
+    let h = ((x * 12.9898 + z * 78.233).sin() * 43_758.547).fract();
+    h.abs()
+}
+
+fn turf_colour(x: f32, z: f32) -> [f32; 3] {
+    let stripe = ((z.floor() as i32).rem_euclid(2)) as f32;
+    let j = jitter(x, z) * 0.04;
+    [0.20 + 0.04 * stripe + j, 0.56 + 0.08 * stripe + j, 0.20 + 0.03 * stripe]
+}
+
+fn piece_geo(piece: &Piece) -> Geo {
+    let mut g = Geo::default();
+    match (piece.surface, piece.shape, piece.motion) {
+        (Surface::Wall, Shape::Block { half, .. }, Motion::Spin { .. }) => {
+            g.block(
+                Vec3::new(half.x, half.y, half.z),
+                |x, _| if ((x * 2.5).floor() as i32).rem_euclid(2) == 0 { [0.86, 0.16, 0.14] } else { [0.95, 0.93, 0.88] },
+                [0.75, 0.2, 0.16],
+                true,
+            );
+        }
+        (Surface::Wall, Shape::Block { half, .. }, Motion::Slide { .. }) => {
+            g.block(
+                Vec3::new(half.x, half.y, half.z),
+                |x, z| if (((x + z) * 3.0).floor() as i32).rem_euclid(2) == 0 { [0.98, 0.8, 0.1] } else { [0.12, 0.12, 0.12] },
+                [0.9, 0.72, 0.1],
+                true,
+            );
+        }
+        (Surface::Wall, Shape::Block { half, .. }, _) => {
+            // Timber rails with a lighter cap.
+            g.block(Vec3::new(half.x, half.y, half.z), |_, z| {
+                let plank = ((z * 1.1).floor() as i32).rem_euclid(2) as f32;
+                [0.62 + 0.04 * plank, 0.43 + 0.03 * plank, 0.25]
+            }, [0.47, 0.31, 0.17], false);
+        }
+        (surface, Shape::Block { half, pitch_t, .. }, _) => {
+            let h = Vec3::new(half.x, half.y, half.z);
+            let sides = [0.42, 0.40, 0.37];
+            match surface {
+                Surface::Sand => g.block(h, |x, z| {
+                    let j = jitter(x * 3.0, z * 3.0) * 0.06;
+                    [0.86 + j, 0.76 + j, 0.52 + j]
+                }, sides, false),
+                Surface::Ice => g.block(h, |x, z| {
+                    let j = jitter(x, z) * 0.05;
+                    [0.72 + j, 0.9 + j, 0.98]
+                }, sides, false),
+                _ => g.block(h, turf_colour, sides, false),
+            }
+            if pitch_t == 0 {
+                // The stone plinth under level ground.
+                let (x, y, z) = (h.x, h.y, h.z);
+                let (top, low) = (-y, -y - 1.2);
+                let stone = [0.46, 0.44, 0.41];
+                g.quad([Vec3::new(x, low, -z), Vec3::new(x, top, -z), Vec3::new(x, top, z), Vec3::new(x, low, z)], Vec3::X, stone);
+                g.quad([Vec3::new(-x, low, -z), Vec3::new(-x, top, -z), Vec3::new(-x, top, z), Vec3::new(-x, low, z)], -Vec3::X, stone);
+                g.quad([Vec3::new(-x, low, z), Vec3::new(x, low, z), Vec3::new(x, top, z), Vec3::new(-x, top, z)], Vec3::Z, stone);
+                g.quad([Vec3::new(-x, low, -z), Vec3::new(x, low, -z), Vec3::new(x, top, -z), Vec3::new(-x, top, -z)], -Vec3::Z, stone);
+            }
+        }
+        (_, Shape::Post { r, h }, _) => {
+            g.post(r, h, |b| if b % 2 == 0 { [0.9, 0.18, 0.16] } else { [0.96, 0.95, 0.92] }, [0.9, 0.85, 0.3]);
+        }
+    }
+    g
+}
+
+fn ball_mesh() -> Mesh {
+    // A UV sphere lit from above; the material's colour tints it per player.
+    let mut g = Geo::default();
+    let (rings, seg) = (10, 16);
+    for i in 0..rings {
+        let t0 = std::f32::consts::PI * i as f32 / rings as f32;
+        let t1 = std::f32::consts::PI * (i + 1) as f32 / rings as f32;
+        for j in 0..seg {
+            let p0 = std::f32::consts::TAU * j as f32 / seg as f32;
+            let p1 = std::f32::consts::TAU * (j + 1) as f32 / seg as f32;
+            let v = |t: f32, p: f32| Vec3::new(t.sin() * p.cos(), t.cos(), t.sin() * p.sin()) * BALL_R;
+            let n = v((t0 + t1) * 0.5, (p0 + p1) * 0.5).normalize();
+            g.quad([v(t0, p0), v(t0, p1), v(t1, p1), v(t1, p0)], n, [1.0, 1.0, 1.0]);
+        }
+    }
+    g.mesh()
+}
+
+// ------------------------------------------------------------------------------------------------
+// Building and tearing down
+
+fn mats(golf: &mut Golf, materials: &mut Assets<StandardMaterial>) -> Mats {
+    if let Some(m) = &golf.mats {
+        return m.clone();
+    }
+    let m = Mats {
+        solid: materials.add(StandardMaterial { base_color: Color::WHITE, unlit: true, ..default() }),
+        glass: materials.add(StandardMaterial {
+            base_color: Color::linear_rgba(0.16, 0.48, 0.8, 0.62),
+            unlit: true,
+            alpha_mode: AlphaMode::Blend,
+            ..default()
+        }),
+        cloth: materials.add(StandardMaterial {
+            base_color: Color::WHITE,
+            unlit: true,
+            double_sided: true,
+            cull_mode: None,
+            ..default()
+        }),
+    };
+    golf.mats = Some(m.clone());
+    m
+}
+
+fn clear(golf: &mut Golf, commands: &mut Commands) {
+    if let Some(root) = golf.root.take() {
+        commands.entity(root).despawn();
+    }
+    golf.movers.clear();
+    golf.balls.clear();
+    golf.flag = None;
+    golf.aim = None;
+    golf.roll = None;
+}
+
+fn build_hole(golf: &mut Golf, commands: &mut Commands, meshes: &mut Assets<Mesh>, materials: &mut Assets<StandardMaterial>, now: f32) {
+    let m = mats(golf, materials);
+    clear(golf, commands);
+    let Some(hole) = golf.hole().cloned() else {
+        return;
+    };
+    let root = commands.spawn((Name::new("golf hole"), Transform::IDENTITY, Visibility::default())).id();
+    golf.root = Some(root);
+    let phase = golf.phase_now(now);
+    for piece in &hole.pieces {
+        let mesh = meshes.add(piece_geo(piece).mesh());
+        let (center, rot) = piece_pose(piece, phase);
+        let t = Transform { translation: golf.world(center), rotation: golf.world_rot(&rot), ..default() };
+        let e = commands.spawn((Mesh3d(mesh), MeshMaterial3d(m.solid.clone()), t, ChildOf(root))).id();
+        if piece.motion != Motion::Still {
+            golf.movers.push((e, *piece));
+        }
+    }
+    for w in &hole.water {
+        let mut g = Geo::default();
+        let (x, z) = (w.half_x, w.half_z);
+        g.quad([Vec3::new(-x, 0.0, -z), Vec3::new(x, 0.0, -z), Vec3::new(x, 0.0, z), Vec3::new(-x, 0.0, z)], Vec3::Y, [1.0, 1.0, 1.0]);
+        let t = Transform::from_translation(golf.world(w.center)).with_rotation(golf.basis());
+        commands.spawn((Mesh3d(meshes.add(g.mesh())), MeshMaterial3d(m.glass.clone()), t, ChildOf(root)));
+        // The pool floor and walls, dark, so the water reads as deep.
+        let mut bed = Geo::default();
+        bed.block(Vec3::new(x, 0.35, z), |_, _| [0.06, 0.16, 0.26], [0.3, 0.3, 0.3], false);
+        let t = Transform::from_translation(golf.world(w.center + V3::new(0.0, -0.85, 0.0))).with_rotation(golf.basis());
+        commands.spawn((Mesh3d(meshes.add(bed.mesh())), MeshMaterial3d(m.solid.clone()), t, ChildOf(root)));
+    }
+    for b in &hole.boosts {
+        let mut g = Geo::default();
+        g.block(Vec3::new(b.half_x, 0.012, b.half_z), |x, z| {
+            // Chevrons pointing forward (+z).
+            let v = (z * 2.2 - x.abs() * 2.6).rem_euclid(1.0);
+            if v < 0.45 { [1.0, 0.82, 0.15] } else { [0.85, 0.32, 0.08] }
+        }, [0.6, 0.25, 0.08], false);
+        let rot = Rot::yaw_pitch(b.yaw_t, 0);
+        let t = Transform { translation: golf.world(b.center + V3::new(0.0, 0.008, 0.0)), rotation: golf.world_rot(&rot), ..default() };
+        commands.spawn((Mesh3d(meshes.add(g.mesh())), MeshMaterial3d(m.solid.clone()), t, ChildOf(root)));
+    }
+    // The cup: a white rim and a dark hole, a flag on a pole.
+    let mut cup = Geo::default();
+    cup.post(CUP_R + 0.035, 0.006, |_| [0.95, 0.95, 0.95], [0.95, 0.95, 0.95]);
+    commands.spawn((
+        Mesh3d(meshes.add(cup.mesh())),
+        MeshMaterial3d(m.solid.clone()),
+        Transform::from_translation(golf.world(hole.cup)),
+        ChildOf(root),
+    ));
+    let mut hole_disc = Geo::default();
+    hole_disc.post(CUP_R, 0.009, |_| [0.02, 0.02, 0.02], [0.02, 0.03, 0.02]);
+    commands.spawn((
+        Mesh3d(meshes.add(hole_disc.mesh())),
+        MeshMaterial3d(m.solid.clone()),
+        Transform::from_translation(golf.world(hole.cup)),
+        ChildOf(root),
+    ));
+    let mut pole = Geo::default();
+    pole.post(0.022, 1.7, |b| if b % 3 == 0 { [0.9, 0.15, 0.12] } else { [0.97, 0.97, 0.97] }, [0.98, 0.85, 0.2]);
+    let mut cloth = Geo::default();
+    cloth.quad(
+        [Vec3::new(0.0, 1.32, 0.0), Vec3::new(0.62, 1.47, 0.0), Vec3::new(0.62, 1.47, 0.0), Vec3::new(0.0, 1.68, 0.0)],
+        Vec3::Z,
+        [0.92, 0.12, 0.1],
+    );
+    let flag = commands
+        .spawn((
+            Mesh3d(meshes.add(pole.mesh())),
+            MeshMaterial3d(m.solid.clone()),
+            Transform::from_translation(golf.world(hole.cup)),
+            ChildOf(root),
+        ))
+        .id();
+    commands.spawn((Mesh3d(meshes.add(cloth.mesh())), MeshMaterial3d(m.cloth.clone()), Transform::IDENTITY, ChildOf(flag)));
+    golf.flag = Some(flag);
+    // The tee mat.
+    let mut mat = Geo::default();
+    mat.block(Vec3::new(0.28, 0.006, 0.28), |_, _| [0.1, 0.32, 0.14], [0.08, 0.2, 0.1], false);
+    commands.spawn((
+        Mesh3d(meshes.add(mat.mesh())),
+        MeshMaterial3d(m.solid.clone()),
+        Transform::from_translation(golf.world(hole.tee + V3::new(0.0, 0.004, 0.0))).with_rotation(golf.basis()),
+        ChildOf(root),
+    ));
+    golf.flyover = Some(now);
+    golf.cam = None;
+}
