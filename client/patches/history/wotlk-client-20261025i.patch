+#!/usr/bin/env bash
+# Minigolf determinism: the wasm build (as the browser client compiles it: simd128, debug and
+# release) must compute the same shot fingerprint as the native tests pin
+# (crates/benilla-mode/courses/golden.txt). Needs node and rust-src (build-std).
+set -euo pipefail
+cd "$(dirname "$0")/golf-det"
+want=$(tr -d '[:space:]' < ../../crates/benilla-mode/courses/golden.txt)
+export RUSTC_BOOTSTRAP=1 CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/tmp/golf-det-target}
+export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS="-C target-feature=+simd128"
+status=0
+for profile in dev release; do
+  cargo build -q --profile "$profile" -Z build-std=std,panic_abort --target wasm32-unknown-unknown
+  dir=$([ "$profile" = dev ] && echo debug || echo release)
+  got=$(node -e '
+    const b = require("fs").readFileSync(process.argv[1]);
+    WebAssembly.instantiate(b, {}).then(({instance: i}) => {
+      const h = i.exports.fingerprint_hi() >>> 0, l = i.exports.fingerprint_lo() >>> 0;
+      console.log(h.toString(16).padStart(8, "0") + l.toString(16).padStart(8, "0"));
+    });' "$CARGO_TARGET_DIR/wasm32-unknown-unknown/$dir/golf_det.wasm")
+  if [ "$got" = "$want" ]; then echo "wasm $profile: $got matches"; else echo "wasm $profile: $got, expected $want"; status=1; fi
+done
+exit $status
