+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_editor_round_trips_the_shipped_course() {
+        let course = golf::parse(golf::MEADOW_NINE).unwrap();
+        let mut ed = Editor { on: true, ..Editor::default() };
+        ed.title = course.title.clone();
+        ed.author = course.author.clone();
+        ed.holes = course.holes.iter().map(EditHole::from_hole).collect();
+        let again = golf::parse(&ed.text()).expect("the editor's text parses");
+        for (a, b) in course.holes.iter().zip(&again.holes) {
+            let (sa, sb) = (golf::simulate(a, a.tee_ball(), Shot { angle_t: 40, power_m: 700 }, 5), golf::simulate(b, b.tee_ball(), Shot { angle_t: 40, power_m: 700 }, 5));
+            // Pieces may be reordered (water and boosts last), so compare where the ball ends up.
+            assert_eq!(sa.end, sb.end, "hole {}", a.number);
+            assert!((sa.rest - sb.rest).len() < 1e-3, "hole {}", a.number);
+        }
+    }
+
+    #[test]
+    fn a_ray_finds_the_nearest_box() {
+        let hole = EditHole::starter(1);
+        let (hit, place) = pick(&hole, V3::new(0.0, 5.0, 4.0), V3::new(0.0, -1.0, 0.0));
+        assert_eq!(hit.map(|h| h.0), Some(0), "straight down onto the turf");
+        assert!((place.unwrap().y - 0.0).abs() < 1e-4);
+    }
+
+    #[test]
+    fn numbers_read_cleanly() {
+        assert_eq!(num(1.5), "1.5");
+        assert_eq!(num(-0.0001), "0");
+        assert_eq!(num(2.0), "2");
+        assert_eq!(num(0.263), "0.263");
+    }
+}
