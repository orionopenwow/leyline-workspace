+/// The browser's frame pacing. Bevy's web runner updates once per `requestAnimationFrame`, so a
+/// frame of 17-33 ms waits for the vblank after next and the rate halves to exactly 30 fps
+/// (Dalaran: p50 33.3 ms, 31 fps, on frames of ~20 ms of work). Once frames run slow the loop is
+/// let off the animation frame: the next frame starts when this one ends, and the browser shows
+/// the newest at each vblank, so ~20 ms frames show at ~50 fps instead of 30. Fast frames go
+/// back to the animation frame, which never renders a frame the display cannot show.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum WebPacing {
+    /// One update per animation frame (bevy's own loop).
+    AnimationFrame,
+    /// The next update as soon as this one ends.
+    FreeRun,
+}
+
+/// Mean frame time (ms) above which the loop leaves the animation frame: past one 60 Hz vblank.
+pub(crate) const FREE_RUN_ABOVE_MS: f32 = 18.0;
+/// Mean frame time (ms) below which it goes back: well inside one vblank.
+pub(crate) const FREE_RUN_BELOW_MS: f32 = 14.0;
+/// The mean's smoothing, per frame.
+#[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+const PACING_EMA: f32 = 0.05;
+
+/// The pacing for a smoothed frame time, with hysteresis.
+pub(crate) fn web_pacing(current: WebPacing, mean_ms: f32) -> WebPacing {
+    match current {
+        WebPacing::AnimationFrame if mean_ms > FREE_RUN_ABOVE_MS => WebPacing::FreeRun,
+        WebPacing::FreeRun if mean_ms < FREE_RUN_BELOW_MS => WebPacing::AnimationFrame,
+        p => p,
+    }
+}
+
+/// The free-running loop: a zero wait, so the runner polls, and an update needs no redraw.
+fn free_run_mode() -> UpdateMode {
+    UpdateMode::Reactive {
+        wait: Duration::ZERO,
+        react_to_device_events: false,
+        react_to_user_events: false,
+        react_to_window_events: false,
+    }
+}
+
+/// Switch the foreground loop between the animation frame and free-running ([`WebPacing`]).
+/// Only with no `maxFPS` cap, and only in a focused tab. Bevy's runner updates without a redraw
+/// only while every window reads invisible, which on the web changes nothing else (winit's
+/// `set_visible` is a no-op there), so free-running also clears `Window::visible`.
+#[cfg(target_arch = "wasm32")]
+fn pace_web_frames(
+    cap: Res<FrameCap>,
+    time: Res<Time<bevy::time::Real>>,
+    settings: Option<ResMut<WinitSettings>>,
+    mut windows: Query<&mut Window, With<bevy::window::PrimaryWindow>>,
+    mut state: Local<Option<(WebPacing, f32)>>,
+) {
+    let Some(mut settings) = settings else { return };
+    let Ok(mut window) = windows.single_mut() else { return };
+    let dt_ms = (time.delta_secs() * 1000.0).min(250.0);
+    let (pacing, mean) = state.get_or_insert((WebPacing::AnimationFrame, 16.7));
+    *mean += (dt_ms - *mean) * PACING_EMA;
+    let want = if cap.foreground == 0 && window.focused {
+        web_pacing(*pacing, *mean)
+    } else {
+        WebPacing::AnimationFrame
+    };
+    if want == *pacing {
+        return;
+    }
+    *pacing = want;
+    match want {
+        WebPacing::FreeRun => {
+            settings.focused_mode = free_run_mode();
+            window.visible = false;
+        }
+        WebPacing::AnimationFrame => {
+            settings.focused_mode = update_mode(cap.foreground, false);
+            window.visible = true;
+        }
+    }
+    info!("video: browser frame pacing {want:?} (mean frame {mean:.1} ms)");
+}
