+#[derive(Clone, Copy)]
+struct Retry {
+    tries: u32,
+    next_at: Instant,
+}
+
+/// Tries for an M2 placement or WMO prop before it retires as empty.
+const M2_RETRIES: u32 = 3;
+
+/// The wait before re-request `tries` (1-based): 1, 2, 4, 8, then every 10 s.
+fn retry_delay(tries: u32) -> Duration {
+    Duration::from_secs(match tries {
+        0 | 1 => 1,
+        2 => 2,
+        3 => 4,
+        4 => 8,
+        _ => 10,
+    })
+}
+
+/// What to do with a failed load: retire it (absent, or out of tries) or wait for its re-request.
+#[derive(Debug, PartialEq, Eq)]
+enum FailedLoad {
+    Retire,
+    Retrying,
+}
+
+impl LoadRetries {
+    /// A failed load's next step; a re-request is due, it is sent through `reload`.
+    fn on_failed(
+        &mut self,
+        id: bevy::asset::UntypedAssetId,
+        absent: bool,
+        wmo: bool,
+        now: Instant,
+        reload: impl FnOnce(),
+    ) -> FailedLoad {
+        if absent {
+            self.by_asset.remove(&id);
+            return FailedLoad::Retire;
+        }
+        let r = self.by_asset.entry(id).or_insert(Retry {
+            tries: 0,
+            next_at: now,
+        });
+        if now < r.next_at {
+            return FailedLoad::Retrying;
+        }
+        if !wmo && r.tries >= M2_RETRIES {
+            self.by_asset.remove(&id);
+            return FailedLoad::Retire;
+        }
+        r.tries += 1;
+        r.next_at = now + retry_delay(r.tries);
+        reload();
+        FailedLoad::Retrying
+    }
+}
