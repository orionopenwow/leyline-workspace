+/// Triangle cap per collider build for one placement's hull. The browser builds a trimesh on the
+/// main thread at ~1 µs per triangle and a build is indivisible, so Dalaran's city WMO (313k
+/// camera and 727k walk triangles) froze a frame for 297 ms and 628 ms. Split into pieces of this
+/// size, each build is ~20-25 ms and the per-frame budget spreads them over frames.
+pub const SPLIT_MAX_TRIS: usize = 24_576;
+
+/// `(verts, tris)` cut into pieces of at most `max_tris` triangles, each with only the vertices
+/// its triangles use (indices rebased). The triangles keep their order, and a WMO's merged hull
+/// lists them group by group, so each piece stays one neighbourhood of the building. A hull at or
+/// under the cap comes back whole, untouched.
+pub fn split_collider_data(
+    verts: Vec<Vec3>,
+    tris: Vec<[u32; 3]>,
+    max_tris: usize,
+) -> Vec<(Vec<Vec3>, Vec<[u32; 3]>)> {
+    let max_tris = max_tris.max(1);
+    if tris.len() <= max_tris {
+        return vec![(verts, tris)];
+    }
+    // `stamp[v] == piece + 1` while `v` is in the current piece, so the remap never needs clearing.
+    let mut stamp = vec![0u32; verts.len()];
+    let mut remap = vec![0u32; verts.len()];
+    let mut out = Vec::with_capacity(tris.len().div_ceil(max_tris));
+    for (piece, chunk) in tris.chunks(max_tris).enumerate() {
+        let tag = piece as u32 + 1;
+        let mut pv: Vec<Vec3> = Vec::new();
+        let mut pt: Vec<[u32; 3]> = Vec::with_capacity(chunk.len());
+        for t in chunk {
+            let mut nt = [0u32; 3];
+            for (k, &v) in t.iter().enumerate() {
+                let vi = v as usize;
+                let Some(&p) = verts.get(vi) else {
+                    nt = [u32::MAX; 3];
+                    break;
+                };
+                if stamp[vi] != tag {
+                    stamp[vi] = tag;
+                    remap[vi] = pv.len() as u32;
+                    pv.push(p);
+                }
+                nt[k] = remap[vi];
+            }
+            // An out-of-range index (a malformed hull) drops its triangle, as parry would panic.
+            if nt[0] != u32::MAX {
+                pt.push(nt);
+            }
+        }
+        if !pt.is_empty() {
+            out.push((pv, pt));
+        }
+    }
+    out
+}
