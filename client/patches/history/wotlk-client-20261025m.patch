+/// How a 4:3 layer of the cover fits the window: the art covers it, the bar's area fits inside.
+#[derive(Component, Clone, Copy, PartialEq, Eq, Debug)]
+enum LoadingFit {
+    Cover,
+    Contain,
+}
+
+/// A 4:3 layer's size and top-left in a `w`×`h` window (logical px): `Cover` is at least the
+/// window both ways, `Contain` at most; both centred.
+fn fit_rect(fit: LoadingFit, w: f32, h: f32) -> (f32, f32, f32, f32) {
+    let (w, h) = (w.max(1.0), h.max(1.0));
+    let by_height = (h * BACKDROP_ASPECT, h);
+    let by_width = (w, w / BACKDROP_ASPECT);
+    let wider = w / h > BACKDROP_ASPECT;
+    let (lw, lh) = match (fit, wider) {
+        (LoadingFit::Cover, true) | (LoadingFit::Contain, false) => by_width,
+        (LoadingFit::Cover, false) | (LoadingFit::Contain, true) => by_height,
+    };
+    (lw, lh, (w - lw) * 0.5, (h - lh) * 0.5)
+}
+
+/// Size the cover's two 4:3 layers to the window, on a change only.
+fn fit_loading_layers(
+    window: Query<&Window, With<bevy::window::PrimaryWindow>>,
+    mut layers: Query<(&LoadingFit, &mut Node)>,
+    mut last: Local<Option<(f32, f32)>>,
+) {
+    let Ok(win) = window.single() else {
+        return;
+    };
+    let size = (win.width(), win.height());
+    if *last == Some(size) && !layers.is_empty() {
+        // Re-fit only on a resize (and the first frame the layers exist).
+        return;
+    }
+    if layers.is_empty() {
+        return;
+    }
+    *last = Some(size);
+    for (fit, mut node) in &mut layers {
+        let (w, h, left, top) = fit_rect(*fit, size.0, size.1);
+        node.width = Val::Px(w);
+        node.height = Val::Px(h);
+        node.left = Val::Px(left);
+        node.top = Val::Px(top);
+    }
+}
