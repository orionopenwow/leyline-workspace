+//! The load trace: where a browser load's main-thread time goes, readable from the page.
+//!
+//! - **Phases** ([`phase`]): named milestones on the page clock (`performance.now()`), each with
+//!   the time since the previous one: login, charselect, enter, first world frame, resident, scene
+//!   ready, warm done, cover lifted.
+//! - **Busy spans** ([`busy`], [`timed`]): labelled stretches of main-thread work. A Bevy frame
+//!   is one (labelled with the notes its systems left, [`note`]); an asset loader's poll is
+//!   another, timed by [`timed`] (on wasm a loader runs between frames, on the main thread). The
+//!   ten longest since the world session started are kept; the recent ones (a ring) let the page
+//!   label the browser's own long tasks, which can hold several loader polls at once.
+//! - **Publishing** ([`publish`]): on wasm, `window.__wenilla_loadtrace_rs` as plain arrays; the
+//!   page (`web/boot.js`) merges it with its `longtask` observer into `window.__wenilla_loadtrace`.
+//!
+//! Natively nothing is published; the store still works, for tests and logs.
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::future::Future;
+use std::pin::Pin;
+use std::task::{Context, Poll};
+
+/// A span shorter than this (ms) is not kept: below a frame's worth it is no one's stall.
+pub const KEEP_TOP_MS: f64 = 16.0;
+/// A span shorter than this (ms) does not enter the ring: noise for the long-task matcher.
+pub const KEEP_RECENT_MS: f64 = 2.0;
+/// How many of the longest spans are kept.
+pub const TOP: usize = 10;
+/// The recent-span ring's length.
+const RECENT: usize = 256;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Phase {
+    pub name: String,
+    /// Page clock (ms).
+    pub at: f64,
+    /// Since the previous phase (ms); 0 for the first.
+    pub ms: f64,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Busy {
+    pub label: String,
+    /// Page clock at its start (ms).
+    pub at: f64,
+    pub ms: f64,
+}
+
+#[derive(Default)]
+pub struct Trace {
+    pub phases: Vec<Phase>,
+    /// The [`TOP`] longest, longest first.
+    pub top: Vec<Busy>,
+    pub recent: VecDeque<Busy>,
+    /// This frame's notes, for its label.
+    notes: Vec<String>,
+    /// Frames seen since the world session started, and how many ran past 50 ms.
+    pub frames: u64,
+    pub slow_frames: u64,
+    dirty: bool,
+    last_publish: f64,
+    /// The frame in flight: its start and state label.
+    open: Option<(f64, String)>,
+}
+
+impl Trace {
+    /// Record a milestone; a name already recorded since the last [`Self::restart`] is kept as
+    /// it was (the first time is the one that matters).
+    pub fn phase(&mut self, name: &str, at: f64) {
+        if self.phases.iter().any(|p| p.name == name) {
+            return;
+        }
+        let ms = self.phases.last().map_or(0.0, |p| (at - p.at).max(0.0));
+        self.phases.push(Phase {
+            name: name.to_string(),
+            at,
+            ms,
+        });
+        self.dirty = true;
+    }
+
+    /// A new world session: the busy record restarts, the pre-world phases stay, and the world
+    /// phases may be recorded again (a second Enter World is a new load).
+    pub fn restart(&mut self, keep_phases: &[&str]) {
+        self.phases.retain(|p| keep_phases.contains(&p.name.as_str()));
+        self.top.clear();
+        self.recent.clear();
+        self.frames = 0;
+        self.slow_frames = 0;
+        self.dirty = true;
+    }
+
+    pub fn busy(&mut self, label: impl FnOnce() -> String, at: f64, ms: f64) {
+        if ms < KEEP_RECENT_MS {
+            return;
+        }
+        let entry = Busy {
+            label: label(),
+            at,
+            ms,
+        };
+        if ms >= KEEP_TOP_MS {
+            let i = self.top.partition_point(|b| b.ms >= ms);
+            if i < TOP {
+                self.top.insert(i, entry.clone());
+                self.top.truncate(TOP);
+                self.dirty = true;
+            }
+        }
+        if self.recent.len() == RECENT {
+            self.recent.pop_front();
+        }
+        self.recent.push_back(entry);
+        // The page labels its long tasks from the ring: it goes out within a second.
+        self.dirty = true;
+    }
+
+    pub fn note(&mut self, s: String) {
+        if self.notes.len() < 16 {
+            self.notes.push(s);
+        }
+    }
+
+    /// End a frame that started at `at` and took `ms`: a frame of 50 ms or more is a span,
+    /// labelled with its notes.
+    pub fn end_frame(&mut self, state: &str, at: f64, ms: f64) {
+        self.frames += 1;
+        let notes = std::mem::take(&mut self.notes);
+        if ms >= 50.0 {
+            self.slow_frames += 1;
+            self.busy(
+                || {
+                    if notes.is_empty() {
+                        format!("frame ({state})")
+                    } else {
+                        format!("frame ({state}): {}", notes.join("; "))
+                    }
+                },
+                at,
+                ms,
+            );
+        }
+    }
+
+    /// A frame starts at `at`; one still open (its end never ran) is closed here.
+    pub fn begin_frame(&mut self, at: f64, state: String) {
+        self.close_frame(at);
+        self.open = Some((at, state));
+    }
+
+    /// The frame in flight ends at `now`.
+    pub fn close_frame(&mut self, now: f64) {
+        if let Some((start, state)) = self.open.take() {
+            self.end_frame(&state, start, (now - start).max(0.0));
+        }
+    }
+
+    /// Whether a phase was recorded.
+    pub fn has_phase(&self, name: &str) -> bool {
+        self.phases.iter().any(|p| p.name == name)
+    }
+
+    /// Whether a publish is due at `now`: something changed and a second has passed, or `force`.
+    pub fn due(&mut self, now: f64, force: bool) -> bool {
+        if !self.dirty && !force {
+            return false;
+        }
+        if !force && now - self.last_publish < 1000.0 {
+            return false;
+        }
+        self.dirty = false;
+        self.last_publish = now;
+        true
+    }
+}
+
+thread_local! {
+    static TRACE: RefCell<Trace> = RefCell::new(Trace::default());
+}
+
+/// Run `f` on the store.
+pub fn with<R>(f: impl FnOnce(&mut Trace) -> R) -> R {
+    TRACE.with(|t| f(&mut t.borrow_mut()))
+}
+
+/// The page clock: `performance.now()` in the browser, process time natively (ms).
+pub fn now_ms() -> f64 {
+    #[cfg(target_arch = "wasm32")]
+    {
+        use wasm_bindgen::JsCast;
+        (|| {
+            let perf = js_sys::Reflect::get(&js_sys::global(), &"performance".into()).ok()?;
+            let now = js_sys::Reflect::get(&perf, &"now".into())
+                .ok()?
+                .dyn_into::<js_sys::Function>()
+                .ok()?;
+            now.call0(&perf).ok()?.as_f64()
+        })()
+        .unwrap_or(0.0)
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        static ORIGIN: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+        ORIGIN
+            .get_or_init(std::time::Instant::now)
+            .elapsed()
+            .as_secs_f64()
+            * 1000.0
+    }
+}
+
+/// Record a milestone now, and publish at once.
+pub fn phase(name: &str) {
+    let now = now_ms();
+    with(|t| t.phase(name, now));
+    publish(true);
+}
+
+/// Record a busy span.
+pub fn busy(label: impl FnOnce() -> String, at: f64, ms: f64) {
+    with(|t| t.busy(label, at, ms));
+}
+
+/// Leave a note on this frame's label.
+pub fn note(s: impl FnOnce() -> String) {
+    with(|t| t.note(s()));
+}
+
+/// Time each poll of `f` as a busy span labelled `label`: on wasm a poll is main-thread time.
+pub fn timed<F: Future>(label: String, f: F) -> Timed<F> {
+    Timed {
+        label,
+        inner: Box::pin(f),
+    }
+}
+
+pub struct Timed<F> {
+    label: String,
+    inner: Pin<Box<F>>,
+}
+
+impl<F: Future> Future for Timed<F> {
+    type Output = F::Output;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<F::Output> {
+        let t0 = now_ms();
+        let out = self.inner.as_mut().poll(cx);
+        let ms = now_ms() - t0;
+        if ms >= KEEP_RECENT_MS {
+            let label = &self.label;
+            busy(|| label.clone(), t0, ms);
+        }
+        out
+    }
+}
+
+/// Publish the store to the page (`window.__wenilla_loadtrace_rs`), when due or `force`d.
+pub fn publish(force: bool) {
+    let now = now_ms();
+    if !with(|t| t.due(now, force)) {
+        return;
+    }
+    #[cfg(target_arch = "wasm32")]
+    with(|t| {
+        use js_sys::{Array, Object, Reflect};
+        use wasm_bindgen::JsValue;
+        fn obj(pairs: &[(&str, JsValue)]) -> Object {
+            let o = Object::new();
+            for (k, v) in pairs {
+                let _ = Reflect::set(&o, &JsValue::from_str(k), v);
+            }
+            o
+        }
+        fn busy_list<'a>(it: impl Iterator<Item = &'a Busy>) -> Array {
+            let a = Array::new();
+            for b in it {
+                a.push(&obj(&[
+                    ("label", JsValue::from_str(&b.label)),
+                    ("at", JsValue::from_f64(b.at.round())),
+                    ("ms", JsValue::from_f64(b.ms.round())),
+                ]));
+            }
+            a
+        }
+        let phases = Array::new();
+        for p in &t.phases {
+            phases.push(&obj(&[
+                ("phase", JsValue::from_str(&p.name)),
+                ("at", JsValue::from_f64(p.at.round())),
+                ("ms", JsValue::from_f64(p.ms.round())),
+            ]));
+        }
+        let reads = crate::web::read_stats();
+        let out = obj(&[
+            ("phases", phases.into()),
+            ("tasks", busy_list(t.top.iter()).into()),
+            ("recent", busy_list(t.recent.iter()).into()),
+            ("frames", JsValue::from_f64(t.frames as f64)),
+            ("slowFrames", JsValue::from_f64(t.slow_frames as f64)),
+            (
+                "syncReads",
+                obj(&[
+                    ("count", JsValue::from_f64(f64::from(reads.reads))),
+                    ("ms", JsValue::from_f64(reads.ms.round())),
+                    ("mb", JsValue::from_f64(reads.bytes as f64 / 1048576.0)),
+                ])
+                .into(),
+            ),
+        ]);
+        if let Some(w) = web_sys::window() {
+            let _ = Reflect::set(&w, &"__wenilla_loadtrace_rs".into(), &out);
+        }
+    });
+}
+
