+/// A browser long task's label: the client spans (`__wenilla_loadtrace_rs.recent`, a frame or an
+/// asset loader's poll, loadtrace.rs) it overlaps, longest first, summed per label; a task no
+/// client span explains is the page's own (synchronous reads, GC, fetch callbacks, layout).
+export function labelLongTask(task, spans) {
+  const end = task.at + task.ms;
+  const per = new Map();
+  for (const s of spans || []) {
+    const lo = Math.max(task.at, s.at);
+    const hi = Math.min(end, s.at + s.ms);
+    if (hi <= lo) continue;
+    per.set(s.label, (per.get(s.label) || 0) + (hi - lo));
+  }
+  if (per.size === 0) return 'outside the client\'s spans (sync reads, GC, fetch callbacks, layout)';
+  return [...per.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, 3)
+    .map(([label, ms]) => `${label} ${Math.round(ms)} ms`)
+    .join(' + ');
+}
+
+/// What `window.__wenilla_loadtrace` reads: the client's phases (each `ms` since the one before),
+/// its ten longest labelled spans, the browser's ten longest tasks, and the world load's total.
+export function loadTraceView(rs, longtasks) {
+  rs = rs || {};
+  const phases = rs.phases || [];
+  const at = (name) => phases.find((p) => p.phase === name)?.at;
+  const enter = at('enter');
+  const lifted = at('cover lifted');
+  return {
+    phases: phases.map(({ phase, ms }) => ({ phase, ms })),
+    enterToCoverLiftedMs: enter !== undefined && lifted !== undefined ? Math.round(lifted - enter) : null,
+    tasks: (rs.tasks || []).map(({ label, ms, at }) => ({ label, ms, at })),
+    longtasks: longtasks.map(({ label, ms, at }) => ({ label, ms: Math.round(ms), at: Math.round(at) })),
+    frames: rs.frames ?? 0,
+    slowFrames: rs.slowFrames ?? 0,
+    syncReads: rs.syncReads ?? null,
+  };
+}
+
+/// `window.__wenilla_loadtrace`: one read for the whole load, e.g.
+/// `copy(JSON.stringify(__wenilla_loadtrace, null, 1))`. The browser's long tasks are labelled a
+/// little after they end, once the client has published the spans inside them (at most a second).
+function installLoadTrace() {
+  const longtasks = [];
+  const keep = (t) => {
+    longtasks.push(t);
+    longtasks.sort((a, b) => b.ms - a.ms);
+    longtasks.length = Math.min(longtasks.length, 10);
+  };
+  try {
+    const types = (typeof PerformanceObserver !== 'undefined' && PerformanceObserver.supportedEntryTypes) || [];
+    if (types.includes('longtask')) {
+      new PerformanceObserver((list) => {
+        for (const e of list.getEntries()) {
+          const t = { at: e.startTime, ms: e.duration, label: '(labelling)' };
+          keep(t);
+          setTimeout(() => {
+            t.label = labelLongTask(t, window.__wenilla_loadtrace_rs?.recent);
+          }, 1500);
+        }
+      }).observe({ type: 'longtask', buffered: true });
+    }
+  } catch (_) {
+    /* no long-task timing in this browser: the client's own spans remain */
+  }
+  try {
+    Object.defineProperty(window, '__wenilla_loadtrace', {
+      configurable: true,
+      get: () => loadTraceView(window.__wenilla_loadtrace_rs, longtasks),
+    });
+  } catch (_) {
+    /* a page that froze window */
+  }
+}
+
 function mark(what) {
   console.log(`boot: ${what} at ${Math.round(performance.now())} ms`);
 }
