+/// How [`CurrentAreaWmo`] found its group.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum AreaWmoSource {
+    /// The faces-only down-ray's group under the feet (EXTERIOR included) has its own row.
+    GroupRow,
+    /// The ray's group has no row naming an area (or the ray missed: a jump, a gap, a prop under
+    /// the feet), and the body is inside the placement's bounds: the nearest group with one.
+    NearestGroup,
+}
+
+impl AreaWmoSource {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::GroupRow => "wmo-group",
+            Self::NearestGroup => "wmo-nearest-group",
+        }
+    }
+}
+
+/// The area leg's WMO claim, EXTERIOR groups included: `GetAreaID`'s map-object leg (AzerothCore's
+/// `GetWMOAreaTableEntryByTripple`) names the area of any group under the feet by its exact
+/// `WMOAreaTable` row. Dalaran's streets are exterior groups over Crystalsong Forest terrain, and
+/// both interior claims ([`CurrentAreaInterior`], [`CurrentWmoInterior`]) drop exterior groups by
+/// design, so neither ever named Runeweaver Square.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct AreaWmoClaim {
+    pub keys: WmoInteriorKeys,
+    /// Absolute group index in the building.
+    pub group: usize,
+    /// The `AreaTable` id its row names (never 0).
+    pub area_id: u32,
+    pub source: AreaWmoSource,
+}
+
+/// [`AreaWmoClaim`] for the body, or `None` over the open world and over buildings whose
+/// `WMOAreaTable` group rows name no area.
+#[derive(Resource, Default, Clone, Copy, PartialEq, Eq)]
+pub struct CurrentAreaWmo(pub Option<AreaWmoClaim>);
+
+/// Terrain this close (yd) under the feet is the ground the body stands on: no fallback claim.
+const TERRAIN_UNDERFOOT: f32 = 5.0;
+
+/// How far (yd) outside every group's box the nearest-group fallback still looks.
+const NEAREST_GROUP_REACH: f32 = 40.0;
+
+/// One placement's area claim, `feet` in model-local WoW space. The ray leg first (with its depth,
+/// for arbitration across placements); then, with the feet inside the building's bounds, the
+/// nearest group that has an area row, by distance to its box (smaller box on a tie).
+pub fn zone_wmo_claim(
+    model: &WmoModel,
+    name_set: u32,
+    feet: [f32; 3],
+    terrain_local: Option<f32>,
+    cat: &benilla_formats::WmoAreaCatalog,
+) -> Option<(f32, AreaWmoClaim)> {
+    if model.wmo_id == 0 || !cat.has_group_areas(model.wmo_id, name_set) {
+        return None;
+    }
+    let keys_of = |gi: usize| WmoInteriorKeys {
+        wmo_id: model.wmo_id,
+        name_set,
+        group_area_id: model.group_nav.get(gi).map_or(0, |g| g.area_table_id),
+    };
+    let row_area = |gi: usize| {
+        let k = keys_of(gi);
+        (k.group_area_id != 0)
+            .then(|| cat.group_area(k.wmo_id, k.name_set, k.group_area_id))
+            .flatten()
+    };
+    // The outdoor mask is irrelevant here: an exterior claim is still a claim.
+    let ray = super::seed::down_ray_claim(
+        &model.group_collision_tris,
+        &model.group_collision_bounds,
+        &model.group_collision_grids,
+        &model.group_nav,
+        feet,
+        terrain_local,
+        EXTERIOR,
+    );
+    if let Some(c) = ray {
+        if let Some(area_id) = row_area(c.group) {
+            return Some((
+                c.depth,
+                AreaWmoClaim {
+                    keys: keys_of(c.group),
+                    group: c.group,
+                    area_id,
+                    source: AreaWmoSource::GroupRow,
+                },
+            ));
+        }
+    }
+    // Inside the building's bounds (the collision AABB, else the union of group boxes).
+    let bounds = model.collision_bounds.or_else(|| {
+        model.group_nav.iter().fold(None, |acc: Option<([f32; 3], [f32; 3])>, g| {
+            Some(match acc {
+                None => (g.bbox_min, g.bbox_max),
+                Some((lo, hi)) => (
+                    std::array::from_fn(|i| lo[i].min(g.bbox_min[i])),
+                    std::array::from_fn(|i| hi[i].max(g.bbox_max[i])),
+                ),
+            })
+        })
+    })?;
+    let inside = (0..3).all(|i| feet[i] >= bounds.0[i] - 2.0 && feet[i] <= bounds.1[i] + 2.0);
+    // Standing on the terrain (a park or canal bank inside a city's box): the ground names it.
+    let on_ground = terrain_local
+        .is_some_and(|tz| tz <= feet[2] && feet[2] - tz <= TERRAIN_UNDERFOOT);
+    if !inside || on_ground {
+        return None;
+    }
+    let mut best: Option<(f32, f32, usize, u32)> = None;
+    for (gi, g) in model.group_nav.iter().enumerate() {
+        let Some(area_id) = row_area(gi) else { continue };
+        let d2: f32 = (0..3)
+            .map(|i| {
+                let d = (g.bbox_min[i] - feet[i]).max(feet[i] - g.bbox_max[i]).max(0.0);
+                d * d
+            })
+            .sum();
+        if d2 > NEAREST_GROUP_REACH * NEAREST_GROUP_REACH {
+            continue;
+        }
+        let vol: f32 = (0..3).map(|i| (g.bbox_max[i] - g.bbox_min[i]).max(0.0)).product();
+        if best.is_none_or(|(bd, bv, ..)| d2 < bd || (d2 == bd && vol < bv)) {
+            best = Some((d2, vol, gi, area_id));
+        }
+    }
+    let (d2, _, gi, area_id) = best?;
+    Some((
+        // Behind every ray claim in the arbitration.
+        ZONE_FALLBACK_DEPTH + d2.sqrt(),
+        AreaWmoClaim {
+            keys: keys_of(gi),
+            group: gi,
+            area_id,
+            source: AreaWmoSource::NearestGroup,
+        },
+    ))
+}
+
+/// The arbitration depth of a nearest-group claim: past any ray's reach.
+const ZONE_FALLBACK_DEPTH: f32 = 1.0e6;
+
+/// Track [`CurrentAreaWmo`]: every placed building's [`zone_wmo_claim`] from the feet, the nearest
+/// claim winning.
+pub(super) fn track_area_wmo(
+    wmos: Res<Assets<WmoModel>>,
+    viewer: Res<crate::view::Viewer>,
+    instances: Query<&WmoPortalInstance>,
+    streamer: Res<TerrainStreamer>,
+    adt_tiles: Res<Assets<AdtTile>>,
+    areas: Option<Res<WmoAreas>>,
+    mut current: ResMut<CurrentAreaWmo>,
+) {
+    let (Some(body), Some(areas)) = (viewer.at, areas) else {
+        if current.0.is_some() {
+            current.0 = None;
+        }
+        return;
+    };
+    let feet_world = body + Vec3::Y * POSITION_PROBE_LIFT;
+    let terrain = terrain_height_under(&streamer, &adt_tiles, feet_world);
+    let mut best: Option<(f32, AreaWmoClaim)> = None;
+    for inst in &instances {
+        let Some(model) = wmos.get(&inst.handle) else {
+            continue;
+        };
+        let local_from_world = inst.world_from_local.inverse();
+        let feet_local = bevy_to_wow(local_from_world.transform_point3(feet_world));
+        let terrain_local = terrain.map(|z| terrain_z_local(&local_from_world, feet_world, z));
+        if let Some(c) =
+            zone_wmo_claim(model, u32::from(inst.name_set), feet_local, terrain_local, &areas.0)
+        {
+            if best.is_none_or(|(d, _)| c.0 < d) {
+                best = Some(c);
+            }
+        }
+    }
+    let found = best.map(|(_, c)| c);
+    if current.0 != found {
+        current.0 = found;
+    }
+}
