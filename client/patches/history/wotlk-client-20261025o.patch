diff --git a/crates/benilla-app/src/loadtrace.rs b/crates/benilla-app/src/loadtrace.rs
new file mode 100644
index 00000000..3b37e368
--- /dev/null
+++ b/crates/benilla-app/src/loadtrace.rs
@@ -0,0 +1,156 @@
+//! The app's half of the page's load trace ([`benilla_formats::loadtrace`]): every frame is a
+//! busy span (from `First` to the end of the render schedule, which on wasm runs in the same
+//! task), labelled with its client state and the notes systems left; the world-load phases
+//! (`enter` is [`crate::startup_pace::mark_world_begin`]'s, `cover lifted` its first uncovered
+//! frame's) are recorded here as their facts first hold. The page reads it all as
+//! `window.__wenilla_loadtrace` (`web/boot.js` merges in the browser's own long tasks).
+
+use bevy::prelude::*;
+use benilla_formats::loadtrace as lt;
+
+use crate::char_select::ClientState;
+
+/// The phases a new world session keeps from before it: the glue screens.
+pub(crate) const GLUE_PHASES: &[&str] = &["login", "charselect"];
+
+/// The world session started: the busy record and the world phases start over.
+pub(crate) fn world_session_started() {
+    lt::with(|t| t.restart(GLUE_PHASES));
+    lt::phase("enter");
+}
+
+/// A glue screen came up: `login` and `charselect` are phases.
+pub(crate) fn glue_screen(screen: &str) {
+    if matches!(screen, "login" | "charselect") {
+        lt::phase(screen);
+    }
+}
+
+fn state_label(
+    state: Option<&State<ClientState>>,
+    covered: bool,
+    warming: bool,
+) -> String {
+    let base = match state.map(State::get) {
+        Some(ClientState::InWorld) => "inworld",
+        Some(ClientState::CharSelect) => "charselect",
+        _ => "login",
+    };
+    match (covered, warming) {
+        (true, true) => format!("{base}, covered, pipeline warm"),
+        (true, false) => format!("{base}, covered"),
+        _ => base.to_string(),
+    }
+}
+
+/// Open this frame's span.
+fn begin_frame(
+    state: Option<Res<State<ClientState>>>,
+    screen: Option<Res<crate::loading_screen::LoadingScreen>>,
+    warm: Res<crate::pipe_warm::WarmPass>,
+) {
+    let covered = screen.is_some_and(|s| s.covering());
+    let label = state_label(state.as_deref(), covered, warm.running());
+    let now = lt::now_ms();
+    lt::with(|t| t.begin_frame(now, label));
+}
+
+/// Close it: on wasm at the end of the render schedule (same task, after extraction, prepare
+/// and the pipeline cache's compiles); natively at `Last`, as the render world is another thread.
+fn close_frame() {
+    let now = lt::now_ms();
+    lt::with(|t| t.close_frame(now));
+}
+
+/// The world-load phases, each the first frame its fact holds after `enter`; then publish.
+fn record_world_phases(
+    state: Option<Res<State<ClientState>>>,
+    progress: Option<Res<benilla_world::terrain_stream::WorldLoadProgress>>,
+    warm: Res<crate::pipe_warm::WarmPass>,
+) {
+    let in_world = state.is_some_and(|s| *s.get() == ClientState::InWorld);
+    let (entered, pending) = lt::with(|t| {
+        let entered = t.has_phase("enter");
+        let next = [
+            ("first world frame", in_world),
+            (
+                "resident",
+                in_world && progress.as_ref().is_some_and(|p| p.focus_resident),
+            ),
+            (
+                "scene ready",
+                in_world && progress.as_ref().is_some_and(|p| p.scene_ready),
+            ),
+            ("warm done", in_world && warm.satisfied()),
+        ]
+        .into_iter()
+        .filter(|(name, holds)| *holds && !t.has_phase(name))
+        .map(|(name, _)| name)
+        .collect::<Vec<_>>();
+        (entered, next)
+    });
+    if entered {
+        for name in pending {
+            lt::phase(name);
+        }
+    }
+    lt::publish(false);
+}
+
+pub(crate) struct LoadTracePlugin;
+
+impl Plugin for LoadTracePlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(First, begin_frame)
+            .add_systems(Last, record_world_phases);
+        #[cfg(target_arch = "wasm32")]
+        if let Some(render) = app.get_sub_app_mut(bevy::render::RenderApp) {
+            use bevy::render::{Render, RenderSystems};
+            render.add_systems(Render, close_frame.after(RenderSystems::Cleanup));
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        app.add_systems(Last, close_frame.after(record_world_phases));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_frame_label_names_the_state_the_cover_and_the_warm() {
+        assert_eq!(state_label(None, false, false), "login");
+        assert_eq!(state_label(None, true, true), "login, covered, pipeline warm");
+    }
+
+    /// Phases are recorded once the world session started, in the order their facts first hold.
+    #[test]
+    fn the_world_phases_follow_enter() {
+        let mut app = App::new();
+        app.add_plugins(bevy::state::app::StatesPlugin)
+            .init_state::<ClientState>()
+            .init_resource::<crate::pipe_warm::WarmPass>()
+            .init_resource::<benilla_world::terrain_stream::WorldLoadProgress>()
+            .add_systems(Last, record_world_phases);
+        // The store is per thread (the browser has one): keep the system on the test's.
+        app.edit_schedule(Last, |s| {
+            s.set_executor_kind(bevy::ecs::schedule::ExecutorKind::SingleThreaded);
+        });
+        lt::with(|t| *t = Default::default());
+        app.update();
+        assert!(lt::with(|t| t.phases.is_empty()), "nothing before enter");
+        glue_screen("charselect");
+        world_session_started();
+        app.world_mut()
+            .resource_mut::<NextState<ClientState>>()
+            .set(ClientState::InWorld);
+        app.update();
+        app.update();
+        app.world_mut()
+            .resource_mut::<benilla_world::terrain_stream::WorldLoadProgress>()
+            .focus_resident = true;
+        app.update();
+        let names: Vec<String> = lt::with(|t| t.phases.iter().map(|p| p.name.clone()).collect());
+        assert_eq!(names, ["charselect", "enter", "first world frame", "resident"]);
+    }
+}
