+    fn phases_keep_their_first_time_and_the_gap_since_the_last() {
+        let mut t = Trace::default();
+        t.phase("login", 1000.0);
+        t.phase("charselect", 4000.0);
+        t.phase("enter", 9000.0);
+        t.phase("charselect", 9500.0);
+        let got: Vec<_> = t.phases.iter().map(|p| (p.name.as_str(), p.ms)).collect();
+        assert_eq!(got, [("login", 0.0), ("charselect", 3000.0), ("enter", 5000.0)]);
+        // A second Enter World: the glue phases stay, the world ones are recorded again.
+        t.restart(&["login", "charselect"]);
+        t.phase("enter", 20000.0);
+        assert_eq!(t.phases.last().unwrap().ms, 16000.0);
+    }
+
+    #[test]
+    fn the_ten_longest_spans_are_kept_longest_first() {
+        let mut t = Trace::default();
+        for i in 0..30 {
+            t.busy(|| format!("s{i}"), f64::from(i), f64::from(i) * 10.0);
+        }
+        t.busy(|| "tiny".into(), 0.0, 1.0);
+        let ms: Vec<f64> = t.top.iter().map(|b| b.ms).collect();
+        assert_eq!(ms, (20..30).rev().map(|i| f64::from(i) * 10.0).collect::<Vec<_>>());
+        assert!(t.recent.iter().all(|b| b.label != "tiny"), "below the ring's floor");
+        assert_eq!(t.recent.len(), 29, "s0 is 0 ms, below the floor too");
+    }
+
+    #[test]
+    fn a_slow_frame_is_a_span_labelled_with_its_notes() {
+        let mut t = Trace::default();
+        t.note("warm: 24 rigs".into());
+        t.note("24 pipelines".into());
+        t.end_frame("inworld, covered", 100.0, 3000.0);
+        t.note("dropped".into());
+        t.end_frame("inworld", 3100.0, 20.0);
+        assert_eq!(t.frames, 2);
+        assert_eq!(t.slow_frames, 1);
+        assert_eq!(t.top[0].label, "frame (inworld, covered): warm: 24 rigs; 24 pipelines");
+        assert_eq!(t.top.len(), 1, "a fast frame's notes are dropped with it");
+        // Begin/close pairs, and a frame whose close never ran closes at the next begin.
+        t.begin_frame(10_000.0, "charselect".into());
+        t.begin_frame(10_080.0, "charselect".into());
+        t.close_frame(10_100.0);
+        assert_eq!(t.frames, 4);
+        assert_eq!(t.top.iter().filter(|b| b.label == "frame (charselect)").count(), 1);
+    }
