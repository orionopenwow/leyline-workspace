+            fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<u32> {
+                let t0 = std::time::Instant::now();
+                while t0.elapsed().as_millis() < 3 {}
+                self.0 += 1;
+                if self.0 == 2 {
