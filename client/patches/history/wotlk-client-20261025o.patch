+
+/// The next frame's slice: halved after a frame past [`WARM_SLOW_FRAME_MS`], doubled back after
+/// one inside [`WARM_FAST_FRAME_MS`], within `1..=max`. A browser compiles each variant on the
+/// main thread (~125 ms each on the owner's machine), so a fixed 24-rig slice made every frame
+/// ~3 s for the whole pass, and every per-frame budget behind the cover (spawns, colliders,
+/// streaming) crawled with it.
+pub(crate) fn next_slice(cur: usize, frame_ms: f32, max: usize) -> usize {
+    let max = max.max(1);
+    let next = if frame_ms > WARM_SLOW_FRAME_MS {
+        cur / 2
+    } else if frame_ms < WARM_FAST_FRAME_MS {
+        cur.saturating_mul(2)
+    } else {
+        cur
+    };
+    next.clamp(1, max)
