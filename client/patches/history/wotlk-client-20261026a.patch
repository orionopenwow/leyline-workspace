+/// The measured world-entry read-set (`world-manifest.json`, first-need order), put in front of
+/// the interface prefetch. A live capture (2026-10-26, Dalaran): Enter World read 253 files
+/// synchronously, all on that list, mostly 2-4 MB interface art that the size-blind tier order
+/// fetched last, so a player who clicked Enter World early paid ~54 s of round trips.
+export function worldFirst(manifestNames, uiNames, have) {
+  const seen = new Set(have);
+  const out = [];
+  for (const n of manifestNames) {
+    const k = storeKey(n);
+    if (seen.has(k)) continue;
+    seen.add(k);
+    out.push(n);
+  }
+  for (const n of uiNames) {
+    const k = storeKey(n);
+    if (seen.has(k)) continue;
+    seen.add(k);
+    out.push(n);
+  }
+  return out;
+}
+
+async function worldManifestNames() {
+  try {
+    const r = await fetch('./world-manifest.json');
+    if (!r.ok) return [];
+    const m = await r.json();
+    return Array.isArray(m && m.names) ? m.names.filter((n) => typeof n === 'string' && n) : [];
+  } catch (_) {
+    return [];
+  }
+}
