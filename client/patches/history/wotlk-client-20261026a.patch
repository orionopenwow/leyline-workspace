+/// The group's poses when the carry or drag began, and the leader's.
+#[derive(Default)]
+pub(super) struct GroupStart {
+    leader: Option<(Entity, Transform)>,
+    followers: Vec<(Entity, Transform)>,
+}
+
+/// A follower's pose for the leader moved from `lead_start` to `lead_at` and turned `turn` degrees
+/// about its starting spot: the group keeps its shape.
+fn follow_pose(lead_start: Vec3, lead_at: Vec3, turn: f32, start: Transform) -> Transform {
+    let r = Quat::from_rotation_y(turn.to_radians());
+    Transform {
+        translation: lead_at + r * (start.translation - lead_start),
+        rotation: r * start.rotation,
+        scale: start.scale,
+    }
+}
+
+/// The multi-selection ghost: while a prop is carried or dragged, the rest of the group
+/// (`LeylineEdit("group ...")`) moves and turns with it on this client. A put-back puts them back;
+/// a commit leaves them where they are, for the realm's respawns. Runs after [`edit_tools`].
+pub(super) fn follow_group(
+    edit: Res<EditMode>,
+    grab: Res<EditGrab>,
+    mut transforms: Query<&mut Transform, Without<FlyCam>>,
+    mut start: Local<GroupStart>,
+) {
+    let active = edit
+        .on
+        .then(|| {
+            grab.carry
+                .map(|c| (c.start, c.turn))
+                .or(grab.drag.map(|d| (d.start, d.turn)))
+        })
+        .flatten()
+        .zip(grab.entity);
+    let Some(((lead_start, turn), lead)) = active else {
+        if let Some((lead, lead_start)) = start.leader.take() {
+            let put_back = transforms
+                .get(lead)
+                .is_ok_and(|t| t.translation.distance(lead_start.translation) < 1e-3 && t.rotation.angle_between(lead_start.rotation) < 1e-3);
+            for (e, t0) in std::mem::take(&mut start.followers) {
+                if put_back || !edit.on {
+                    if let Ok(mut t) = transforms.get_mut(e) {
+                        *t = t0;
+                    }
+                }
+            }
+        }
+        return;
+    };
+    if start.leader.map(|(e, _)| e) != Some(lead) {
+        let b = edit_bridge();
+        start.leader = Some((lead, lead_start));
+        start.followers = b
+            .group
+            .iter()
+            .filter_map(|id| b.placed.iter().find(|p| p.id == *id).map(|p| p.entity))
+            .filter(|&e| e != lead)
+            .filter_map(|e| transforms.get(e).ok().map(|t| (e, *t)))
+            .collect();
+    }
+    let Ok(lead_at) = transforms.get(lead).map(|t| t.translation) else {
+        return;
+    };
+    for (e, t0) in start.followers.clone() {
+        if let Ok(mut t) = transforms.get_mut(e) {
+            *t = follow_pose(lead_start.translation, lead_at, turn, t0);
+        }
+    }
+}
