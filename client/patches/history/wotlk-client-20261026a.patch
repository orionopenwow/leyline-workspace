+/// The wait for the world entry's read-set behind the cover ([`entry_reads_warm`]).
+#[derive(Resource)]
+#[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+pub(crate) struct EntryWarmWait {
+    since: bevy::platform::time::Instant,
+    first_missing: Option<usize>,
+}
+
+/// The longest the entry load waits for its read-set: past it, what has not landed is read the old
+/// way, one synchronous round trip each.
+#[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+const ENTRY_WARM_MAX: std::time::Duration = std::time::Duration::from_secs(25);
+
+/// Whether the world entry's interface reads can run: in the browser, once every file of the
+/// entry's read-set (`world-manifest.json`) is in the page's body store, fetched in parallel
+/// behind the cover (or [`ENTRY_WARM_MAX`] passed). 20261026a: the first frame of the load read
+/// 253 of them one synchronous round trip at a time, ~54 s, the 33 s long task of the trace.
+/// Natively there is nothing to fetch.
+fn entry_reads_warm(world: &mut World) -> bool {
+    #[cfg(target_arch = "wasm32")]
+    {
+        let now = bevy::platform::time::Instant::now();
+        let pending = benilla_formats::web::world_entry_pending();
+        let mut wait = world.get_resource_or_insert_with(|| EntryWarmWait {
+            since: now,
+            first_missing: None,
+        });
+        if wait.first_missing.is_none() {
+            wait.first_missing = pending;
+        }
+        let waited = now.duration_since(wait.since);
+        let first = wait.first_missing.unwrap_or(0);
+        let done = pending == Some(0) || waited >= ENTRY_WARM_MAX;
+        if !done {
+            return false;
+        }
+        info!(
+            "ui_script: world entry read-set warm in {:.0} ms ({} file(s) fetched behind the cover, {} left to read synchronously)",
+            waited.as_secs_f32() * 1000.0,
+            first,
+            pending.map_or_else(|| "list not loaded,".to_string(), |n| n.to_string()),
+        );
+        world.remove_resource::<EntryWarmWait>();
+        true
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let _ = world;
+        true
+    }
+}
+
