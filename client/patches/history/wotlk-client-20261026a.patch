+/// A glue scene's sky behind its art: the void fill shows it wherever the scene's art does not
+/// reach (above the skyline, past its edges), and the clears take its horizon. 20261026a: the
+/// void fill was the dark faction vignette, which read as a black wedge above the scene at
+/// 800x868. Colours are sRGB.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub(crate) struct Sky {
+    pub(crate) zenith: [f32; 3],
+    pub(crate) horizon: [f32; 3],
+}
+
+impl Sky {
+    fn horizon_linear(&self) -> LinearRgba {
+        Color::srgb(self.horizon[0], self.horizon[1], self.horizon[2]).to_linear()
+    }
+}
+
+/// The deep blue every zenith leans toward.
+const ZENITH_TINT: [f32; 3] = [0.16, 0.22, 0.40];
+/// No sky channel peaks below this (sRGB): never black.
+const SKY_FLOOR: f32 = 0.16;
+
+/// Lift `c` so its brightest channel reaches `floor`, keeping its hue.
+fn lift(c: [f32; 3], floor: f32) -> [f32; 3] {
+    let max = c[0].max(c[1]).max(c[2]);
+    if max >= floor {
+        return c;
+    }
+    if max <= 1e-4 {
+        return [floor; 3];
+    }
+    let k = floor / max;
+    [c[0] * k, c[1] * k, c[2] * k]
+}
+
+/// The sky for a scene: the horizon is the scene's own fog colour (the stock `CharModelFogInfo`
+/// rows, so the fogged far art meets it with no seam), the zenith that colour darkened toward
+/// [`ZENITH_TINT`]. The three scenes with no fog row get their land's light: Eversong's gold,
+/// Azuremyst's violet, Acherus's grey-green.
+pub(crate) fn sky_of(scene: Option<super::glue_booth::GlueScene>) -> Sky {
+    use super::glue_booth::GlueScene;
+    let horizon = match scene {
+        Some(GlueScene::BloodElf) => [0.96, 0.78, 0.52],
+        Some(GlueScene::Draenei) => [0.62, 0.58, 0.88],
+        Some(GlueScene::DeathKnight) => [0.40, 0.50, 0.54],
+        Some(s) => s.stock_fog().map_or([0.55, 0.60, 0.75], |f| f.rgb),
+        None => [0.55, 0.60, 0.75],
+    };
+    let horizon = lift(horizon, 0.30);
+    let zenith = std::array::from_fn(|i| horizon[i] * 0.45 + ZENITH_TINT[i] * 0.55);
+    Sky {
+        zenith: lift(zenith, SKY_FLOOR),
+        horizon,
+    }
+}
+
+/// The sky colour (sRGB) at `v`, 0 the wall's top, 1 its bottom: the zenith down to the horizon
+/// just below the middle, a faint glow on the horizon, the horizon colour under it.
+pub(crate) fn sky_at(sky: &Sky, v: f32) -> [f32; 3] {
+    let t = smoothstep(0.08, 0.62, v).powf(0.8);
+    let glow = 1.0 + 0.10 * (-((v - 0.6) / 0.08).powi(2)).exp();
+    std::array::from_fn(|i| ((sky.zenith[i] + (sky.horizon[i] - sky.zenith[i]) * t) * glow).clamp(0.0, 1.0))
+}
+
+/// The sky's texture: 4 texels wide, 128 tall, sRGB, sampled linearly.
+fn sky_image(sky: &Sky) -> Image {
+    let (w, h) = (4u32, 128u32);
+    let mut data = Vec::with_capacity((w * h * 4) as usize);
+    for y in 0..h {
+        let c = sky_at(sky, (y as f32 + 0.5) / h as f32);
+        for _ in 0..w {
+            data.extend_from_slice(&[
+                (c[0] * 255.0).round() as u8,
+                (c[1] * 255.0).round() as u8,
+                (c[2] * 255.0).round() as u8,
+                255,
+            ]);
+        }
+    }
+    let mut image = Image::new(
+        Extent3d {
+            width: w,
+            height: h,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        data,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor::linear());
+    image
+}
