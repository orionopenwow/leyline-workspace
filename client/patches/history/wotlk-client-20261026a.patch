+/// The page's raw key edges as keyboard messages on the primary window: the UI feed reads them this
+/// frame (a keyboard-capturing frame's `OnKeyDown`/`OnKeyUp`), `ButtonInput<KeyCode>` the next.
+fn emit_synth_keys(
+    mut input: ResMut<BridgeInput>,
+    window: Query<Entity, With<bevy::window::PrimaryWindow>>,
+    mut writer: MessageWriter<bevy::input::keyboard::KeyboardInput>,
+) {
+    if input.keys.is_empty() {
+        return;
+    }
+    let keys = std::mem::take(&mut input.keys);
+    let Ok(window) = window.single() else {
+        return;
+    };
+    for (code, down) in keys {
+        writer.write(synth_key(code, down, window));
+    }
+}
+
+/// One keyboard message for `code`.
+pub(crate) fn synth_key(code: KeyCode, down: bool, window: Entity) -> bevy::input::keyboard::KeyboardInput {
+    use bevy::input::keyboard::Key;
+    let ch = key_char(code);
+    let logical_key = match code {
+        KeyCode::Space => Key::Space,
+        KeyCode::Escape => Key::Escape,
+        KeyCode::Enter => Key::Enter,
+        KeyCode::Tab => Key::Tab,
+        KeyCode::Backspace => Key::Backspace,
+        KeyCode::ArrowUp => Key::ArrowUp,
+        KeyCode::ArrowDown => Key::ArrowDown,
+        KeyCode::ArrowLeft => Key::ArrowLeft,
+        KeyCode::ArrowRight => Key::ArrowRight,
+        KeyCode::ShiftLeft | KeyCode::ShiftRight => Key::Shift,
+        KeyCode::ControlLeft | KeyCode::ControlRight => Key::Control,
+        KeyCode::AltLeft | KeyCode::AltRight => Key::Alt,
+        _ => match ch {
+            Some(c) => Key::Character(c.to_string().as_str().into()),
+            None => Key::Unidentified(bevy::input::keyboard::NativeKey::Unidentified),
+        },
+    };
+    bevy::input::keyboard::KeyboardInput {
+        key_code: code,
+        logical_key,
+        state: if down {
+            bevy::input::ButtonState::Pressed
+        } else {
+            bevy::input::ButtonState::Released
+        },
+        text: if down {
+            ch.map(|c| c.to_string().as_str().into())
+        } else {
+            None
+        },
+        repeat: false,
+        window,
+    }
+}
+
+/// The text a key types unshifted (letters lower case), if any.
+fn key_char(code: KeyCode) -> Option<char> {
+    let letters = [
+        KeyCode::KeyA, KeyCode::KeyB, KeyCode::KeyC, KeyCode::KeyD, KeyCode::KeyE, KeyCode::KeyF,
+        KeyCode::KeyG, KeyCode::KeyH, KeyCode::KeyI, KeyCode::KeyJ, KeyCode::KeyK, KeyCode::KeyL,
+        KeyCode::KeyM, KeyCode::KeyN, KeyCode::KeyO, KeyCode::KeyP, KeyCode::KeyQ, KeyCode::KeyR,
+        KeyCode::KeyS, KeyCode::KeyT, KeyCode::KeyU, KeyCode::KeyV, KeyCode::KeyW, KeyCode::KeyX,
+        KeyCode::KeyY, KeyCode::KeyZ,
+    ];
+    let digits = [
+        KeyCode::Digit0, KeyCode::Digit1, KeyCode::Digit2, KeyCode::Digit3, KeyCode::Digit4,
+        KeyCode::Digit5, KeyCode::Digit6, KeyCode::Digit7, KeyCode::Digit8, KeyCode::Digit9,
+    ];
+    if let Some(i) = letters.iter().position(|k| *k == code) {
+        return Some((b'a' + i as u8) as char);
+    }
+    if let Some(i) = digits.iter().position(|k| *k == code) {
+        return Some((b'0' + i as u8) as char);
+    }
+    (code == KeyCode::Space).then_some(' ')
+}
+
+/// A DOM `KeyboardEvent.code` (`KeyW`, `Digit1`, `Space`, `ArrowUp`, `ShiftLeft`, `F5`…), or a
+/// single letter or digit, as a [`KeyCode`].
+pub(crate) fn key_code_of(code: &str) -> Option<KeyCode> {
+    let letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+    let one = code.strip_prefix("Key").unwrap_or(code);
+    if one.len() == 1 {
+        let c = one.chars().next()?.to_ascii_uppercase();
+        if let Some(i) = letters.find(c) {
+            return Some(
+                [
+                    KeyCode::KeyA, KeyCode::KeyB, KeyCode::KeyC, KeyCode::KeyD, KeyCode::KeyE, KeyCode::KeyF,
+                    KeyCode::KeyG, KeyCode::KeyH, KeyCode::KeyI, KeyCode::KeyJ, KeyCode::KeyK, KeyCode::KeyL,
+                    KeyCode::KeyM, KeyCode::KeyN, KeyCode::KeyO, KeyCode::KeyP, KeyCode::KeyQ, KeyCode::KeyR,
+                    KeyCode::KeyS, KeyCode::KeyT, KeyCode::KeyU, KeyCode::KeyV, KeyCode::KeyW, KeyCode::KeyX,
+                    KeyCode::KeyY, KeyCode::KeyZ,
+                ][i],
+            );
+        }
+    }
+    let digit = code.strip_prefix("Digit").unwrap_or(code);
+    if digit.len() == 1 {
+        if let Some(d) = digit.chars().next()?.to_digit(10) {
+            return Some(
+                [
+                    KeyCode::Digit0, KeyCode::Digit1, KeyCode::Digit2, KeyCode::Digit3, KeyCode::Digit4,
+                    KeyCode::Digit5, KeyCode::Digit6, KeyCode::Digit7, KeyCode::Digit8, KeyCode::Digit9,
+                ][d as usize],
+            );
+        }
+    }
+    if let Some(n) = code.strip_prefix('F').and_then(|n| n.parse::<usize>().ok()) {
+        let f = [
+            KeyCode::F1, KeyCode::F2, KeyCode::F3, KeyCode::F4, KeyCode::F5, KeyCode::F6,
+            KeyCode::F7, KeyCode::F8, KeyCode::F9, KeyCode::F10, KeyCode::F11, KeyCode::F12,
+        ];
+        return f.get(n.wrapping_sub(1)).copied();
+    }
+    Some(match code {
+        "Space" | "SPACE" => KeyCode::Space,
+        "Escape" | "ESCAPE" => KeyCode::Escape,
+        "Enter" | "ENTER" => KeyCode::Enter,
+        "Tab" | "TAB" => KeyCode::Tab,
+        "Backspace" | "BACKSPACE" => KeyCode::Backspace,
+        "Delete" | "DELETE" => KeyCode::Delete,
+        "ArrowUp" | "UP" => KeyCode::ArrowUp,
+        "ArrowDown" | "DOWN" => KeyCode::ArrowDown,
+        "ArrowLeft" | "LEFT" => KeyCode::ArrowLeft,
+        "ArrowRight" | "RIGHT" => KeyCode::ArrowRight,
+        "ShiftLeft" | "SHIFT" => KeyCode::ShiftLeft,
+        "ShiftRight" => KeyCode::ShiftRight,
+        "ControlLeft" | "CTRL" => KeyCode::ControlLeft,
+        "ControlRight" => KeyCode::ControlRight,
+        "AltLeft" | "ALT" => KeyCode::AltLeft,
+        "AltRight" => KeyCode::AltRight,
+        _ => return None,
+    })
+}
