+/// The arrows and the ring; the hovered or dragged handle is drawn bright.
+fn draw_handles(gizmos: &mut Gizmos, at: Vec3, len: f32, hot: Option<HandleKind>, active: Option<HandleKind>) {
+    let bright = Color::srgb(1.0, 0.95, 0.55);
+    let pick = |k: HandleKind, base: Color| if hot == Some(k) || active == Some(k) { bright } else { base };
+    for (k, base) in [
+        (HandleKind::X, Color::srgb(0.93, 0.28, 0.25)),
+        (HandleKind::Y, Color::srgb(0.35, 0.86, 0.38)),
+        (HandleKind::Z, Color::srgb(0.30, 0.52, 0.98)),
+    ] {
+        if active.is_some_and(|a| a != k) {
+            continue;
+        }
+        let d = k.axis();
+        gizmos.arrow(at + d * len * 0.15, at + d * len, pick(k, base)).with_tip_length(len * 0.22);
+        if active == Some(k) {
+            // The axis line the drag runs on.
+            gizmos.line(at - d * EDIT_RADIUS * 0.25, at + d * EDIT_RADIUS * 0.25, Color::srgba(1.0, 0.95, 0.55, 0.35));
+        }
+    }
+    if active.is_none() || active == Some(HandleKind::Ring) {
+        let flat = Quat::from_rotation_arc(Vec3::Z, Vec3::Y);
+        gizmos
+            .circle(Isometry3d::new(at, flat), len * RING_OVER_ARROW, pick(HandleKind::Ring, Color::srgb(0.89, 0.72, 0.36)))
+            .resolution(64);
+    }
+}
