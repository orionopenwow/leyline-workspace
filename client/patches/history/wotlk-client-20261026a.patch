+// ------------------------------------------------------------------------------------------------
+// M2 handles: axis arrows and a turn ring on the selection, dragged with the mouse.
+//
+// The selected prop shows three arrows (red and blue along the ground's two axes, green up) and a
+// gold ring around it. Press the left button on one and drag: an arrow moves the prop along its
+// axis only (the flat axes land on the `leylineEditGrid` grid, the vertical one moves in grid
+// steps), the ring turns it by `leylineEditAngle` steps. The prop moves on this client while the
+// button is held (nothing is sent); the release sends one change, through the HUD's existing
+// `.build placeat` path (`WrathUnleashedUI.EditMode.Drop`), which the realm checks as ever.
+// Escape, Backspace or the right button during a drag puts it back.
+//
+// The Lua side (EditMode.lua / Builder.lua) reaches the client through one global,
+// `LeylineEdit(text)`, installed in every UI VM:
+//
+//   LeylineEdit("box x0 y0 x1 y1")   -> "id id id ..."  the placed objects whose screen position
+//                                       falls in the rectangle; corners as fractions of the screen,
+//                                       origin bottom-left (UI convention), any corner order
+//   LeylineEdit("where <id>")        -> "x y z sx sy"    world position (game coordinates) and
+//                                       screen fractions, or "" when it is not in view
+//   LeylineEdit("select <id>")       -> "ok"/"none"      put the handles on that object (next frame)
+//   LeylineEdit("handles on|off")    -> "ok"             show or hide the handles (default on)
+//   LeylineEdit("group id id ...")   -> "ok"             the rest of a multi-selection: these objects
+//                                       follow the carried or dragged one on this client (a ghost
+//                                       preview; the commit is still the one `.build` call). An empty
+//                                       list clears it. At most 256 ids.
+//   LeylineEdit("state")             -> "on=1 sel=<id|0> drag=<x|y|z|ring|none> handles=1 grid=<g> angle=<a> group=<n>"
+//
+// `id` is the object's GUID counter, the number `.build pick <id>` and `E.Clicked` take. Every
+// answer reads the client's last frame, so a call costs no frame of its own.
+//
+// And calls into the HUD (each only when defined):
+//   E.GizmoCommit(id, dx, dy, dz, turn, x, y, z)  on a handle release that changed something: the
+//       move in game coordinates and the turn in degrees, plus where the prop now is. A multi-select
+//       HUD defines it to move the whole selection by the same delta. Without it the client calls
+//       E.Drop(x, y, z, turn), the single-prop path the carry uses.
+//   E.GizmoStart(kind)   kind "x" | "y" | "z" | "ring", when a drag begins (for the note line)
+//   E.Clicked(x, y, z, id, shift)  every world click; `shift` true for a Shift-click
+//   E.BoxSelect(x1, y1, x2, y2, add)  Shift + left-drag on the world: the box's ground corners (game
+//       x/y), `add` with Ctrl held
+//   E.SpawnMenu(down)    Q down / up with nothing carried (carrying, Q and E still turn the prop)
+//   E.Cmd("copy")        Ctrl+C;   E.StartPasting()  Ctrl+V (V alone still duplicates)
+
+/// Which handle.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum HandleKind {
+    /// Bevy +X: the game's −Y (west–east).
+    X,
+    /// Up.
+    Y,
+    /// Bevy +Z: the game's −X (north–south).
+    Z,
+    Ring,
+}
+
+impl HandleKind {
+    fn axis(self) -> Vec3 {
+        match self {
+            HandleKind::X => Vec3::X,
+            HandleKind::Y => Vec3::Y,
+            HandleKind::Z => Vec3::Z,
+            HandleKind::Ring => Vec3::ZERO,
+        }
+    }
+    fn label(self) -> &'static str {
+        match self {
+            HandleKind::X => "x",
+            HandleKind::Y => "y",
+            HandleKind::Z => "z",
+            HandleKind::Ring => "ring",
+        }
+    }
+}
+
+/// A handle drag: the pose to put back, the handle, and where on it the grab began (the axis
+/// parameter, or the ring's angle in radians).
+#[derive(Clone, Copy, Debug)]
+struct Drag {
+    kind: HandleKind,
+    start: Transform,
+    grab: f32,
+    /// The turn so far (degrees) for the ring; the position is the transform's.
+    turn: f32,
+}
+
+/// The handle under the cursor last frame, read by `camera::latch_world_mouse`: a left press there
+/// belongs to the handles, so it starts no camera look and no click.
+#[derive(Resource, Default, Clone, Copy, Debug)]
+pub(crate) struct EditHandleHover {
+    pub(crate) over: Option<HandleKind>,
+    /// Shift is held over the world with nothing carried or dragged: a left press starts a box
+    /// select ([`edit_box_select`]), or is a Shift-click if it never moves.
+    pub(crate) shift_box: bool,
+}
+
+/// The most ids `LeylineEdit("group ...")` keeps.
+const MAX_GROUP: usize = 256;
+
+/// How near (logical pixels) the cursor must come to a handle to grab it.
+const HANDLE_PICK_PX: f32 = 9.0;
+/// The arrows' length over the camera distance, and its bounds (yards).
+const HANDLE_SCALE: f32 = 0.14;
+const HANDLE_MIN: f32 = 0.8;
+const HANDLE_MAX: f32 = 8.0;
+/// The ring's radius over the arrow length.
+const RING_OVER_ARROW: f32 = 1.2;
+/// A committed prop's respawn is looked for this long (seconds) to keep the handles on it.
+const RESELECT_SECS: f32 = 4.0;
+
+/// One placed object seen this frame: its id (GUID counter), entity, position (game coordinates)
+/// and screen point (fractions, origin bottom-left), `None` off screen.
+#[derive(Clone, Debug)]
+struct Placed {
+    id: u32,
+    entry: u32,
+    entity: Entity,
+    wow: [f32; 3],
+    screen: Option<Vec2>,
+}
+
+/// The Lua bridge's shared state: the last frame's placed objects and the requests since.
+#[derive(Default)]
+struct EditBridge {
+    on: bool,
+    sel: u32,
+    drag: Option<HandleKind>,
+    handles_off: bool,
+    grid: f32,
+    angle: f32,
+    placed: Vec<Placed>,
+    select: Option<u32>,
+    /// The rest of a multi-selection (GUID counters), which follows the carried or dragged prop.
+    group: Vec<u32>,
+}
+
+static EDIT_BRIDGE: std::sync::Mutex<EditBridge> = std::sync::Mutex::new(EditBridge {
+    on: false,
+    sel: 0,
+    drag: None,
+    handles_off: false,
+    grid: 0.0,
+    angle: 15.0,
+    placed: Vec::new(),
+    select: None,
+    group: Vec::new(),
+});
+
+fn edit_bridge() -> std::sync::MutexGuard<'static, EditBridge> {
+    EDIT_BRIDGE.lock().unwrap_or_else(|p| p.into_inner())
+}
+
+/// The ids whose screen point lies inside the rectangle `a`–`b` (fractions, any corner order).
+fn box_ids(placed: &[Placed], a: Vec2, b: Vec2) -> Vec<u32> {
+    let (lo, hi) = (a.min(b), a.max(b));
+    let mut ids: Vec<u32> = placed
+        .iter()
+        .filter_map(|p| p.screen.filter(|s| s.cmpge(lo).all() && s.cmple(hi).all()).map(|_| p.id))
+        .collect();
+    ids.sort_unstable();
+    ids.dedup();
+    ids
+}
+
+/// Answers one `LeylineEdit(text)` call.
+fn bridge_call(b: &mut EditBridge, text: &str) -> String {
+    let mut words = text.split_whitespace();
+    let num = |w: Option<&str>| w.and_then(|v| v.parse::<f32>().ok()).filter(|v| v.is_finite());
+    match words.next().unwrap_or("") {
+        "box" => {
+            let (Some(x0), Some(y0), Some(x1), Some(y1)) =
+                (num(words.next()), num(words.next()), num(words.next()), num(words.next()))
+            else {
+                return String::new();
+            };
+            box_ids(&b.placed, Vec2::new(x0, y0), Vec2::new(x1, y1))
+                .iter()
+                .map(u32::to_string)
+                .collect::<Vec<_>>()
+                .join(" ")
+        }
+        "where" => {
+            let Some(id) = words.next().and_then(|w| w.parse::<u32>().ok()) else {
+                return String::new();
+            };
+            b.placed
+                .iter()
+                .find(|p| p.id == id)
+                .and_then(|p| {
+                    p.screen.map(|s| {
+                        format!("{:.3} {:.3} {:.3} {:.4} {:.4}", p.wow[0], p.wow[1], p.wow[2], s.x, s.y)
+                    })
+                })
+                .unwrap_or_default()
+        }
+        "select" => match words.next().and_then(|w| w.parse::<u32>().ok()) {
+            Some(id) if b.placed.iter().any(|p| p.id == id) => {
+                b.select = Some(id);
+                "ok".into()
+            }
+            _ => "none".into(),
+        },
+        "handles" => {
+            b.handles_off = words.next() == Some("off");
+            "ok".into()
+        }
+        "group" => {
+            b.group = words.filter_map(|w| w.parse::<u32>().ok()).take(MAX_GROUP).collect();
+            "ok".into()
+        }
+        "state" => format!(
+            "on={} sel={} drag={} handles={} grid={} angle={} group={}",
+            b.on as u8,
+            b.sel,
+            b.drag.map_or("none", HandleKind::label),
+            (!b.handles_off) as u8,
+            b.grid,
+            b.angle,
+            b.group.len()
+        ),
+        _ => String::new(),
+    }
+}
+
+/// Installs `LeylineEdit(text)` into each new UI VM.
+pub(super) fn install_edit_bridge(
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mut installed: Local<u64>,
+) {
+    let Some(script) = script else {
+        return;
+    };
+    if *installed == script.session() {
+        return;
+    }
+    *installed = script.session();
+    let made = script
+        .lua()
+        .create_function(|_, text: String| Ok(bridge_call(&mut edit_bridge(), &text)));
+    match made {
+        Ok(f) => {
+            if let Err(e) = script.lua().globals().set("LeylineEdit", f) {
+                error!("edit mode: installing LeylineEdit: {e}");
+            }
+        }
+        Err(e) => error!("edit mode: creating LeylineEdit: {e}"),
+    }
+}
+
+/// The arrow length for a prop at `at` seen from `eye`.
+fn handle_len(at: Vec3, eye: Vec3) -> f32 {
+    ((at - eye).length() * HANDLE_SCALE).clamp(HANDLE_MIN, HANDLE_MAX)
+}
+
+/// The distance from `p` to the segment `a`–`b` (screen space).
+fn seg_dist(p: Vec2, a: Vec2, b: Vec2) -> f32 {
+    let ab = b - a;
+    let t = if ab.length_squared() > 1e-6 {
+        ((p - a).dot(ab) / ab.length_squared()).clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    (a + ab * t).distance(p)
+}
+
+/// The ring's points, flat around `at`.
+fn ring_points(at: Vec3, r: f32) -> impl Iterator<Item = Vec3> {
+    (0..=48).map(move |i| {
+        let a = i as f32 / 48.0 * std::f32::consts::TAU;
+        at + Vec3::new(a.cos() * r, 0.0, -a.sin() * r)
+    })
+}
+
+/// The handle nearest the cursor within [`HANDLE_PICK_PX`], arrows before the ring.
+fn pick_handle(
+    cursor: Vec2,
+    at: Vec3,
+    len: f32,
+    to_screen: &dyn Fn(Vec3) -> Option<Vec2>,
+) -> Option<HandleKind> {
+    let mut best: Option<(f32, HandleKind)> = None;
+    let o = to_screen(at)?;
+    for kind in [HandleKind::X, HandleKind::Y, HandleKind::Z] {
+        if let Some(tip) = to_screen(at + kind.axis() * len) {
+            let d = seg_dist(cursor, o.lerp(tip, 0.15), tip);
+            if d < HANDLE_PICK_PX && best.is_none_or(|(bd, _)| d < bd) {
+                best = Some((d, kind));
+            }
+        }
+    }
+    if best.is_some() {
+        return best.map(|(_, k)| k);
+    }
+    let pts: Vec<Option<Vec2>> = ring_points(at, len * RING_OVER_ARROW).map(to_screen).collect();
+    for w in pts.windows(2) {
+        if let (Some(a), Some(b)) = (w[0], w[1]) {
+            if seg_dist(cursor, a, b) < HANDLE_PICK_PX {
+                return Some(HandleKind::Ring);
+            }
+        }
+    }
+    None
+}
+
+/// The parameter along the axis `p0 + t·d` nearest the ray `o + s·v`; `None` when the two run
+/// nearly parallel (the axis points at the camera).
+fn axis_param(p0: Vec3, d: Vec3, o: Vec3, v: Vec3) -> Option<f32> {
+    let w0 = p0 - o;
+    let b = d.dot(v);
+    let (dd, e) = (d.dot(w0), v.dot(w0));
+    let denom = d.dot(d) * v.dot(v) - b * b;
+    (denom.abs() > 1e-4).then(|| (b * e - v.dot(v) * dd) / denom)
+}
+
+/// The angle (radians, counter-clockwise from above, 0 along +X) where the ray meets the flat
+/// plane through `at`; `None` when it never does in front of the camera.
+fn ring_angle(at: Vec3, o: Vec3, v: Vec3) -> Option<f32> {
+    if v.y.abs() < 1e-4 {
+        return None;
+    }
+    let s = (at.y - o.y) / v.y;
+    if s <= 0.0 {
+        return None;
+    }
+    let h = o + v * s - at;
+    Some((-h.z).atan2(h.x))
+}
+
+/// Degrees wrapped into (−180, 180].
+fn wrap_deg(d: f32) -> f32 {
+    let w = (d + 180.0).rem_euclid(360.0) - 180.0;
+    if w <= -180.0 {
+        w + 360.0
+    } else {
+        w
+    }
+}
+
+/// The dragged pose for the axis handle `kind`: moved `off` along the axis from `start`, the flat
+/// axes landing on the grid, the vertical one in grid steps.
+fn axis_pose(kind: HandleKind, start: Vec3, off: f32, grid: f32) -> Vec3 {
+    let off = off.clamp(-EDIT_RADIUS, EDIT_RADIUS);
+    match kind {
+        HandleKind::X => Vec3::new(snap(start.x + off, grid), start.y, start.z),
+        HandleKind::Z => Vec3::new(start.x, start.y, snap(start.z + off, grid)),
+        HandleKind::Y => Vec3::new(start.x, start.y + snap(off, grid), start.z),
+        HandleKind::Ring => start,
+    }
+}
+
+/// The commit chunk for a finished drag: `E.GizmoCommit` when the HUD defines it, else `E.Drop`.
+fn commit_chunk(id: u32, from: Vec3, to: Vec3, turn: f32) -> String {
+    let (a, b) = (benilla_assets::coords::bevy_to_wow(from), benilla_assets::coords::bevy_to_wow(to));
+    format!(
+        "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if not E then return end \
+         if E.GizmoCommit then E.GizmoCommit({id}, {:.3}, {:.3}, {:.3}, {turn:.1}, {:.3}, {:.3}, {:.3}) \
+         elseif E.Drop then E.Drop({:.3}, {:.3}, {:.3}, {turn:.1}) end",
+        b[0] - a[0],
+        b[1] - a[1],
+        b[2] - a[2],
+        b[0],
+        b[1],
+        b[2],
+        b[0],
+        b[1],
+        b[2],
+    )
+}
+
+/// After a commit: the respawned prop to put the handles back on (same entry, at the spot).
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Reselect {
+    entry: u32,
+    at: Vec3,
+    until: f32,
+}
+
+/// The handles: publish the placed objects for `LeylineEdit`, hover, grab, drag (a local preview)
+/// and the release's one commit; draws them. Runs after `control`, before [`edit_tools`].
+#[allow(clippy::too_many_arguments)]
+pub(super) fn edit_handles(
+    edit: Res<EditMode>,
+    mut grab: ResMut<EditGrab>,
+    mut hover: ResMut<EditHandleHover>,
+    input: (
+        Res<ButtonInput<MouseButton>>,
+        Res<ButtonInput<KeyCode>>,
+        Res<crate::ui_script::PointerOverUi>,
+        Res<Time<bevy::time::Real>>,
+    ),
+    cvars: Option<Res<Cvars>>,
+    camera: Query<(&Camera, &GlobalTransform), With<benilla_world::view::WorldCamera>>,
+    window: Query<&Window, With<bevy::window::PrimaryWindow>>,
+    objects: Query<(Entity, &crate::net::Guid, &GlobalTransform)>,
+    mut transforms: Query<&mut Transform, Without<FlyCam>>,
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mut reselect: Local<Option<Reselect>>,
+    mut gizmos: Gizmos,
+) {
+    let (buttons, keys, over_ui, time) = (&input.0, &input.1, &input.2, &input.3);
+    let script = script.as_deref();
+    let mut b = edit_bridge();
+    b.on = edit.on;
+    if !edit.on {
+        if let Some(d) = grab.drag.take() {
+            if let Some(mut t) = grab.entity.and_then(|e| transforms.get_mut(e).ok()) {
+                *t = d.start;
+            }
+        }
+        hover.over = None;
+        b.drag = None;
+        b.placed.clear();
+        b.select = None;
+        *reselect = None;
+        return;
+    }
+    let grid = cvars.as_deref().and_then(|c| c.num(GRID_CVAR)).unwrap_or(0.0).clamp(0.0, 10.0);
+    let angle = cvars.as_deref().and_then(|c| c.num(ANGLE_CVAR)).unwrap_or(15.0).clamp(1.0, 90.0);
+    b.grid = grid;
+    b.angle = angle;
+    let (Ok((cam, cam_gt)), Ok(win)) = (camera.single(), window.single()) else {
+        hover.over = None;
+        return;
+    };
+    let size = Vec2::new(win.width(), win.height()).max(Vec2::ONE);
+    let eye = cam_gt.translation();
+    let fwd = cam_gt.forward().as_vec3();
+    let to_screen = |p: Vec3| -> Option<Vec2> {
+        ((p - eye).dot(fwd) > 0.05).then(|| cam.world_to_viewport(cam_gt, p).ok()).flatten()
+    };
+
+    // The placed objects in reach, for `LeylineEdit` (GameObjects: high GUID 0xF110).
+    b.placed.clear();
+    for (e, guid, gt) in objects.iter() {
+        if guid.0 >> 48 != 0xF110 {
+            continue;
+        }
+        let at = gt.translation();
+        if at.distance(eye) > EDIT_RADIUS * 2.0 {
+            continue;
+        }
+        let screen = to_screen(at)
+            .map(|s| Vec2::new(s.x / size.x, 1.0 - s.y / size.y))
+            .filter(|s| s.cmpge(Vec2::ZERO).all() && s.cmple(Vec2::ONE).all());
+        b.placed.push(Placed {
+            id: guid_counter(guid.0) as u32,
+            entry: ((guid.0 >> 24) & 0x00FF_FFFF) as u32,
+            entity: e,
+            wow: benilla_assets::coords::bevy_to_wow(at),
+            screen,
+        });
+    }
+    // A Lua select, or the respawn of a prop this client just committed.
+    let pick = |entity: Entity, grab: &mut EditGrab| {
+        if let Ok((_, g, _)) = objects.get(entity) {
+            grab.entity = Some(entity);
+            grab.guid = Some(g.0);
+        }
+    };
+    if grab.drag.is_none() && grab.carry.is_none() {
+        if let Some(id) = b.select.take() {
+            if let Some(p) = b.placed.iter().find(|p| p.id == id) {
+                pick(p.entity, &mut *grab);
+            }
+        }
+        if let Some(r) = *reselect {
+            let gone = grab.entity.is_none_or(|e| objects.get(e).is_err());
+            if time.elapsed_secs() > r.until {
+                *reselect = None;
+            } else if gone {
+                let near = b
+                    .placed
+                    .iter()
+                    .filter(|p| p.entry == r.entry)
+                    .map(|p| (p.entity, benilla_assets::coords::wow_to_bevy(p.wow).distance(r.at)))
+                    .filter(|(_, d)| *d < 0.5)
+                    .min_by(|a, c| a.1.total_cmp(&c.1));
+                if let Some((e, _)) = near {
+                    pick(e, &mut *grab);
+                    *reselect = None;
+                }
+            }
+        }
+    } else {
+        b.select = None;
+    }
+    b.sel = grab.guid.map_or(0, |g| guid_counter(g) as u32);
+
+    let target = grab
+        .entity
+        .filter(|_| grab.carry.is_none() && !b.handles_off)
+        .and_then(|e| objects.get(e).ok().map(|(_, g, gt)| (e, g.0, gt.translation())));
+    let Some((entity, guid, at_now)) = target else {
+        if let Some(d) = grab.drag.take() {
+            // The prop went away mid-drag (despawned): nothing to put back.
+            let _ = d;
+        }
+        hover.over = None;
+        b.drag = None;
+        return;
+    };
+    drop(b);
+    let cursor = win.cursor_position();
+    let ray = cursor.and_then(|c| cam.viewport_to_world(cam_gt, c).ok());
+
+    // A drag in flight: follow the mouse, or end it.
+    if let Some(mut d) = grab.drag {
+        let cancel = keys.just_pressed(KeyCode::Escape)
+            || keys.just_pressed(CANCEL_KEY)
+            || buttons.just_pressed(MouseButton::Right);
+        if cancel {
+            if let Ok(mut t) = transforms.get_mut(entity) {
+                *t = d.start;
+            }
+            grab.drag = None;
+            edit_bridge().drag = None;
+            hud_note(script, "Put back.");
+            return;
+        }
+        if let Some(ray) = ray {
+            let (o, v) = (ray.origin, *ray.direction);
+            match d.kind {
+                HandleKind::Ring => {
+                    if let Some(a) = ring_angle(d.start.translation, o, v) {
+                        d.turn = snap(wrap_deg((a - d.grab).to_degrees()), angle);
+                    }
+                }
+                kind => {
+                    if let Some(t) = axis_param(d.start.translation, kind.axis(), o, v) {
+                        let to = axis_pose(kind, d.start.translation, t - d.grab, grid);
+                        if let Ok(mut tf) = transforms.get_mut(entity) {
+                            tf.translation = to;
+                        }
+                    }
+                }
+            }
+            if let Ok(mut tf) = transforms.get_mut(entity) {
+                tf.rotation = Quat::from_rotation_y(d.turn.to_radians()) * d.start.rotation;
+            }
+        }
+        grab.drag = Some(d);
+        if !buttons.pressed(MouseButton::Left) {
+            grab.drag = None;
+            edit_bridge().drag = None;
+            let to = transforms.get(entity).map(|t| t.translation).unwrap_or(d.start.translation);
+            let moved = to.distance(d.start.translation) > 1e-3;
+            if moved || d.turn.abs() > 0.05 {
+                call_hud(script, &commit_chunk(guid_counter(guid) as u32, d.start.translation, to, d.turn));
+                *reselect = Some(Reselect {
+                    entry: ((guid >> 24) & 0x00FF_FFFF) as u32,
+                    at: to,
+                    until: time.elapsed_secs() + RESELECT_SECS,
+                });
+            }
+        }
+        draw_handles(&mut gizmos, at_now, handle_len(at_now, eye), Some(d.kind), Some(d.kind));
+        return;
+    }
+
+    // No drag: hover, and a press on the hovered handle (the press `latch_world_mouse` kept from
+    // the world) starts one.
+    let len = handle_len(at_now, eye);
+    let was_over = hover.over;
+    hover.over = cursor
+        .filter(|_| !over_ui.0)
+        .and_then(|c| pick_handle(c, at_now, len, &to_screen));
+    if let (Some(kind), true, Some(ray)) = (was_over, buttons.just_pressed(MouseButton::Left), ray) {
+        if !over_ui.0 {
+            if let Ok(start) = transforms.get(entity).map(|t| *t) {
+                let (o, v) = (ray.origin, *ray.direction);
+                let grab_at = match kind {
+                    HandleKind::Ring => ring_angle(start.translation, o, v),
+                    k => axis_param(start.translation, k.axis(), o, v),
+                };
+                if let Some(g) = grab_at {
+                    grab.drag = Some(Drag { kind, start, grab: g, turn: 0.0 });
+                    edit_bridge().drag = Some(kind);
+                    call_hud(
+                        script,
+                        &format!(
+                            "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.GizmoStart then E.GizmoStart('{}') end",
+                            kind.label()
+                        ),
+                    );
+                }
+            }
+        }
+    }
+    draw_handles(&mut gizmos, at_now, len, hover.over, None);
+}
+
+
+/// A Shift + left-drag box in progress: where it started, on screen and on the ground.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct BoxDrag {
+    screen: Vec2,
+    ground: Option<Vec3>,
+}
+
+/// How far (logical pixels) a Shift press must travel to be a box rather than a Shift-click.
+const BOX_MIN_PX: f32 = 6.0;
+
+/// The box's two ground corners as `E.BoxSelect`'s call (game x/y; `add` with Ctrl held).
+fn box_chunk(a: Vec3, b: Vec3, add: bool) -> String {
+    let (a, b) = (benilla_assets::coords::bevy_to_wow(a), benilla_assets::coords::bevy_to_wow(b));
+    format!(
+        "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.BoxSelect then E.BoxSelect({:.3}, {:.3}, {:.3}, {:.3}, {add}) end",
+        a[0], a[1], b[0], b[1]
+    )
+}
+
+/// Shift + left-drag on the world: a box on the ground between the press and the cursor, drawn
+/// while held; the release hands its two ground corners to `E.BoxSelect` (Ctrl adds to the
+/// selection). A Shift press that never moves is a Shift-click: `E.Clicked(x, y, z, id, true)`.
+/// `latch_world_mouse` keeps the press from the camera and the click test ([`EditHandleHover`]).
+#[allow(clippy::too_many_arguments)]
+pub(super) fn edit_box_select(
+    edit: Res<EditMode>,
+    mut grab: ResMut<EditGrab>,
+    mut hover: ResMut<EditHandleHover>,
+    input: (
+        Res<ButtonInput<MouseButton>>,
+        Res<ButtonInput<KeyCode>>,
+        Res<crate::ui_script::PointerOverUi>,
+        Res<crate::ui_script::UiKeyboardCapture>,
+    ),
+    picks: (Res<crate::target::PickOcclusion>, Res<crate::target::HoveredObject>),
+    cvars: Option<Res<Cvars>>,
+    window: Query<&Window, With<bevy::window::PrimaryWindow>>,
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mut drag: Local<Option<BoxDrag>>,
+    mut gizmos: Gizmos,
+) {
+    let (buttons, keys, over_ui, capture) = (&input.0, &input.1, &input.2, &input.3);
+    let (occlusion, hovered) = (&picks.0, &picks.1);
+    let script = script.as_deref();
+    let shift = !capture.typing && keys.any_pressed([KeyCode::ShiftLeft, KeyCode::ShiftRight]);
+    let ctrl = !capture.typing && keys.any_pressed([KeyCode::ControlLeft, KeyCode::ControlRight]);
+    let busy = grab.carry.is_some() || grab.drag.is_some();
+    let was_armed = hover.shift_box;
+    hover.shift_box = edit.on && shift && !busy && hover.over.is_none() && !over_ui.0;
+    if !edit.on || busy {
+        *drag = None;
+        return;
+    }
+    let cursor = window.single().ok().and_then(Window::cursor_position);
+    if drag.is_none() {
+        if was_armed && buttons.just_pressed(MouseButton::Left) {
+            if let Some(c) = cursor {
+                *drag = Some(BoxDrag { screen: c, ground: occlusion.point });
+            }
+        }
+        return;
+    }
+    let Some(d) = *drag else { return };
+    let moved = cursor.is_some_and(|c| c.distance(d.screen) > BOX_MIN_PX);
+    let end = occlusion.point;
+    if buttons.pressed(MouseButton::Left) {
+        if let (true, Some(a), Some(b)) = (moved, d.ground, end) {
+            let y = a.y.max(b.y) + 0.06;
+            let c = Color::srgb(0.30, 0.80, 1.0);
+            let corners = [
+                Vec3::new(a.x, y, a.z),
+                Vec3::new(b.x, y, a.z),
+                Vec3::new(b.x, y, b.z),
+                Vec3::new(a.x, y, b.z),
+            ];
+            for i in 0..4 {
+                gizmos.line(corners[i], corners[(i + 1) % 4], c);
+            }
+        }
+        return;
+    }
+    *drag = None;
+    if moved {
+        if let (Some(a), Some(b)) = (d.ground, end) {
+            call_hud(script, &box_chunk(a, b, ctrl));
+        }
+        return;
+    }
+    // A Shift-click: the same call a plain click makes, with Shift.
+    let grid = cvars.as_deref().and_then(|c| c.num(GRID_CVAR)).unwrap_or(0.0).clamp(0.0, 10.0);
+    let go = hovered.target.zip(hovered.guid);
+    if let Some((e, g)) = go {
+        grab.entity = Some(e);
+        grab.guid = Some(g);
+    }
+    let pt = d
+        .ground
+        .map(|p| {
+            let w = benilla_assets::coords::bevy_to_wow(snap_flat(p, grid));
+            format!("{:.3}, {:.3}, {:.3}", w[0], w[1], w[2])
+        })
+        .unwrap_or_else(|| "nil, nil, nil".into());
+    let low = go.map_or("nil".to_string(), |(_, g)| guid_counter(g).to_string());
+    call_hud(
+        script,
+        &format!("local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Clicked then E.Clicked({pt}, {low}, true) end"),
+    );
+}
