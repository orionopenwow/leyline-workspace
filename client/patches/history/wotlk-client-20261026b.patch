@@ -0,0 +1,135 @@
+//! The browser's per-frame budget for new shader modules, through the module build gate of the
+//! patched `bevy_shader` (`third_party/bevy_shader/BENILLA.md`).
+//!
+//! On wasm `bevy_render` builds every queued pipeline inside the frame that queued it, and a new
+//! module is ~125-350 ms of naga work on the main thread: 20261026a's Dalaran trace had a 9.4 s
+//! `frame (login): 27 pipelines queued` and a 9.2 s covered world-entry frame. With the gate, a
+//! frame starts one new module build, and more only while its builds so far fit in
+//! [`BUILD_BUDGET_MS`]; the rest wait for the next frame, where `PipelineCache` retries them. A
+//! deferred pipeline reads as one still compiling ([`super::PipeWatch::compiling`]), which every
+//! consumer already handles, since native builds compile asynchronously too.
+//!
+//! Natively the gate is not installed: pipelines build on the task pool (or inline on macOS, where
+//! the warm pass already paces them).
+
+use std::cell::Cell;
+
+use bevy::prelude::*;
+
+/// A frame's build time for new shader modules (ms). The first build of a frame always starts, so
+/// progress never stops; a cheap module (a few ms) leaves room for more.
+pub(crate) const BUILD_BUDGET_MS: f64 = 40.0;
+
+/// One frame's module builds: when the first started (page clock, ms), how many started, and how
+/// many were turned away.
+#[derive(Clone, Copy, Default, Debug, PartialEq)]
+pub(crate) struct BuildBudget {
+    first_at: Option<f64>,
+    built: u32,
+    deferred: u32,
+}
+
+impl BuildBudget {
+    /// Whether a module build may start at `now` (ms), counting it either way.
+    pub(crate) fn admit(&mut self, now: f64, budget_ms: f64) -> bool {
+        let ok = match self.first_at {
+            None => {
+                self.first_at = Some(now);
+                true
+            }
+            Some(first) => now - first < budget_ms,
+        };
+        if ok {
+            self.built += 1;
+        } else {
+            self.deferred += 1;
+        }
+        ok
+    }
+
+    /// Close the frame: `(built, deferred)`, and a fresh budget for the next one.
+    pub(crate) fn end_frame(&mut self) -> (u32, u32) {
+        let out = (self.built, self.deferred);
+        *self = Self::default();
+        out
+    }
+}
+
+thread_local! {
+    /// The render world's budget. The browser has one thread; natively nothing reads it.
+    static BUDGET: Cell<BuildBudget> = const {
+        Cell::new(BuildBudget { first_at: None, built: 0, deferred: 0 })
+    };
+}
+
+/// The gate `bevy_shader` asks before each new module.
+#[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+fn gate() -> bool {
+    let now = benilla_formats::loadtrace::now_ms();
+    BUDGET.with(|b| {
+        let mut budget = b.get();
+        let ok = budget.admit(now, BUILD_BUDGET_MS);
+        b.set(budget);
+        ok
+    })
+}
+
+/// Install the gate (the browser only).
+pub(super) fn install() {
+    #[cfg(target_arch = "wasm32")]
+    if !bevy::shader::set_module_build_gate(gate) {
+        warn!("pipe_warm: a shader module build gate was already installed");
+    }
+}
+
+/// `Render`, in `Cleanup` (after the frame's builds, before the load trace closes the frame): the
+/// budget starts over, and a frame that turned builds away says so in its trace label.
+pub(super) fn end_build_frame() {
+    let (built, deferred) = BUDGET.with(|b| {
+        let mut budget = b.get();
+        let out = budget.end_frame();
+        b.set(budget);
+        out
+    });
+    if deferred > 0 {
+        benilla_formats::loadtrace::note(|| {
+            format!("{built} shader build(s), {deferred} deferred")
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The 20261026a login frame: 27 modules of ~350 ms. One starts per frame.
+    #[test]
+    fn a_slow_module_holds_the_rest_to_the_next_frame() {
+        let mut b = BuildBudget::default();
+        let mut now = 1000.0;
+        assert!(b.admit(now, BUILD_BUDGET_MS), "the frame's first build always starts");
+        now += 350.0;
+        for _ in 0..26 {
+            assert!(!b.admit(now, BUILD_BUDGET_MS));
+        }
+        assert_eq!(b.end_frame(), (1, 26));
+        assert!(b.admit(now, BUILD_BUDGET_MS), "the next frame starts one again");
+    }
+
+    /// Cheap modules share a frame up to the budget.
+    #[test]
+    fn cheap_modules_fill_the_budget() {
+        let mut b = BuildBudget::default();
+        let mut now = 0.0;
+        let mut started = 0;
+        for _ in 0..20 {
+            if b.admit(now, BUILD_BUDGET_MS) {
+                started += 1;
+            }
+            now += 5.0;
+        }
+        assert_eq!(started, 8, "5 ms each: builds start at 0..35 ms");
