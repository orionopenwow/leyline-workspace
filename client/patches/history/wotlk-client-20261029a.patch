index 86fb5743..87801da1 100644
--- a/web/bridge.js
+++ b/web/bridge.js
@@ -339,6 +339,71 @@ document.addEventListener('visibilitychange', () => {
 });
 if (document.hidden) background.start();
 
+// ── The stalled-frame keepalive ──
+//
+// A page can be "visible" and still get no animation frames: an occluded or collapsed pane, a
+// window behind another on some compositors, an embedded view the host stopped painting. No
+// `visibilitychange` fires, so the hidden-tab Worker above never starts and the game sits still:
+// the 2026-10-29 smoke ran in a hidden pane and got 8 frames in its first 30 s in the world, a
+// 54 s black screen after Enter World, and a first update 29 s after page load. A second Worker
+// watches the page's own animation frames; when none has come for STALL_MS while the page reads
+// as visible, it drives `wake` at STALL_HZ until frames come back (the loading screens and the
+// world load are sliced per frame, so they move again). It never runs while frames flow.
+const STALL_MS = 500;
+const STALL_HZ = 10;
+let lastAnimationFrame = performance.now();
+const noteAnimationFrame = () => {
+  lastAnimationFrame = performance.now();
+  requestAnimationFrame(noteAnimationFrame);
+};
+requestAnimationFrame(noteAnimationFrame);
+const stallWatch = {
+  worker: null,
+  wakes: 0,
+  start() {
+    if (this.worker || typeof Worker === 'undefined') return;
+    const src = `setInterval(() => postMessage(0), ${Math.round(1000 / STALL_HZ)});`;
+    const url = URL.createObjectURL(new Blob([src], { type: 'text/javascript' }));
+    try {
+      this.worker = new Worker(url);
+    } catch (_) {
+      return;
+    } finally {
+      URL.revokeObjectURL(url);
+    }
+    let stalled = false;
+    let lastTick = 0;
+    let quiet = 0;
+    this.worker.onmessage = () => {
+      // Hidden is the other keepalive's case; with frames flowing there is nothing to do.
+      const now = performance.now();
+      // Ticks that queued up behind a long main-thread task arrive back to back: one wake for
+      // the burst, never one update per queued tick.
+      const burst = now - lastTick < 1000 / STALL_HZ / 2;
+      lastTick = now;
+      if (burst) return;
+      // Two ticks in a row with no frame: a long frame that just ended has its animation frame
+      // coming, and is not a stall.
+      const noFrame = !document.hidden && now - lastAnimationFrame > STALL_MS;
+      quiet = noFrame ? quiet + 1 : 0;
+      const isStalled = quiet >= 2;
+      if (isStalled !== stalled) {
+        stalled = isStalled;
+        console.info(`wenilla: animation frames ${stalled ? 'stopped while visible; driving frames from a worker' : 'are back'}`);
+      }
+      if (!stalled || !hook.wake) return;
+      this.wakes += 1;
+      try {
+        hook.wake();
+      } catch (_) {
+        /* a stale wake: the hidden-tab path stops on this; here the next frame retries */
+      }
+    };
+  },
+};
+wenilla.stallWatch = stallWatch;
+stallWatch.start();
+
