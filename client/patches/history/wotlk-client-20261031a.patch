+/// What the client knows of us that bars edit mode, with nothing filled for an unknown.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct EditFacts {
+    /// Our `UNIT_FIELD_FLAGS`, `None` with no self descriptor yet.
+    pub(crate) unit_flags: Option<u32>,
+    pub(crate) dead_or_ghost: bool,
+    /// The current map's `Map.dbc` `InstanceType` (`Some(0)` for a map with no row), `None` when
+    /// the map or the catalog is not known.
+    pub(crate) instance_type: Option<u32>,
+}
+
+/// Why the free camera may not come out now, or `None`. Fails closed on anything unknown.
+pub(crate) fn local_refusal(f: &EditFacts) -> Option<&'static str> {
+    let Some(flags) = f.unit_flags else {
+        return Some("no character yet");
+    };
+    if flags & super::UNIT_FLAG_IN_COMBAT != 0 {
+        return Some("in combat");
+    }
+    if f.dead_or_ghost {
+        return Some("dead");
+    }
+    if flags & super::UNIT_FLAG_TAXI_FLIGHT != 0 {
+        return Some("on a flight");
+    }
+    match f.instance_type {
+        None => Some("map unknown"),
+        // 1 party, 2 raid, 3 battleground, 4 arena: every instanced map.
+        Some(t) if t != 0 => Some("in an instance"),
+        Some(_) => None,
+    }
+}
+
+/// [`local_refusal`], then the realm's grant.
+pub(crate) fn edit_refusal(f: &EditFacts, grant: &EditGrant, now: f64) -> Option<&'static str> {
+    local_refusal(f).or_else(|| (!grant.fresh(now)).then_some("the realm hasn't allowed it"))
+}
+
+/// The facts for [`local_refusal`] from the self descriptor and the map.
+pub(crate) fn edit_facts(
+    store: Option<&ObjectStore>,
+    map: Option<u32>,
+    maps: Option<&benilla_assets::MapCatalogRes>,
+) -> EditFacts {
+    EditFacts {
+        unit_flags: store.map(|s| s.0.unit_flags()),
+        dead_or_ghost: store.is_some_and(|s| s.0.is_dead_or_ghost()),
+        instance_type: map.and_then(|m| maps.map(|c| c.0.instance_type(m).unwrap_or(0))),
+    }
+}
