-/// Follows the CVar (and F7) into [`EditMode`] and the free-fly detach. Runs before `control`.
+/// The addon prefix of the realm's grant: Open Mod API traffic (`ov_modapi.lua`), which the realm
+/// never relays from a player, so a line under it with our own guid as sender came from the server.
+pub(crate) const GRANT_PREFIX: &str = "OVMOD";
+/// The realm's module and message for edit mode (`ov_build.lua`, `X.snapSend`).
+const GRANT_HEAD: &str = "wubuild\tsnap\t1/1\t";
+/// How long one grant (or its last `keep`) holds, seconds. The realm refreshes it every
+/// `X.SNAP_KEEP` (10 s) while edit mode is on, so a missed refresh or two never drops the camera.
+pub(crate) const GRANT_LEASE_SECS: f64 = 30.0;
+
+/// The realm's say on edit mode, server-authoritative: the time (real seconds) the grant runs to.
+#[derive(Resource, Default, Clone, Copy, Debug, PartialEq)]
+pub(crate) struct EditGrant {
+    until: Option<f64>,
+}
+
+impl EditGrant {
+    pub(crate) fn fresh(&self, now: f64) -> bool {
+        self.until.is_some_and(|t| now < t)
+    }
+    pub(crate) fn revoke(&mut self) {
+        self.until = None;
+    }
+    /// One grant line from the realm: `on` starts a lease, `keep` extends a live one only, `off`
+    /// (with or without its reason) ends it.
+    fn apply(&mut self, line: GrantLine, now: f64) {
+        match line {
+            GrantLine::On => self.until = Some(now + GRANT_LEASE_SECS),
+            GrantLine::Keep if self.fresh(now) => self.until = Some(now + GRANT_LEASE_SECS),
+            GrantLine::Keep => {}
+            GrantLine::Off => self.revoke(),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum GrantLine {
+    On,
+    Keep,
+    Off,
+}
+
+/// Reads an addon line's wire text (`prefix` TAB payload) as a grant line, if it is one.
+fn grant_line(text: &[u8]) -> Option<GrantLine> {
+    let text = std::str::from_utf8(text).ok()?;
+    let rest = text.strip_prefix(GRANT_PREFIX)?.strip_prefix('\t')?;
+    let data = rest.strip_prefix(GRANT_HEAD)?;
+    match data {
+        "on" => Some(GrantLine::On),
+        "keep" => Some(GrantLine::Keep),
+        d if d == "off" || d.starts_with("off,") => Some(GrantLine::Off),
+        _ => None,
+    }
+}
+
+/// One `SMSG_MESSAGECHAT` line for the grant. Only `LANG_ADDON` lines whose sender is our own
+/// character count (the realm sends them as us to us); the realm drops every OVMOD line a player
+/// sends, a whisper to themselves included, so no player can make one arrive.
+pub(crate) fn take_grant(
+    m: &benilla_protocol::messages::ChatMessage,
+    self_guid: Option<u64>,
+    now: f64,
+    grant: &mut EditGrant,
+) {
+    if !m.is_addon() || self_guid.is_none_or(|g| g != m.sender_guid) {
+        return;
+    }
+    let text = m.addon_bytes.as_deref().unwrap_or(m.text.as_bytes());
+    if let Some(line) = grant_line(text) {
+        grant.apply(line, now);
+        debug!("edit mode: realm grant {line:?}");
+    }
+}
