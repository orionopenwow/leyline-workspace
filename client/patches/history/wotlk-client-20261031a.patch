+/// `SMSG_MESSAGECHAT`: the realm's edit-mode grant lines ([`edit_mode::EditGrant`]).
+fn on_edit_grant(
+    In(ev): In<benilla_protocol::SessionEvent>,
+    self_guid: Res<crate::net::SelfGuid>,
+    time: Res<Time<Real>>,
+    mut grant: ResMut<edit_mode::EditGrant>,
+) {
+    if let benilla_protocol::SessionEvent::Chat(m) = ev {
+        edit_mode::take_grant(&m, self_guid.0, time.elapsed_secs_f64(), &mut grant);
+    }
+}
+
+/// A session end drops the edit-mode grant with everything else the realm said.
+fn on_edit_session_end(
+    In(_): In<benilla_protocol::SessionEvent>,
+    mut grant: ResMut<edit_mode::EditGrant>,
+) {
+    grant.revoke();
+}
