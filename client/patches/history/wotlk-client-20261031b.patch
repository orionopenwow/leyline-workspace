+#[cfg(test)]
+mod modf_bounds_tests {
+    use super::*;
+
+    /// MODF's box goes through the position's transform: each axis flips, so the corners swap.
+    #[test]
+    fn modf_bounds_land_on_the_world_ground_plane() {
+        let c = 32.0 * TILE_SIZE;
+        // placement coords: x -> world Y, z -> world X; y is height
+        let b = modf_ground_bounds([[100.0, 0.0, 200.0], [150.0, 80.0, 260.0]], c).unwrap();
+        assert_eq!(b, [[c - 260.0, c - 150.0], [c - 200.0, c - 100.0]]);
+        assert!(b[0][0] <= b[1][0] && b[0][1] <= b[1][1]);
+        // a placement at the box's middle lies inside it, as the position transform puts it
+        let pos = [c - 230.0, c - 125.0];
+        assert!(pos[0] >= b[0][0] && pos[0] <= b[1][0] && pos[1] >= b[0][1] && pos[1] <= b[1][1]);
+        assert!(modf_ground_bounds([[f32::NAN, 0.0, 0.0], [1.0, 1.0, 1.0]], c).is_none());
+    }
+}
