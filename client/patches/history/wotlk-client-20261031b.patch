     pub name_set: u16,
+    /// The MODF bounding box on the ground plane in WoW world coords, `[min_x, min_y]` and
+    /// `[max_x, max_y]`; `None` when unknown (the WDT's one building), which counts everywhere.
+    pub ground_bounds: Option<[[f32; 2]; 2]>,
+}
+
+/// A MODF bounding box (placement coords, lower and upper corner) on the ground plane in WoW
+/// world coords: the position's transform, `X = 32·TILE − z`, `Y = 32·TILE − x`, which flips
+/// each axis, so the corners swap.
+pub fn modf_ground_bounds(extents: [[f32; 3]; 2], map_center: f32) -> Option<[[f32; 2]; 2]> {
+    if !extents.iter().flatten().all(|v| v.is_finite()) {
+        return None;
+    }
+    let [lo, hi] = extents;
+    let b = [
+        [map_center - hi[2].max(lo[2]), map_center - hi[0].max(lo[0])],
+        [map_center - hi[2].min(lo[2]), map_center - hi[0].min(lo[0])],
+    ];
+    b.iter().flatten().all(|v| v.is_finite()).then_some(b)
 }
 
