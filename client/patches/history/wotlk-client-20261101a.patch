+/// Whether a held item still sits in the slot it was picked from. The source keeps the item
+/// (locked) for as long as it is held, so a slot that now holds nothing or another item means the
+/// item moved under the cursor (a server swap, an auto-equip, a bag update): the payload is stale,
+/// and a destroy by that `(bag, slot)` would hit whatever is there now.
+pub(crate) fn held_item_at_source(model: &Model, item: &CursorItem) -> bool {
+    if item.bag == EQUIPMENT_BAG {
+        return usize::try_from(item.slot)
+            .ok()
+            .and_then(|i| model.inv_slot("player", i))
+            .is_some_and(|s| s.item_id == item.item_id);
+    }
+    model
+        .containers
+        .get(&item.bag)
+        .and_then(|c| c.slots.get(&item.slot))
+        .is_some_and(|s| s.item_id == item.item_id)
+}
+
+/// Whether the player can see the held item at the mouse: it has an icon, the host is not
+/// reporting the plain arrow in its place, and it still sits in its source slot.
+fn held_item_visible(model: &Model, item: &CursorItem) -> bool {
+    item.texture.as_deref().is_some_and(|t| !t.is_empty())
+        && model.cursor_icon_shown != Some(false)
+        && held_item_at_source(model, item)
+}
+
+/// Drop a held item that went stale ([`held_item_at_source`]): a plain clear, so its source
+/// unlocks and nothing is destroyed. Called after every bag and inventory update.
+pub(crate) fn drop_stale_cursor_item(model: &mut Model) {
+    let stale = matches!(&model.cursor, Some(CursorPayload::Item(item)) if !held_item_at_source(model, item));
+    if stale {
+        clear_cursor(model);
+    }
+}
