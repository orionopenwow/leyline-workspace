+/// The plate's textured and solid quads in draw order: (path, colour).
+fn plate_quads(s: &UiScript) -> Vec<(Option<String>, Option<[f32; 4]>)> {
+    use crate::script::QuadContent;
+    s.extract()
+        .iter()
+        .filter_map(|q| match &q.content {
+            QuadContent::Texture { path, color, .. } => Some((path.clone(), *color)),
+            _ => None,
+        })
+        .collect()
+}
+
+/// The owner's report (1 Nov): a targeted wolf's bar was solid white and every other bar near
+/// black. The stock look draws the reaction-tinted fill under the `Nameplate-Border` art, and
+/// the target is lit by brightening that fill, never by painting over it.
+#[test]
+fn the_stock_plate_draws_a_red_fill_under_the_border_and_lights_the_target_red() {
+    let mut s = vm();
+    let mut wolf = plate("Young Wolf", 30.0, 40.0);
+    wolf.target = true;
+    wolf.lit = true;
+    drive(&mut s, &[wolf]);
+    let quads = plate_quads(&s);
+    let fill = quads
+        .iter()
+        .position(|(p, _)| p.as_deref() == Some(crate::script::nameplate::BAR_FILL_TEXTURE))
+        .unwrap_or_else(|| panic!("no bar fill quad in {quads:?}"));
+    let border = quads
+        .iter()
+        .position(|(p, _)| p.as_deref() == Some(crate::script::nameplate::BORDER_TEXTURE))
+        .unwrap_or_else(|| panic!("no border quad in {quads:?}"));
+    assert!(fill < border, "the fill draws first, the border caps it: {quads:?}");
+    let c = quads[fill].1.expect("the fill is tinted");
+    assert!(c[0] >= 1.0 && c[1] == 0.0 && c[2] == 0.0, "lit hostile is a brighter red, got {c:?}");
+    assert!(
+        !quads.iter().any(|(p, c)| p.is_none() && c.is_some_and(|c| c[..3] == [1.0, 1.0, 1.0])),
+        "no white box over the bar: {quads:?}"
+    );
+}
+
+/// The modern look's flat border sits under the fill (on the bar's own BACKGROUND), so the bar
+/// keeps its colour, and a target leaves it dark.
+#[test]
+fn the_modern_border_draws_under_the_fill_and_never_turns_white() {
+    let mut s = vm();
+    let g = PlateGeometry {
+        modern: true,
+        width: 112.0,
+        height: 14.0,
+        bar_width: 110.0,
+        bar_height: 12.0,
+        ..geometry()
+    };
+    let mut wolf = plate("Young Wolf", 30.0, 40.0);
+    wolf.target = true;
+    wolf.lit = true;
+    s.sync_nameplates(g, &[wolf]);
+    s.resolve();
+    let quads = plate_quads(&s);
+    let fill = quads
+        .iter()
+        .position(|(p, _)| p.as_deref() == Some(crate::script::nameplate::MODERN_FILL_TEXTURE))
+        .unwrap_or_else(|| panic!("no bar fill quad in {quads:?}"));
+    let back = quads
+        .iter()
+        .position(|(p, c)| p.is_none() && c.is_some_and(|c| c[..3] == [0.0, 0.0, 0.0]))
+        .unwrap_or_else(|| panic!("no flat border quad in {quads:?}"));
+    assert!(back < fill, "the flat border must draw before the fill: {quads:?}");
+    assert!(
+        !quads.iter().any(|(p, c)| p.is_none() && c.is_some_and(|c| c[..3] == [1.0, 1.0, 1.0])),
+        "the target's border is not repainted white: {quads:?}"
+    );
+}
