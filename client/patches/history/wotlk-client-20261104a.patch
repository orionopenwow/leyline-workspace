+    /// The owner's report (4 Nov, browser): a stock plate about twice its size, away from its
+    /// unit. One code path that draws exactly that: the world camera still reports its viewport
+    /// at a 1× factor on a 2× display (3200x1800 for a 1600x900 window, see
+    /// `world_backdrop::retarget_world_camera`), and the driver seated and sized plates in that
+    /// space while the seam divided by the window's. Seated in the window's space, the plate's top
+    /// centre lands on the projected head point at the window's stock size, under a UI scale that
+    /// is not 1.
+    #[test]
+    fn a_stale_camera_viewport_still_seats_the_plate_on_its_head_at_the_stock_size() {
+        let window = Vec2::new(1600.0, 900.0);
+        let stale = Vec2::new(3200.0, 1800.0);
+        let space = plate_space(stale, Some(window));
+        assert_eq!(space, window, "plates live in the window's logical px");
+        assert_eq!(plate_space(stale, None), stale, "headless: the camera's own");
+        assert_eq!(
+            plate_space(stale, Some(Vec2::ZERO)),
+            stale,
+            "a degenerate window is no space"
+        );
+
+        // The head point (plus the lift) projects three quarters across, a third down.
+        let head = to_plate_px(Vec2::new(2400.0, 600.0), stale, space);
+        assert_eq!(head, Vec2::new(1200.0, 300.0), "the same fraction of the screen");
+        // A camera that agrees with the window is untouched.
+        assert_eq!(
+            to_plate_px(Vec2::new(1200.0, 300.0), window, window),
+            Vec2::new(1200.0, 300.0)
+        );
+
+        // The stock size is the window's diagonal basis, not the stale viewport's.
+        let (pw, ph) = (
+            gx_px(PLATE_W, plate_basis(space)),
+            gx_px(PLATE_H, plate_basis(space)),
+        );
+        assert_eq!((pw, ph), (156.0, 39.0), "0.1 x 0.025 gx of the damped 1600x900 diagonal");
+        assert!(
+            gx_px(PLATE_W, plate_basis(stale)) > 1.5 * pw,
+            "the stale viewport's basis is the oversized plate"
+        );
+
+        // Seated top-centre on the head, at uiScale 0.75: the widget layer's units, scaled back
+        // by the seam, are the head point in window px (Y up from the bottom).
+        let seam = crate::ui_script::seam_scale(window.y, 0.75);
+        let plate = Rect::new(head.x - pw * 0.5, head.y, head.x + pw * 0.5, head.y + ph);
+        let (x, y) = top_centre_units(plate, space, seam);
+        assert!((x * seam - head.x).abs() < 1e-3, "centred on the head: {}", x * seam);
+        assert!(
+            (y * seam - (window.y - head.y)).abs() < 1e-3,
+            "its top on the head: {}",
+            y * seam
+        );
+    }
