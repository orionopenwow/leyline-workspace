+/// The seat the app's plate driver hands over (`vplates::top_centre_units`, 4 Nov): under a UI
+/// scale that is not 1 (0.75 on a 1600x900 window, a screen 1024 units tall), the plate's TOP
+/// centre lands exactly on `top_centre`, in units from the screen's bottom-left, at the
+/// geometry's size, with no scale of its own on top: the plate sits on its unit's head point at
+/// the stock size. A plate scaled twice, or hung from another point, drew far off its unit.
+#[test]
+fn the_plate_hangs_its_top_centre_on_the_seat_at_the_geometrys_size() {
+    let seam = 900.0 / 768.0 * 0.75;
+    let mut s = UiScript::new().unwrap();
+    s.set_screen_size(1600.0 / seam, 900.0 / seam);
+    s.run(r#"WorldFrame = CreateFrame("WorldFrame", "WorldFrame") WorldFrame:SetAllPoints()"#)
+        .unwrap();
+    s.resolve();
+    let mut boar = plate("Mottled Boar", 50.0, 71.0);
+    boar.top_centre = (1364.0, 682.0);
+    drive(&mut s, &[boar]);
+
+    let r: Vec<f32> = s
+        .eval(
+            "local p = WorldFrame:GetChildren() \
+             return { p:GetLeft(), p:GetRight(), p:GetTop(), p:GetBottom(), p:GetEffectiveScale() }",
+        )
+        .unwrap();
+    let want = [1300.0, 1428.0, 682.0, 650.0, 1.0];
+    assert_eq!(r.len(), want.len(), "an unresolved plate: {r:?}");
+    for (got, w) in r.iter().zip(want) {
+        assert!(
+            (got - w).abs() < 1e-3,
+            "left, right, top, bottom, scale: {r:?}, want {want:?}"
+        );
+    }
+}
