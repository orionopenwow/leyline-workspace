+/// The pixel space plates are seated and sized in: the window's logical size, the space the UI
+/// seam (`seam_scale(window.height())`) divides out. With no window (a headless run), the world
+/// camera's logical viewport.
+///
+/// The camera's viewport is not used for this: it is the window's only once Bevy has recomputed
+/// the camera's target for the latest scale factor ([`crate::world_backdrop`]). A camera still
+/// on an older factor (a browser zoom or a display hop that kept the canvas's physical size)
+/// reports `physical / old_factor`, and seating in that space drew every plate `new / old` times
+/// too large and that many times too far from the screen's bottom-left: a plate twice the stock
+/// size, far from its unit, on a 2× display.
+pub(crate) fn plate_space(cam_viewport: Vec2, window: Option<Vec2>) -> Vec2 {
+    match window {
+        Some(w) if w.x > 0.0 && w.y > 0.0 => w,
+        _ => cam_viewport,
+    }
+}
+
+/// A point projected into the world camera's logical viewport, in [`plate_space`] px: the same
+/// fraction of the screen, so the plate stays on its unit whatever pixel unit the camera reports.
+pub(crate) fn to_plate_px(p: Vec2, cam_viewport: Vec2, space: Vec2) -> Vec2 {
+    if cam_viewport.x > 0.0 && cam_viewport.y > 0.0 {
+        p * (space / cam_viewport)
+    } else {
+        p
+    }
+}
+
+/// A seated plate (Y-down [`plate_space`] px) to its top centre in UI units from the screen's
+/// bottom-left, the [`PlateState::top_centre`] the widget layer hangs the plate from.
+pub(crate) fn top_centre_units(plate: Rect, space: Vec2, seam: f32) -> (f32, f32) {
+    (
+        (plate.min.x + plate.max.x) * 0.5 / seam,
+        (space.y - plate.min.y) / seam,
+    )
+}
