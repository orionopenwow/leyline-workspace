+    /// A factor-only move (a browser zoom or a display hop that keeps the canvas's physical size)
+    /// builds no new image, so no asset event reaches Bevy's `camera_system`, which re-reads an
+    /// image target only for that or a changed projection. The stamp must mark the projection, or
+    /// the camera keeps the old factor: its logical viewport `physical / old`, and the nameplates
+    /// seated in it drew `new / old` times too big and that far off their units.
+    #[test]
+    fn a_factor_only_restamp_makes_bevy_reread_the_cameras_target() {
+        #[derive(Resource, Default)]
+        struct Rereads(usize);
+        // `camera_system`'s own trigger for a camera whose target is an image.
+        fn count(
+            q: Query<(), (With<WorldCamera>, Changed<Projection>)>,
+            mut n: ResMut<Rereads>,
+        ) {
+            n.0 += q.iter().count();
+        }
+
+        let mut app = App::new();
+        app.add_plugins((MinimalPlugins, bevy::asset::AssetPlugin::default()))
+            .init_asset::<Image>()
+            .init_resource::<Rereads>();
+        let mut w = Window::default();
+        w.resolution.set_scale_factor(1.0);
+        let win = app.world_mut().spawn((w, PrimaryWindow)).id();
+        app.insert_resource(RenderScale(1.0))
+            .add_systems(Startup, setup_backdrop)
+            .add_systems(
+                Update,
+                (track_render_size, retarget_world_camera, count).chain(),
+            );
+        app.world_mut()
+            .spawn((WorldCamera, RenderTarget::default(), Projection::default()));
+        app.update();
+        let image = app.world().resource::<WorldBackdrop>().image.id();
+        app.world_mut().resource_mut::<Rereads>().0 = 0;
+
+        app.update();
+        assert_eq!(
+            app.world().resource::<Rereads>().0,
+            0,
+            "a frame with nothing to re-stamp leaves the projection alone"
+        );
+
+        // 1× to 2× at the same physical size: the browser's zoom.
+        app.world_mut()
+            .entity_mut(win)
+            .get_mut::<Window>()
+            .expect("the primary window")
+            .resolution
+            .set_scale_factor(2.0);
+        app.update();
+        assert_eq!(
+            app.world().resource::<WorldBackdrop>().image.id(),
+            image,
+            "the same physical size builds no new image: no asset event will re-read the target"
+        );
+        assert_eq!(
+            app.world().resource::<Rereads>().0,
+            1,
+            "the factor-only stamp must mark the projection, so camera_system re-reads the target"
+        );
+    }
