+    /// The owner's report (4 Nov, 14:17): three wolves' plates drawn over the wolves, the model
+    /// under the name. A unit whose head point projects to (960, 600) on a 1920x1080 window, the
+    /// lift putting the seat 24 px higher: the plate's bottom centre (the bar's bottom edge
+    /// under it) lands on the seat, every pixel of the plate above the head, and the solver and
+    /// the widget layer's units keep it there.
+    #[test]
+    fn a_plate_stands_on_its_bottom_centre_above_the_head_never_over_the_model() {
+        let vp = Vec2::new(1920.0, 1080.0);
+        let head = Vec2::new(960.0, 600.0);
+        let seat = head - Vec2::new(0.0, 24.0);
+        let basis = plate_px_basis(vp, 1.0);
+        let (pw, ph) = (gx_px(PLATE_W, basis), gx_px(PLATE_H, basis));
+        let desired = seat_rect(seat, pw, ph);
+        assert_eq!(desired.width(), pw);
+        assert_eq!(desired.height(), ph);
+        assert_eq!(desired.max.y, seat.y, "the bottom edge on the seat");
+        assert_eq!((desired.min.x + desired.max.x) * 0.5, seat.x, "centred on it");
+        assert!(desired.max.y < head.y, "the whole plate above the head point");
+        assert!(
+            desired.max.y - gx_px(BAR_OFF_Y, basis) < head.y,
+            "the health bar's bottom edge above the head"
+        );
+
+        // Alone on screen, the solver keeps the seat.
+        let solved = crate::smart_rect::SmartBucket::default().resolve(desired, vp);
+        for (got, want) in [
+            (solved.min.x, desired.min.x),
+            (solved.min.y, desired.min.y),
+            (solved.max.x, desired.max.x),
+            (solved.max.y, desired.max.y),
+        ] {
+            assert!((got - want).abs() < 1e-3, "unmoved: {solved:?} vs {desired:?}");
+        }
+
+        // The widget layer hangs the frame from its top centre: one plate height above the seat.
+        let seam = crate::ui_script::seam_scale(vp.y, 1.0);
+        let (x, y) = top_centre_units(desired, vp, seam);
+        assert!((x * seam - seat.x).abs() < 1e-3);
+        assert!(
+            (y * seam - ph - (vp.y - seat.y)).abs() < 1e-3,
+            "bottom (Y up) on the seat: {}",
+            y * seam - ph
+        );
+    }
