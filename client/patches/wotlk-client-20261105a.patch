+#[cfg(test)]
+mod combo_tests {
+    /// The modern set is 83 pairs and keeps every stock pair; "all" is the full 100, each once.
+    #[test]
+    fn modern_and_all() {
+        let stock = [(1u8, 1u8), (2, 7), (6, 11)];
+        let modern = super::combine(&stock, false);
+        assert_eq!(modern.len(), 83);
+        assert!(stock.iter().all(|p| modern.contains(p)));
+        assert!(modern.contains(&(6, 2)) && !modern.contains(&(7, 11)));
+        let all = super::combine(&stock, true);
+        assert_eq!(all.len(), 100);
+        assert!(all.contains(&(7, 11)) && all.contains(&(1, 7)));
+        assert_eq!(&all[..3], &stock[..], "the stock pairs keep their place");
+    }
+}
