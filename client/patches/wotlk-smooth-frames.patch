diff --git a/web/examples/perf.js b/web/examples/perf.js
new file mode 100644
index 00000000..80888473
--- /dev/null
+++ b/web/examples/perf.js
@@ -0,0 +1,130 @@
+// examples/perf.js — the smooth-frames test pass. `?bridge=perf` mounts it: a small panel that
+// records every frame while you play and reports what players feel — frame times, hitches, the
+// blocking file reads behind freezes, and how fast the cursor answers a hover. Play a fixed route
+// (the plan: Stormwind gate to Goldshire on foot, a flight, Dalaran), then press "Copy report".
+// Everything stays in this tab; nothing is sent anywhere.
+import { wenilla } from '../bridge.js';
+
+const frames = []; // ms between animation frames
+let last = performance.now();
+let syncReads = 0;
+let syncReadMs = 0;
+let slowestRead = { ms: 0, url: '' };
+const hovers = []; // ms from hover change to the canvas cursor changing
+let pendingHover = null;
+let lastHover = null;
+
+// Frame times: the game draws once per animation frame, so the gap between frames is the frame.
+function tick(now) {
+  frames.push(now - last);
+  last = now;
+  if (frames.length > 20000) frames.splice(0, frames.length - 20000);
+  requestAnimationFrame(tick);
+}
+requestAnimationFrame(tick);
+
+// Blocking reads: a synchronous XMLHttpRequest freezes the tab for its whole round trip.
+const open = XMLHttpRequest.prototype.open;
+const send = XMLHttpRequest.prototype.send;
+XMLHttpRequest.prototype.open = function (method, url, async, ...rest) {
+  this.__perf = async === false ? String(url) : null;
+  return open.call(this, method, url, async, ...rest);
+};
+XMLHttpRequest.prototype.send = function (...args) {
+  if (!this.__perf) return send.apply(this, args);
+  const t0 = performance.now();
+  try {
+    return send.apply(this, args);
+  } finally {
+    const ms = performance.now() - t0;
+    syncReads += 1;
+    syncReadMs += ms;
+    if (ms > slowestRead.ms) slowestRead = { ms, url: decodeURIComponent(this.__perf.split('/data/').pop()) };
+  }
+};
+
+// Hover answer time: when the hovered unit changes, time until the canvas cursor style changes.
+const canvas = document.querySelector('canvas');
+if (canvas) {
+  new MutationObserver(() => {
+    if (pendingHover !== null) {
+      hovers.push(performance.now() - pendingHover);
+      pendingHover = null;
+    }
+  }).observe(canvas, { attributes: true, attributeFilter: ['style'] });
+}
+wenilla.on('frame', (s) => {
+  const g = s.hover?.guid ?? null;
+  if (g !== lastHover) {
+    lastHover = g;
+    pendingHover = performance.now();
+  }
+});
+wenilla.set({ hz: 0 }); // every frame, so the hover change is seen the frame it happens
+
+const pct = (arr, p) => {
+  if (!arr.length) return 0;
+  const s = [...arr].sort((a, b) => a - b);
+  return s[Math.min(s.length - 1, Math.floor((p / 100) * s.length))];
+};
+function report() {
+  const f = frames.slice(1);
+  return {
+    when: new Date().toISOString(),
+    build: location.pathname,
+    query: location.search,
+    frames: f.length,
+    seconds: Math.round(f.reduce((a, b) => a + b, 0) / 1000),
+    medianMs: +pct(f, 50).toFixed(1),
+    p95Ms: +pct(f, 95).toFixed(1),
+    p99Ms: +pct(f, 99).toFixed(1),
+    over33ms: f.filter((x) => x > 33).length,
+    over100ms: f.filter((x) => x > 100).length,
+    worstMs: +Math.max(0, ...f).toFixed(0),
+    blockingReads: syncReads,
+    blockingReadMs: Math.round(syncReadMs),
+    slowestRead: { ms: Math.round(slowestRead.ms), file: slowestRead.url },
+    hoverSamples: hovers.length,
+    hoverMedianMs: +pct(hovers, 50).toFixed(1),
+    hoverWorstMs: +Math.max(0, ...hovers).toFixed(1),
+    fileStoreMB: Math.round((globalThis.__wenilla_files?.bytes ?? 0) / 1048576),
+  };
+}
+
+const el = document.createElement('div');
+el.style.cssText = `position: fixed; right: 0; top: 0; z-index: 9; padding: .4rem .6rem;
+  color: #ddd; background: rgba(0,0,0,.6); border-bottom-left-radius: 6px;
+  font: 12px/1.4 ui-monospace, monospace; white-space: pre;`;
+const text = document.createElement('div');
+const copy = document.createElement('button');
+copy.textContent = 'Copy report';
+copy.onclick = async () => {
+  const r = JSON.stringify(report(), null, 2);
+  try {
+    await navigator.clipboard.writeText(r);
+    copy.textContent = 'Copied';
+  } catch {
+    console.log(r);
+    copy.textContent = 'In the console';
+  }
+  setTimeout(() => (copy.textContent = 'Copy report'), 1500);
+};
+const reset = document.createElement('button');
+reset.textContent = 'Reset';
+reset.onclick = () => {
+  frames.length = 0;
+  hovers.length = 0;
+  syncReads = 0;
+  syncReadMs = 0;
+  slowestRead = { ms: 0, url: '' };
+};
+el.append(text, copy, reset);
+document.body.appendChild(el);
+setInterval(() => {
+  const r = report();
+  text.textContent =
+    `frame ${r.medianMs} ms  p95 ${r.p95Ms}  p99 ${r.p99Ms}\n` +
+    `hitches >33ms ${r.over33ms}  >100ms ${r.over100ms}  worst ${r.worstMs}\n` +
+    `blocking reads ${r.blockingReads} (${r.blockingReadMs} ms)\n` +
+    `hover -> cursor ${r.hoverMedianMs} ms (n=${r.hoverSamples})\n`;
+}, 500);
