+/// The tuning knobs a test pass may set from the page's address on the web build, where wasm32
+/// has no process environment: `?farclip=600&upload_budget=4` reads back as `WOW_FARCLIP` and
+/// `WOW_UPLOAD_BUDGET` (the `WOW_` prefix dropped, lowercased, as `benilla_app::webenv` maps its
+/// keys). Only these keys: the rest of the `WOW_*` set are native instruments (captures, dumps,
+/// traces that write files) a URL must not switch on in a browser.
+pub const WEB_TUNABLE: &[&str] = &[
+    "WOW_ANISO",
+    "WOW_ART_RADIUS",
+    "WOW_FADE_NEAR",
+    "WOW_FARCLIP",
+    "WOW_LIQUID_DC",
+    "WOW_MSAA",
+    "WOW_NOPORTALCULL",
+    "WOW_NO_BC",
+    "WOW_NO_FRAME_PACE",
+    "WOW_NOVSYNC",
+    "WOW_STATIC_GX",
+    "WOW_STATIC_GX_FADE",
+    "WOW_STATIC_GX_PROP",
+    "WOW_STATIC_GX_WMO",
+    "WOW_STATIC_MERGE",
+    "WOW_TILE_UNLOAD",
+    "WOW_UPLOAD_BUDGET",
+    "WOW_WEATHER",
+];
+
+/// `std::env::var`, with the web build's answer for [`WEB_TUNABLE`] keys taken from the page's
+/// query string. Native: exactly `std::env::var`.
+pub fn env_var(name: &str) -> Result<String, std::env::VarError> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        if !WEB_TUNABLE.contains(&name) {
+            return Err(std::env::VarError::NotPresent);
+        }
+        wasm::query_var(name).ok_or(std::env::VarError::NotPresent)
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::env::var(name)
+    }
+}
