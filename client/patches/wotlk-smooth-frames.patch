+        let bare = path.strip_prefix("mpq://").unwrap_or(path);
+        if let Ok(internal) = internal_path(Path::new(bare)) {
+            benilla_formats::web::prefetch(&web_data_url(&internal));
+        }
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    let _ = path;
+}
