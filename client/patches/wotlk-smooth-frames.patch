+/// A terrain tile's collider in 16 pieces, one per cell of 4×4 chunks (the chunks are in MCNK
+/// file order, 16 to a row). Each piece is the same weld as [`terrain_collider_data`] over its 16
+/// chunks; together they are the same surface. The web build uses it: there one whole-tile
+/// trimesh (~65k triangles) was a BVH build the browser budget could not split, a frame of tens of
+/// ms on the one thread; a cell piece (~4k) fits the 2 ms build budget, and the pieces queue.
+#[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+pub(super) fn terrain_collider_cells(
+    chunks: &[benilla_formats::ChunkMesh],
+) -> Vec<(Vec<Vec3>, Vec<[u32; 3]>)> {
+    let mut cells: Vec<Vec<&benilla_formats::ChunkMesh>> = vec![Vec::new(); 16];
+    for (i, chunk) in chunks.iter().enumerate() {
+        let (row, col) = (i / 16, i % 16);
+        cells[(row / 4 % 4) * 4 + col / 4 % 4].push(chunk);
+    }
+    cells
+        .into_iter()
+        .filter_map(|cell| {
+            let mut verts: Vec<Vec3> = Vec::new();
+            let mut tris: Vec<[u32; 3]> = Vec::new();
+            for chunk in cell {
+                let base = verts.len() as u32;
+                verts.extend(chunk.positions.iter().map(|p| wow_to_bevy(*p)));
+                tris.extend(
+                    chunk
+                        .indices
+                        .as_chunks::<3>()
+                        .0
+                        .iter()
+                        .map(|c| [base + c[0], base + c[1], base + c[2]]),
+                );
+            }
+            (!tris.is_empty()).then_some((verts, tris))
+        })
+        .collect()
+}
