 /// Owns the world camera's target (the size-carrier) and the UI camera's claim on the world.
 pub(crate) struct WorldBackdropPlugin;
 
+/// The web build's automatic render scale: the 3D world's resolution follows the frame time
+/// between [`AUTO_SCALE_RANGE`] while the interface stays sharp, as the plan's browser path has it
+/// (most browser players are on integrated graphics, where pixels are the main cost). Off on
+/// native, and off for the session once the `renderScale` CVar is set by anyone.
+#[derive(Resource)]
+pub(crate) struct AutoRenderScale {
+    enabled: bool,
+    /// Smoothed frame time, seconds.
+    ema: f32,
+    /// Seconds the smoothed frame time has sat past a threshold, signed: + slow, - fast.
+    held: f32,
+    /// Seconds since the last step, so a resize settles before the next judgement.
+    since_step: f32,
+}
+
+impl Default for AutoRenderScale {
+    fn default() -> Self {
+        Self {
+            enabled: cfg!(target_arch = "wasm32"),
+            ema: 1.0 / 60.0,
+            held: 0.0,
+            since_step: 0.0,
+        }
+    }
+}
+
+/// The automatic scale's bounds: below half the picture is too soft to read a nameplate's world.
+const AUTO_SCALE_RANGE: std::ops::RangeInclusive<f32> = 0.5..=1.0;
+/// Step down past ~45 fps sustained for 2 s; step up under ~70 fps sustained for 5 s.
+const AUTO_SLOW_S: f32 = 1.0 / 45.0;
+const AUTO_FAST_S: f32 = 1.0 / 70.0;
+const AUTO_STEP: f32 = 0.05;
+
+/// One judgement a frame. Never under a loading cover (its frames are load work, not draw cost),
+/// and at most one step every 3 s so each new size is measured before the next.
+fn auto_render_scale(
+    time: Res<Time<bevy::time::Real>>,
+    screen: Res<crate::loading_screen::LoadingScreen>,
+    mut auto: ResMut<AutoRenderScale>,
+    mut scale: ResMut<RenderScale>,
+) {
+    if !auto.enabled {
+        return;
+    }
+    let dt = time.delta_secs();
+    if screen.covering() || dt <= 0.0 || dt > 0.5 {
+        auto.held = 0.0;
+        return;
+    }
+    auto.ema += (dt - auto.ema) * 0.05;
+    auto.since_step += dt;
+    if auto.ema > AUTO_SLOW_S {
+        auto.held = auto.held.max(0.0) + dt;
+    } else if auto.ema < AUTO_FAST_S {
+        auto.held = auto.held.min(0.0) - dt;
+    } else {
+        auto.held = 0.0;
+    }
+    if auto.since_step < 3.0 {
+        return;
+    }
+    let current = scale.0;
+    let next = if auto.held > 2.0 {
+        current - AUTO_STEP
+    } else if auto.held < -5.0 {
+        current + AUTO_STEP
+    } else {
+        return;
+    }
+    .clamp(*AUTO_SCALE_RANGE.start(), *AUTO_SCALE_RANGE.end());
+    if (next - current).abs() > f32::EPSILON {
+        scale.0 = next;
+        auto.since_step = 0.0;
+        auto.held = 0.0;
+    }
+}
