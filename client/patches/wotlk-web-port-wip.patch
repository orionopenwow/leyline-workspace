diff --git a/crates/benilla-app/src/startup_pace.rs b/crates/benilla-app/src/startup_pace.rs
new file mode 100644
index 00000000..0e7123ae
--- /dev/null
+++ b/crates/benilla-app/src/startup_pace.rs
@@ -0,0 +1,713 @@
+//! Startup pacing: what the browser does before the first glue screen, and when the rest happens.
+//!
+//! A browser boot runs the whole `Startup` schedule in the first frame, one main-thread task that
+//! the page cannot repaint through: every catalog was read (synchronous XHR) and parsed there, and
+//! the overlay sat on "Starting…" until all of it was done. Much of it no glue screen reads: the
+//! 49k-spell display catalog, achievements, talents, the spellbook tabs, the Dungeon Finder and
+//! battleground tables, the GM ticket categories and the chat filters' 5,220 expressions.
+//!
+//! - **Deferred loads** ([`add_deferred_load`]): in the browser those loaders leave `Startup` and
+//!   run once the first glue screen has drawn, one or a few a frame within a small budget, so the
+//!   screens keep drawing. Every one of them already tolerates its resource being absent (the
+//!   readers take `Option<Res<_>>` and a landing counts as a change). The rest of the queue runs
+//!   at once when the world session starts ([`drain`] from the net dispatch, before
+//!   `SMSG_LOGIN_VERIFY_WORLD`'s event, and on entering [`ClientState::InWorld`]), so nothing in
+//!   the world ever sees one missing. Natively they stay in `Startup`, as before.
+//! - **Timing** ([`StartupTimings`]): one `startup:` line when the first glue screen is up, one
+//!   when the deferred queue is empty and one at the first world frame, in milliseconds.
+//! - **Ready**: the page's overlay (`web/boot.js`) waits for `__wenilla_progress("ready")`; it is
+//!   sent at the end of the first frame, which presents the glue screen.
+//! - **Quiet login** ([`QuietLogin`]): when the page signed the player in (`window.__wenilla_env`
+//!   has the account and password), the login screen is only a status line on black: no
+//!   Northrend scene, no music or ambience, and the account form hidden. A refused login brings
+//!   the stock screen back whole.
+
+use std::collections::VecDeque;
+
+use bevy::ecs::system::SystemId;
+use bevy::platform::time::Instant;
+use bevy::prelude::*;
+
+use crate::char_select::ClientState;
+
+/// Whether the loaders registered through [`add_deferred_load`] wait for the first glue screen.
+const DEFER: bool = cfg!(target_arch = "wasm32");
+
+/// Per-frame budget of the deferred queue: the next loader starts only while the frame has spent
+/// less than this on the queue (a loader itself is never split).
+const FRAME_BUDGET_MS: f64 = 8.0;
+
+/// Frames drawn before the queue starts: the first presents the glue screen, the second lets the
+/// page drop its overlay over a live screen.
+const FRAMES_BEFORE_DEFERRED: u32 = 2;
+
+/// Register `system` as a catalog loader that no glue screen needs: in the browser it runs after
+/// the first glue screen (see the module header), natively at `Startup` after the chain opens.
+pub(crate) fn add_deferred_load<M>(
+    app: &mut App,
+    name: &'static str,
+    system: impl IntoSystem<(), (), M> + 'static,
+) {
+    add_deferred_load_with(app, name, system, DEFER);
+}
+
+fn add_deferred_load_with<M>(
+    app: &mut App,
+    name: &'static str,
+    system: impl IntoSystem<(), (), M> + 'static,
+    defer: bool,
+) {
+    if !defer {
+        app.add_systems(Startup, system.after(benilla_assets::AssetSet::Open));
+        return;
+    }
+    let id = app.world_mut().register_system(system);
+    app.world_mut()
+        .get_resource_or_init::<DeferredLoads>()
+        .queue
+        .push_back((name, id));
+}
+
+/// The loaders still to run, and what the ones that ran cost.
+#[derive(Resource, Default)]
+pub(crate) struct DeferredLoads {
+    queue: VecDeque<(&'static str, SystemId)>,
+    /// When the queue first waited on the character screen's model ([`glue_model_pending`]).
+    held_since: Option<f64>,
+    ran: Vec<(&'static str, f64)>,
+    frames: u32,
+    first_ms: Option<f64>,
+    reported: bool,
+}
+
+impl DeferredLoads {
+    fn run_one(world: &mut World) -> bool {
+        let next = world
+            .resource_mut::<DeferredLoads>()
+            .queue
+            .pop_front();
+        let Some((name, id)) = next else {
+            return false;
+        };
+        let start = Instant::now();
+        if let Err(e) = world.run_system(id) {
+            error!("startup: deferred load `{name}` did not run: {e}");
+        }
+        let ms = start.elapsed().as_secs_f64() * 1000.0;
+        if ms >= 4.0 {
+            benilla_formats::loadtrace::note(|| format!("catalog {name} {ms:.0} ms"));
+        }
+        let mut loads = world.resource_mut::<DeferredLoads>();
+        loads.first_ms.get_or_insert(page_ms());
+        loads.ran.push((name, ms));
+        true
+    }
+
+    fn report(world: &mut World, how: &str) {
+        let mut loads = world.resource_mut::<DeferredLoads>();
+        if loads.reported || !loads.queue.is_empty() || loads.ran.is_empty() {
+            return;
+        }
+        loads.reported = true;
+        let total: f64 = loads.ran.iter().map(|(_, ms)| ms).sum();
+        let each: Vec<String> = loads
+            .ran
+            .iter()
+            .map(|(name, ms)| format!("{name} {ms:.0}"))
+            .collect();
+        info!(
+            "startup: deferred loads {total:.0} ms over {} frame(s), {how} ({}), done at {:.0} ms \
+             since page load",
+            loads.frames,
+            each.join(", "),
+            page_ms()
+        );
+    }
+}
+
+/// The longest the deferred queue waits on the character screen's model, once per session (ms).
+const GLUE_MODEL_HOLD_MS: f64 = 6000.0;
+
+/// A glue look is up whose model has not stood yet. A deferred loader runs whole in one frame
+/// (the 49k-spell catalog's reads and parse are seconds in a browser), and while it runs no model
+/// download lands, so the character stood seconds after its scene: the queue waits for it.
+fn glue_model_pending(world: &World) -> bool {
+    let (Some(p), Some(b)) = (
+        world.get_resource::<crate::portrait::GluePreview>(),
+        world.get_resource::<crate::portrait::GluePreviewBake>(),
+    ) else {
+        return false;
+    };
+    p.look.is_some() && b.look != p.look
+}
+
+/// The per-frame slice of the deferred queue, once the first glue screen has drawn.
+fn run_deferred_loads(world: &mut World) {
+    let Some(mut loads) = world.get_resource_mut::<DeferredLoads>() else {
+        return;
+    };
+    if loads.queue.is_empty() {
+        return;
+    }
+    loads.frames += 1;
+    if loads.frames <= FRAMES_BEFORE_DEFERRED {
+        return;
+    }
+    if glue_model_pending(world) {
+        let now = page_ms();
+        let mut loads = world.resource_mut::<DeferredLoads>();
+        let since = *loads.held_since.get_or_insert(now);
+        if now - since < GLUE_MODEL_HOLD_MS {
+            return;
+        }
+    }
+    let start = Instant::now();
+    while start.elapsed().as_secs_f64() * 1000.0 < FRAME_BUDGET_MS {
+        if !DeferredLoads::run_one(world) {
+            break;
+        }
+    }
+    if world.resource::<DeferredLoads>().queue.is_empty() {
+        DeferredLoads::report(world, "time-sliced");
+        log_read_stats("with the deferred loads");
+    }
+}
+
+/// Run every deferred loader still queued, now: the world session is starting and its readers
+/// expect the catalogs. Cheap when the queue is empty.
+pub(crate) fn drain(world: &mut World) {
+    if world
+        .get_resource::<DeferredLoads>()
+        .is_none_or(|l| l.queue.is_empty())
+    {
+        return;
+    }
+    let left = world.resource::<DeferredLoads>().queue.len();
+    let start = Instant::now();
+    while DeferredLoads::run_one(world) {}
+    info!(
+        "startup: {left} deferred load(s) finished at world entry in {:.0} ms",
+        start.elapsed().as_secs_f64() * 1000.0
+    );
+    DeferredLoads::report(world, "finished at world entry");
+    log_read_stats("to the world entry");
+}
+
+/// `OnEnter(InWorld)` with no held packets (a run that starts in the world): everything at once.
+fn drain_on_world_enter(world: &mut World) {
+    if world.get_resource::<HeldWorldEvents>().is_some_and(|h| h.holding) {
+        return;
+    }
+    drain(world);
+}
+
+/// The world session's packets after `SMSG_LOGIN_VERIFY_WORLD`, held while deferred catalogs are
+/// still loading: the loading screen goes up on that packet and keeps drawing while the rest of
+/// the queue runs in frame slices, instead of one frozen frame. Released whole, in order, once the
+/// queue is empty, so every handler sees its catalog.
+#[derive(Resource, Default)]
+pub(crate) struct HeldWorldEvents {
+    holding: bool,
+    events: Vec<benilla_protocol::SessionEvent>,
+    since: Option<Instant>,
+}
+
+/// This frame's session events as the handlers should see them (`net::apply_net_updates`).
+pub(crate) fn gate_world_events(
+    world: &mut World,
+    mut events: Vec<benilla_protocol::SessionEvent>,
+) -> Vec<benilla_protocol::SessionEvent> {
+    let queued = world
+        .get_resource::<DeferredLoads>()
+        .map_or(0, |l| l.queue.len());
+    let mut held = world.get_resource_or_init::<HeldWorldEvents>();
+    if held.holding {
+        held.events.append(&mut events);
+        if queued > 0 {
+            return Vec::new();
+        }
+        held.holding = false;
+        let waited = held.since.take().map_or(0.0, |t| t.elapsed().as_secs_f64() * 1000.0);
+        let out = std::mem::take(&mut held.events);
+        info!(
+            "startup: the deferred catalogs are in; {} held world packet(s) released after {waited:.0} ms",
+            out.len()
+        );
+        log_read_stats("to the world entry");
+        return out;
+    }
+    if queued == 0 {
+        return events;
+    }
+    let Some(at) = events
+        .iter()
+        .position(|e| matches!(e, benilla_protocol::SessionEvent::Connected { .. }))
+    else {
+        return events;
+    };
+    held.events = events.split_off(at + 1);
+    held.holding = true;
+    held.since = Some(Instant::now());
+    info!(
+        "startup: the world session started with {queued} deferred catalog load(s) left; its \
+         packets wait under the loading screen while they finish"
+    );
+    events
+}
+
+/// Milliseconds since the page's navigation start in the browser (`performance.now()`), since the
+/// process clock's first read natively.
+pub(crate) fn page_ms() -> f64 {
+    #[cfg(target_arch = "wasm32")]
+    {
+        use wasm_bindgen::JsCast;
+        let now = (|| {
+            let global = js_sys::global();
+            let perf = js_sys::Reflect::get(&global, &"performance".into()).ok()?;
+            let now = js_sys::Reflect::get(&perf, &"now".into())
+                .ok()?
+                .dyn_into::<js_sys::Function>()
+                .ok()?;
+            now.call0(&perf).ok()?.as_f64()
+        })();
+        now.unwrap_or(0.0)
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        static ORIGIN: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+        ORIGIN.get_or_init(Instant::now).elapsed().as_secs_f64() * 1000.0
+    }
+}
+
+/// The boot's milestones, in [`page_ms`] milliseconds, and the glue load's own cost.
+#[derive(Resource, Default)]
+pub(crate) struct StartupTimings {
+    startup_begin: f64,
+    startup_end: f64,
+    /// `ui_script::setup_script`: the glue VM, GlueXML and the first screen.
+    pub(crate) glue_ms: f64,
+    first_frame_reported: bool,
+    /// The world session's start (`SMSG_LOGIN_VERIFY_WORLD`), and whether its first uncovered
+    /// frame was reported.
+    world_begin: Option<f64>,
+    world_reported: bool,
+}
+
+fn mark_startup_begin(mut t: ResMut<StartupTimings>) {
+    t.startup_begin = page_ms();
+}
+
+fn mark_startup_end(mut t: ResMut<StartupTimings>) {
+    t.startup_end = page_ms();
+}
+
+/// The end of the first frame: the glue screen is presented. Logs the boot line and tells the
+/// page (`ready`), once.
+fn report_first_frame(mut t: ResMut<StartupTimings>, loads: Option<Res<DeferredLoads>>) {
+    if t.first_frame_reported {
+        return;
+    }
+    t.first_frame_reported = true;
+    let now = page_ms();
+    let startup = t.startup_end - t.startup_begin;
+    let deferred = loads.as_ref().map_or(0, |l| l.queue.len());
+    info!(
+        "startup: page load to first update {:.0} ms, Startup {startup:.0} ms (glue {:.0} ms, \
+         catalogs and the rest {:.0} ms), first frame {:.0} ms; first glue screen at {now:.0} ms \
+         since page load; {deferred} catalog load(s) deferred",
+        t.startup_begin,
+        t.glue_ms,
+        (startup - t.glue_ms).max(0.0),
+        now - t.startup_end,
+    );
+    log_read_stats("to the first glue screen");
+    crate::webprogress::signal_ready_once();
+}
+
+/// The chain reads so far: how much of the boot was the synchronous XHR and the copy, and how many
+/// the page's prefetch answered with no request at all.
+fn log_read_stats(when: &str) {
+    #[cfg(target_arch = "wasm32")]
+    {
+        let r = benilla_formats::web::read_stats();
+        info!(
+            "startup: {} chain read(s) {when}, {:.1} MB, {:.0} ms inside the reads, {} from the \
+             page's prefetch",
+            r.reads,
+            r.bytes as f64 / (1024.0 * 1024.0),
+            r.ms,
+            r.prefetched
+        );
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    let _ = when;
+}
+
+/// The world session started: the clock for the first world frame.
+pub(crate) fn mark_world_begin(world: &mut World) {
+    if let Some(mut t) = world.get_resource_mut::<StartupTimings>() {
+        t.world_begin = Some(page_ms());
+        t.world_reported = false;
+    }
+    // The page's read recorder files what follows under "enter" (`web/boot.js`).
+    crate::webprogress::signal("enter");
+    crate::loadtrace::world_session_started();
+}
+
+/// The first frame the loading screen no longer covers, in the world.
+fn report_first_world_frame(
+    mut t: ResMut<StartupTimings>,
+    screen: Option<Res<crate::loading_screen::LoadingScreen>>,
+    state: Option<Res<State<ClientState>>>,
+) {
+    let Some(begin) = t.world_begin else { return };
+    if t.world_reported || state.is_none_or(|s| *s.get() != ClientState::InWorld) {
+        return;
+    }
+    if screen.is_some_and(|s| s.covering()) {
+        return;
+    }
+    t.world_reported = true;
+    crate::webprogress::signal("world");
+    benilla_formats::loadtrace::phase("cover lifted");
+    let now = page_ms();
+    info!(
+        "startup: first world frame {:.0} ms after the world session started ({now:.0} ms since \
+         page load)",
+        now - begin
+    );
+}
+
+/// The page signed the player in: the login screen is only the status line (module header).
+#[derive(Resource)]
+pub(crate) struct QuietLogin(pub(crate) bool);
+
+impl Default for QuietLogin {
+    fn default() -> Self {
+        QuietLogin(cfg!(target_arch = "wasm32") && crate::run_mode::env_login())
+    }
+}
+
+/// The Lua that keeps the account form down while the quiet login stands: the stock screen's
+/// `AccountLogin_ShowUserAgreements` (from `OnShow`) and `SCANDLL_FINISHED` both show it.
+const HIDE_ACCOUNT_FORM: &str =
+    "if AccountLoginUI and AccountLoginUI:IsShown() then AccountLoginUI:Hide() end \
+     if GlueDialog and GlueDialog:IsShown() and GlueDialog.which ~= 'CANCEL' then GlueDialog:Hide() end \
+     for _, n in ipairs({'AccountLoginAccountEdit', 'AccountLoginPasswordEdit'}) do \
+       local e = _G[n] if e and e.ClearFocus then e:ClearFocus() end end";
+
+/// Hide the account form on the glue VM now, when the quiet login stands: called right after the
+/// first screen is set, before anything draws.
+pub(crate) fn quiet_login_hide_form(world: &World, script: &benilla_ui::script::UiScript) {
+    if world.get_resource::<QuietLogin>().is_some_and(|q| q.0) {
+        let _ = script.eval::<()>(HIDE_ACCOUNT_FORM);
+    }
+}
+
+/// Keep the form down while quiet; end the quiet login on a refusal or once past the login screen,
+/// and give the stock screen back whole (its `OnShow`: music, agreements, the form) when it ends
+/// on the login screen.
+fn drive_quiet_login(
+    mut quiet: ResMut<QuietLogin>,
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mut failed: MessageReader<crate::net::LoginFailedMessage>,
+    state: Option<Res<State<ClientState>>>,
+) {
+    if !quiet.0 {
+        failed.clear();
+        // Back on the login screen with the page's credentials (a lost session): quiet again, the
+        // glue manager reconnects on its own and the page shows its overlay.
+        let on_login = state.as_ref().is_some_and(|s| *s.get() == ClientState::Login);
+        if cfg!(target_arch = "wasm32") && page_signed_in() && on_login {
+            if let Some(s) = script
+                .as_ref()
+                .filter(|s| s.vm_kind() == benilla_ui::script::VmKind::Glue)
+            {
+                if s.glue_screen() == "login" {
+                    quiet.0 = true;
+                    let _ = s.eval::<()>(HIDE_ACCOUNT_FORM);
+                }
+            }
+        }
+        return;
+    }
+    // In the browser the glue manager retries a refusal on its backoff; the form stays down.
+    let refused = !cfg!(target_arch = "wasm32")
+        && failed.read().any(|m| m.refusal.is_some() || m.terminal);
+    failed.clear();
+    let past_login = state.is_some_and(|s| *s.get() != ClientState::Login);
+    let Some(script) = script.filter(|s| s.vm_kind() == benilla_ui::script::VmKind::Glue) else {
+        if past_login {
+            quiet.0 = false;
+        }
+        return;
+    };
+    if refused || past_login {
+        quiet.0 = false;
+        if !past_login {
+            info!("startup: the page's login was refused; the login screen comes back");
+            let _ = script.eval::<()>(
+                "if AccountLogin and AccountLogin:IsShown() and AccountLogin_OnShow then \
+                 AccountLogin_OnShow(AccountLogin) end",
+            );
+        }
+        return;
+    }
+    let _ = script.eval::<()>(HIDE_ACCOUNT_FORM);
+}
+
+/// Run condition: in the browser only (the focus signal has no page natively).
+fn cfg_web() -> bool {
+    cfg!(target_arch = "wasm32")
+}
+
+/// Whether the page signed the player in this session (browser only): the glue screens then play
+/// no music.
+pub(crate) fn page_signed_in() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| cfg!(target_arch = "wasm32") && crate::run_mode::env_login())
+}
+
+/// Whether the quiet login stands and the glue VM is on its login screen: the scene, the music and
+/// the ambience are skipped.
+pub(crate) fn quiet_on_login_screen(quiet: Option<&QuietLogin>, screen: &str) -> bool {
+    quiet.is_some_and(|q| q.0) && screen == "login"
+}
+
+/// The character standing on the select screen, as the page's world prefetch wants it: the ADT
+/// under them (`focus:World\Maps\<dir>\<dir>_<x>_<y>.adt`), so `web/boot.js` fetches the slice
+/// tier that holds it, nearest tiles first, rather than a fixed one. Sent on each change.
+fn signal_char_focus(
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    mgr: Option<Res<crate::ui_script::glue_mgr::GlueMgr>>,
+    maps: Option<Res<benilla_assets::MapCatalogRes>>,
+    mut last: Local<Option<String>>,
+) {
+    let (Some(script), Some(mgr), Some(maps)) = (script, mgr, maps) else {
+        return;
+    };
+    if script.vm_kind() != benilla_ui::script::VmKind::Glue {
+        return;
+    }
+    let Some(c) = script
+        .glue_standing_guid()
+        .and_then(|g| mgr.roster_character(g))
+    else {
+        return;
+    };
+    let Some(dir) = maps.0.directory(c.map) else {
+        return;
+    };
+    let (tx, ty) = benilla_formats::world_to_tile(c.position.x, c.position.y);
+    let adt = format!("World\\Maps\\{dir}\\{dir}_{tx}_{ty}.adt");
+    if last.as_deref() != Some(adt.as_str()) {
+        crate::webprogress::signal(&format!("focus:{adt}"));
+        *last = Some(adt);
+    }
+}
+
+/// A worldport's destination, as the page's world prefetch wants it (`port:<adt>`): the page warms
+/// the slice tier holding it, nearest tiles first and at full priority, while the client streams,
+/// so the destination's reads find the HTTP cache warm rather than queueing behind each other.
+fn signal_port_focus(
+    mut ports: MessageReader<crate::net::WorldportMessage>,
+    maps: Option<Res<benilla_assets::MapCatalogRes>>,
+) {
+    let Some(maps) = maps else {
+        ports.clear();
+        return;
+    };
+    for port in ports.read() {
+        // A boat-local position names no tile.
+        if port.transport_entry.is_some() {
+            continue;
+        }
+        let Some(dir) = maps.0.directory(port.map_id) else {
+            continue;
+        };
+        let (tx, ty) = benilla_formats::world_to_tile(port.position[0], port.position[1]);
+        crate::webprogress::signal(&format!("port:World\\Maps\\{dir}\\{dir}_{tx}_{ty}.adt"));
+    }
+}
+
+/// The glue screen the page sees (`glue:<screen>` on each change, `glue:world` in the world), so a
+/// page without the bridge still knows a return to the character list.
+fn signal_glue_screen(
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+    state: Option<Res<State<ClientState>>>,
+    mut last: Local<String>,
+) {
+    let screen = if state.is_some_and(|s| *s.get() == ClientState::InWorld) {
+        "world".to_string()
+    } else {
+        match script.filter(|s| s.vm_kind() == benilla_ui::script::VmKind::Glue) {
+            Some(s) => s.glue_screen(),
+            None => return,
+        }
+    };
+    if *last != screen {
+        crate::webprogress::signal(&format!("glue:{screen}"));
+        crate::loadtrace::glue_screen(&screen);
+        *last = screen;
+    }
+}
+
+pub(crate) struct StartupPacePlugin;
+
+impl Plugin for StartupPacePlugin {
+    fn build(&self, app: &mut App) {
+        app.init_resource::<StartupTimings>()
+            .init_resource::<DeferredLoads>()
+            .init_resource::<QuietLogin>()
+            .init_resource::<HeldWorldEvents>()
+            .add_systems(PreStartup, mark_startup_begin)
+            .add_systems(PostStartup, mark_startup_end)
+            .add_systems(PreUpdate, run_deferred_loads)
+            .add_systems(OnEnter(ClientState::InWorld), drain_on_world_enter)
+            .add_systems(
+                Update,
+                drive_quiet_login.after(crate::ui_script::glue_mgr::drive_glue_mgr),
+            )
+            .add_systems(Last, (report_first_frame, report_first_world_frame))
+            .add_systems(
+                Update,
+                (signal_char_focus, signal_glue_screen, signal_port_focus).run_if(cfg_web),
+            );
+    }
+}
