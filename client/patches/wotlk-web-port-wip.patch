+pub const FARCLIP_RANGE: std::ops::RangeInclusive<f32> = 177.0..=1277.0;
+
+/// The engine's per-map ceiling on the far wall, by `Map.dbc` `ExpansionID`: the classic maps stop
+/// at 791.67 yd and the Burning Crusade and Wrath maps at 1583.33 yd, the two floats 3.3.5a's
+/// far-clip setter clamps against (community-measured on the 12340 executable; not re-derived
+/// here). Data: a row per expansion, the last one standing for any later id.
+pub const FARCLIP_EXPANSION_CAPS: &[f32] = &[2375.0 / 3.0, 4750.0 / 3.0, 4750.0 / 3.0];
+
+/// The far wall's ceiling on a map of `expansion` (`None`: no `Map.dbc` row, or no client data),
+/// never below the slider's floor; an unknown map takes only the CVar's own range.
+pub fn farclip_cap(expansion: Option<u32>) -> f32 {
+    let Some(e) = expansion else {
+        return *FARCLIP_RANGE.end();
+    };
+    let row = (e as usize).min(FARCLIP_EXPANSION_CAPS.len() - 1);
+    FARCLIP_EXPANSION_CAPS[row].max(*FARCLIP_RANGE.start())
+}
+
+/// The player's `farclip`, clamped to [`FARCLIP_RANGE`] but not yet to the map: the CVar keeps
+/// what was asked and [`apply_farclip_cap`] holds [`ViewDistance::farclip`] at
+/// `min(request, cap)`, so leaving a classic map gives the wider wall back.
+#[derive(Resource, Clone, Copy, PartialEq, Debug)]
+pub struct FarclipRequest(pub f32);
+
+impl Default for FarclipRequest {
+    /// [`ViewDistance::default`]'s value, `$WOW_FARCLIP` included.
+    fn default() -> Self {
+        Self(ViewDistance::default().farclip)
+    }
