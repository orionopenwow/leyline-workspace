+      // each new selection.
+      if (WORLD.uiDone && !skipPrefetch) prefetchWorld().catch(() => {});
+    } else if (stage === 'enter') {
+      reconnectOverlay(null);
+      mark('world session started');
+      logMemory('character select, at Enter World');
+      window.__wenilla_phase = 'enter';
+      if (UI_BOOST.add) UI_BOOST.add(UI_PREFETCH_CONCURRENCY);
+    } else if (stage === 'world') {
+      mark('first world frame');
+      reconnectOverlay(null);
+      window.__wenilla_phase = 'world';
