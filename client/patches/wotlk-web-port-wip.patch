+/// The world view's last-resort guard: a non-finite camera or body (a NaN out of a collision or a
+/// snap) draws nothing at all, the frame flat grey while the UI keeps running. Each is put back to
+/// its last finite pose and named once in the log; a map change logs the view it lands with.
+fn guard_non_finite_view(
+    mut cams: Query<(&mut Transform, &Projection), With<benilla_world::view::WorldCamera>>,
+    player: Option<ResMut<Player>>,
+    mut changes: MessageReader<benilla_world::world_map::MapChange>,
+    mut last_cam: Local<Option<Transform>>,
+    mut last_pos: Local<Option<Vec3>>,
+    mut warned: Local<bool>,
+) {
+    let changed = changes.read().count() > 0;
+    if let Some(mut p) = player {
+        if p.pos.is_finite() {
+            *last_pos = Some(p.pos);
+        } else if let Some(good) = *last_pos {
+            if !std::mem::replace(&mut *warned, true) {
+                error!("view: the body's position went non-finite ({:?}) — put back to {good}", p.pos);
+            }
+            p.pos = good;
+        }
+    }
+    for (mut t, proj) in &mut cams {
+        let finite = t.translation.is_finite() && t.rotation.is_finite() && t.scale.is_finite();
+        if finite {
+            *last_cam = Some(*t);
+        } else if let Some(good) = *last_cam {
+            if !std::mem::replace(&mut *warned, true) {
+                error!("view: the world camera went non-finite ({t:?}) — put back");
+            }
+            *t = good;
+        }
+        if changed {
+            let (near, far) = match proj {
+                Projection::Perspective(p) => (p.near, p.far),
+                _ => (f32::NAN, f32::NAN),
+            };
+            info!(
+                "view: after the map change the camera stands at {} (near {near}, far {far}), the \
+                 body at {:?}",
+                t.translation,
+                last_pos.as_ref()
+            );
+        }
+    }
+}
