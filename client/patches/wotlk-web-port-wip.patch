+/// Plays the current roll frame by frame, then reports where it ended.
+fn play_roll(
+    mut golf: ResMut<Golf>,
+    time: Res<Time>,
+    mut transforms: Query<&mut Transform, Without<FlyCam>>,
+    mut commands: Commands,
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+) {
+    let now = time.elapsed_secs();
+    // Holed balls disappear a moment after they drop.
+    let sunk: Vec<String> = golf.balls.iter().filter(|(_, b)| b.sink_at.is_some_and(|t| now >= t)).map(|(n, _)| n.clone()).collect();
+    for n in sunk {
+        if let Some(b) = golf.balls.remove(&n) {
+            commands.entity(b.entity).despawn();
+        }
+    }
+    let Some(roll) = golf.roll.as_ref() else {
+        return;
+    };
+    let frames = &roll.outcome.frames;
+    let f = ((now - roll.start) * golf::TICK_HZ as f32).max(0.0);
+    let i = (f as usize).min(frames.len() - 1);
+    let next = (i + 1).min(frames.len() - 1);
+    let frac = f.fract();
+    let a = frames[i];
+    let b = frames[next];
+    let p = a + (b - a) * frac;
+    let name = roll.name.clone();
+    let done = i + 1 >= frames.len();
+    let world = golf.world(p);
+    if let Some(ball) = golf.balls.get(&name) {
+        if let Ok(mut t) = transforms.get_mut(ball.entity) {
+            t.translation = world;
+        }
+    }
+    if !done {
+        return;
+    }
+    let roll = golf.roll.take().expect("checked above");
+    let o = &roll.outcome;
+    let rest = o.rest;
+    if let Some(ball) = golf.balls.get_mut(&name) {
+        ball.pos = rest;
+        match o.end {
+            End::Holed => ball.sink_at = Some(now + 0.7),
+            e if e.penalty() => {
+                if let Ok(mut t) = transforms.get_mut(ball.entity) {
+                    t.translation = golf.world(rest);
+                }
+            }
+            _ => {}
+        }
+    }
+    if o.end == End::Holed {
+        let at = golf.hole().map(|h| h.cup).unwrap_or(rest);
+        golf.confetti = Some((now, golf.world(at)));
+    }
+    call_hud(
+        script.as_deref(),
+        &format!(
+            "OnRest({}, \"{}\", {:.3}, {:.3}, {:.3}, \"{:016x}\")",
+            lua_str(&name),
+            o.end.word(),
+            rest.x,
+            rest.y,
+            rest.z,
+            o.hash
+        ),
+    );
+}
