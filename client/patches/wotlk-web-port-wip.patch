+    instances.iter().find_map(|inst| {
+        let model = wmos.get(&inst.handle)?;
+        let stem = asset_server
+            .get_path(inst.handle.id())
+            .and_then(|p| wmo_minimap_stem(&p.path().to_string_lossy()))?;
+        if !stem.ends_with("dalaran\\nd_dalaran") {
+            return None;
