diff --git a/crates/benilla-ui/src/script/mirror_timer.rs b/crates/benilla-ui/src/script/mirror_timer.rs
new file mode 100644
index 00000000..2a13b87e
--- /dev/null
+++ b/crates/benilla-ui/src/script/mirror_timer.rs
@@ -0,0 +1,133 @@
+//! The mirror timers' read verbs, `GetMirrorTimerInfo` and `GetMirrorTimerProgress`
+//! (both read-only), over the three slots the app restates from `SMSG_START_MIRROR_TIMER`,
+//! `_PAUSE` and `_STOP` ([`UiScript::set_mirror_timer`]). Stock `MirrorTimer.lua:81-89` reads
+//! every slot at `PLAYER_ENTERING_WORLD` and shows the bar of each one not `"UNKNOWN"`, so a
+//! breath bar survives a `/reload` under water.
+
+use mlua::{Lua, MultiValue, Value};
+
+use super::UiScript;
+
+/// `MIRRORTIMER_NUMTIMERS`: fatigue, breath and feign death, by wire type 0-2.
+pub const MIRROR_TIMER_SLOTS: usize = 3;
+
+/// One running timer as the last edge stated it.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct MirrorTimerView {
+    /// `"EXHAUSTION"`, `"BREATH"` or `"FEIGNDEATH"`.
+    pub name: String,
+    /// Remaining when stated, ms.
+    pub value_ms: i64,
+    pub max_ms: i64,
+    /// The signed rate in ms per ms (`-1` drains, positive refills).
+    pub scale: i64,
+    pub paused: bool,
+    pub label: String,
+}
+
+/// A slot's timer and the `GetTime` it was stated at.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct MirrorTimerSlot {
+    view: MirrorTimerView,
+    at: f64,
+}
+
+impl MirrorTimerSlot {
+    /// The value now: the stated value moved by the rate since, unless paused, within `[0, max]`.
+    fn value_at(&self, now: f64) -> i64 {
+        let v = &self.view;
+        if v.paused {
+            return v.value_ms;
+        }
+        let moved = v.value_ms as f64 + v.scale as f64 * (now - self.at).max(0.0) * 1000.0;
+        (moved.round() as i64).clamp(0, v.max_ms.max(0))
+    }
+}
+
+impl UiScript {
+    /// Restate slot `kind` (the wire type, 0-2) as a `MIRROR_TIMER_START` would, or clear it
+    /// (`None`) as a `MIRROR_TIMER_STOP`; a kind past the three slots is ignored.
+    pub fn set_mirror_timer(&mut self, kind: usize, view: Option<MirrorTimerView>) {
+        let now = self.now();
+        let mut model = self.model_mut();
+        if let Some(slot) = model.mirror_timers.get_mut(kind) {
+            *slot = view.map(|view| MirrorTimerSlot { view, at: now });
+        }
+    }
+
+    /// `MIRROR_TIMER_PAUSE`: freeze or resume slot `kind` at its current value.
+    pub fn pause_mirror_timer(&mut self, kind: usize, paused: bool) {
+        let now = self.now();
+        let mut model = self.model_mut();
+        if let Some(Some(slot)) = model.mirror_timers.get_mut(kind) {
+            slot.view.value_ms = slot.value_at(now);
+            slot.at = now;
+            slot.view.paused = paused;
+        }
+    }
+}
+
+pub(super) fn install(lua: &Lua) -> mlua::Result<()> {
+    let g = lua.globals();
+    // GetMirrorTimerInfo(index) → timer, value, maxvalue, scale, paused, label; an idle slot is
+    // `"UNKNOWN"` with zeros and an empty label, an index outside 1-3 nothing.
+    g.set(
+        "GetMirrorTimerInfo",
+        lua.create_function(|lua, v: Value| {
+            let Some(index) = lua.coerce_number(v)? else {
+                return Err(mlua::Error::runtime("Usage: GetMirrorTimerInfo(index)"));
+            };
+            let index = index as i64;
+            if !(1..=MIRROR_TIMER_SLOTS as i64).contains(&index) {
+                return Ok(MultiValue::new());
+            }
+            let now = super::clock::now(lua);
+            let model = lua
+                .app_data_ref::<crate::script::ModelCell>()
+                .expect("model");
+            let s = |t: &str| lua.create_string(t).map(Value::String);
+            Ok(MultiValue::from_vec(
+                match &model.mirror_timers[index as usize - 1] {
+                    Some(slot) => vec![
+                        s(&slot.view.name)?,
+                        Value::Integer(slot.value_at(now)),
+                        Value::Integer(slot.view.max_ms),
+                        Value::Integer(slot.view.scale),
+                        Value::Integer(i64::from(slot.view.paused)),
+                        s(&slot.view.label)?,
+                    ],
+                    None => vec![
+                        s("UNKNOWN")?,
+                        Value::Integer(0),
+                        Value::Integer(0),
+                        Value::Integer(0),
+                        Value::Integer(0),
+                        s("")?,
+                    ],
+                },
+            ))
+        })?,
+    )?;
+    // GetMirrorTimerProgress(timer) → the running timer's value now, in ms; nothing for a timer
+    // that is not running.
+    g.set(
+        "GetMirrorTimerProgress",
+        lua.create_function(|lua, v: Value| {
+            let Some(name) = lua.coerce_string(v)? else {
+                return Err(mlua::Error::runtime("Usage: GetMirrorTimerProgress(timer)"));
+            };
+            let name = name.to_string_lossy();
+            let now = super::clock::now(lua);
+            let model = lua
+                .app_data_ref::<crate::script::ModelCell>()
+                .expect("model");
+            Ok(model
+                .mirror_timers
+                .iter()
+                .flatten()
+                .find(|slot| slot.view.name == name)
+                .map(|slot| slot.value_at(now)))
+        })?,
+    )?;
+    Ok(())
+}
