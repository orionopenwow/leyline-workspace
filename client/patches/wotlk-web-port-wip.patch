+//! Leyline edit mode: step out of the character into a free-fly building camera.
+//!
+//! F7 (or the Builder window's switch) flips the `leylineEditMode` CVar; this module follows it.
+//! On, the body is parked where it stands and the camera flies free (WASD, Space/C, Ctrl 5×, mouse
+//! to look), the same free fly the client uses before the server places us. The server is told
+//! nothing: building itself goes through the realm's `.build` commands, which check every change.
+//! The camera stays within [`EDIT_RADIUS`] of the body, so edit mode is a building view and not a
+//! way to scout. Off, the camera seats back on the body as usual.
+
+use super::camera::FlyCam;
+use super::Player;
+use crate::cvars::Cvars;
+use bevy::prelude::*;
+
+/// The CVar the Builder window and F7 share; the UI hides itself while it reads `1`.
+pub(crate) const EDIT_CVAR: &str = "leylineEditMode";
+/// How far (yards) the edit camera may go from the parked body.
+pub(crate) const EDIT_RADIUS: f32 = 120.0;
+/// The toggle key. Unbound in the stock 3.3.5a bindings.
+pub(crate) const EDIT_KEY: KeyCode = KeyCode::F7;
+
+/// Whether edit mode is on this frame, for the systems that act differently while building.
+#[derive(Resource, Default, Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) struct EditMode {
+    pub(crate) on: bool,
+}
+
+/// Follows the CVar (and F7) into [`EditMode`] and the free-fly detach. Runs before `control`.
+pub(super) fn sync_edit_mode(
+    keys: Res<ButtonInput<KeyCode>>,
+    capture: Res<crate::ui_script::UiKeyboardCapture>,
+    cvars: Option<ResMut<Cvars>>,
+    mut edit: ResMut<EditMode>,
+    mut player: ResMut<Player>,
+) {
+    let Some(mut cvars) = cvars else {
+        return;
+    };
+    let cvar_on = cvars.flag(EDIT_CVAR).unwrap_or(false);
+    // Not in control of a body (loading, a new character, a session end): edit mode is off, and a
+    // saved `1` from an earlier session must not open the next one in the editor.
+    if !player.active {
+        if cvar_on {
+            let _ = cvars.set(EDIT_CVAR, "0");
+        }
+        if edit.on {
+            edit.on = false;
+        }
+        return;
+    }
+    let mut want = cvar_on;
+    if !capture.typing && keys.just_pressed(EDIT_KEY) {
+        want = !want;
+        let _ = cvars.set(EDIT_CVAR, if want { "1" } else { "0" });
+    }
+    if want != edit.on {
+        edit.on = want;
+        player.detached = want;
+        info!("edit mode {}", if want { "on: free camera, body parked" } else { "off: back in the body" });
+    }
+}
+
+/// Keeps the edit camera within [`EDIT_RADIUS`] of the parked body. Runs after `control`.
+pub(super) fn clamp_edit_camera(
+    edit: Res<EditMode>,
+    player: Res<Player>,
+    mut cam: Query<&mut Transform, With<FlyCam>>,
+) {
+    if !edit.on {
+        return;
+    }
+    let Ok(mut t) = cam.single_mut() else {
+        return;
+    };
+    t.translation = clamp_to(t.translation, player.pos, EDIT_RADIUS);
+}
+
+/// `p` pulled back onto the sphere of `radius` around `centre` when it is outside it.
+fn clamp_to(p: Vec3, centre: Vec3, radius: f32) -> Vec3 {
+    let off = p - centre;
+    if off.length() > radius {
+        centre + off.normalize() * radius
+    } else {
+        p
+    }
+}
+
+/// Grab key: pick up the selected prop and carry it on the cursor; again (or a click) to drop it.
+pub(crate) const GRAB_KEY: KeyCode = KeyCode::KeyG;
+/// Turn the carried prop one angle step left / right.
+pub(crate) const TURN_LEFT: KeyCode = KeyCode::KeyQ;
+pub(crate) const TURN_RIGHT: KeyCode = KeyCode::KeyE;
+/// Put the carried prop back where it was.
+pub(crate) const CANCEL_KEY: KeyCode = KeyCode::Backspace;
+/// Duplicate the selection beside itself.
+pub(crate) const DUPLICATE_KEY: KeyCode = KeyCode::KeyV;
+/// Remove the selection.
+pub(crate) const DELETE_KEY: KeyCode = KeyCode::Delete;
+/// With Ctrl: take back the last change.
+pub(crate) const UNDO_KEY: KeyCode = KeyCode::KeyZ;
+/// The grid and angle steps the HUD's Snap button cycles (`leylineEditGrid`, `leylineEditAngle`).
+pub(crate) const GRID_CVAR: &str = "leylineEditGrid";
+pub(crate) const ANGLE_CVAR: &str = "leylineEditAngle";
+/// One mouse-wheel notch raises or lowers the carried prop this far (yards); Shift turns instead.
+const LIFT_STEP: f32 = 0.25;
+const LIFT_LIMIT: f32 = 20.0;
+
+/// A carry in progress: the pose to put back, the turn so far (degrees) and the lift (yards).
+#[derive(Clone, Copy, Debug)]
+struct Carry {
+    start: Transform,
+    turn: f32,
+    lift: f32,
+}
+
+/// The prop the builder last clicked in edit mode, and the carry in progress.
+#[derive(Resource, Default)]
+pub(crate) struct EditGrab {
+    /// The last clicked GameObject (the server is told to select it; it refuses props not ours).
+    pub(crate) entity: Option<Entity>,
+    pub(crate) guid: Option<u64>,
+    carry: Option<Carry>,
+}
+
+/// The counter part of a GameObject guid, as the realm's `GetGUIDLow` reads it.
+fn guid_counter(guid: u64) -> u64 {
+    guid & 0x00FF_FFFF
+}
+
+/// `v` rounded to the nearest multiple of `step`; unchanged with no step.
+fn snap(v: f32, step: f32) -> f32 {
+    if step > 0.0 {
+        (v / step).round() * step
+    } else {
+        v
+    }
+}
+
+/// A ground point snapped to the grid on the two flat axes (the same grid in WoW's x/y, since
+/// Bevy's x/z are WoW's −y/−x).
+fn snap_flat(p: Vec3, grid: f32) -> Vec3 {
+    Vec3::new(snap(p.x, grid), p.y, snap(p.z, grid))
+}
+
+/// Calls the edit HUD (WrathUnleashedUI's EditMode.lua) if it is loaded.
+fn call_hud(script: Option<&benilla_ui::script::UiScript>, chunk: &str) {
+    if let Some(script) = script {
+        crate::ui_script::run_or_warn(script, chunk);
+    }
+}
+
+fn hud_note(script: Option<&benilla_ui::script::UiScript>, text: &str) {
+    let text = text.replace('\'', "");
+    call_hud(
+        script,
+        &format!("local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Note then E.Note('{text}') end"),
+    );
+}
+
+fn hud_cmd(script: Option<&benilla_ui::script::UiScript>, cmd: &str) {
+    call_hud(
+        script,
+        &format!("local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Cmd then E.Cmd('{cmd}') end"),
+    );
+}
+
+/// Clicks, carry, snap, lift, turn, duplicate, delete and undo while editing. A click hands the
+/// HUD the ground point and the prop under the cursor (it decides: place the prop chosen in the
+/// palette, or select the clicked one). G carries the selection on the cursor: Q/E or Shift+wheel
+/// turn it by the angle step, the wheel lifts it, the grid snaps it, and a click or G drops it
+/// (sent to the realm as an exact place, which it checks); Backspace puts it back. V duplicates,
+/// Delete removes, Ctrl+Z undoes.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn edit_tools(
+    edit: Res<EditMode>,
+    mut clicks: MessageReader<benilla_world::interact::WorldClick>,
+    hovered: Res<crate::target::HoveredObject>,
+    occlusion: Res<crate::target::PickOcclusion>,
+    input: (
+        Res<ButtonInput<KeyCode>>,
+        Res<bevy::input::mouse::AccumulatedMouseScroll>,
+        Res<crate::ui_script::UiKeyboardCapture>,
+    ),
+    cvars: Option<Res<Cvars>>,
+    mut grab: ResMut<EditGrab>,
+    mut transforms: Query<&mut Transform, Without<FlyCam>>,
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+) {
+    let (keys, scroll, capture) = (&input.0, &input.1, &input.2);
+    let script = script.as_deref();
+    if !edit.on {
+        clicks.clear();
+        if let Some(c) = grab.carry.take() {
+            if let Some(mut t) = grab.entity.and_then(|e| transforms.get_mut(e).ok()) {
+                *t = c.start;
+            }
+        }
+        return;
+    }
+    let grid = cvars.as_deref().and_then(|c| c.num(GRID_CVAR)).unwrap_or(0.0).clamp(0.0, 10.0);
+    let angle = cvars.as_deref().and_then(|c| c.num(ANGLE_CVAR)).unwrap_or(15.0).clamp(1.0, 90.0);
+    let typing = capture.typing;
+    let pressed = |k: KeyCode| !typing && keys.just_pressed(k);
+    let held = |k: KeyCode| !typing && keys.pressed(k);
+    let shift = held(KeyCode::ShiftLeft) || held(KeyCode::ShiftRight);
+    let ctrl = held(KeyCode::ControlLeft) || held(KeyCode::ControlRight);
+    let point = occlusion.point;
+    // One notch, whatever the device's unit: only the sign and a whole step count.
+    let notches = if scroll.delta.y > 0.0 {
+        1.0
+    } else if scroll.delta.y < 0.0 {
+        -1.0
+    } else {
+        0.0
+    };
+
+    // Carrying: follow the cursor's ground point, snapped; turn and lift.
+    if let Some(mut c) = grab.carry {
+        if pressed(TURN_LEFT) {
+            c.turn += angle;
+        }
+        if pressed(TURN_RIGHT) {
+            c.turn -= angle;
+        }
+        if notches != 0.0 {
+            if shift {
+                c.turn += angle * notches;
+            } else {
+                c.lift = (c.lift + LIFT_STEP * notches).clamp(-LIFT_LIMIT, LIFT_LIMIT);
+            }
+        }
+        c.turn = snap(c.turn, angle);
+        grab.carry = Some(c);
+        if let Some(mut t) = grab.entity.and_then(|e| transforms.get_mut(e).ok()) {
+            if let Some(p) = point {
+                t.translation = snap_flat(p, grid) + Vec3::Y * c.lift;
+            }
+            t.rotation = Quat::from_rotation_y(c.turn.to_radians()) * c.start.rotation;
+        }
+        if pressed(CANCEL_KEY) {
+            if let Some(mut t) = grab.entity.and_then(|e| transforms.get_mut(e).ok()) {
+                *t = c.start;
+            }
+            grab.carry = None;
+            hud_note(script, "Put back.");
+            clicks.clear();
+            return;
+        }
+        if pressed(GRAB_KEY) || clicks.read().count() > 0 {
+            grab.carry = None;
+            let at = grab
+                .entity
+                .and_then(|e| transforms.get(e).ok())
+                .map(|t| t.translation)
+                .or(point);
+            if let Some(at) = at {
+                let w = benilla_assets::coords::bevy_to_wow(at);
+                call_hud(
+                    script,
+                    &format!(
+                        "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Drop then E.Drop({:.3}, {:.3}, {:.3}, {:.1}) end",
+                        w[0], w[1], w[2], c.turn
+                    ),
+                );
+            }
+        }
+        return;
+    }
+
+    // Not carrying: G picks the selection up; the edit hotkeys act on it.
+    if pressed(GRAB_KEY) {
+        if let Some(t) = grab.entity.and_then(|e| transforms.get(e).ok()) {
+            grab.carry = Some(Carry { start: *t, turn: 0.0, lift: 0.0 });
+            hud_note(
+                script,
+                "Carrying: move the mouse, wheel to lift, Q/E or Shift+wheel to turn, click or G to drop, Backspace to put back.",
+            );
+        } else {
+            hud_note(script, "Click one of your props first, then G to carry it.");
+        }
+    }
+    if pressed(DUPLICATE_KEY) {
+        hud_cmd(script, "dup");
+    }
+    if pressed(DELETE_KEY) {
+        hud_cmd(script, "delete");
+        grab.entity = None;
+        grab.guid = None;
+    }
+    if ctrl && pressed(UNDO_KEY) {
+        hud_cmd(script, "undo");
+    }
+
+    // A click: tell the HUD where (snapped), and which prop (if any) was under the cursor.
+    for _ in clicks.read() {
+        let go = hovered.target.zip(hovered.guid);
+        if let Some((e, g)) = go {
+            grab.entity = Some(e);
+            grab.guid = Some(g);
+        }
+        let pt = point
+            .map(|p| {
+                let w = benilla_assets::coords::bevy_to_wow(snap_flat(p, grid));
+                format!("{:.3}, {:.3}, {:.3}", w[0], w[1], w[2])
+            })
+            .unwrap_or_else(|| "nil, nil, nil".into());
+        let low = go.map_or("nil".to_string(), |(_, g)| guid_counter(g).to_string());
+        call_hud(
+            script,
+            &format!(
+                "local E = WrathUnleashedUI and WrathUnleashedUI.EditMode; if E and E.Clicked then E.Clicked({pt}, {low}) end"
+            ),
+        );
+    }
+}
+
+/// The world-space box around an entity's meshes (itself and every descendant with bounds).
+fn world_bounds(
+    root: Entity,
+    children: &Query<&Children>,
+    bounds: &Query<(&bevy::camera::primitives::Aabb, &GlobalTransform)>,
+) -> Option<(Vec3, Vec3)> {
+    let mut lo = Vec3::splat(f32::MAX);
+    let mut hi = Vec3::splat(f32::MIN);
+    let mut any = false;
+    let mut stack = vec![root];
+    let mut seen = 0;
+    while let Some(e) = stack.pop() {
+        seen += 1;
+        if seen > 512 {
+            break;
+        }
+        if let Ok((aabb, gt)) = bounds.get(e) {
+            let c = Vec3::from(aabb.center);
+            let h = Vec3::from(aabb.half_extents);
+            for i in 0..8 {
+                let corner = c + Vec3::new(
+                    if i & 1 == 0 { -h.x } else { h.x },
+                    if i & 2 == 0 { -h.y } else { h.y },
+                    if i & 4 == 0 { -h.z } else { h.z },
+                );
+                let w = gt.transform_point(corner);
+                lo = lo.min(w);
+                hi = hi.max(w);
+            }
+            any = true;
+        }
+        if let Ok(kids) = children.get(e) {
+            stack.extend(kids.iter());
+        }
+    }
+    any.then_some((lo, hi))
+}
+
+/// Draws the edit view's markers: the selected prop's box, ring and facing arrow (gold, cyan
+/// while carried, with a drop line to the ground under it), the grid around the cursor when
+/// snapping, and a small ring where the cursor meets the ground, which is where a click places.
+pub(super) fn edit_gizmos(
+    edit: Res<EditMode>,
+    grab: Res<EditGrab>,
+    occlusion: Res<crate::target::PickOcclusion>,
+    cvars: Option<Res<Cvars>>,
+    globals: Query<&GlobalTransform>,
+    children: Query<&Children>,
+    bounds: Query<(&bevy::camera::primitives::Aabb, &GlobalTransform)>,
+    mut gizmos: Gizmos,
+) {
+    if !edit.on {
+        return;
+    }
+    let grid = cvars.as_deref().and_then(|c| c.num(GRID_CVAR)).unwrap_or(0.0).clamp(0.0, 10.0);
+    let flat = Quat::from_rotation_arc(Vec3::Z, Vec3::Y);
+    if let Some(p) = occlusion.point {
+        let at = snap_flat(p, grid);
+        gizmos
+            .circle(Isometry3d::new(at + Vec3::Y * 0.05, flat), 0.35, Color::srgba(1.0, 1.0, 1.0, 0.85))
+            .resolution(24);
+        if grid > 0.0 {
+            // A 7x7 patch of the grid around the cursor.
+            let faint = Color::srgba(0.85, 0.9, 1.0, 0.25);
+            let n = 3.0;
+            for i in -3..=3 {
+                let o = i as f32 * grid;
+                gizmos.line(
+                    at + Vec3::new(o, 0.04, -n * grid),
+                    at + Vec3::new(o, 0.04, n * grid),
+                    faint,
+                );
+                gizmos.line(
+                    at + Vec3::new(-n * grid, 0.04, o),
+                    at + Vec3::new(n * grid, 0.04, o),
+                    faint,
+                );
+            }
+        }
+    }
+    let Some(entity) = grab.entity else {
+        return;
+    };
+    let Ok(gt) = globals.get(entity) else {
+        return;
+    };
+    let carrying = grab.carry.is_some();
+    let color = if carrying {
+        Color::srgb(0.22, 0.74, 0.97)
+    } else {
+        Color::srgb(0.89, 0.72, 0.36)
+    };
+    let at = gt.translation();
+    if let Some((lo, hi)) = world_bounds(entity, &children, &bounds) {
+        let centre = (lo + hi) * 0.5;
+        let size = (hi - lo).max(Vec3::splat(0.2));
+        gizmos.cube(Transform::from_translation(centre).with_scale(size), color);
+    }
+    gizmos.circle(Isometry3d::new(at + Vec3::Y * 0.05, flat), 1.4, color).resolution(48);
+    // The prop's facing, flat on the ground.
+    let fwd = (gt.rotation() * Vec3::NEG_Z).with_y(0.0).normalize_or_zero();
+    if fwd != Vec3::ZERO {
+        gizmos.arrow(at + Vec3::Y * 0.1, at + Vec3::Y * 0.1 + fwd * 2.2, color);
+    }
+    // Lifted: a line down to the ground point under it.
+    if let (true, Some(p)) = (carrying, occlusion.point) {
+        if (at.y - p.y).abs() > 0.05 {
+            gizmos.line(at, Vec3::new(at.x, p.y, at.z), Color::srgba(0.22, 0.74, 0.97, 0.6));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_camera_stays_within_the_radius() {
+        let c = Vec3::new(10.0, 0.0, 0.0);
+        assert_eq!(clamp_to(Vec3::new(20.0, 0.0, 0.0), c, 50.0), Vec3::new(20.0, 0.0, 0.0));
+        let far = clamp_to(Vec3::new(210.0, 0.0, 0.0), c, 50.0);
+        assert!((far - Vec3::new(60.0, 0.0, 0.0)).length() < 1e-4);
+    }
+
+    #[test]
+    fn the_grid_snaps_the_flat_axes_only() {
+        assert_eq!(snap_flat(Vec3::new(1.26, 3.3, -0.74), 0.5), Vec3::new(1.5, 3.3, -0.5));
+        assert_eq!(snap_flat(Vec3::new(1.26, 3.3, -0.74), 0.0), Vec3::new(1.26, 3.3, -0.74));
+        assert_eq!(snap(44.0, 15.0), 45.0);
+    }
+
+    #[test]
+    fn the_guid_counter_is_the_low_24_bits() {
+        assert_eq!(guid_counter(0xF110_0007_6D00_1234), 0x00_1234);
+    }
+}
