+/// What [`feed_display_events`] last told a VM, and a change still settling.
+#[derive(Default)]
+pub(crate) struct DisplaySeen {
+    /// The window's logical size and the effective uiScale, as last announced.
+    size: Option<(u32, u32)>,
+    scale: Option<u32>,
+    /// The values awaiting [`DISPLAY_SETTLE_SECS`] of quiet, and since when.
