+                    .units_by_lower
+                    .values()
+                    .any(|u| u.exists && u.guid == g)
+        };
+        let (added, still): (Vec<_>, Vec<_>) = bound
+            .into_iter()
+            .partition(|&(_, g)| plates.waiting.contains(&g) || has_snapshot(g));
+        let waiting: std::collections::HashSet<u64> = still.into_iter().map(|(_, g)| g).collect();
+        if removed.is_empty()
+            && plates.created.is_empty()
+            && added.is_empty()
+            && waiting == plates.waiting
+        {
+            return;
+        }
+        Work {
+            removed,
+            created: plates.created.clone(),
+            added,
+            waiting,
+        }
+    };
+    {
+        let mut model = crate::script::model_mut_of(lua);
+        model.nameplates.created.clear();
+        model.nameplates.waiting = work.waiting;
+    }
+
+    for slot in work.removed {
+        let tok = token(slot);
+        super::tick::fire_event_into(
+            lua,
+            "NAME_PLATE_UNIT_REMOVED",
+            vec![super::ScriptValue::Str(tok)],
+        );
+        let frame = {
+            let mut model = crate::script::model_mut_of(lua);
+            if let Some(g) = model.unit_guids.nameplates.get_mut(slot) {
+                *g = 0;
+            }
+            let table = &mut model.unit_guids.nameplates;
+            while table.last() == Some(&0) {
+                table.pop();
+            }
+            model.nameplates.plates.get(slot).map(|p| p.frame)
+        };
+        if let Some(frame) = frame {
+            mark_token(lua, frame, None);
+        }
+    }
+
+    for frame in work.created {
+        match plate_object(lua, frame) {
+            Ok(obj) => super::tick::fire_event_values(
+                lua,
+                "NAME_PLATE_CREATED",
+                vec![mlua::Value::Table(obj)],
+            ),
+            Err(e) => crate::script::model_mut_of(lua).record_script_error(e.to_string()),
+        }
+    }
+
+    for (slot, guid) in work.added {
+        let frame = {
+            let mut model = crate::script::model_mut_of(lua);
+            // A REMOVED handler may have retired or rebound plates; announce only what holds.
+            if model.nameplates.assigned.get(&guid) != Some(&slot) {
+                continue;
+            }
+            let table = &mut model.unit_guids.nameplates;
+            if table.len() <= slot {
+                table.resize(slot + 1, 0);
+            }
+            table[slot] = guid;
+            model.nameplates.plates[slot].frame
+        };
+        let tok = token(slot);
+        mark_token(lua, frame, Some(&tok));
+        super::tick::fire_event_into(
+            lua,
+            "NAME_PLATE_UNIT_ADDED",
+            vec![super::ScriptValue::Str(tok)],
+        );
+    }
+}
+
+/// `C_NamePlate`, the backport's table: `GetNamePlates()` lists the announced plates in slot
+/// order, and `GetNamePlateForUnit(unit)` answers the plate of whatever unit the token names
+/// (`"target"` as well as `"nameplate3"`), nil when that unit has no announced plate.
+pub(super) fn install_c_nameplate(lua: &Lua) -> mlua::Result<()> {
+    let t = lua.create_table()?;
+    t.set(
+        "GetNamePlates",
+        lua.create_function(|lua, _: mlua::MultiValue| {
+            let frames: Vec<FrameHandle> = {
+                let model = lua
+                    .app_data_ref::<crate::script::ModelCell>()
+                    .expect("model app_data");
+                model
+                    .unit_guids
+                    .nameplates
+                    .iter()
+                    .enumerate()
+                    .filter(|&(_, &g)| g != 0)
+                    .filter_map(|(slot, _)| model.nameplates.plates.get(slot).map(|p| p.frame))
+                    .collect()
+            };
+            let out = lua.create_table()?;
+            for (i, frame) in frames.into_iter().enumerate() {
+                out.raw_set(i + 1, plate_object(lua, frame)?)?;
+            }
+            Ok(out)
+        })?,
+    )?;
+    t.set(
+        "GetNamePlateForUnit",
+        lua.create_function(|lua, (unit, _): (mlua::Value, mlua::MultiValue)| {
+            let unit = super::binding_abi::string_arg(
+                lua,
+                unit,
+                r#"Usage: C_NamePlate.GetNamePlateForUnit("unit")"#,
+            )?;
+            let frame = {
+                let model = lua
+                    .app_data_ref::<crate::script::ModelCell>()
+                    .expect("model app_data");
+                model
+                    .unit_guids
+                    .guid_of(&unit)
+                    .and_then(|g| frame_of_guid(&model, g))
+            };
+            match frame {
+                Some(frame) => Ok(mlua::Value::Table(plate_object(lua, frame)?)),
+                None => Ok(mlua::Value::Nil),
+            }
+        })?,
+    )?;
+    // GetNamePlateByGUID(guid) -> the plate of the unit with that guid, and
+    // GetNamePlateTokenByGUID(guid) -> its `nameplateN`; nil when it has no announced plate.
+    t.set(
+        "GetNamePlateByGUID",
+        lua.create_function(|lua, (guid, _): (mlua::Value, mlua::MultiValue)| {
+            let frame = {
+                let model = lua
+                    .app_data_ref::<crate::script::ModelCell>()
+                    .expect("model app_data");
+                super::backport::parse_guid(&guid).and_then(|g| frame_of_guid(&model, g))
+            };
+            match frame {
+                Some(frame) => Ok(mlua::Value::Table(plate_object(lua, frame)?)),
+                None => Ok(mlua::Value::Nil),
+            }
+        })?,
+    )?;
+    t.set(
+        "GetNamePlateTokenByGUID",
+        lua.create_function(|lua, (guid, _): (mlua::Value, mlua::MultiValue)| {
+            let token = {
+                let model = lua
+                    .app_data_ref::<crate::script::ModelCell>()
+                    .expect("model app_data");
+                super::backport::parse_guid(&guid).and_then(|g| token_of_guid(&model, g))
+            };
+            match token {
+                Some(tok) => Ok(mlua::Value::String(lua.create_string(tok)?)),
+                None => Ok(mlua::Value::Nil),
+            }
+        })?,
+    )?;
+    lua.globals().set("C_NamePlate", t)
+}
