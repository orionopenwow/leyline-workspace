+            .position(|g| {
+                (g.bbox_min[0]..=g.bbox_max[0]).contains(&pw[0])
+                    && (g.bbox_min[1]..=g.bbox_max[1]).contains(&pw[1])
+                    && (g.bbox_min[2]..=g.bbox_max[2]).contains(&pw[2])
+            })
