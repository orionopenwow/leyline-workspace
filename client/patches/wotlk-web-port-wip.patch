index 00000000..9fab88b6
--- /dev/null
+++ b/crates/benilla-mode/src/golf.rs
@@ -0,0 +1,823 @@
+//! Minigolf: course text, and a deterministic ball simulation.
+//!
+//! # Course text
+//!
+//! One instruction per line, `#` starts a comment, numbers in yards and degrees, in the hole's local
+//! frame (x right, y up, z forward; the client places the frame in the world where the session
+//! started). Every hole is played on the same spot: holes replace each other.
+//!
+//! ```text
+//! course Meadow Nine
+//! by WrathUnleashed
+//! hole 2 Straight Start                 # par, then the hole's name
+//! tee  0 0 0                            # ball start, on the surface
+//! cup  0 0 12                           # the cup, on the surface
+//! turf 0 -0.25 6   1.5 0.25 7.5         # block: centre x y z, half sizes x y z, [yaw] [pitch]
+//! sand | ice   (same as turf)           # other ground
+//! wall 1.6 0.15 6  0.1 0.4 7.5          # walls bounce
+//! bump 0 0 6  0.35 0.6                  # round bumper post: base x y z, radius, height (springy)
+//! water 0 -0.2 6  1.5 2                 # hazard: surface height y, half sizes x z; ball in = +1, back
+//! boost 0 0 3  0.6 0.6 0 9              # speed pad: centre, half x z, yaw, speed (yd/s)
+//! spin 0 0.3 8  1.4 0.12 0.12 90        # turning bar: centre, half sizes, degrees per second
+//! slide 0 0.2 8  0.4 0.2 0.1  2 0 3     # sliding block: centre, half sizes, travel x z, seconds
+//! ```
+//!
+//! # Simulation
+//!
+//! [`simulate`] steps the ball at [`TICK_HZ`] from a start position, a [`Shot`] (integer aim and
+//! power) and the session's phase tick (for spinners and sliders) until it rests, drops in the cup,
+//! falls out or hits water. Every client gets the same [`Outcome`], frame for frame.
+
+use crate::detmath::{sin_cos_tenths, Rot, V3};
+
+pub const TICK_HZ: u32 = 120;
+pub const DT: f32 = 1.0 / 120.0;
+/// WoW's own gravity (yd/s²), so the ball falls like everything else in the world.
+pub const GRAVITY: f32 = 19.291_105;
+pub const BALL_R: f32 = 0.11;
+pub const CUP_R: f32 = 0.24;
+/// Launch speed at full power (yd/s) and at zero power.
+pub const MAX_SPEED: f32 = 12.5;
+pub const MIN_SPEED: f32 = 0.45;
+/// A ball over the cup slower than this drops; faster, it lips out.
+pub const SINK_SPEED: f32 = 3.4;
+/// A shot is cut off after this many ticks (20 s) wherever the ball is.
+pub const MAX_TICKS: u32 = TICK_HZ * 20;
+/// Collision passes per tick.
+const SOLVER_PASSES: usize = 4;
+/// Below this approach speed a contact doesn't bounce (no jitter on the ground).
+const BOUNCE_FLOOR: f32 = 0.9;
+/// Ticks of stillness that count as rest.
+const REST_TICKS: u32 = 15;
+/// Speed under which the ball counts as still.
+const REST_SPEED: f32 = 0.03;
+
+pub const MAX_HOLES: usize = 18;
+pub const MAX_PIECES: usize = 160;
+pub const MAX_TEXT: usize = 24 * 1024;
+const MAX_COORD: f32 = 80.0;
+const MAX_HALF: f32 = 40.0;
+
+/// What a piece's surface does to the ball.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Surface {
+    Turf,
+    Sand,
+    Ice,
+    Wall,
+    Bumper,
+}
+
+impl Surface {
+    /// Rolling deceleration (yd/s²) while the ball sits on it.
+    pub fn roll(self) -> f32 {
+        match self {
+            Surface::Turf | Surface::Wall | Surface::Bumper => 1.9,
+            Surface::Sand => 7.5,
+            Surface::Ice => 0.32,
+        }
+    }
+    /// Restitution against it.
+    pub fn bounce(self) -> f32 {
+        match self {
+            Surface::Turf => 0.3,
+            Surface::Sand => 0.05,
+            Surface::Ice => 0.35,
+            Surface::Wall => 0.74,
+            Surface::Bumper => 1.08,
+        }
+    }
+    pub fn word(self) -> &'static str {
+        match self {
+            Surface::Turf => "turf",
+            Surface::Sand => "sand",
+            Surface::Ice => "ice",
+            Surface::Wall => "wall",
+            Surface::Bumper => "bump",
+        }
+    }
+}
+
+/// How a piece moves with the session's phase tick.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Motion {
+    Still,
+    /// Turns about its own vertical axis, degrees per second (any integer, either sign).
+    Spin { deg_per_s: i32 },
+    /// Slides from its centre to centre + `travel` and back, a full cycle every `period` ticks.
+    Slide { travel: V3, period: u32 },
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Shape {
+    /// A box: half sizes, a yaw and a pitch (tenths of a degree).
+    Block { half: V3, yaw_t: i32, pitch_t: i32 },
+    /// An upright cylinder standing on its centre point.
+    Post { r: f32, h: f32 },
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct Piece {
+    pub surface: Surface,
+    pub center: V3,
+    pub shape: Shape,
+    pub motion: Motion,
+}
+
+/// A flat hazard: the ball dropping into it costs a stroke and goes back.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct Water {
+    pub center: V3,
+    pub half_x: f32,
+    pub half_z: f32,
+}
+
+/// A flat pad that pushes the ball along its yaw up to `speed`.
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub struct Boost {
+    pub center: V3,
+    pub half_x: f32,
+    pub half_z: f32,
+    pub yaw_t: i32,
+    pub speed: f32,
+}
+
+#[derive(Clone, PartialEq, Debug, Default)]
+pub struct Hole {
+    pub number: u32,
+    pub name: String,
+    pub par: u32,
+    /// Surface point of the tee; the ball sits [`BALL_R`] above it.
+    pub tee: V3,
+    /// Surface point of the cup.
+    pub cup: V3,
+    pub pieces: Vec<Piece>,
+    pub water: Vec<Water>,
+    pub boosts: Vec<Boost>,
+    /// Lowest piece bottom: below this (less a margin) the ball is out.
+    pub floor: f32,
+}
+
+impl Hole {
+    /// Where the ball rests on the tee.
+    pub fn tee_ball(&self) -> V3 {
+        self.tee + V3::new(0.0, BALL_R, 0.0)
+    }
+}
+
+#[derive(Clone, PartialEq, Debug, Default)]
+pub struct Course {
+    pub title: String,
+    pub author: String,
+    pub holes: Vec<Hole>,
+}
+
+impl Course {
+    pub fn par(&self) -> u32 {
+        self.holes.iter().map(|h| h.par).sum()
+    }
+}
+
+#[derive(Debug, PartialEq, Eq, Clone)]
+pub struct ParseError {
+    pub line: usize,
+    pub message: String,
+}
+
+impl core::fmt::Display for ParseError {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(f, "line {}: {}", self.line, self.message)
+    }
+}
+
+fn err(line: usize, message: impl Into<String>) -> ParseError {
+    ParseError { line, message: message.into() }
+}
+
+/// Degrees (decimal allowed) to whole tenths, through `f64` parse and round (exact for any course).
+fn tenths(word: &str, line: usize) -> Result<i32, ParseError> {
+    let v: f64 = word.parse().map_err(|_| err(line, format!("not a number: {word}")))?;
+    if !v.is_finite() || v.abs() > 3600.0 {
+        return Err(err(line, format!("angle out of range: {word}")));
+    }
+    Ok((v * 10.0).round() as i32)
+}
+
+fn num(word: Option<&&str>, line: usize, what: &str) -> Result<f32, ParseError> {
+    let word = word.ok_or_else(|| err(line, format!("missing {what}")))?;
+    let v: f32 = word.parse().map_err(|_| err(line, format!("{what} is not a number: {word}")))?;
+    if !v.is_finite() || v.abs() > MAX_COORD {
+        return Err(err(line, format!("{what} out of range: {word}")));
+    }
+    Ok(v)
+}
+
+fn half(word: Option<&&str>, line: usize, what: &str) -> Result<f32, ParseError> {
+    let v = num(word, line, what)?;
+    if v <= 0.0 || v > MAX_HALF {
+        return Err(err(line, format!("{what} must be between 0 and {MAX_HALF}")));
+    }
+    Ok(v)
+}
+
+fn point(w: &[&str], at: usize, line: usize) -> Result<V3, ParseError> {
+    Ok(V3::new(num(w.get(at), line, "x")?, num(w.get(at + 1), line, "y")?, num(w.get(at + 2), line, "z")?))
+}
+
+/// Parses course text (see the module docs). Every hole needs a tee, a cup and at least one piece.
+pub fn parse(text: &str) -> Result<Course, ParseError> {
+    if text.len() > MAX_TEXT {
+        return Err(err(0, format!("course text is over {} KB", MAX_TEXT / 1024)));
+    }
+    let mut course = Course::default();
+    let mut have: Vec<(bool, bool)> = Vec::new();
+    for (i, raw) in text.lines().enumerate() {
+        let line = i + 1;
+        let body = raw.split('#').next().unwrap_or("").trim();
+        if body.is_empty() {
+            continue;
+        }
+        let w: Vec<&str> = body.split_whitespace().collect();
+        let rest = || body[w[0].len()..].trim().to_string();
+        let word = w[0].to_ascii_lowercase();
+        if word == "course" {
+            course.title = rest().chars().take(48).collect();
+            continue;
+        }
+        if word == "by" {
+            course.author = rest().chars().take(32).collect();
+            continue;
+        }
+        if word == "hole" {
+            if course.holes.len() >= MAX_HOLES {
+                return Err(err(line, format!("more than {MAX_HOLES} holes")));
+            }
+            let par: u32 = w
+                .get(1)
+                .and_then(|p| p.parse().ok())
+                .filter(|p| (1..=9).contains(p))
+                .ok_or_else(|| err(line, "hole needs a par from 1 to 9"))?;
+            let name: String = w[2.min(w.len())..].join(" ").chars().take(40).collect();
+            let number = course.holes.len() as u32 + 1;
+            course.holes.push(Hole {
+                number,
+                name: if name.is_empty() { format!("Hole {number}") } else { name },
+                par,
+                floor: f32::MAX,
+                ..Hole::default()
+            });
+            have.push((false, false));
+            continue;
+        }
+        let Some(hole) = course.holes.last_mut() else {
+            return Err(err(line, format!("'{}' before the first hole", w[0])));
+        };
+        let flags = have.last_mut().expect("one per hole");
+        let mut piece = |surface: Surface, center: V3, shape: Shape, motion: Motion| -> Result<(), ParseError> {
+            if hole.pieces.len() >= MAX_PIECES {
+                return Err(err(line, format!("more than {MAX_PIECES} pieces in one hole")));
+            }
+            let bottom = match shape {
+                Shape::Block { half, .. } => center.y - half.len(),
+                Shape::Post { .. } => center.y,
+            };
+            hole.floor = hole.floor.min(bottom);
+            hole.pieces.push(Piece { surface, center, shape, motion });
+            Ok(())
+        };
+        match word.as_str() {
+            "tee" => {
+                hole.tee = point(&w, 1, line)?;
+                flags.0 = true;
+            }
+            "cup" => {
+                hole.cup = point(&w, 1, line)?;
+                flags.1 = true;
+            }
+            "turf" | "sand" | "ice" | "wall" => {
+                let surface = match word.as_str() {
+                    "turf" => Surface::Turf,
+                    "sand" => Surface::Sand,
+                    "ice" => Surface::Ice,
+                    _ => Surface::Wall,
+                };
+                let center = point(&w, 1, line)?;
+                let h = V3::new(half(w.get(4), line, "half x")?, half(w.get(5), line, "half y")?, half(w.get(6), line, "half z")?);
+                let yaw_t = w.get(7).map(|s| tenths(s, line)).transpose()?.unwrap_or(0);
+                let pitch_t = w.get(8).map(|s| tenths(s, line)).transpose()?.unwrap_or(0);
+                if pitch_t.abs() > 450 {
+                    return Err(err(line, "pitch is limited to 45 degrees"));
+                }
+                piece(surface, center, Shape::Block { half: h, yaw_t, pitch_t }, Motion::Still)?;
+            }
+            "bump" => {
+                let center = point(&w, 1, line)?;
+                let r = half(w.get(4), line, "radius")?;
+                let h = half(w.get(5), line, "height")?;
+                piece(Surface::Bumper, center, Shape::Post { r, h }, Motion::Still)?;
+            }
+            "spin" => {
+                let center = point(&w, 1, line)?;
+                let h = V3::new(half(w.get(4), line, "half x")?, half(w.get(5), line, "half y")?, half(w.get(6), line, "half z")?);
+                let deg: i32 = w
+                    .get(7)
+                    .and_then(|s| s.parse().ok())
+                    .filter(|d: &i32| d.abs() <= 720)
+                    .ok_or_else(|| err(line, "spin needs whole degrees per second, up to 720"))?;
+                piece(Surface::Wall, center, Shape::Block { half: h, yaw_t: 0, pitch_t: 0 }, Motion::Spin { deg_per_s: deg })?;
+            }
+            "slide" => {
+                let center = point(&w, 1, line)?;
+                let h = V3::new(half(w.get(4), line, "half x")?, half(w.get(5), line, "half y")?, half(w.get(6), line, "half z")?);
+                let travel = V3::new(num(w.get(7), line, "travel x")?, 0.0, num(w.get(8), line, "travel z")?);
+                let secs = num(w.get(9), line, "seconds")?;
+                if !(0.5..=30.0).contains(&secs) {
+                    return Err(err(line, "slide seconds must be between 0.5 and 30"));
+                }
+                // Even, so the half cycle is whole.
+                let period = (((secs as f64) * TICK_HZ as f64 / 2.0).round() as u32) * 2;
+                piece(Surface::Wall, center, Shape::Block { half: h, yaw_t: 0, pitch_t: 0 }, Motion::Slide { travel, period })?;
+            }
+            "water" => {
+                let center = point(&w, 1, line)?;
+                hole.water.push(Water { center, half_x: half(w.get(4), line, "half x")?, half_z: half(w.get(5), line, "half z")? });
+            }
+            "boost" => {
+                let center = point(&w, 1, line)?;
+                let half_x = half(w.get(4), line, "half x")?;
+                let half_z = half(w.get(5), line, "half z")?;
+                let yaw_t = tenths(w.get(6).ok_or_else(|| err(line, "missing yaw"))?, line)?;
+                let speed = num(w.get(7), line, "speed")?;
+                if !(0.5..=MAX_SPEED * 1.5).contains(&speed) {
+                    return Err(err(line, "boost speed out of range"));
+                }
+                hole.boosts.push(Boost { center, half_x, half_z, yaw_t, speed });
+            }
+            other => return Err(err(line, format!("unknown instruction '{other}'"))),
+        }
+    }
+    if course.holes.is_empty() {
+        return Err(err(0, "the course has no holes"));
+    }
+    for (hole, (tee, cup)) in course.holes.iter_mut().zip(have) {
+        if !tee || !cup {
+            return Err(err(0, format!("hole {} needs a tee and a cup", hole.number)));
+        }
+        if hole.pieces.is_empty() {
+            return Err(err(0, format!("hole {} has nothing to roll on", hole.number)));
+        }
+    }
+    if course.title.is_empty() {
+        course.title = "Untitled course".into();
+    }
+    Ok(course)
+}
+
+/// A shot input: aim in tenths of a degree (0 = +z, 900 = +x) and power in permille.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct Shot {
+    pub angle_t: i32,
+    pub power_m: i32,
+}
+
+impl Shot {
+    pub fn clamped(self) -> Shot {
+        Shot { angle_t: self.angle_t.rem_euclid(3600), power_m: self.power_m.clamp(0, 1000) }
+    }
+    /// Launch velocity: power is squared for touch on short putts.
+    pub fn velocity(self) -> V3 {
+        let s = self.clamped();
+        let (sin, cos) = sin_cos_tenths(s.angle_t);
+        let p = s.power_m as f32 / 1000.0;
+        let speed = MIN_SPEED + (MAX_SPEED - MIN_SPEED) * (p * p);
+        V3::new(sin * speed, 0.0, cos * speed)
+    }
+}
+
+/// How a shot ended.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum End {
+    Rest,
+    Holed,
+    /// Fell off the course: one stroke penalty, back to where it was hit from.
+    Out,
+    /// Into water: one stroke penalty, back to where it was hit from.
+    Water,
+    /// Still moving at the time limit: stays where it is.
+    Timeout,
+}
+
+impl End {
+    pub fn word(self) -> &'static str {
+        match self {
+            End::Rest => "rest",
+            End::Holed => "holed",
+            End::Out => "out",
+            End::Water => "water",
+            End::Timeout => "rest",
+        }
+    }
+    pub fn penalty(self) -> bool {
+        matches!(self, End::Out | End::Water)
+    }
+}
+
+#[derive(Clone, PartialEq, Debug)]
+pub struct Outcome {
+    /// The ball's centre, one entry per tick, the start first.
+    pub frames: Vec<V3>,
+    /// Where the next shot is played from.
+    pub rest: V3,
+    pub end: End,
+    pub hash: u64,
+}
+
+/// A piece's pose at a tick: centre, rotation, and the surface velocity at a point.
+struct Pose {
+    center: V3,
+    rot: Rot,
+    /// Linear velocity of the whole piece (slides).
+    vel: V3,
+    /// Angular speed about +y, radians per second (spins).
+    omega: f32,
+}
+
+const RAD_PER_TENTH: f32 = 0.001_745_329_3;
+
+fn pose(piece: &Piece, tick: i64) -> Pose {
+    match (piece.shape, piece.motion) {
+        (Shape::Block { yaw_t, pitch_t, .. }, Motion::Still) => {
+            Pose { center: piece.center, rot: Rot::yaw_pitch(yaw_t, pitch_t), vel: V3::ZERO, omega: 0.0 }
+        }
+        (Shape::Block { yaw_t, .. }, Motion::Spin { deg_per_s }) => {
+            // Whole tenths of a degree at this tick, by integer arithmetic.
+            let ang = (deg_per_s as i64 * 10 * tick).div_euclid(TICK_HZ as i64);
+            let a = (ang.rem_euclid(3600)) as i32 + yaw_t;
+            let omega = (deg_per_s * 10) as f32 * RAD_PER_TENTH;
+            Pose { center: piece.center, rot: Rot::yaw_pitch(a, 0), vel: V3::ZERO, omega }
+        }
+        (Shape::Block { yaw_t, pitch_t, .. }, Motion::Slide { travel, period }) => {
+            let p = period as i64;
+            let halfp = p / 2;
+            let k = tick.rem_euclid(p);
+            let (u, dir) = if k < halfp { (k, 1.0) } else { (p - k, -1.0) };
+            let f = u as f32 / halfp as f32;
+            let rate = dir / (halfp as f32 * DT);
+            Pose {
+                center: piece.center + travel * f,
+                rot: Rot::yaw_pitch(yaw_t, pitch_t),
+                vel: travel * rate,
+                omega: 0.0,
+            }
+        }
+        (Shape::Post { .. }, _) => Pose { center: piece.center, rot: Rot::IDENTITY, vel: V3::ZERO, omega: 0.0 },
+    }
+}
+
+/// The contact of a ball at `p` with a piece in pose: outward normal and depth.
+fn contact(piece: &Piece, pose: &Pose, p: V3) -> Option<(V3, f32)> {
+    match piece.shape {
+        Shape::Block { half, .. } => {
+            let l = pose.rot.unapply(p - pose.center);
+            let q = V3::new(l.x.clamp(-half.x, half.x), l.y.clamp(-half.y, half.y), l.z.clamp(-half.z, half.z));
+            let d = l - q;
+            let dist2 = d.dot(d);
+            if dist2 > BALL_R * BALL_R {
+                return None;
+            }
+            if dist2 > 1e-12 {
+                let dist = dist2.sqrt();
+                let n = pose.rot.apply(d * (1.0 / dist));
+                return Some((n, BALL_R - dist));
+            }
+            // The centre is inside: out through the nearest face.
+            let gaps = [half.x - l.x.abs(), half.y - l.y.abs(), half.z - l.z.abs()];
+            let mut axis = 0;
+            for a in 1..3 {
+                if gaps[a] < gaps[axis] {
+                    axis = a;
+                }
+            }
+            let sign = |v: f32| if v < 0.0 { -1.0 } else { 1.0 };
+            let nl = match axis {
+                0 => V3::new(sign(l.x), 0.0, 0.0),
+                1 => V3::new(0.0, sign(l.y), 0.0),
+                _ => V3::new(0.0, 0.0, sign(l.z)),
+            };
+            Some((pose.rot.apply(nl), gaps[axis] + BALL_R))
+        }
+        Shape::Post { r, h } => {
+            let l = p - pose.center;
+            let rad = l.flat_len();
+            let y = l.y.clamp(0.0, h);
+            let q = if rad > r {
+                V3::new(l.x * (r / rad), y, l.z * (r / rad))
+            } else if l.y > h || l.y < 0.0 {
+                V3::new(l.x, y, l.z)
+            } else if rad > 1e-6 {
+                // Inside the post: push out sideways.
+                let n = V3::new(l.x / rad, 0.0, l.z / rad);
+                return Some((n, r - rad + BALL_R));
+            } else {
+                return Some((V3::new(1.0, 0.0, 0.0), r + BALL_R));
+            };
+            let d = l - q;
+            let dist2 = d.dot(d);
+            if dist2 > BALL_R * BALL_R || dist2 <= 1e-12 {
+                return None;
+            }
+            let dist = dist2.sqrt();
+            Some((d * (1.0 / dist), BALL_R - dist))
+        }
+    }
+}
+
+/// Surface velocity of a moving piece at a world point.
+fn surface_velocity(pose: &Pose, at: V3) -> V3 {
+    if pose.omega != 0.0 {
+        let r = at - pose.center;
+        // ω ŷ × r = (ω r.z, 0, −ω r.x)
+        return V3::new(pose.omega * r.z, 0.0, -pose.omega * r.x) + pose.vel;
+    }
+    pose.vel
+}
+
+fn fnv(hash: &mut u64, word: u32) {
+    for b in word.to_le_bytes() {
+        *hash ^= b as u64;
+        *hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+}
+
+fn over(center: V3, half_x: f32, half_z: f32, p: V3) -> bool {
+    (p.x - center.x).abs() <= half_x && (p.z - center.z).abs() <= half_z
+}
+
+/// Plays one shot from `start` (the ball's centre). `phase` is the session tick at which the shot
+/// was struck (spinners and sliders are where that tick puts them). Deterministic: the same inputs
+/// give the same [`Outcome`] on every platform.
+pub fn simulate(hole: &Hole, start: V3, shot: Shot, phase: i64) -> Outcome {
+    simulate_for(hole, start, shot, phase, MAX_TICKS)
+}
+
+/// [`simulate`] cut off after `max_ticks` (the aim preview plays a short piece of the path).
+pub fn simulate_for(hole: &Hole, start: V3, shot: Shot, phase: i64, max_ticks: u32) -> Outcome {
+    let mut p = start;
+    let mut v = shot.velocity();
+    let mut frames = Vec::with_capacity(512);
+    frames.push(p);
+    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
+    let mut still = 0;
+    let mut end = End::Timeout;
+    let mut rest = p;
+    let low = hole.floor.min(hole.cup.y) - 3.0;
+    let cap = MAX_SPEED * 1.6;
+    for tick in 1..=max_ticks {
+        let now = phase + tick as i64;
+        v.y -= GRAVITY * DT;
+        p += v * DT;
+
+        // Boost pads push along their yaw while the ball is on them.
+        for b in &hole.boosts {
+            if over(b.center, b.half_x, b.half_z, p) && (p.y - (b.center.y + BALL_R)).abs() < 0.08 {
+                let (s, c) = sin_cos_tenths(b.yaw_t);
+                let dir = V3::new(s, 0.0, c);
+                let along = v.dot(dir);
+                if along < b.speed {
+                    v += dir * ((b.speed - along).min(40.0 * DT));
+                }
+            }
+        }
+
+        let mut ground: Option<(V3, Surface)> = None;
+        for _ in 0..SOLVER_PASSES {
+            let mut touched = false;
+            for piece in &hole.pieces {
+                let pose = pose(piece, now);
+                let Some((n, depth)) = contact(piece, &pose, p) else {
+                    continue;
+                };
+                touched = true;
+                p += n * depth;
+                let sv = surface_velocity(&pose, p - n * BALL_R);
+                let rel = v - sv;
+                let vn = rel.dot(n);
+                if vn < 0.0 {
+                    let e = if -vn < BOUNCE_FLOOR { 0.0 } else { piece.surface.bounce() };
+                    v -= n * ((1.0 + e) * vn);
+                }
+                if n.y > 0.55 && ground.is_none_or(|(g, _)| n.y > g.y) {
+                    ground = Some((n, piece.surface));
+                }
+            }
+            if !touched {
+                break;
+            }
+        }
+
+        // Rolling resistance, and rest on a slope that can't keep the ball going.
+        if let Some((n, surface)) = ground {
+            let vt = v - n * v.dot(n);
+            let speed = vt.len();
+            let decel = surface.roll() * DT;
+            let slope = GRAVITY * (1.0 - n.y * n.y).max(0.0).sqrt();
+            if speed <= decel {
+                if slope < surface.roll() {
+                    v = V3::ZERO;
+                } else {
+                    v -= vt;
+                }
+            } else {
+                v -= vt * (decel / speed);
+            }
+        }
+
+        // The cup: slow enough over it, the ball drops; near it, the lip pulls a little.
+        let to_cup = V3::new(hole.cup.x - p.x, 0.0, hole.cup.z - p.z);
+        let d = to_cup.flat_len();
+        let level = p.y - (hole.cup.y + BALL_R);
+        if level.abs() < 0.12 {
+            let flat_speed = v.flat_len();
+            if d < CUP_R && flat_speed < SINK_SPEED {
+                end = End::Holed;
+                // A short drop into the cup for the frames, then done.
+                let sink = hole.cup + V3::new(0.0, BALL_R - 0.2, 0.0);
+                for k in 1..=12u32 {
+                    let f = k as f32 / 12.0;
+                    let q = p + (sink - p) * f;
+                    frames.push(q);
+                    for w in q.bits() {
+                        fnv(&mut hash, w);
+                    }
+                }
+                rest = hole.cup;
+                break;
+            }
+            if d < CUP_R * 1.6 && d > 1e-4 && flat_speed < SINK_SPEED * 1.4 {
+                v += to_cup * (2.4 * DT / d);
+            }
+        }
+
+        if v.len() > cap {
+            v = v * (cap / v.len());
+        }
+
+        frames.push(p);
+        for w in p.bits() {
+            fnv(&mut hash, w);
+        }
+
+        if hole.water.iter().any(|w| over(w.center, w.half_x, w.half_z, p) && p.y < w.center.y + BALL_R * 0.5) {
+            end = End::Water;
+            rest = start;
+            break;
+        }
+        if p.y < low {
+            end = End::Out;
+            rest = start;
+            break;
+        }
+        if ground.is_some() && v.len() < REST_SPEED {
+            still += 1;
+            if still >= REST_TICKS {
+                end = End::Rest;
+                rest = p;
+                break;
+            }
+        } else {
+            still = 0;
+        }
+        rest = p;
+    }
+    fnv(&mut hash, frames.len() as u32);
+    fnv(&mut hash, end as u32);
+    Outcome { frames, rest, end, hash }
+}
+
+/// The aim that points straight from `from` at the cup, in whole tenths (a starting aim only).
+pub fn aim_at_cup(hole: &Hole, from: V3) -> i32 {
+    let dx = (hole.cup.x - from.x) as f64;
+    let dz = (hole.cup.z - from.z) as f64;
+    let a = dx.atan2(dz).to_degrees() * 10.0;
+    (a.round() as i32).rem_euclid(3600)
+}
+
+/// A fingerprint of 72 shots across the shipped course (every hole, many aims, powers and phases),
+/// for checking that a platform simulates bit-identically: the native tests pin its value.
+pub fn fingerprint() -> u64 {
+    let c = parse(MEADOW_NINE).expect("the shipped course parses");
+    let mut all: u64 = 0;
+    for (i, h) in c.holes.iter().enumerate() {
+        for k in 0..8 {
+            let shot = Shot { angle_t: (i as i32 * 131 + k * 457) % 3600, power_m: 150 + k * 110 };
+            all ^= simulate(h, h.tee_ball(), shot, k as i64 * 97).hash.rotate_left(k as u32 + i as u32);
+        }
+    }
+    all
+}
+
+/// The first-party course the client ships for practice and the realm offers by default.
+pub const MEADOW_NINE: &str = include_str!("../courses/meadow-nine.course");
