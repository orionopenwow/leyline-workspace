diff --git a/crates/benilla-app/src/ui_window.rs b/crates/benilla-app/src/ui_window.rs
new file mode 100644
index 00000000..65fa76ad
--- /dev/null
+++ b/crates/benilla-app/src/ui_window.rs
@@ -0,0 +1,156 @@
+//! The platform half of the backport's window calls (`benilla_ui::script::WindowCaps`): which of
+//! `FlashWindow`, `IsWindowFocused`, `FocusWindow` and `CopyToClipboard` this build really does,
+//! declared once per VM, the focus pushed each frame, and the queued requests carried out.
+//!
+//! - Desktop: the attention request is winit's `request_user_attention` (taskbar flash, dock
+//!   bounce), focus is Bevy's `Window::focused` write (which winit's `focus_window` carries out),
+//!   and the copy goes through the EditBox's own pasteboard ([`HostClipboard`]).
+//! - Browser: the attention request flashes the tab title until the page has focus again, focus
+//!   is the canvas's, and the copy is `navigator.clipboard.writeText`.
+
+use bevy::prelude::*;
+use bevy::window::{PrimaryWindow, RawHandleWrapper};
+
+use benilla_ui::script::{UiScript, WindowCaps, WindowRequest};
+
+use crate::textinput::HostClipboard;
+
+pub(crate) struct UiWindowPlugin;
+
+impl Plugin for UiWindowPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(Update, drive_window_calls.after(crate::ui_script::UiInput));
+    }
+}
+
+/// What this build's platform layer does: everything, on both targets.
+const CAPS: WindowCaps = WindowCaps {
+    flash: true,
+    focused: true,
+    focus: true,
+    clipboard: true,
+};
+
+fn drive_window_calls(
+    script: Option<NonSend<UiScript>>,
+    mut windows: Query<(Entity, &mut Window, Option<&RawHandleWrapper>), With<PrimaryWindow>>,
+    mut clipboard: Option<NonSendMut<HostClipboard>>,
+    mut seated: Local<crate::ui_script::VmMemo<bool>>,
+    mut flashing: Local<bool>,
+) {
+    let Some(script) = script else {
+        return;
+    };
+    let Ok((entity, mut window, handle)) = windows.single_mut() else {
+        return;
+    };
+    let done = seated.get(&script);
+    if !*done {
+        if let Err(e) = script.set_window_caps(CAPS) {
+            warn!("ui_window: declaring the window calls: {e}");
+        }
+        *done = true;
+    }
+    let focused = window.focused;
+    script.set_window_focused(focused);
+    if focused && *flashing {
+        *flashing = false;
+        web::stop_flash();
+    }
+    for request in script.take_window_requests() {
+        match request {
+            WindowRequest::Flash => {
+                if !focused {
+                    *flashing = true;
+                    flash(entity);
+                }
+            }
+            WindowRequest::Focus => {
+                if !window.focused {
+                    window.focused = true;
+                }
+            }
+            WindowRequest::Copy(text) => {
+                if let Some(clipboard) = clipboard.as_deref_mut() {
+                    copy(clipboard, handle, &text);
+                }
+            }
+        }
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn flash(entity: Entity) {
+    bevy::winit::WINIT_WINDOWS.with_borrow(|w| {
+        if let Some(window) = w.get_window(entity) {
+            window.request_user_attention(Some(winit::window::UserAttentionType::Informational));
+        }
+    });
+}
+
+#[cfg(target_arch = "wasm32")]
+fn flash(_entity: Entity) {
+    web::start_flash();
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn copy(clipboard: &mut HostClipboard, handle: Option<&RawHandleWrapper>, text: &str) {
+    clipboard.write(crate::textinput::wayland_display(handle), text);
+}
+
+#[cfg(target_arch = "wasm32")]
+fn copy(_clipboard: &mut HostClipboard, _handle: Option<&RawHandleWrapper>, text: &str) {
+    web::write_clipboard(text);
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+mod web {
+    pub(super) fn stop_flash() {}
+}
+
+/// The page's title and clipboard, through `js-sys` reflection as the bridge reads the page.
+#[cfg(target_arch = "wasm32")]
+mod web {
+    use js_sys::{Function, Reflect};
+    use wasm_bindgen::{JsCast, JsValue};
+
+    const MARK: &str = "(!) ";
+
+    fn get(obj: &JsValue, key: &str) -> Option<JsValue> {
+        Reflect::get(obj, &JsValue::from_str(key))
+            .ok()
+            .filter(|v| !v.is_undefined() && !v.is_null())
+    }
+
+    fn document() -> Option<JsValue> {
+        get(&js_sys::global(), "document")
+    }
+
+    pub(super) fn start_flash() {
+        let Some(doc) = document() else { return };
+        let title = get(&doc, "title").and_then(|t| t.as_string()).unwrap_or_default();
+        if !title.starts_with(MARK) {
+            let _ = Reflect::set(&doc, &"title".into(), &format!("{MARK}{title}").into());
+        }
+    }
+
+    pub(super) fn stop_flash() {
+        let Some(doc) = document() else { return };
+        if let Some(title) = get(&doc, "title").and_then(|t| t.as_string()) {
+            if let Some(rest) = title.strip_prefix(MARK) {
+                let _ = Reflect::set(&doc, &"title".into(), &rest.into());
+            }
+        }
+    }
+
+    pub(super) fn write_clipboard(text: &str) {
+        let Some(clip) = get(&js_sys::global(), "navigator").and_then(|n| get(&n, "clipboard"))
+        else {
+            return;
+        };
+        if let Some(write) = get(&clip, "writeText").and_then(|f| f.dyn_into::<Function>().ok()) {
+            // A promise; a refusal (no focus, no permission) is the page's to report.
+            let _ = write.call1(&clip, &JsValue::from_str(text));
+        }
+    }
+}
