+/// What can go wrong fetching one asset over the web host's Data URL scheme — collapsed to the two
+/// shapes [`MpqAssetReader::read_bytes`] cares about: "the asset genuinely isn't there" (a 404, which
+/// Bevy needs as [`AssetReaderError::NotFound`] to fall back to default meta / report a load
+/// error cleanly) versus everything else (network failure, a non-`Response` from `fetch`, a body
+/// read that failed), which is a plain I/O error.
+#[cfg(target_arch = "wasm32")]
+enum WasmFetchError {
+    NotFound,
+    Other(String),
+}
+
+/// One `GET` of `url` via the browser's async `fetch`, used only from the wasm
+/// `MpqAssetReader::read_bytes` above. `Chain::read` uses a *synchronous* `XMLHttpRequest` on the
+/// page instead, because it is called from ~60 non-async call sites; this path has no such
+/// constraint — `AssetReader` is `async fn` on every target — so it uses the ordinary async
+/// `fetch`/`Response::array_buffer` pair rather than sync XHR's
+/// `text/plain; charset=x-user-defined` byte-smuggling trick.
+#[cfg(target_arch = "wasm32")]
