+/// The modern look: the 1.12 regions and health bar first (region 1 still the border path addons
+/// identify a plate by, hidden), then the flat border and the dragon; the cast bar is the second
+/// child, shown with the cast's progress and icon, and hidden again on the plate's reuse.
+#[test]
+fn the_modern_plate_keeps_the_abi_and_draws_its_cast_and_dragon() {
+    let mut s = vm();
+    let g = PlateGeometry {
+        modern: true,
+        width: 112.0,
+        height: 14.0,
+        bar_width: 110.0,
+        bar_height: 12.0,
+        ..geometry()
+    };
+    let mut wolf = plate("Wolf", 30.0, 40.0);
+    wolf.elite = true;
+    wolf.target = true;
+    wolf.cast = Some(crate::script::PlateCast {
+        progress: 0.25,
+        icon: Some("Interface\\Icons\\Spell_Fire_Fireball02".into()),
+        channel: false,
+    });
+    s.sync_nameplates(g, &[wolf]);
+    s.resolve();
+    let got: (i64, i64, String, bool, f64, f64, f64, bool) = s
+        .eval(
+            r#"
+            local p = WorldFrame:GetChildren()
+            local border = p:GetRegions()
+            local _, cast = p:GetChildren()
+            local health = select(1, p:GetChildren())
+            return p:GetNumRegions(), p:GetNumChildren(), border:GetTexture(),
+                border:IsShown() == 1, health:GetWidth(), health:GetHeight(), cast:GetValue(),
+                cast:IsShown() == 1
+        "#,
+        )
+        .unwrap();
+    assert_eq!(got.0, 8, "six 1.12 regions, then the flat border and the dragon");
+    assert_eq!(got.1, 2, "the health bar, then the cast bar");
+    assert_eq!(got.2, "Interface\\Tooltips\\Nameplate-Border");
+    assert!(!got.3, "the stock border art is hidden under the modern look");
+    assert_eq!((got.4, got.5), (110.0, 12.0), "the 110x12 bar");
+    assert!((got.6 - 0.25).abs() < 1e-6 && got.7, "the cast shows its progress");
+    let dragon: bool = s
+        .eval("local p = WorldFrame:GetChildren() return select(8, p:GetRegions()):IsShown() == 1")
+        .unwrap();
+    assert!(dragon, "an elite shows the dragon");
+
+    // The unit leaves and another takes the plate: no stale cast bar.
+    s.sync_nameplates(g, &[]);
+    s.sync_nameplates(g, &[plate("Bear", 10.0, 90.0)]);
+    s.resolve();
+    let cast_shown: bool = s
+        .eval("local p = WorldFrame:GetChildren() local _, c = p:GetChildren() return c:IsShown() == 1")
+        .unwrap();
+    assert!(!cast_shown);
+}
diff --git a/crates/benilla-ui/src/script/tests/nameplate_api.rs b/crates/benilla-ui/src/script/tests/nameplate_api.rs
new file mode 100644
index 00000000..e289ef64
--- /dev/null
+++ b/crates/benilla-ui/src/script/tests/nameplate_api.rs
@@ -0,0 +1,281 @@
+//! The awesome_wotlk nameplate backport as a plate addon uses it: `NAME_PLATE_CREATED`,
+//! `NAME_PLATE_UNIT_ADDED`/`_REMOVED` with `nameplateN`, the `Unit*` getters on that token, and
+//! `C_NamePlate`.
+
+use std::collections::HashMap;
+
+use crate::script::{PlateGeometry, PlateState, UiScript, UnitGuids, UnitState};
+
+const ME: u64 = 0x10;
+const WOLF: u64 = 0xF130_0000_0000_0001;
+const BEAR: u64 = 0xF130_0000_0000_0002;
+const BOAR: u64 = 0xF130_0000_0000_0003;
+
+fn vm() -> UiScript {
+    let mut s = UiScript::new().unwrap();
+    s.set_screen_size(1024.0, 768.0);
+    s.run(r#"WorldFrame = CreateFrame("WorldFrame", "WorldFrame") WorldFrame:SetAllPoints()"#)
+        .unwrap();
+    s.resolve();
+    s
+}
+
+fn geometry() -> PlateGeometry {
+    PlateGeometry {
+        modern: false,
+        border: 1.0,
+        cast_height: 6.0,
+        elite_size: 14.0,
+        width: 128.0,
+        height: 32.0,
+        bar_off_x: 4.0,
+        bar_off_y: 4.0,
+        bar_width: 103.0,
+        bar_height: 9.0,
+        level_off_x: 11.8,
+        level_off_y: 9.1,
+        skull_size: 12.8,
+        raid_size: 25.6,
+        name_height: 12.8,
+        level_height: 11.0,
+        shadow_offset: 1.0,
+    }
+}
+
+fn plate(guid: u64, name: &str) -> PlateState {
+    PlateState {
+        target: false,
+        elite: false,
+        cast: None,
+        key: guid,
+        top_centre: (500.0, 400.0),
+        health: 30.0,
+        max_health: 40.0,
+        bar_colour: [1.0, 0.0, 0.0],
+        name: name.to_string(),
+        level: Some(12),
+        skull: false,
+        level_colour: [1.0, 1.0, 0.0],
+        raid_icon: None,
+        alpha: 1.0,
+        lit: false,
+        hovered: false,
+    }
+}
+
+fn unit(guid: u64, name: &str, health: u32) -> UnitState {
+    UnitState {
+        exists: true,
+        has_object: true,
+        guid,
+        name: Some(name.into()),
+        health,
+        max_health: 1000,
+        level: 12,
+        ..Default::default()
+    }
+}
+
+/// An addon in the backport's idiom: it records every event with what the getters and
+/// `C_NamePlate` answer for the token at that moment.
+const ADDON: &str = r#"
+    LOG = {}
+    CREATED = {}
+    local f = CreateFrame("Frame")
+    f:RegisterEvent("NAME_PLATE_CREATED")
+    f:RegisterEvent("NAME_PLATE_UNIT_ADDED")
+    f:RegisterEvent("NAME_PLATE_UNIT_REMOVED")
+    f:RegisterEvent("UNIT_HEALTH")
+    f:SetScript("OnEvent", function(self, event, arg)
+        if event == "NAME_PLATE_CREATED" then
+            table.insert(CREATED, arg)
+            return
+        end
+        local plate = C_NamePlate.GetNamePlateForUnit(arg)
+        table.insert(LOG, table.concat({
+            event, tostring(arg), tostring(UnitName(arg)), tostring(UnitHealth(arg)),
+            tostring(UnitGUID(arg)), tostring(plate ~= nil),
+            tostring(plate ~= nil and plate.namePlateUnitToken == arg),
+        }, " "))
+    end)
+"#;
+
+fn log(s: &UiScript) -> Vec<String> {
+    s.eval("local out = LOG LOG = {} return out").unwrap()
+}
+
+/// Bind `units` to plates and push their by-guid snapshots, the way one app frame does.
+fn frame(s: &mut UiScript, units: &[(u64, &str)]) {
+    for &(g, name) in units {
+        s.set_unit_by_guid(g, Some(unit(g, name, 500)));
+    }
+    let states: Vec<PlateState> = units.iter().map(|&(g, n)| plate(g, n)).collect();
+    s.sync_nameplates(geometry(), &states);
+    s.resolve();
+}
+
+#[test]
+fn an_addon_sees_plates_arrive_answer_and_leave() {
+    let mut s = vm();
+    s.set_unit_guids(&UnitGuids {
+        player: ME,
+        target: BEAR,
+        held: HashMap::from([(ME, BEAR), (WOLF, 0), (BEAR, 0)]),
+        ..Default::default()
+    });
+    s.set_unit("target", Some(unit(BEAR, "Bear", 500)));
+    s.run(ADDON).unwrap();
+
+    frame(&mut s, &[(WOLF, "Wolf"), (BEAR, "Bear")]);
+    assert_eq!(
+        log(&s),
+        [
+            "NAME_PLATE_UNIT_ADDED nameplate1 Wolf 500 0xF130000000000001 true true",
+            "NAME_PLATE_UNIT_ADDED nameplate2 Bear 500 0xF130000000000002 true true",
+        ]
+    );
+    // Each plate built fires NAME_PLATE_CREATED once, with the plate frame itself.
+    assert!(s
+        .eval::<bool>(
+            "local a, b = WorldFrame:GetChildren() \
+             return #CREATED == 2 and CREATED[1] == a and CREATED[2] == b"
+        )
+        .unwrap());
+
+    // The getters and C_NamePlate on the tokens outside any handler.
+    assert_eq!(
+        s.eval::<String>(r#"return UnitName("nameplate1")"#)
+            .unwrap(),
+        "Wolf"
+    );
+    assert_eq!(
+        s.eval::<String>(r#"return UnitName("NamePlate2")"#)
+            .unwrap(),
+        "Bear"
+    );
+    assert!(s
+        .eval::<bool>(
+            r#"return UnitExists("nameplate1") == 1 and UnitIsUnit("nameplate2", "target") == 1"#
+        )
+        .unwrap());
+    assert!(s
+        .eval::<bool>(
+            r#"local a, b = WorldFrame:GetChildren()
+               local plates = C_NamePlate.GetNamePlates()
+               return #plates == 2 and plates[1] == a and plates[2] == b
+                  and C_NamePlate.GetNamePlateForUnit("nameplate1") == a
+                  and C_NamePlate.GetNamePlateForUnit("target") == b
+                  and C_NamePlate.GetNamePlateForUnit("player") == nil
+                  and C_NamePlate.GetNamePlateForUnit("nameplate3") == nil"#
+        )
+        .unwrap());
+
+    // A moved health on a plate unit fires UNIT_HEALTH for its token.
+    s.set_unit_by_guid(WOLF, Some(unit(WOLF, "Wolf", 120)));
+    assert_eq!(
+        log(&s),
+        ["UNIT_HEALTH nameplate1 Wolf 120 0xF130000000000001 true true"]
+    );
+
+    // The wolf leaves: REMOVED fires while its token still names it, then the token is empty.
+    frame(&mut s, &[(BEAR, "Bear")]);
+    assert_eq!(
+        log(&s),
+        ["NAME_PLATE_UNIT_REMOVED nameplate1 Wolf 120 0xF130000000000001 true true"]
+    );
+    assert!(s
+        .eval::<bool>(
+            r#"local a, b = WorldFrame:GetChildren()
+               local plates = C_NamePlate.GetNamePlates()
+               return UnitExists("nameplate1") == nil and UnitName("nameplate1") == nil
+                  and #plates == 1 and plates[1] == b and a.namePlateUnitToken == nil
+                  and C_NamePlate.GetNamePlateForUnit("nameplate2") == b"#
+        )
+        .unwrap());
+
+    // A new unit takes the pooled plate and its token back; no plate is built, none created.
+    frame(&mut s, &[(BEAR, "Bear"), (BOAR, "Boar")]);
+    assert_eq!(
+        log(&s),
+        ["NAME_PLATE_UNIT_ADDED nameplate1 Boar 500 0xF130000000000003 true true"]
+    );
+    assert_eq!(s.eval::<i64>("return #CREATED").unwrap(), 2);
+
+    // Plates off: every announced unit is removed.
+    s.retire_nameplates();
+    assert_eq!(
+        log(&s),
+        [
+            "NAME_PLATE_UNIT_REMOVED nameplate1 Boar 500 0xF130000000000003 true true",
+            "NAME_PLATE_UNIT_REMOVED nameplate2 Bear 500 0xF130000000000002 true true",
+        ]
+    );
+    assert_eq!(
+        s.eval::<i64>("return #C_NamePlate.GetNamePlates()")
+            .unwrap(),
+        0
+    );
+}
+
+/// A unit bound before its snapshot arrives is announced on the next sync, not before: the
+/// host's by-guid feed lists it from [`UiScript::chain_end_guids`] in between.
+#[test]
+fn a_unit_waits_one_sync_for_its_snapshot() {
+    let mut s = vm();
+    s.run(ADDON).unwrap();
+    s.sync_nameplates(geometry(), &[plate(WOLF, "Wolf")]);
+    assert!(log(&s).is_empty(), "no snapshot yet, no announcement");
+    assert!(
+        s.chain_end_guids().contains(&WOLF),
+        "the feed is asked for it"
+    );
+    assert_eq!(s.nameplate_unit_guids(), [WOLF]);
+    assert!(s.nameplate_token_guids().is_empty());
+
+    s.set_unit_by_guid(WOLF, Some(unit(WOLF, "Wolf", 500)));
+    s.sync_nameplates(geometry(), &[plate(WOLF, "Wolf")]);
+    assert_eq!(
+        log(&s),
+        ["NAME_PLATE_UNIT_ADDED nameplate1 Wolf 500 0xF130000000000001 true true"]
+    );
+    assert_eq!(s.nameplate_token_guids(), [WOLF]);
+    assert_eq!(s.unit_tokens(WOLF), ["nameplate1"]);
+
+    // A unit that never gets one is still announced a sync later.
+    s.sync_nameplates(geometry(), &[plate(WOLF, "Wolf"), plate(BEAR, "Bear")]);
+    assert!(log(&s).is_empty());
+    s.sync_nameplates(geometry(), &[plate(WOLF, "Wolf"), plate(BEAR, "Bear")]);
+    assert_eq!(
+        log(&s),
+        ["NAME_PLATE_UNIT_ADDED nameplate2 nil 0 0xF130000000000002 true true"]
+    );
+}
+
+/// A plate pushed and gone before it was announced fires nothing.
+#[test]
+fn a_plate_gone_before_its_announcement_fires_nothing() {
+    let mut s = vm();
+    s.run(ADDON).unwrap();
+    s.sync_nameplates(geometry(), &[plate(WOLF, "Wolf")]);
+    s.sync_nameplates(geometry(), &[]);
+    s.sync_nameplates(geometry(), &[]);
+    assert!(log(&s).is_empty());
+    assert!(s.nameplate_unit_guids().is_empty());
+}
+
+/// The getters on a bad call: `GetNamePlateForUnit` takes a string token.
+#[test]
+fn get_name_plate_for_unit_wants_a_token() {
+    let s = vm();
+    let err = s
+        .eval::<mlua::Value>("return C_NamePlate.GetNamePlateForUnit()")
+        .unwrap_err()
+        .to_string();
+    assert!(
+        err.contains("Usage: C_NamePlate.GetNamePlateForUnit"),
+        "{err}"
+    );
+    assert!(s
+        .eval::<bool>(r#"return C_NamePlate.GetNamePlateForUnit("bogus") == nil"#)
+        .unwrap());
+}
