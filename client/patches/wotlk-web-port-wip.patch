@@ -0,0 +1,51 @@
+//! `IsProtected`: `isProtected, isExplicit`, each 1 or nil.
+//!
+//! A frame is explicitly protected by XML alone (`protected="true"`, on the element or an
+//! inherited template such as `SecureFrameTemplate`); Lua has no setter. It is protected when it
+//! is explicit or has an explicitly protected descendant, since moving or hiding it moves or hides
+//! that descendant. Anchor-borne protection is not tracked: benilla has no combat lockdown that
+//! would act on it. A texture or font string answers its owner frame's protection, never explicit.
+
+use mlua::{Lua, MultiValue, Table, Value};
+
+use crate::script::region_map::{set_shared, Side};
+use crate::script::Model;
+use crate::widget::FrameHandle;
+
+/// Whether `h` or any frame under it is explicitly protected.
+fn protected_tree(model: &Model, h: FrameHandle) -> bool {
+    let Some(f) = model.arena.frame(h) else {
+        return false;
+    };
+    f.protected || f.children.iter().any(|&c| protected_tree(model, c))
+}
+
+fn answer(protected: bool, explicit: bool) -> MultiValue {
+    let flag = |b: bool| if b { Value::Integer(1) } else { Value::Nil };
+    MultiValue::from_vec(vec![flag(protected), flag(explicit)])
+}
+
+/// Register `IsProtected` for `side`'s method table.
+pub(in crate::script) fn install(lua: &Lua, m: &Table, side: Side) -> mlua::Result<()> {
+    match side {
+        Side::Frame => set_shared(lua, m, side, "IsProtected", |lua, this: Table| {
+            let h = super::frame_handle_of(lua, &this)?;
+            let model = lua
+                .app_data_ref::<crate::script::ModelCell>()
+                .expect("model");
+            let explicit = model.arena.frame(h).is_some_and(|f| f.protected);
+            Ok(answer(explicit || protected_tree(&model, h), explicit))
+        }),
+        Side::Region => set_shared(lua, m, side, "IsProtected", |lua, this: Table| {
+            let rh = crate::script::region::region_handle_of(lua, &this)?;
+            let model = lua
+                .app_data_ref::<crate::script::ModelCell>()
+                .expect("model");
+            let owner = model.arena.region(rh).map(|r| r.owner);
+            Ok(answer(
+                owner.is_some_and(|o| protected_tree(&model, o)),
+                false,
+            ))
+        }),
+    }
+}
