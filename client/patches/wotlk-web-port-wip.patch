--- /dev/null
+++ b/crates/benilla-ui/src/script/region/wrap.rs
@@ -0,0 +1,53 @@
+//! 3.3.5a's FontString wrap switches, which 1.12 lacks: `SetWordWrap`/`CanWordWrap` (a pair
+//! of verbs) and `SetIndentedWordWrap`/`GetIndentedWordWrap`, all in the
+//! FontString map. Stored, not applied: the layout wraps any FontString with a bounded
+//! width, which is the stock game's default, and an indented wrap is not built. Present so an addon
+//! that feature-tests them (`if fs.SetWordWrap then`, Forever UI's `ReputationTab.lua:901`) takes
+//! the stock game's path.
+
+use mlua::{Lua, Table, Value};
+
+use super::region_handle_of;
+
+/// Install the wrap methods into `m`; [`crate::script::FONTSTRING_ONLY_METHODS`] routes them.
+pub(super) fn install(lua: &Lua, m: &Table) -> mlua::Result<()> {
+    // `(setter, getter, word wrap?)`: the one flag pair each, read as Lua truth, answered 1 or nil.
+    for (setter, getter, word) in [
+        ("SetWordWrap", "CanWordWrap", true),
+        ("SetIndentedWordWrap", "GetIndentedWordWrap", false),
+    ] {
+        m.set(
+            setter,
+            lua.create_function(move |lua, (this, on): (Table, Value)| {
+                let on = !matches!(on, Value::Nil | Value::Boolean(false));
+                let rh = region_handle_of(lua, &this)?;
+                let mut model = crate::script::model_mut_of(lua);
+                let d = model.region_data.entry(rh).or_default();
+                if word {
+                    d.word_wrap = Some(on);
+                } else {
+                    d.indented_word_wrap = Some(on);
+                }
+                Ok(())
+            })?,
+        )?;
+        m.set(
+            getter,
+            lua.create_function(move |lua, this: Table| {
+                let rh = region_handle_of(lua, &this)?;
+                let model = lua
+                    .app_data_ref::<crate::script::ModelCell>()
+                    .expect("model");
+                let d = model.region_data.get(&rh);
+                // Word wrap starts on, indented wrap off.
+                let on = if word {
+                    d.and_then(|d| d.word_wrap).unwrap_or(true)
+                } else {
+                    d.and_then(|d| d.indented_word_wrap).unwrap_or(false)
+                };
+                Ok(crate::script::binding_abi::flag(on))
+            })?,
+        )?;
+    }
+    Ok(())
+}
