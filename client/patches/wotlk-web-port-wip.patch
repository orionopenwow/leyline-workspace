+    s.run(
+        r#"
+        Smf = CreateFrame("ScrollingMessageFrame", "Smf", UIParent)
+        Smf:SetWidth(300) Smf:SetHeight(200) Smf:SetPoint("CENTER")
+        Smf:SetMaxLines(50)
+        for i = 1, 10 do Smf:AddMessage("line " .. i) end
