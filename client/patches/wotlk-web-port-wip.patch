+async function tierLists() {
+  if (WORLD.tiers) return WORLD.tiers;
+  let tiers = [];
+  try {
+    const idx = await fetch('/data/__tier/index.json', { cache: 'no-cache' });
+    if (idx.ok) {
+      const list = await idx.json();
+      tiers = await Promise.all(
+        (Array.isArray(list) ? list : [])
+          .filter((t) => t && Number.isInteger(t.tier) && t.tier > 0)
+          .map(async (t) => {
+            const r = await fetch(`/data/__tier/${t.tier}.txt`, { cache: 'no-cache' });
+            return { tier: t.tier, name: t.name, names: r.ok ? parseTierNames(await r.text()) : [] };
+          })
+      );
+    }
+  } catch (_) {
+    tiers = [];
+  }
+  WORLD.tiers = tiers;
+  return tiers;
+}
+
+/// A tier's names for a focus tile: its ADTs nearest first, then everything else in list order.
+export function orderForFocus(names, focusKey) {
+  const tile = (k) => {
+    const m = /_(\d+)_(\d+)\.adt$/.exec(k);
+    return m ? [Number(m[1]), Number(m[2])] : null;
+  };
+  const f = tile(focusKey);
+  const adts = [];
+  const rest = [];
+  for (const n of names) {
+    const t = tile(storeKey(n));
+    if (t && f) adts.push([Math.max(Math.abs(t[0] - f[0]), Math.abs(t[1] - f[1])), n]);
+    else rest.push(n);
+  }
+  adts.sort((a, b) => a[0] - b[0]);
+  return adts.map((a) => a[1]).concat(rest);
+}
+
+/// The most files an in-world port's prefetch warms, nearest first.
+const PORT_PREFETCH_MAX = 600;
+
+async function prefetchWorld({ urgent = false } = {}) {
+  const gen = ++WORLD.gen;
+  const tiers = await tierLists();
+  if (gen !== WORLD.gen) return;
+  const corner = (WORLD.corner ??= createCornerLine());
+  const onProgress = (done, total) =>
+    gen === WORLD.gen &&
+    corner.set(total > 0 && done < total ? `preparing world data — ${done}/${total}` : '');
+  if (!tiers.length) {
+    if (WORLD.manifestDone) return;
+    WORLD.manifestDone = true;
+    return prefetchManifest('./world-manifest.json', onProgress, { concurrency: 3 });
+  }
+  if (!WORLD.focus) return; // no character yet: wait for the select screen's
+  const want = storeKey(WORLD.focus);
+  const pick = tiers.filter((t) => t.names.some((n) => storeKey(n) === want));
+  if (!pick.length) {
+    console.log(`boot: no streamed tier holds ${WORLD.focus}; no world prefetch`);
+    return corner.set('');
+  }
+  // An in-world port warms only the nearest part of the tier: the rest streams as the player moves.
+  const ordered = orderForFocus(pick.flatMap((t) => t.names), want);
+  const names = urgent ? ordered.slice(0, PORT_PREFETCH_MAX) : ordered;
+  console.log(`boot: world prefetch for ${WORLD.focus}: tier ${pick.map((t) => `${t.tier} (${t.name})`).join(', ')}, ${names.length} files`);
+  await prefetchNames(names, onProgress, {
+    concurrency: urgent ? 24 : 12,
+    low: !urgent,
+    alive: () => gen === WORLD.gen,
+  });
+  if (gen === WORLD.gen) corner.set('');
+}
+
+/// What the glue screens, character select and the world entry's UI load read, fetched into the
+/// body store while the player is on the first glue screen, so those reads find their bodies with
+/// no request. Every read that misses the store costs a synchronous round trip (185 ms from the
+/// US to the server): the in-game FrameXML load alone was hundreds of them. The names come from
+/// the host's own list of what it serves (the slice's base tier with sizes, else `/data/__index`):
+/// the interface's text files first in the list's own order (an overlay such as Forever UI lists
+/// its files at the front), then the client tables, the fonts and the interface art, leaving out
+/// the big folders no screen reads whole.
+const UI_PREFETCH_CONCURRENCY = 32;
+/// The interface prefetch's handle: Enter World adds a second pool for what is left, since every
+/// file it has not fetched yet would otherwise be read synchronously, one round trip each.
+const UI_BOOST = { add: null };
+const UI_PREFETCH_BUDGET = 160 * 1024 * 1024;
+const UI_TEXT = /^interface\\(framexml|gluexml|addons\\[^\\]+)\\.*\.(toc|xml|lua)$/;
+const UI_SKIP = /^interface\\(icons|worldmap|cinematics|glues\\(credits|loadingscreens|models)|tutorialframe|lfgframe\\lfgicon|achievementframe|calendar|glyphframe|tabardframe|taxiframe)/;
+// The client tables the character screens and the world entry read past the boot set (a live
+// capture at the WrathUnleashed slice, 2026-10-24); any other table under 512 KB comes last.
+const UI_DBCS = new Set(['emotestext', 'creaturedisplayinfo', 'areatable', 'chrraces',
+  'creaturemodeldata', 'gameobjectdisplayinfo', 'charsections', 'charhairgeosets',
+  'characterfacialhairstyles', 'particlecolor', 'spellshapeshiftform', 'spellicon',
+  'groundeffecttexture', 'map', 'languages', 'mapdifficulty', 'worldmaparea', 'worldmapcontinent',
+  'worldmapoverlay', 'dungeonmap', 'worldmaptransforms', 'exhaustion'].map((n) => `dbfilesclient\\${n}.dbc`));
+export function uiPrefetchNames(entries, have) {
+  const tiers = [[], [], [], [], []];
+  for (const { name, bytes } of entries) {
+    const k = storeKey(name);
+    if (have.has(k)) continue;
+    if (UI_TEXT.test(k)) tiers[0].push({ name, bytes });
+    else if (UI_DBCS.has(k)) tiers[1].push({ name, bytes });
+    else if (/^fonts\\[^\\]*\.ttf$/.test(k)) tiers[2].push({ name, bytes });
+    else if (/^interface\\.*\.blp$/.test(k) && !UI_SKIP.test(k)) tiers[3].push({ name, bytes });
+    else if (/^dbfilesclient\\[^\\]*\.dbc$/.test(k) && bytes <= 512 * 1024) tiers[4].push({ name, bytes });
+  }
+  const out = [];
+  let total = 0;
+  for (const tier of tiers) {
+    for (const e of tier) {
+      // Unknown sizes (the plain index) count as 64 KB, the interface art's typical size.
+      const b = Number.isFinite(e.bytes) ? e.bytes : 64 * 1024;
+      if (total + b > UI_PREFETCH_BUDGET) continue;
+      total += b;
+      out.push(e.name);
+    }
+  }
+  return { names: out, bytes: total };
+}
+
+/// The host's served names: the slice's base tier list (`/data/__tier/0.txt`, with sizes) when it
+/// has one, else the chain index the boot prefetch kept.
+async function servedNames() {
+  try {
+    const r = await fetch('/data/__tier/0.txt', { cache: 'no-cache' });
+    if (r.ok) {
+      const list = parseTierEntries(await r.text());
+      if (list.length) return list;
+    }
+  } catch (_) {
+    /* no tier lists */
+  }
+  try {
+    const kept = globalThis.__wenilla_prefetch && globalThis.__wenilla_prefetch.get(storeKey('__index'));
+    const body = kept ? new TextDecoder().decode(kept) : await (await fetch('/data/__index')).text();
+    const names = JSON.parse(body);
+    return Array.isArray(names) ? names.map((name) => ({ name, bytes: NaN })) : [];
+  } catch (_) {
+    return [];
+  }
+}
+
+async function prefetchUi(onProgress) {
+  const store = (globalThis.__wenilla_prefetch ??= new Map());
+  const have = new Set(store.keys());
+  for (const k of globalThis.__wenilla_taken || []) have.add(k);
+  const { names, bytes } = uiPrefetchNames(await servedNames(), have);
+  if (!names.length) return onProgress(0, 0);
+  console.log(`boot: interface prefetch, ${names.length} files, ~${(bytes / 1048576).toFixed(0)} MB`);
+  const t0 = performance.now();
+  await prefetchNames(names, onProgress, {
+    keep: true,
+    concurrency: UI_PREFETCH_CONCURRENCY,
