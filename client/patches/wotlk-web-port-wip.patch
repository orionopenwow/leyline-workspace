+/// A window drag or a phone's rotation moves the size every frame: the events wait this long
+/// after the last change, so a layout addon re-seats once.
+const DISPLAY_SETTLE_SECS: f32 = 0.25;
+
+/// `DISPLAY_SIZE_CHANGED` when the window's size moves and `UI_SCALE_CHANGED` when the effective
+/// uiScale does (the stock game fires them on a mode set and a `uiScale` write), so a layout addon
+/// (Forever UI's glue `onScale`, the bar layout) re-seats after a browser resize, a rotation or the
+/// pixel-perfect scale following the canvas. The first values a VM sees are not a change.
+pub(crate) fn feed_display_events(
+    script: Option<NonSendMut<UiScript>>,
+    window: Query<&Window, With<bevy::window::PrimaryWindow>>,
+    scale: Res<UiScaleCvar>,
+    time: Res<Time<bevy::time::Real>>,
+    mut seen: Local<VmMemo<DisplaySeen>>,
+) {
+    let (Some(mut script), Ok(w)) = (script, window.single()) else {
+        return;
+    };
+    let size = (w.width().round() as u32, w.height().round() as u32);
+    let bits = scale.for_vm(script.vm_kind()).to_bits();
+    let now = time.elapsed_secs();
+    let s = seen.get(&script);
+    if s.size.is_none() {
+        s.size = Some(size);
+        s.scale = Some(bits);
+        return;
+    }
+    if s.size == Some(size) && s.scale == Some(bits) {
+        s.pending = None;
+        return;
+    }
+    match s.pending {
+        Some((ps, pb, since)) if ps == size && pb == bits => {
+            if now - since < DISPLAY_SETTLE_SECS {
+                return;
+            }
+        }
+        _ => {
+            s.pending = Some((size, bits, now));
+            return;
+        }
+    }
+    let (size_moved, scale_moved) = (s.size != Some(size), s.scale != Some(bits));
+    s.size = Some(size);
+    s.scale = Some(bits);
+    s.pending = None;
+    if size_moved {
+        script.queue_event("DISPLAY_SIZE_CHANGED", Vec::new());
+    }
+    if scale_moved {
+        script.queue_event("UI_SCALE_CHANGED", Vec::new());
+    }
