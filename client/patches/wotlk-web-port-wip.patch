diff --git a/crates/benilla-assets/src/web_read.rs b/crates/benilla-assets/src/web_read.rs
new file mode 100644
index 00000000..38487896
--- /dev/null
+++ b/crates/benilla-assets/src/web_read.rs
@@ -0,0 +1,182 @@
+//! The browser's parallel reads for the loaders: a loader that needs several dependency files
+//! starts every request at once and then takes the bodies in its own order, where awaiting
+//! `LoadContext::read_asset_bytes` one at a time made each file a round trip of its own (a WMO's
+//! groups, an ADT's layer textures: seconds each at 190 ms). The bytes, and the order the loader
+//! consumes them in, are the serial path's, so the loaded asset is identical.
+//!
+//! Each name is answered like the async reader answers it ([`crate::MpqAssetReader`]): absent per
+//! the chain's name index with no request, from the page's body store, else one `fetch`. Hot-reload
+//! dependency tracking, which a page has no use for, is all `read_asset_bytes` adds.
+
+use std::sync::OnceLock;
+
+use benilla_formats::Chain;
+use wasm_bindgen::JsCast;
+
+/// The page's chain, for its name index (shared by every chain of the page).
+fn chain() -> &'static Chain {
+    static CHAIN: OnceLock<Chain> = OnceLock::new();
+    CHAIN.get_or_init(|| Chain::open(std::path::Path::new("")).expect("the web chain never fails"))
+}
+
+/// Whether the host has `internal` (an archive path), per the name index; `true` when the index
+/// is unavailable, since nothing is then known.
+pub(crate) fn may_exist(internal: &str) -> bool {
+    !chain().index_says_absent(internal)
+}
+
+/// One read in flight.
+pub(crate) enum Pending {
+    Absent,
+    Ready(Vec<u8>),
+    /// The request in flight and its URL, for a retry.
+    Fetch(js_sys::Promise, String),
+}
+
+/// Start reading `internal` now.
+pub(crate) fn start(internal: &str) -> Pending {
+    if !may_exist(internal) {
+        return Pending::Absent;
+    }
+    let url = format!(
+        "{}/{}",
+        benilla_formats::web::data_base(),
+        benilla_formats::web::encode_name(internal)
+    );
+    if let Some(bytes) = benilla_formats::web::stored(&url) {
+        return Pending::Ready(bytes);
+    }
+    match web_sys::window() {
+        Some(w) => Pending::Fetch(w.fetch_with_str(&url), url),
+        None => Pending::Absent,
+    }
+}
+
+/// What one read came back with.
+pub(crate) enum Body {
+    Bytes(Vec<u8>),
+    /// Not in the archive chain: the name index says so, or the host answered 404.
+    Absent,
+    /// The request failed (network, 5xx) on every try: the file exists but did not arrive.
+    Unreachable,
+}
+
+/// Re-tries for a failed request, after the page's own `/data` retries (`window.__wuRetries`):
+/// a dropped WMO group used to be skipped for good, a hole in a city floor.
+const RETRY_DELAYS_MS: [i32; 3] = [400, 1200, 3000];
+
+/// Give the browser its event loop back (a `setTimeout(0)` macrotask, not a microtask), so a
+/// frame can render between slices of a long loader.
+pub(crate) async fn yield_to_browser() {
+    sleep_ms(0).await;
+}
+
+/// Time-slicing for a loader's long synchronous loop: [`Self::tick`] yields to the browser once
+/// [`SLICE_MS`] of work has run since the last yield.
+pub(crate) struct Slicer(bevy::platform::time::Instant);
+
+/// The work a loader does between yields: a fraction of a 60 Hz frame.
+const SLICE_MS: u128 = 8;
+
+impl Slicer {
+    pub(crate) fn new() -> Self {
+        Self(bevy::platform::time::Instant::now())
+    }
+
+    pub(crate) async fn tick(&mut self) {
+        if self.0.elapsed().as_millis() >= SLICE_MS {
+            yield_to_browser().await;
+            self.0 = bevy::platform::time::Instant::now();
+        }
+    }
+}
+
+async fn sleep_ms(ms: i32) {
+    let p = js_sys::Promise::new(&mut |resolve, _| {
+        match web_sys::window() {
+            Some(w) => {
+                let _ = w.set_timeout_with_callback_and_timeout_and_arguments_0(&resolve, ms);
+            }
+            None => {
+                let _ = resolve.call0(&wasm_bindgen::JsValue::NULL);
+            }
+        }
+    });
+    let _ = wasm_bindgen_futures::JsFuture::from(p).await;
+}
+
+/// One `fetch` of `url`: the body, a definite absence (404), or a failure worth another try.
+async fn fetch_once(p: js_sys::Promise) -> Body {
+    let Ok(resp) = wasm_bindgen_futures::JsFuture::from(p).await else {
+        return Body::Unreachable;
+    };
+    let Ok(resp) = resp.dyn_into::<web_sys::Response>() else {
+        return Body::Unreachable;
+    };
+    if resp.status() == 404 {
+        return Body::Absent;
+    }
+    if !resp.ok() {
+        return Body::Unreachable;
+    }
+    let Ok(buf) = resp.array_buffer() else {
+        return Body::Unreachable;
+    };
+    match wasm_bindgen_futures::JsFuture::from(buf).await {
+        Ok(buf) => Body::Bytes(js_sys::Uint8Array::new(&buf).to_vec()),
+        Err(_) => Body::Unreachable,
+    }
+}
+
+impl Pending {
+    /// The body, `None` for a missing file or a request that failed every retry.
+    pub(crate) async fn bytes(self) -> Option<Vec<u8>> {
+        match self.body().await {
+            Body::Bytes(b) => Some(b),
+            Body::Absent | Body::Unreachable => None,
+        }
+    }
+
+    /// The body, telling a missing file from one that failed to arrive. A failed request is
+    /// re-sent after [`RETRY_DELAYS_MS`].
+    pub(crate) async fn body(self) -> Body {
+        match self {
+            Pending::Absent => Body::Absent,
+            Pending::Ready(b) => Body::Bytes(b),
+            Pending::Fetch(p, url) => {
+                let mut got = fetch_once(p).await;
+                for delay in RETRY_DELAYS_MS {
+                    if !matches!(got, Body::Unreachable) {
+                        break;
+                    }
+                    bevy::log::warn!("data: {url} failed; trying again in {delay} ms");
+                    sleep_ms(delay).await;
+                    let Some(w) = web_sys::window() else { break };
+                    got = fetch_once(w.fetch_with_str(&url)).await;
+                }
+                got
+            }
+        }
+    }
+}
+
+/// Read every name at once; the bodies in the names' order.
+pub(crate) async fn read_all(names: &[String]) -> Vec<Option<Vec<u8>>> {
+    let pending: Vec<Pending> = names.iter().map(|n| start(n)).collect();
+    let mut out = Vec::with_capacity(pending.len());
+    for p in pending {
+        out.push(p.bytes().await);
+    }
+    out
+}
+
+/// [`read_all`], keeping each name's [`Body`] so a caller can fail on a file that exists but
+/// did not arrive.
+pub(crate) async fn read_all_bodies(names: &[String]) -> Vec<Body> {
+    let pending: Vec<Pending> = names.iter().map(|n| start(n)).collect();
+    let mut out = Vec::with_capacity(pending.len());
+    for p in pending {
+        out.push(p.body().await);
+    }
+    out
+}
