@@ -0,0 +1,58 @@
+//! WrathUnleashed's switch for Forever UI (github.com/Adrestie/mod-forever-ui), the modern-look
+//! addon suite: once the player installs it (its `Interface\AddOns\ForeverUI`, its art under
+//! `Interface\ForeverUI` and its glue files beside `GlueXML.toc`), it is on by default, as any
+//! installed addon is. The `foreverUI` CVar at 0, or `?foreverui=0` on the page (`WOW_FOREVERUI=0`
+//! natively), keeps the stock interface: the addon does not load and the login screens drop the
+//! glue files it appends to `GlueXML.toc`. Nothing of it ships with the client.
+
+use benilla_ui::script::UiScript;
+
+/// The addon's folder name.
+pub(crate) const ADDON: &str = "ForeverUI";
+
+/// The CVar that turns it off.
+pub(crate) const CVAR: &str = "foreverUI";
+
+/// The prefix of the files Forever UI appends to `GlueXML.toc` (`ForeverUIGlue.xml`, which
+/// includes the rest).
+const GLUE_PREFIX: &str = "foreverui";
+
+/// `false` only for an explicit 0: the page/environment override first, then the CVar.
+pub(crate) fn enabled(script: &UiScript) -> bool {
+    let value = crate::webenv::var("WOW_FOREVERUI").or_else(|| script.cvar(CVAR));
+    on(value.as_deref())
+}
+
+fn on(value: Option<&str>) -> bool {
+    value.is_none_or(|v| v.trim() != "0")
+}
+
+/// Whether a manifest entry is one of Forever UI's glue files.
+pub(crate) fn is_glue_entry(entry: &str) -> bool {
+    entry
+        .rsplit(['\\', '/'])
+        .next()
+        .is_some_and(|leaf| leaf.to_ascii_lowercase().starts_with(GLUE_PREFIX))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_an_explicit_zero_turns_it_off() {
+        assert!(on(None));
+        assert!(on(Some("1")));
+        assert!(on(Some("")));
+        assert!(!on(Some("0")));
+        assert!(!on(Some(" 0 ")));
+    }
+
+    #[test]
+    fn its_glue_entries_are_told_from_the_stock_ones() {
+        assert!(is_glue_entry(r"Interface\GlueXML\ForeverUIGlue.xml"));
+        assert!(is_glue_entry("ForeverUIGlue.xml"));
+        assert!(!is_glue_entry(r"Interface\GlueXML\AccountLogin.xml"));
+        assert!(!is_glue_entry(r"Interface\GlueXML\GlueParent.xml"));
+    }
+}
