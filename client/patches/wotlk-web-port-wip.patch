new file mode 100644
index 00000000..2db2c67c
--- /dev/null
+++ b/crates/benilla-ui/src/script/wrath_api.rs
@@ -0,0 +1,341 @@
+//! 3.3.5a calls addons lean on that the 1.12-shaped surface lacked: `GetSpellInfo`,
+//! `GetSpellLink` and `UnitGUID`. The spell table is the host's (`Spell.dbc` joined with its
+//! icon, range and cast-time rows), seated once with [`super::UiScript::set_spell_info`].
+
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use mlua::{Lua, MultiValue, Value};
+
+use super::Model;
+
+/// One spell as `GetSpellInfo` returns it.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SpellInfo {
+    pub name: String,
+    /// `NameSubtext`, "" when the spell has none.
+    pub rank: String,
+    /// `Interface\Icons\...`, `None` for a spell with no icon.
+    pub icon: Option<String>,
+    /// Power cost in display units (rage and runic power already divided by 10).
+    pub cost: i64,
+    pub funnel: bool,
+    pub power_type: i64,
+    pub cast_ms: i64,
+    pub min_range: f64,
+    pub max_range: f64,
+    /// `GetSpellBaseCooldown`'s first return: the larger of `RecoveryTime` and
+    /// `CategoryRecoveryTime`, in ms.
+    pub cooldown_ms: i64,
+    /// `GetSpellBaseCooldown`'s second return: `StartRecoveryTime`, the global cooldown, in ms.
+    pub gcd_ms: i64,
+}
+
+pub(crate) type SpellInfoTable = Rc<HashMap<u32, SpellInfo>>;
+
+impl super::UiScript {
+    /// The saved equipment sets in the server's order, `(id, name, icon file)`, for
+    /// `GetNumEquipmentSets` and `GetEquipmentSetInfo`.
+    pub fn set_equipment_set_list(&self, sets: Vec<(u32, String, String)>) {
+        if self.model_ref().equipment_set_list != sets {
+            self.model_mut().equipment_set_list = sets;
+        }
+    }
+
+    /// Seat the spell table `GetSpellInfo` and `GetSpellLink` read.
+    pub fn set_spell_info(&self, table: HashMap<u32, SpellInfo>) {
+        self.model_mut().spell_info = Some(Rc::new(table));
+    }
+}
+
+/// The spell an argument names: an id (number or numeric string), else a name, optionally with
+/// `(Rank N)`, looked up in the player's spellbook, the highest rank winning as on 12340.
+pub(super) fn resolve(model: &Model, v: &Value) -> Option<u32> {
+    let text = match v {
+        Value::Integer(i) => return u32::try_from(*i).ok().filter(|&i| i > 0),
+        Value::Number(n) => return (*n > 0.0).then_some(*n as u32),
+        Value::String(s) => s.to_str().ok()?.trim().to_string(),
+        _ => return None,
+    };
+    if let Ok(id) = text.parse::<u32>() {
+        return (id > 0).then_some(id);
+    }
+    let (name, rank) = match text.find('(') {
+        Some(at) if text.ends_with(')') => (
+            text[..at].trim().to_string(),
+            Some(text[at + 1..text.len() - 1].trim().to_string()),
+        ),
+        _ => (text.clone(), None),
+    };
+    let mut found = None;
+    for slot in &model.spellbook.slots {
+        if !slot.name.eq_ignore_ascii_case(&name) {
+            continue;
+        }
+        if let Some(want) = &rank {
+            if !slot.rank.as_deref().unwrap_or("").eq_ignore_ascii_case(want) {
+                continue;
+            }
+        }
+        found = Some(slot.spell_id); // later slots are higher ranks
+    }
+    found
+}
+
+/// The 3.3.5a spell hyperlink.
+pub(crate) fn spell_link(id: u32, name: &str) -> String {
+    format!("|cff71d5ff|Hspell:{id}|h[{name}]|h|r")
+}
+
+pub(super) fn install(lua: &Lua) -> mlua::Result<()> {
+    let g = lua.globals();
+
+    // GetSpellInfo(spellId | "name" | "name(Rank N)") -> name, rank, icon, cost, isFunnel,
+    // powerType, castTime, minRange, maxRange; nothing for an unknown spell.
+    g.set(
+        "GetSpellInfo",
+        lua.create_function(|lua, v: Value| {
+            let model = lua
+                .app_data_ref::<crate::script::ModelCell>()
+                .expect("model app_data");
+            let Some(info) = resolve(&model, &v)
+                .and_then(|id| model.spell_info.as_ref()?.get(&id).cloned())
+            else {
+                return Ok(MultiValue::new());
+            };
+            drop(model);
+            let s = |t: &str| lua.create_string(t).map(Value::String);
+            Ok(MultiValue::from_vec(vec![
+                s(&info.name)?,
+                s(&info.rank)?,
+                match &info.icon {
+                    Some(i) => s(i)?,
+                    None => Value::Nil,
+                },
+                Value::Integer(info.cost),
+                Value::Boolean(info.funnel),
+                Value::Integer(info.power_type),
+                Value::Integer(info.cast_ms),
+                Value::Number(info.min_range),
+                Value::Number(info.max_range),
+            ]))
+        })?,
+    )?;
+
+    // GetSpellLink(spellId | "name") -> link; nothing for an unknown spell.
+    g.set(
+        "GetSpellLink",
+        lua.create_function(|lua, v: Value| {
+            let model = lua
+                .app_data_ref::<crate::script::ModelCell>()
+                .expect("model app_data");
+            let Some((id, name)) = resolve(&model, &v).and_then(|id| {
+                Some((id, model.spell_info.as_ref()?.get(&id)?.name.clone()))
+            }) else {
+                return Ok(Value::Nil);
+            };
+            drop(model);
+            Ok(Value::String(lua.create_string(spell_link(id, &name))?))
+        })?,
+    )?;
+
+    // UnitGUID("unit") -> "0x" + 16 hex digits, nil for nobody.
+    g.set(
+        "UnitGUID",
+        lua.create_function(|lua, token: Value| {
+            let token = crate::script::binding_abi::string_arg(
+                lua,
+                token,
+                r#"Usage: UnitGUID("unit")"#,
+            )?;
+            let model = lua
+                .app_data_ref::<crate::script::ModelCell>()
+                .expect("model app_data");
+            match model.unit_guids.guid_of(&token) {
+                Some(g) if g != 0 && g != crate::script::focus::NOBODY => {
+                    drop(model);
+                    Ok(Value::String(lua.create_string(format!("0x{g:016X}"))?))
+                }
+                _ => Ok(Value::Nil),
+            }
+        })?,
+    )?;
+
+    // GetNumEquipmentSets(), GetEquipmentSetInfo(index) -> name, icon, setID, and
+    // GetEquipmentSetInfoByName(name) -> icon, setID: the server's saved sets.
+    fn icon_path(icon: &str) -> String {
+        if icon.is_empty() {
+            "Interface\\Icons\\INV_Misc_QuestionMark".to_string()
+        } else if icon.contains('\\') {
+            icon.to_string()
+        } else {
+            format!("Interface\\Icons\\{icon}")
+        }
+    }
+    g.set(
+        "GetNumEquipmentSets",
+        lua.create_function(|lua, ()| {
+            let model = lua.app_data_ref::<crate::script::ModelCell>().expect("model app_data");
+            Ok(model.equipment_set_list.len() as i64)
+        })?,
+    )?;
+    g.set(
+        "GetEquipmentSetInfo",
+        lua.create_function(|lua, index: i64| {
+            let model = lua.app_data_ref::<crate::script::ModelCell>().expect("model app_data");
+            let Some((id, name, icon)) = usize::try_from(index - 1)
+                .ok()
+                .and_then(|i| model.equipment_set_list.get(i))
+                .cloned()
+            else {
+                return Ok(MultiValue::new());
+            };
+            drop(model);
+            Ok(MultiValue::from_vec(vec![
+                Value::String(lua.create_string(&name)?),
+                Value::String(lua.create_string(icon_path(&icon))?),
+                Value::Integer(i64::from(id)),
+            ]))
+        })?,
+    )?;
+    g.set(
+        "GetEquipmentSetInfoByName",
+        lua.create_function(|lua, name: String| {
+            let model = lua.app_data_ref::<crate::script::ModelCell>().expect("model app_data");
+            let Some((id, _, icon)) = model
+                .equipment_set_list
+                .iter()
+                .find(|(_, n, _)| n == &name)
+                .cloned()
+            else {
+                return Ok(MultiValue::new());
+            };
+            drop(model);
+            Ok(MultiValue::from_vec(vec![
+                Value::String(lua.create_string(icon_path(&icon))?),
+                Value::Integer(i64::from(id)),
+            ]))
+        })?,
+    )?;
+
+    // The rest of the 3.3.5a surface addons expect, derived or empty ([`COMPAT`]).
+    lua.load(COMPAT).set_name("=wrath_compat.lua").exec()?;
+    Ok(())
+}
+
+/// Lua definitions for 3.3.5a calls with no native implementation yet: each defined only when
+/// nothing else defined it, so a native one added later wins without touching this file.
+const COMPAT: &str = include_str!("wrath_compat.lua");
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn spell_links_use_the_wrath_color_and_shape() {
+        assert_eq!(spell_link(133, "Fireball"), "|cff71d5ff|Hspell:133|h[Fireball]|h|r");
+    }
+
+    #[test]
+    fn get_spell_info_answers_by_id_and_nothing_for_an_unknown_spell() {
+        let s = crate::script::UiScript::new().unwrap();
+        s.set_spell_info(
+            [(
+                133,
+                SpellInfo {
+                    name: "Fireball".into(),
+                    rank: "Rank 1".into(),
+                    icon: Some("Interface\\Icons\\Spell_Fire_FlameBolt".into()),
+                    cost: 30,
+                    power_type: 0,
+                    cast_ms: 1500,
+                    max_range: 35.0,
+                    ..Default::default()
+                },
+            )]
+            .into_iter()
+            .collect(),
+        );
+        let (name, rank, cost, cast): (String, String, i64, i64) = s
+            .eval("local n, r, _, c, _, _, t = GetSpellInfo(133) return n, r, c, t")
+            .unwrap();
+        assert_eq!((name.as_str(), rank.as_str(), cost, cast), ("Fireball", "Rank 1", 30, 1500));
+        assert!(s.eval::<bool>("return GetSpellInfo(99999) == nil").unwrap());
+        assert_eq!(
+            s.eval::<String>("return GetSpellLink(133)").unwrap(),
+            "|cff71d5ff|Hspell:133|h[Fireball]|h|r"
+        );
+        assert!(s.eval::<bool>("return UnitGUID('player') == nil").unwrap());
+    }
+
+    #[test]
+    fn the_compat_layer_answers_wrath_calls_without_raising() {
+        let s = crate::script::UiScript::new().unwrap();
+        assert_eq!(s.eval::<i64>("return GetNumEquipmentSets()").unwrap(), 0);
+        s.set_equipment_set_list(vec![(4, "Tank".into(), "INV_Shield_06".into())]);
+        let (n, icon, id): (String, String, i64) = s.eval("return GetEquipmentSetInfo(1)").unwrap();
+        assert_eq!((n.as_str(), icon.as_str(), id), ("Tank", "Interface\\Icons\\INV_Shield_06", 4));
+        assert_eq!(s.eval::<i64>("return select(2, GetEquipmentSetInfoByName('Tank'))").unwrap(), 4);
+        s.set_equipment_set_list(vec![]);
+        assert_eq!(s.eval::<i64>("return GetCurrencyListSize()").unwrap(), 0);
+        assert!(s.eval::<bool>("return GetEquipmentSetInfo(1) == nil").unwrap());
+        assert!(!s.eval::<bool>("return (GetGlyphSocketInfo(1))").unwrap());
+        assert_eq!(
+            s.eval::<String>("return GetCoinText(1234567, ' ')").unwrap(),
+            "123 Gold 45 Silver 67 Copper"
+        );
+        let (_, m, d, y): (i64, i64, i64, i64) = s.eval("return CalendarGetDate()").unwrap();
+        assert!((1..=12).contains(&m) && (1..=31).contains(&d) && y >= 2024);
+        s.run("SaveEquipmentSet('x', 1) VehicleExit()").unwrap();
+    }
+
+    #[test]
+    fn hooksecurefunc_runs_the_hook_after_the_original_and_keeps_its_returns() {
+        let s = crate::script::UiScript::new().unwrap();
+        let out: (i64, i64, i64) = s
+            .eval(
+                "seen = 0 \
+                 function Twice(x) return x * 2, nil, 7 end \
+                 hooksecurefunc('Twice', function(x) seen = x end) \
+                 local a, _, c = Twice(21) return a, c, seen",
+            )
+            .unwrap();
+        assert_eq!(out, (42, 7, 21));
+        let t: i64 = s
+            .eval("local t = { f = function() return 1 end } local n = 0 \
+                   hooksecurefunc(t, 'f', function() n = n + 1 end) t.f() t.f() return n")
+            .unwrap();
+        assert_eq!(t, 2);
+        assert_eq!(s.eval::<i64>("return strlenutf8('héllo')").unwrap(), 5);
+    }
+
+    #[test]
+    fn override_bindings_lay_over_the_saved_keys_until_cleared() {
+        let s = crate::script::UiScript::new().unwrap();
+        s.run("SetBinding('F', 'TOGGLEBACKPACK') owner = {} other = {}").unwrap();
+        let find = |s: &crate::script::UiScript, key: &str| {
+            s.binding_keys()
+                .into_iter()
+                .filter(|(k, _)| k == key)
+                .map(|(_, c)| c)
+                .last()
+        };
+        assert_eq!(find(&s, "F").as_deref(), Some("TOGGLEBACKPACK"));
+        s.run("SetOverrideBindingClick(owner, false, 'F', 'MyButton')").unwrap();
+        assert_eq!(find(&s, "F").as_deref(), Some("CLICK MyButton"));
+        s.run("SetOverrideBinding(other, true, 'F', 'TOGGLEWORLDMAP')").unwrap();
+        assert_eq!(find(&s, "F").as_deref(), Some("TOGGLEWORLDMAP"), "priority wins");
+        s.run("ClearOverrideBindings(other) ClearOverrideBindings(owner)").unwrap();
+        assert_eq!(find(&s, "F").as_deref(), Some("TOGGLEBACKPACK"));
+        assert!(s.run("SetOverrideBinding('notaframe', false, 'F', 'X')").is_err());
+    }
+
+    #[test]
+    fn a_click_binding_clicks_the_named_button() {
+        let s = crate::script::UiScript::new().unwrap();
+        s.run("clicked = nil MyBtn = { Click = function(self, b, down) clicked = b end }").unwrap();
+        assert!(s.execute_binding("CLICK MyBtn:RightButton", true).unwrap());
+        assert_eq!(s.eval::<String>("return clicked").unwrap(), "RightButton");
+        assert!(!s.execute_binding("NOT A COMMAND", true).unwrap());
+    }
+}
diff --git a/crates/benilla-ui/src/script/wrath_compat.lua b/crates/benilla-ui/src/script/wrath_compat.lua
new file mode 100644
index 00000000..40247c1d
--- /dev/null
+++ b/crates/benilla-ui/src/script/wrath_compat.lua
@@ -0,0 +1,321 @@
+-- WrathUnleashed: 3.3.5a calls the client does not implement natively yet. Each is defined only
+-- when nothing else has defined it, before FrameXML loads, so the stock interface and addons get
+-- a sane answer instead of "attempt to call a nil value". Two kinds:
+--   * derived: built from calls that do exist (GetInventoryItemID from the item link, ...);
+--   * empty: the feature has no data on this client yet (equipment sets, currency, calendar
+--     events, raid browser, Battle.net, vehicles seats): the answer the real client gives when
+--     there is nothing to show.
+local function def(name, fn) if _G[name] == nil then _G[name] = fn end end
+local function noop() end
+local function zero() return 0 end
+local function none() return nil end
+local function no() return false end
+
+-- Derived ------------------------------------------------------------------------------------
+local function idFromLink(link)
+    if type(link) ~= "string" then return nil end
+    local id = link:match("item:(%d+)")
+    return id and tonumber(id) or nil
+end
+def("GetInventoryItemID", function(unit, slot)
+    return idFromLink(GetInventoryItemLink(unit, slot))
+end)
+local function itemId(item)
+    if type(item) == "number" then return item end
+    if type(item) == "string" then
+        local id = idFromLink(item) or tonumber(item)
+        if id then return id end
+        local _, link = GetItemInfo(item)
+        return idFromLink(link)
+    end
+end
+def("IsEquippedItem", function(item)
+    local want = itemId(item)
+    if not want then return false end
+    for slot = 0, 19 do
+        if GetInventoryItemID("player", slot) == want then return true end
+    end
+    return false
+end)
+def("IsEquippableItem", function(item)
+    local _, _, _, _, _, _, _, _, equipLoc = GetItemInfo(item)
+    return equipLoc ~= nil and equipLoc ~= "" and equipLoc ~= "INVTYPE_BAG" and true or false
+end)
+def("EquipItemByName", function(item)
+    local want = itemId(item)
+    if not want then return end
+    for bag = 0, 4 do
+        for slot = 1, GetContainerNumSlots(bag) do
+            if idFromLink(GetContainerItemLink(bag, slot)) == want then
+                UseContainerItem(bag, slot)
+                return
+            end
+        end
+    end
+end)
+def("GetCoinText", function(money, separator)
+    money = math.floor(tonumber(money) or 0)
+    separator = separator or ", "
+    local g, s, c = math.floor(money / 10000), math.floor(money / 100) % 100, money % 100
+    local parts = {}
+    if g > 0 then parts[#parts + 1] = g .. " " .. (GOLD or "Gold") end
+    if s > 0 then parts[#parts + 1] = s .. " " .. (SILVER or "Silver") end
+    if c > 0 or #parts == 0 then parts[#parts + 1] = c .. " " .. (COPPER or "Copper") end
+    return table.concat(parts, separator)
+end)
+def("GetRealNumRaidMembers", function() return GetNumRaidMembers() end)
+def("UnitIsSameServer", function(unit) return UnitExists(unit) and true or false end)
+def("GetPlayerInfoByGUID", function(guid)
+    if not guid or not UnitGUID then return nil end
+    local tokens = { "player", "target", "focus", "mouseover", "pet" }
+    for i = 1, 4 do tokens[#tokens + 1] = "party" .. i end
+    for i = 1, 40 do tokens[#tokens + 1] = "raid" .. i end
+    for _, t in ipairs(tokens) do
+        if UnitGUID(t) == guid then
+            local class, classFile = UnitClass(t)
+            local race, raceFile = UnitRace(t)
+            return class, classFile, race, raceFile, UnitSex(t), (UnitName(t))
+        end
+    end
+end)
+def("StartAttack", function()
+    if not (IsCurrentSpell and IsCurrentSpell(6603)) then AttackTarget() end
+end)
+def("StopAttack", function()
+    if IsCurrentSpell and IsCurrentSpell(6603) then AttackTarget() end
+end)
+def("CalendarGetDate", function()
+    local t = date("*t")
+    return t.wday, t.month, t.day, t.year
+end)
+def("CalendarGetMonth", function(offset)
+    local t = date("*t")
+    local m, y = t.month + (offset or 0), t.year
+    while m > 12 do m, y = m - 12, y + 1 end
+    while m < 1 do m, y = m + 12, y - 1 end
+    local first = date("*t", time({ year = y, month = m, day = 1, hour = 12 }))
+    local days = date("*t", time({ year = y, month = m + 1, day = 0, hour = 12 })).day
+    return m, y, days, first.wday
+end)
+
+-- Empty: no data on this client yet ----------------------------------------------------------
+for _, n in ipairs({
+    "GetNumEquipmentSets", "GetCurrencyListSize", "GetNumTitles", "GetNumDisplayChannels",
+    "GetSelectedDisplayChannel", "GetNumGuildBankTabs", "GetNumTrackingTypes",
+    "CalendarGetNumPendingInvites", "CalendarGetNumDayEvents", "SearchLFGGetNumResults",
+    "SearchLFGGetJoinedID", "GetInstanceLockTimeRemaining", "GetCurrentTitle",
+}) do def(n, zero) end
+for _, n in ipairs({
+    "GetEquipmentSetInfo", "GetEquipmentSetInfoByName", "GetEquipmentSetItemIDs",
+    "GetCurrencyListInfo", "GetBackpackCurrencyInfo", "GetTitleName", "GetChannelDisplayInfo",
+    "GetChannelRosterInfo", "GetTrackingInfo", "GetGlyphLink", "GetItemSpell",
+    "GetQuestLogSpellLink", "GetQuestSpellLink", "GetVoiceSessionInfo", "GetVehicleUIIndicator",
+    "UnitVehicleSeatInfo", "UnitVehicleSkin", "CalendarGetDayEvent", "SearchLFGGetResults",
+    "SearchLFGGetPartyResults", "SearchLFGGetEncounterResults", "BNGetInfo", "BNGetFriendInfo",
+    "BNGetFriendInfoByID", "BNGetFriendInviteInfo", "BNGetToonInfo", "BNGetConversationInfo",
+    "GetMirrorTimerInfo",
+}) do def(n, none) end
+for _, n in ipairs({
+    "IsTitleKnown", "EquipmentSetContainsLockedItems", "CanSwitchVehicleSeat",
+    "UnitIsControlling",
+}) do def(n, no) end
+for _, n in ipairs({
+    "SaveEquipmentSet", "UseEquipmentSet", "DeleteEquipmentSet", "PickupEquipmentSet",
+    "PickupEquipmentSetByName", "EquipmentManagerClearIgnoredSlotsForSave",
+    "EquipmentManagerIgnoreSlotForSave", "ExpandCurrencyList", "SetCurrencyUnused",
+    "SetCurrencyBackpack", "SetCurrentTitle", "PlaceGlyphInSocket", "RemoveGlyphFromSocket",
+    "SetTracking", "RefreshLFGList", "SearchLFGJoin", "SearchLFGLeave", "SearchLFGSort",
+    "UnitSwitchToVehicleSeat", "VehicleExit", "AddMute", "ClearPartyAssignment",
+    "SetPartyAssignment", "GuildInvite", "WithdrawGuildBankMoney", "ReportPlayerIsPVPAFK",
+    "RespondInstanceLock", "ContainerRefundItemPurchase", "CancelItemTempEnchantment",
+}) do def(n, noop) end
+def("GetInventoryItemsForSlot", function(slot, t) return t or {} end)
+def("GetAutoCompleteResults", noop)
+-- GetGlyphSocketInfo(socket) -> enabled, glyphType, glyphSpell, icon: no socket data yet, so every
+-- socket reads as locked (the client's answer below the socket's unlock level).
+def("GetGlyphSocketInfo", function(socket)
+    return false, (socket == 1 or socket == 4 or socket == 6) and 1 or 2, nil, nil
+end)
+
+-- Secure hooks and the Lua helpers addons call everywhere -------------------------------------
+local function pack(...) return { n = select("#", ...), ... } end
+def("hooksecurefunc", function(tbl, name, hook)
+    if type(tbl) ~= "table" then tbl, name, hook = _G, tbl, name end
+    local orig = tbl[name]
+    if type(orig) ~= "function" then
+        error("hooksecurefunc(): " .. tostring(name) .. " is not a function", 2)
+    end
+    if type(hook) ~= "function" then error("Usage: hooksecurefunc([table,] \"name\", hookfunc)", 2) end
+    tbl[name] = function(...)
+        local r = pack(orig(...))
+        hook(...)
+        return unpack(r, 1, r.n)
+    end
+end)
+def("issecurevariable", function() return 1, nil end)
+def("forceinsecure", noop)
+def("scrub", function(...)
+    local r = pack(...)
+    for i = 1, r.n do
+        local t = type(r[i])
+        if t ~= "number" and t ~= "string" and t ~= "boolean" and t ~= "nil" then r[i] = nil end
+    end
+    return unpack(r, 1, r.n)
+end)
+def("debuglocals", function() return "" end)
+def("difftime", function(a, b) return (a or 0) - (b or 0) end)
+def("strlenutf8", function(s) return select(2, tostring(s):gsub("[^\128-\191]", "")) end)
+
+-- Keys, cursor, CVars --------------------------------------------------------------------------
+def("IsModifierKeyDown", function()
+    return (IsShiftKeyDown() or IsControlKeyDown() or IsAltKeyDown()) and 1 or nil
+end)
+def("IsLeftShiftKeyDown", function() return IsShiftKeyDown() end)
+def("IsLeftControlKeyDown", function() return IsControlKeyDown() end)
+def("IsLeftAltKeyDown", function() return IsAltKeyDown() end)
+for _, n in ipairs({ "IsRightShiftKeyDown", "IsRightControlKeyDown", "IsRightAltKeyDown",
+    "CursorHasMacro", "IsFlying", "IsSwimming", "IsStealthed", "IsFlyableArea",
+    "IsIndoors", "UnitIsFeignDeath", "UnitUsingVehicle", "UnitInVehicleControlSeat",
+    "QuestIsDaily", "QuestIsWeekly", "IsConsumableSpell", "ItemHasRange", "IsUsingVehicleControls",
+    "IsVehicleAimAngleAdjustable", "IsVehicleAimPowerAdjustable", "IsBNLogin", "IsDebugBuild" }) do
+    def(n, no)
+end
+def("IsOutdoors", function() return 1 end)
+def("IsLoggedIn", function() return 1 end)
+def("IsDesaturateSupported", function() return 1 end)
+def("IsTutorialFlagged", function() return 1 end)
+def("GetCVarInfo", function(name)
+    return GetCVar(name), GetCVarDefault and GetCVarDefault(name) or nil, nil, nil, nil
+end)
+def("GetCurrentKeyBoardFocus", none)
+def("GetMouseButtonClicked", none)
+def("GetCoinTextureString", function(money)
+    money = math.floor(tonumber(money) or 0)
+    local g, s, c = math.floor(money / 10000), math.floor(money / 100) % 100, money % 100
+    local icon = "|TInterface\\MoneyFrame\\UI-%sIcon:0:0:2:0|t"
+    local parts = {}
+    if g > 0 then parts[#parts + 1] = g .. icon:format("Gold") end
+    if s > 0 then parts[#parts + 1] = s .. icon:format("Silver") end
+    if c > 0 or #parts == 0 then parts[#parts + 1] = c .. icon:format("Copper") end
+    return table.concat(parts, " ")
+end)
+
+-- Bindings: the typed forms over SetBinding (override bindings are native, in keybind.rs). ---
+def("SetBindingClick", function(key, button, mouse)
+    return SetBinding(key, "CLICK " .. button .. ":" .. (mouse or "LeftButton"))
+end)
+def("SetBindingSpell", function(key, spell) return SetBinding(key, "SPELL " .. spell) end)
+def("SetBindingMacro", function(key, macro) return SetBinding(key, "MACRO " .. macro) end)
+def("SetBindingItem", function(key, item) return SetBinding(key, "ITEM " .. item) end)
+def("SetMouselookOverrideBinding", noop)
+
+-- Items and bags, derived from the bag and item calls that exist ------------------------------
+def("GetContainerItemID", function(bag, slot) return idFromLink(GetContainerItemLink(bag, slot)) end)
+def("GetItemCount", function(item)
+    local want, total = itemId(item), 0
+    if not want then return 0 end
+    for bag = 0, 4 do
+        for slot = 1, GetContainerNumSlots(bag) do
+            if idFromLink(GetContainerItemLink(bag, slot)) == want then
+                local _, count = GetContainerItemInfo(bag, slot)
+                total = total + (count or 1)
+            end
+        end
+    end
+    for slot = 0, 19 do
+        if GetInventoryItemID("player", slot) == want then total = total + 1 end
+    end
+    return total
+end)
+def("GetItemIcon", function(item) return select(10, GetItemInfo(item)) end)
+def("GetItemCooldown", function(item)
+    local want = itemId(item)
+    if want then
+        for bag = 0, 4 do
+            for slot = 1, GetContainerNumSlots(bag) do
+                if idFromLink(GetContainerItemLink(bag, slot)) == want then
+                    return GetContainerItemCooldown(bag, slot)
+                end
+            end
+        end
+    end
+    return 0, 0, 1
+end)
+def("IsUsableItem", function(item) return GetItemCount(item) > 0 and 1 or nil, nil end)
+def("IsItemInRange", none)
+-- By id, link or name. A name the item cache has not seen (`GetItemInfo` answers only cached
+-- items) is matched against the bag links' own `[Name]`, any case, so `UseItemByName("Hearthstone")`
+-- works on a fresh session.
+def("UseItemByName", function(item)
+    local want = itemId(item)
+    local name = type(item) == "string" and not want and item:lower() or nil
+    if not want and not name then return end
+    for bag = 0, 4 do
+        for slot = 1, GetContainerNumSlots(bag) do
+            local link = GetContainerItemLink(bag, slot)
+            if (want and idFromLink(link) == want)
+                or (name and type(link) == "string" and (link:match("%[(.-)%]") or ""):lower() == name) then
+                return UseContainerItem(bag, slot)
+            end
+        end
+    end
+end)
+def("GetContainerFreeSlots", function(bag, out)
+    out = out or {}
+    for slot = 1, GetContainerNumSlots(bag) do
+        if not GetContainerItemLink(bag, slot) then out[#out + 1] = slot end
+    end
+    return out
+end)
+def("GetItemStats", none)
+
+-- Spells ---------------------------------------------------------------------------------------
+def("IsUsableSpell", function(spell)
+    return GetSpellInfo(spell) and 1 or nil, nil
+end)
+def("SpellHasRange", function(spell)
+    local _, _, _, _, _, _, _, _, maxRange = GetSpellInfo(spell)
+    return maxRange and maxRange > 0 and 1 or nil
+end)
+def("IsSpellInRange", none)
+def("GetSpellCount", zero)
+def("IsAttackSpell", function(spell) return GetSpellInfo(spell) == (GetSpellInfo(6603)) and 1 or nil end)
+def("IsAutoRepeatSpell", function(spell)
+    local n = GetSpellInfo(spell)
+    return n ~= nil and (n == GetSpellInfo(75) or n == GetSpellInfo(5019)) and 1 or nil
+end)
+def("IsHarmfulSpell", none)
+def("IsHelpfulSpell", none)
+def("GetMacroBody", function(id) return select(3, GetMacroInfo(id)) end)
+def("GetMacroSpell", none)
+def("GetMacroItem", none)
+def("RunMacroText", function(text)
+    local eb = ChatFrameEditBox or (DEFAULT_CHAT_FRAME and DEFAULT_CHAT_FRAME.editBox)
+    if not (eb and ChatEdit_SendText) then return end
+    for line in tostring(text):gmatch("[^\r\n]+") do
+        eb:SetText(line)
+        ChatEdit_SendText(eb)
+    end
+end)
+
+-- Units, groups, targeting ---------------------------------------------------------------------
+def("UnitInRange", function(unit) return UnitExists(unit) and UnitIsConnected(unit) and 1 or nil end)
+def("UnitVehicleSeatCount", zero)
+def("GetUnitSpeed", function() return 0, 7, 4.5, 4.722222 end)
+def("GetRealNumPartyMembers", function() return GetNumPartyMembers() end)
+def("IsRealPartyLeader", function() return IsPartyLeader() end)
+def("IsRealRaidLeader", function() return IsRaidLeader() end)
+def("TargetNearest", function(...) return TargetNearestEnemy(...) end)
+def("TargetNearestEnemyPlayer", function(...) return TargetNearestEnemy(...) end)
+def("TargetNearestFriendPlayer", function(...) return TargetNearestFriend(...) end)
+for _, n in ipairs({ "TargetLastFriend", "InteractUnit", "CancelShapeshiftForm",
+    "SetDungeonDifficulty", "SetRaidDifficulty", "QueryQuestsCompleted", "UpdateAddOnMemoryUsage",
+    "UpdateAddOnCPUUsage", "ResetCPUUsage" }) do
+    def(n, noop)
+end
+def("GetInstanceDifficulty", function() return 1 end)
+def("GetQuestsCompleted", function(t) return t or {} end)
+def("GetNumGlyphSockets", function() return 6 end)
+def("GetAddOnMemoryUsage", zero)
+def("GetAddOnCPUUsage", zero)
+def("GetFramesRegisteredForEvent", noop)
diff --git a/crates/benilla-ui/src/web_saved.rs b/crates/benilla-ui/src/web_saved.rs
new file mode 100644
index 00000000..1e1b70ca
--- /dev/null
+++ b/crates/benilla-ui/src/web_saved.rs
@@ -0,0 +1,28 @@
+//! wenilla carry: where an addon's saved-variables file is read from in the browser.
+//!
+//! `script::addon::load_saved_variables` reads `<saved dir>/<Addon>.lua` from disk. The browser
+//! build has no filesystem: `benilla-app`'s state folder (`/benilla-config/…`) lives in
+//! `localStorage`, which is also where the shutdown write puts these files. `std::fs::read` there
+//! answers `Unsupported`, not `NotFound`, so every load-on-demand addon (`Blizzard_CombatText` at
+//! world entry) raised a "operation not supported on this platform" error dialog and its saved
+//! values never came back. `benilla-ui` cannot reach that store itself, so `benilla-app` installs
+//! its reader here at boot; until it does, a file reads as absent.
+
+use std::io::{Error, ErrorKind, Result};
+use std::path::Path;
+use std::sync::OnceLock;
+
+static READER: OnceLock<fn(&Path) -> Result<Vec<u8>>> = OnceLock::new();
+
+/// Install the state folder's reader; the first call wins.
+pub fn set_reader(read: fn(&Path) -> Result<Vec<u8>>) {
+    let _ = READER.set(read);
+}
+
+/// A saved-variables file's bytes; `NotFound` when absent, as on disk.
+pub(crate) fn read(path: &Path) -> Result<Vec<u8>> {
