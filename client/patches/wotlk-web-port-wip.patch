+++ b/crates/wenilla-host/src/main.rs
@@ -0,0 +1,397 @@
+//! `wenilla-host` — the piece of the browser build that can't be static hosting: it serves the
+//! wasm bundle, answers game-data reads out of the real MPQ chain, and proxies the two TCP ports
+//! the client needs (login 3724, world 8085) over WebSocket, since a browser tab cannot open a
+//! raw socket. See `web/README.md` for
+//! the exact URL/encoding rules the client lanes code against.
+//!
+//! This host is a **local development tool**. `/data` hands out the operator's game files to
+//! anyone who can reach the socket, with no login, so it binds to loopback by default and must
+//! never be exposed on the open internet. Multi-user hosting is `wenilla-realm`, which mounts the
+//! same routers behind a session cookie.
+//!
+//! Streaming a "mini" slice (a small part of the game) uses four more switches:
+//! - `--record <file>` while serving: append every name served to a manifest (capture).
+//! - `--deps <slice.json> --tiers 0-N --out <dir>`: the static walk of what a slice needs.
+//! - `--export <names...> <outdir>`: copy those names out of the chain into loose files.
+//! - `--only-listed` while serving: serve `--patch` and nothing else (the slice host, which runs
+//!   behind the website's sign-in, never with the full game data).
+//! - `--size-report <slice.json> --out <dir>`: the walk again for the base, every slice tier and
+//!   every instance in Map.dbc, measured (lite and full) without exporting anything.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use anyhow::{bail, Context, Result};
+use benilla_formats::Chain;
+use clap::Parser;
+
+#[derive(Parser)]
+#[command(
+    about = "Serve the benilla browser build, its game data, and its net proxy (local testing only)",
+    after_help = "wenilla-host is for local testing. /data serves the game files under --data to \
+                  anyone who can reach the socket, without any login. Keep it on loopback or a \
+                  private network; never expose it on the open internet. For hosting players, \
+                  use wenilla-realm. --only-listed serves a slice folder only, for a host behind \
+                  a sign-in gate."
+)]
+struct Cli {
+    /// Address to listen on. Loopback by default; anything else exposes `/data` to that
+    /// network unauthenticated (see `--help`).
+    #[arg(long, default_value = "127.0.0.1:8090")]
+    bind: String,
+    /// Directory holding the wasm-bindgen output (`index.html`, `wenilla.js`, `*.wasm`) —
+    /// `scripts/web-build.sh`'s `web/dist/`. Required to serve.
+    #[arg(long)]
+    www: Option<PathBuf>,
+    /// The `Data` directory (or a single `.MPQ`) the chain opens — the same one `benilla`
+    /// itself reads on the desktop. Required except with `--only-listed`.
+    #[arg(long)]
+    data: Option<PathBuf>,
+    /// Host the `/ws/{port}` proxy dials for the allowed ports — the mangos boxes this host
+    /// itself runs against, so it defaults to loopback.
+    #[arg(long, default_value = "127.0.0.1")]
+    upstream: String,
+    /// A folder of edited game files served instead of the archives' copies, by game path
+    /// (`patch\DBFilesClient\Spell.dbc`, `patch\Interface\FrameXML\...`). Defaults to the
+    /// `patch` folder next to the `play` folder when it exists.
+    #[arg(long)]
+    patch: Option<PathBuf>,
+    /// Append every `/data` name served (once each, any case) to this file: run the client,
+    /// visit the places a slice should hold, and the file lists what they needed.
+    #[arg(long, value_name = "FILE")]
+    record: Option<PathBuf>,
+    /// Serve `/data` only for names in `--patch` (everything else 404; `__index` lists only
+    /// those). For a server that holds a slice and nothing else.
+    #[arg(long)]
+    only_listed: bool,
+    /// Export: one or more names lists (text, one name per line, or a `{"names":[...]}`
+    /// manifest), in tier order, then the output folder. Reads `--data` (+ `--patch`).
+    #[arg(long, num_args = 2.., value_names = ["NAMES", "OUTDIR"])]
+    export: Option<Vec<PathBuf>>,
+    /// Export: a boot list exported first (the client's login read-set). Defaults to
+    /// `boot-manifest.json` and `world-manifest.json` in `--www` when given.
+    #[arg(long, value_name = "MANIFEST")]
+    boot: Vec<PathBuf>,
+    /// Export: leave out the first tier that would take the slice over this many MiB, and every
+    /// tier after it. Default: the slice's `budgetMB` with `--slice`.
+    #[arg(long, value_name = "MIB")]
+    budget_mb: Option<u64>,
+    /// Export: report sizes only, write nothing.
+    #[arg(long)]
+    dry_run: bool,
+    /// Export: BLPs under these prefixes keep only mips of at most `--lite-max` px ("lite").
+    #[arg(long, value_name = "PREFIX")]
+    lite_prefix: Vec<String>,
+    /// Export: the long-side limit for lite textures.
+    #[arg(long, default_value_t = 256)]
+    lite_max: u32,
+    /// Export: read `budgetMB` and `lite` from this slice description (`slices/mini.json`).
+    #[arg(long, value_name = "SLICE_JSON")]
+    slice: Option<PathBuf>,
+    /// Static walk: the slice description to walk (`slices/mini.json`).
+    #[arg(long, value_name = "SLICE_JSON")]
+    deps: Option<PathBuf>,
+    /// Static walk: which tiers (`0-3`, `0,2`). Default: `0` to the slice's `maxTier`.
+    #[arg(long)]
+    tiers: Option<String>,
+    /// Static walk: spawned displays (`kind<TAB>map<TAB>displayId`, from `displays.py`).
+    #[arg(long, value_name = "TSV")]
+    displays: Option<PathBuf>,
+    /// Static walk: folder for `tier-<n>.txt`, one names list per tier. Size report: folder for
+    /// `size-report.md` and `size-report.json`.
+    #[arg(long, value_name = "DIR")]
+    out: Option<PathBuf>,
+    /// Size report: walk the base, every tier of this slice and every instance in Map.dbc, and
+    /// report what each would take on the server (lite and full), beyond the base. Writes no game
+    /// file. Uses --data, --displays (displays.py --instances) and --boot.
+    #[arg(long, value_name = "SLICE_JSON")]
+    size_report: Option<PathBuf>,
+}
+
+fn open_chain(data: &Option<PathBuf>) -> Result<Chain> {
+    let Some(data) = data else {
+        bail!("--data (the game's Data folder) is required here");
+    };
+    Chain::open(data).with_context(|| format!("opening {}", data.display()))
+}
+
+fn read_json(path: &std::path::Path) -> Result<serde_json::Value> {
+    let text =
+        std::fs::read_to_string(path).with_context(|| format!("reading {}", path.display()))?;
+    serde_json::from_str(&text).with_context(|| format!("{} is not valid JSON", path.display()))
+}
+
+fn run_deps(cli: &Cli, spec_path: &std::path::Path) -> Result<()> {
+    let mut chain = open_chain(&cli.data)?;
+    let text = std::fs::read_to_string(spec_path)
+        .with_context(|| format!("reading {}", spec_path.display()))?;
+    let spec = wenilla_host::deps::SliceSpec::parse(&text)?;
+    let max_tier = read_json(spec_path)?
+        .get("maxTier")
+        .and_then(|v| v.as_u64())
+        .unwrap_or(0);
+    let tiers =
+        wenilla_host::deps::parse_tiers(cli.tiers.as_deref().unwrap_or(&format!("0-{max_tier}")))?;
+    let displays = match &cli.displays {
+        Some(p) => wenilla_host::deps::parse_displays(
+            &std::fs::read_to_string(p).with_context(|| format!("reading {}", p.display()))?,
+        ),
+        None => {
+            eprintln!("note: no --displays file, so no creature or object models are walked");
+            Vec::new()
+        }
+    };
+    let Some(out) = &cli.out else {
+        bail!("--deps needs --out <folder>");
+    };
+    std::fs::create_dir_all(out)?;
+    let cats = wenilla_host::deps::Catalogs::load(&mut chain)?;
+    for w in &cats.warnings {
+        eprintln!("warning: {w}");
+    }
+    let result = wenilla_host::deps::walk(&chain, &cats, &spec, &tiers, &displays);
+    for t in &result {
+        let path = out.join(format!("tier-{}.txt", t.tier));
+        let mut body = format!("# tier {} {} (wenilla-host --deps)\n", t.tier, t.name);
+        for n in &t.notes {
+            body.push_str(&format!("# {n}\n"));
+        }
+        for n in &t.names {
+            body.push_str(n);
+            body.push('\n');
+        }
+        std::fs::write(&path, body).with_context(|| format!("writing {}", path.display()))?;
+        println!(
+            "tier {:>2} {:<28} {:>7} files  -> {}",
+            t.tier,
+            t.name,
+            t.names.len(),
+            path.display()
+        );
+        for n in &t.notes {
+            println!("         {n}");
+        }
+    }
+    Ok(())
+}
+
+fn lite_of(slice: Option<&serde_json::Value>, cli: &Cli) -> Option<wenilla_host::export::Lite> {
+    let mut prefixes = cli.lite_prefix.clone();
+    let mut max_px = cli.lite_max;
+    if let Some(l) = slice.and_then(|s| s.get("lite")) {
+        if let Some(a) = l.get("prefixes").and_then(|a| a.as_array()) {
+            prefixes.extend(a.iter().filter_map(|p| p.as_str().map(str::to_owned)));
+        }
+        if let Some(m) = l.get("maxPx").and_then(|m| m.as_u64()) {
+            max_px = m as u32;
+        }
+    }
+    (!prefixes.is_empty()).then_some(wenilla_host::export::Lite { max_px, prefixes })
+}
+
+fn run_size_report(cli: &Cli, spec_path: &std::path::Path) -> Result<()> {
+    let mut chain = open_chain(&cli.data)?;
+    let text = std::fs::read_to_string(spec_path)
+        .with_context(|| format!("reading {}", spec_path.display()))?;
+    let slice = read_json(spec_path)?;
+    let displays = match &cli.displays {
+        Some(p) => wenilla_host::deps::parse_displays(
+            &std::fs::read_to_string(p).with_context(|| format!("reading {}", p.display()))?,
+        ),
+        None => {
+            eprintln!("note: no --displays file: creature and object models are not counted");
+            Vec::new()
+        }
+    };
+    let mut boot = Vec::new();
+    for p in &cli.boot {
+        boot.extend(wenilla_host::export::read_names(p)?);
+    }
+    let Some(out) = &cli.out else {
+        bail!("--size-report needs --out <folder>");
+    };
+    let lite = lite_of(Some(&slice), cli);
+    wenilla_host::size::run(&mut chain, &text, &displays, &boot, lite.as_ref(), out)?;
+    println!("\nwritten: {} and {}", out.join("size-report.md").display(), out.join("size-report.json").display());
+    Ok(())
+}
+
+fn run_export(cli: &Cli, args: &[PathBuf]) -> Result<()> {
+    let (out, lists) = args.split_last().expect("clap requires two values");
+    let chain = open_chain(&cli.data)?;
+    let mut sources: Vec<(String, Vec<String>)> = Vec::new();
+    let mut boot = cli.boot.clone();
+    if boot.is_empty() {
+        if let Some(www) = &cli.www {
+            boot = ["boot-manifest.json", "world-manifest.json"]
+                .iter()
+                .map(|m| www.join(m))
+                .filter(|p| p.is_file())
+                .collect();
+        }
+    }
+    if boot.is_empty() {
+        eprintln!(
+            "warning: no boot list (--boot or --www): a slice without the login read-set cannot \
+             reach the login screen"
+        );
+    }
+    for p in boot.iter().chain(lists.iter()) {
+        sources.push((
+            p.display().to_string(),
+            wenilla_host::export::read_names(p)?,
+        ));
+    }
+    let slice = match &cli.slice {
+        Some(p) => Some(read_json(p)?),
+        None => None,
+    };
+    let budget = cli
+        .budget_mb
+        .or_else(|| slice.as_ref()?.get("budgetMB")?.as_u64())
+        .map(|m| m * 1024 * 1024);
+    let lite = lite_of(slice.as_ref(), cli);
+    let reader = wenilla_host::export::layered_reader(Some(&chain), None, cli.patch.as_deref());
+    let report = wenilla_host::export::export_with(
+        &reader,
+        &sources,
+        out,
+        budget,
+        cli.dry_run,
+        lite.as_ref(),
+    )?;
+    print!("{}", wenilla_host::export::summary(&report));
+    if !cli.dry_run {
+        // The per-tier file lists for the browser's "Download this section" (/data/__tier/<n>.txt):
+        // the boot lists are tier 0's, `tier-<n>.txt` lists tier n's; --record captures are not a tier.
+        let names: std::collections::HashMap<u32, String> = match &cli.slice {
+            Some(p) => wenilla_host::deps::SliceSpec::parse(&std::fs::read_to_string(p)?)?
+                .tiers
+                .into_iter()
+                .map(|t| (t.tier, t.name))
+                .collect(),
+            None => Default::default(),
+        };
+        let mut tiers: Vec<wenilla_host::export::TierFiles> = Vec::new();
+        for (i, l) in report.lists.iter().enumerate() {
+            let n = if i < boot.len() { Some(0) } else { wenilla_host::export::tier_of_list(&l.source) };
+            let Some(n) = n else { continue };
+            match tiers.iter_mut().find(|t| t.tier == n) {
+                Some(t) => t.lists.push(l),
+                None => tiers.push(wenilla_host::export::TierFiles {
+                    tier: n,
+                    name: names.get(&n).cloned().unwrap_or_default(),
+                    lists: vec![l],
+                }),
+            }
+        }
+        tiers.sort_by_key(|t| t.tier);
+        wenilla_host::export::write_tier_lists(out, &tiers)?;
+        println!("slice written to {} (tier file lists in .tiers)", out.display());
+    }
+    Ok(())
+}
+
+#[tokio::main]
+async fn main() -> Result<()> {
+    tracing_subscriber::fmt()
+        .with_writer(std::io::stderr)
+        .init();
+    let cli = Cli::parse();
+
+    if let Some(spec) = cli.size_report.clone() {
+        return run_size_report(&cli, &spec);
+    }
+    if let Some(spec) = cli.deps.clone() {
+        return run_deps(&cli, &spec);
+    }
+    if let Some(args) = cli.export.clone() {
+        return run_export(&cli, &args);
+    }
+    let Some(www) = cli.www.clone() else {
+        bail!("--www (the browser build folder) is required to serve");
+    };
+
+    let chain = if cli.only_listed && cli.data.is_none() {
+        None
+    } else {
+        let c = Arc::new(open_chain(&cli.data)?);
+        tracing::info!(data = %cli.data.as_ref().map(|d| d.display().to_string()).unwrap_or_default(), "patch chain open");
+        Some(c)
+    };
+
+    // The player's own loose `Interface` folder beside `Data` (their addons), when there is one.
+    let loose = cli
+        .data
+        .as_ref()
+        .and_then(|d| d.parent())
+        .map(|p| p.join("Interface"))
+        .filter(|p| p.is_dir() && !cli.only_listed);
+    if let Some(l) = &loose {
+        tracing::info!(interface = %l.display(), "serving your loose Interface folder (addons)");
+    }
+    // An optional patch folder (`--patch`, else `patch` beside `--www`'s parent) served before the
+    // chain: drop an edited game file there at its game path to change the client's data.
+    let patch = cli
+        .patch
+        .clone()
+        .or_else(|| www.parent().map(|p| p.join("..").join("patch")))
+        .filter(|p| p.is_dir());
+    if let Some(p) = &patch {
+        tracing::info!(patch = %p.display(), "serving the patch folder over the game files");
+    }
+    if cli.only_listed {
+        let Some(p) = &patch else {
+            bail!("--only-listed needs --patch <slice folder> (an existing folder)");
+        };
+        tracing::info!(slice = %p.display(), "only-listed: serving this folder and nothing else");
+    }
+    let record = match &cli.record {
+        Some(path) => {
+            tracing::info!(record = %path.display(), "recording every name served");
+            Some(Arc::new(wenilla_host::data::Recorder::open(path)?))
+        }
+        None => None,
+    };
+    let app = wenilla_host::data::router_with_config(wenilla_host::data::DataConfig {
+        chain,
+        loose,
+        patch,
+        only_listed: cli.only_listed,
+        record,
+    })
+    .merge(wenilla_host::ws::router(
+        cli.upstream.clone(),
+        wenilla_host::ALLOWED_PORTS,
+    ))
+    .merge(wenilla_host::static_site::router(&www));
+
+    let listener = tokio::net::TcpListener::bind(&cli.bind)
+        .await
+        .with_context(|| format!("binding {}", cli.bind))?;
+    if !binds_loopback(&listener) {
+        if cli.only_listed {
+            tracing::warn!(
+                bind = %cli.bind,
+                "serving a slice beyond loopback: keep this behind the sign-in gate"
+            );
+        } else {
+            tracing::warn!(
+                bind = %cli.bind,
+                "wenilla-host is a local testing tool: /data serves your game files to anyone who \
+                 can reach this address, with no login. Do not expose it on the open internet — use \
+                 wenilla-realm to host players."
+            );
+        }
+    }
+    tracing::info!(bind = %cli.bind, www = %www.display(), upstream = %cli.upstream, "wenilla-host listening");
+    axum::serve(listener, app).await.context("serving")
+}
+
+/// Is the listener bound to a loopback address (the only place `/data` is safe unauthenticated)?
+fn binds_loopback(listener: &tokio::net::TcpListener) -> bool {
+    listener
+        .local_addr()
+        .map(|a| a.ip().is_loopback())
+        .unwrap_or(false)
+}
