+//! `--deps`: work out, without playing, which game files a "mini" slice needs — a static walk of
+//! the game data from a slice description (`slices/mini.json`), tier by tier.
+//!
+//! Per tier:
+//! - `prefixes`: every listed chain name under these folders (the shared base: UI, DBCs, the
+//!   player models, spell effects, interface sounds...).
+//! - `names`: single files.
+//! - `maps`: each map's WDT and WDL, its ADT tiles (all of them; for a `zone` only the tiles
+//!   covering that zone's `WorldMapArea` rect; for a world `box` [x min, x max, y min, y max]
+//!   the tiles under it; for `tiles` [x0, x1, y0, y1] those; each plus `marginTiles`), the map's
+//!   loading screen and the minimap tiles; a WMO-only map's global WMO.
+//!
+//! Tier numbers: with a top-level `order` (a list of tier `key`s), a tier's number is its
+//! position there and tiers left out of it are not walked; without one, each tier's `tier`.
+//! - creature and game-object displays spawned on those maps (`--displays`, from the server's
+//!   database: `stream/displays.py`), resolved through `CreatureDisplayInfo` /
+//!   `CreatureModelData` / `CreatureDisplayInfoExtra` / `GameObjectDisplayInfo`.
+//!
+//! Every model found is followed recursively: an ADT's textures, M2s (MMDX) and WMOs (MWMO); a
+//! WMO's groups, textures, doodads (MODN) and skybox (MOSB); an M2's skin profiles, `.anim`
+//! files and file-named textures. Only names the chain actually holds are emitted.
+//!
+//! Known gaps, which a `--record` session of the slice finds: sounds (zone music, ambience,
+//! creature voices), the world-map and dungeon-map art of instances, spell visuals that are not
+//! under the tier's prefixes, creatures summoned by scripts rather than spawned, and textures a
+//! model only gets at run time (equipment on NPCs, through the item prefixes).
+
+use std::collections::{HashSet, VecDeque};
+use std::io::Cursor;
+
+use anyhow::{bail, Context, Result};
+use benilla_formats::Chain;
+
+use crate::data::name_key;
+
+/// A slice description (the parts the walker reads).
+pub struct SliceSpec {
+    pub tiers: Vec<TierSpec>,
+}
+
+pub struct TierSpec {
+    pub tier: u32,
+    /// The stable name `order` refers to (empty in an older file without `order`).
+    pub key: String,
+    pub name: String,
+    pub prefixes: Vec<String>,
+    pub names: Vec<String>,
+    pub maps: Vec<MapSpec>,
+}
+
+pub struct MapSpec {
+    pub id: u32,
+    /// Only the tiles under this `AreaTable` zone's world-map rect.
+    pub zone: Option<u32>,
+    /// Only the tiles under this world rect: x min, x max, y min, y max (a subzone, which has no
+    /// world-map rect of its own: Northshire Valley, the Valley of Trials).
+    pub world_box: Option<[f32; 4]>,
+    /// Only these tiles: x0, x1, y0, y1 (inclusive).
+    pub tiles: Option<[u32; 4]>,
+    pub margin_tiles: u32,
+}
+
+impl MapSpec {
+    /// The whole map.
+    pub fn whole(id: u32) -> Self {
+        Self { id, zone: None, world_box: None, tiles: None, margin_tiles: 0 }
+    }
+}
+
+fn f32x4(v: &serde_json::Value, key: &str) -> Result<Option<[f32; 4]>> {
+    let Some(a) = v.get(key) else { return Ok(None) };
+    let a: Vec<f32> = a
+        .as_array()
+        .map(|a| a.iter().filter_map(|x| x.as_f64()).map(|x| x as f32).collect())
+        .unwrap_or_default();
+    if a.len() < 4 {
+        bail!("\"{key}\" needs four numbers");
+    }
+    Ok(Some([a[0], a[1], a[2], a[3]]))
+}
+
+fn u32_of(v: &serde_json::Value, key: &str) -> Option<u32> {
+    v.get(key).and_then(|x| x.as_u64()).map(|x| x as u32)
+}
+
+fn strings_of(v: &serde_json::Value, key: &str) -> Vec<String> {
+    v.get(key)
+        .and_then(|x| x.as_array())
+        .map(|a| {
+            a.iter()
+                .filter_map(|s| s.as_str().map(str::to_owned))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+impl SliceSpec {
+    pub fn parse(text: &str) -> Result<Self> {
+        let v: serde_json::Value = serde_json::from_str(text).context("slice JSON")?;
+        let Some(tiers) = v.get("tiers").and_then(|t| t.as_array()) else {
+            bail!("the slice has no \"tiers\" array");
+        };
+        // With "order": tier number = position of the tier's key in it.
+        let order: Option<Vec<String>> = v.get("order").map(|o| {
+            o.as_array()
+                .map(|a| a.iter().filter_map(|k| k.as_str().map(str::to_owned)).collect())
+                .unwrap_or_default()
+        });
+        if let Some(order) = &order {
+            for (i, k) in order.iter().enumerate() {
+                if order[..i].contains(k) {
+                    bail!("\"order\" lists {k:?} twice");
+                }
+                if !tiers.iter().any(|t| t.get("key").and_then(|x| x.as_str()) == Some(k)) {
+                    bail!("\"order\" lists {k:?}, but no tier has that key");
+                }
+            }
+        }
+        let mut out = Vec::new();
+        for t in tiers {
+            let key = t.get("key").and_then(|k| k.as_str()).unwrap_or("").to_owned();
+            let tier = match &order {
+                Some(order) => match order.iter().position(|k| *k == key) {
+                    Some(i) => i as u32,
+                    None => continue, // left out of "order": not streamed
+                },
+                None => match u32_of(t, "tier") {
+                    Some(n) => n,
+                    None => bail!("a tier has no numeric \"tier\" (and the slice has no \"order\")"),
+                },
+            };
+            let mut maps = Vec::new();
+            for m in t
+                .get("maps")
+                .and_then(|m| m.as_array())
+                .into_iter()
+                .flatten()
+            {
+                let Some(id) = u32_of(m, "id") else {
+                    bail!("tier {tier}: a map has no numeric \"id\"");
+                };
+                let tiles = f32x4(m, "tiles")
+                    .with_context(|| format!("tier {tier}, map {id}"))?
+                    .map(|t| [t[0] as u32, t[1] as u32, t[2] as u32, t[3] as u32]);
+                let world_box = f32x4(m, "box").with_context(|| format!("tier {tier}, map {id}"))?;
+                if let Some(b) = world_box {
+                    if !(b[0] < b[1] && b[2] < b[3]) {
+                        bail!("tier {tier}, map {id}: box must be [x min, x max, y min, y max]");
+                    }
+                }
+                maps.push(MapSpec {
+                    id,
+                    zone: u32_of(m, "zone"),
+                    world_box,
+                    tiles,
+                    margin_tiles: u32_of(m, "marginTiles").unwrap_or(0),
+                });
+            }
+            out.push(TierSpec {
+                tier,
+                key,
+                name: t
+                    .get("name")
+                    .and_then(|n| n.as_str())
+                    .unwrap_or("")
+                    .to_owned(),
+                prefixes: strings_of(t, "prefixes"),
+                names: strings_of(t, "names"),
+                maps,
+            });
+        }
+        out.sort_by_key(|t| t.tier);
+        Ok(Self { tiers: out })
+    }
+}
+
+/// `"0-3"`, `"2"`, `"0,2-4"` → the tier numbers.
+pub fn parse_tiers(s: &str) -> Result<Vec<u32>> {
+    let mut out = Vec::new();
+    for part in s.split(',').map(str::trim).filter(|p| !p.is_empty()) {
+        let (a, b) = part.split_once('-').unwrap_or((part, part));
+        let (a, b): (u32, u32) = (
+            a.trim().parse().with_context(|| format!("tier {a:?}"))?,
+            b.trim().parse().with_context(|| format!("tier {b:?}"))?,
+        );
+        if a > b {
+            bail!("tier range {part:?} runs backwards");
+        }
+        out.extend(a..=b);
+    }
+    out.sort_unstable();
+    out.dedup();
+    Ok(out)
+}
+
+/// One spawned display from the server: `kind` `c` (creature) or `g` (game object).
+pub struct Display {
+    pub kind: char,
+    pub map: u32,
+    pub id: u32,
+    /// The tier whose map entry holds the spawn (`displays.py`'s fourth column); `None` (`-` or
+    /// no column): any tier with this map.
+    pub tier: Option<u32>,
+}
+
+/// Read `displays.tsv` (`kind<TAB>map<TAB>displayId[<TAB>tier]` per line, as `mysql -N -B`
+/// prints it).
+pub fn parse_displays(text: &str) -> Vec<Display> {
+    text.lines()
+        .filter_map(|l| {
+            let mut f = l.split('\t').map(str::trim);
+            let kind = f.next()?.chars().next()?;
+            let map = f.next()?.parse().ok()?;
+            let id = f.next()?.parse().ok()?;
+            let tier = f.next().and_then(|t| t.parse().ok());
+            (matches!(kind, 'c' | 'g') && id != 0).then_some(Display { kind, map, id, tier })
+        })
+        .collect()
+}
+
+/// What the walker reads the game data through, so it can be tested without an install.
+pub trait Source {
+    fn contains(&self, name: &str) -> bool;
+    fn read(&self, name: &str) -> Option<Vec<u8>>;
+    /// Every listed name (for `prefixes`).
+    fn list(&self) -> Vec<String>;
+}
+
+impl Source for Chain {
+    fn contains(&self, name: &str) -> bool {
+        Chain::contains(self, name)
+    }
+    fn read(&self, name: &str) -> Option<Vec<u8>> {
+        Chain::read(self, name).ok()
+    }
+    fn list(&self) -> Vec<String> {
+        Chain::list(self)
+            .map(|v| v.into_iter().map(|e| e.name).collect())
+            .unwrap_or_default()
+    }
+}
+
+/// The DBC-derived lookups the walker needs, loaded once from the chain (or faked in tests).
+#[derive(Default)]
+pub struct Catalogs {
+    /// map id → `Map.dbc` directory.
+    pub map_dir: std::collections::HashMap<u32, String>,
+    /// map id → loading-screen file.
+    pub loading_screen: std::collections::HashMap<u32, String>,
+    /// zone (`AreaTable`) id → world rect (left, right, top, bottom: left/right world Y,
+    /// top/bottom world X).
+    pub zone_rect: std::collections::HashMap<u32, (f32, f32, f32, f32)>,
+    /// creature display id → (model path, texture variation names, baked NPC texture).
+    pub creature: std::collections::HashMap<u32, (String, Vec<String>, Option<String>)>,
+    /// game-object display id → model path.
+    pub gameobject: std::collections::HashMap<u32, String>,
+    /// lower-case `<dir>\map<x>_<y>.blp` → hashed minimap file name.
+    pub minimap: Option<benilla_formats::MinimapTranslate>,
+    /// Catalogs that failed to load (the walk goes on without them; printed by `--deps`).
+    pub warnings: Vec<String>,
+}
+
+impl Catalogs {
+    pub fn load(chain: &mut Chain) -> Result<Self> {
+        let mut c = Catalogs::default();
+        let maps = benilla_formats::load_map_catalog(chain).context("Map.dbc")?;
+        let screens = match benilla_formats::load_loading_screens(chain) {
+            Ok(s) => Some(s),
+            Err(e) => {
+                c.warnings.push(format!("LoadingScreens.dbc: {e:#}"));
+                None
+            }
+        };
+        // `MapCatalog` has no iterator over every row; ids below 2000 cover 3.3.5a's Map.dbc.
+        for id in 0..2000u32 {
+            if let Some(dir) = maps.directory(id) {
+                c.map_dir.insert(id, dir.to_owned());
+                if let (Some(s), Some(ls)) = (&screens, maps.loading_screen_id(id)) {
+                    if let Some(p) = s.path(ls) {
+                        c.loading_screen.insert(id, p.to_owned());
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_world_map_area_catalog(chain) {
+            Err(e) => c.warnings.push(format!("WorldMapArea.dbc: {e:#}")),
+            Ok(wma) => {
+                for (_, a) in wma.iter() {
+                    if a.area_id != 0 {
+                        c.zone_rect.insert(
+                            a.area_id,
+                            (a.loc_left, a.loc_right, a.loc_top, a.loc_bottom),
+                        );
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_creature_catalog(chain) {
+            Err(e) => c.warnings.push(format!("creature displays: {e:#}")),
+            Ok(cc) => {
+                for (display, _) in cc.display_models() {
+                    if let Some(m) = cc.model(display) {
+                        let bake = m.npc_appearance.as_ref().and_then(|a| a.bake_name.clone());
+                        let tex = m.textures.iter().flatten().cloned().collect();
+                        c.creature.insert(display, (m.model_path, tex, bake));
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_gameobject_catalog(chain) {
+            Err(e) => c.warnings.push(format!("GameObjectDisplayInfo.dbc: {e:#}")),
+            Ok(go) => {
+                for (id, path) in go.iter() {
+                    c.gameobject.insert(id, path.to_owned());
+                }
+            }
+        }
+        match benilla_formats::load_minimap_translate(chain) {
+            Ok(m) => c.minimap = Some(m),
+            Err(e) => c.warnings.push(format!("minimap md5translate: {e:#}")),
+        }
+        Ok(c)
+    }
+}
+
+/// The walk's result: one ordered list of names per tier, each without the names of earlier
+/// tiers, plus notes on what could not be resolved.
+pub struct TierNames {
+    pub tier: u32,
+    pub name: String,
+    pub names: Vec<String>,
+    pub notes: Vec<String>,
+}
+
+/// `.mdx` / `.mdl` (the DBC spelling) → `.m2` (what is in the archives).
+pub fn m2_name(path: &str) -> String {
+    let lower = path.to_ascii_lowercase();
+    if lower.ends_with(".mdx") || lower.ends_with(".mdl") {
+        format!("{}.m2", &path[..path.len() - 4])
+    } else {
+        path.to_owned()
+    }
+}
+
+fn dir_of(path: &str) -> &str {
+    path.rfind(['\\', '/']).map_or("", |i| &path[..=i])
+}
+
+/// The zero-terminated strings of a string block (MOTX, MODN, MTEX...).
+fn strings(block: &[u8]) -> Vec<String> {
+    block
+        .split(|&b| b == 0)
+        .filter(|s| !s.is_empty())
+        .map(|s| String::from_utf8_lossy(s).into_owned())
+        .collect()
+}
+
+/// A chunked file's `(magic as stored, payload)` pairs; stops at the first malformed chunk.
+fn chunks(b: &[u8]) -> Vec<([u8; 4], &[u8])> {
+    let mut out = Vec::new();
+    let mut at = 0usize;
+    while at + 8 <= b.len() {
+        let magic = [b[at], b[at + 1], b[at + 2], b[at + 3]];
+        let size = u32::from_le_bytes([b[at + 4], b[at + 5], b[at + 6], b[at + 7]]) as usize;
+        let Some(end) = (at + 8).checked_add(size).filter(|&e| e <= b.len()) else {
+            break;
+        };
+        out.push((magic, &b[at + 8..end]));
+        at = end;
+    }
+    out
+}
+
+fn u32_at(b: &[u8], at: usize) -> Option<u32> {
+    b.get(at..at + 4)
+        .map(|s| u32::from_le_bytes([s[0], s[1], s[2], s[3]]))
+}
+
+/// An M2's skin-profile count and file-named textures (version 264 header: `nViews` at 0x44,
+/// the texture array at 0x50, 16-byte entries `type, flags, filename (len, ofs)`).
+pub fn m2_refs(m2: &[u8]) -> (u32, Vec<String>) {
+    if m2.get(0..4) != Some(b"MD20") {
+        return (0, Vec::new());
+    }
+    let views = u32_at(m2, 0x44).unwrap_or(0).min(8);
+    let mut tex = Vec::new();
+    if let (Some(n), Some(ofs)) = (u32_at(m2, 0x50), u32_at(m2, 0x54)) {
+        for i in 0..n.min(512) as usize {
+            let e = ofs as usize + i * 16;
+            let (Some(kind), Some(len), Some(at)) =
+                (u32_at(m2, e), u32_at(m2, e + 8), u32_at(m2, e + 12))
+            else {
+                break;
+            };
+            if kind != 0 || len < 2 {
+                continue;
+            }
+            if let Some(s) = m2.get(at as usize..at as usize + len as usize) {
+                let s = s.split(|&b| b == 0).next().unwrap_or(&[]);
+                if !s.is_empty() {
+                    tex.push(String::from_utf8_lossy(s).into_owned());
+                }
+            }
+        }
+    }
+    (views, tex)
+}
+
+/// A WMO root's textures (MOTX), doodads (MODN) plus skybox (MOSB), and group count (MOHD +4).
+pub fn wmo_refs(root: &[u8]) -> (Vec<String>, Vec<String>, u32) {
+    let mut tex = Vec::new();
+    let mut doodads = Vec::new();
+    let mut groups = 0;
+    for (magic, data) in chunks(root) {
+        match &magic {
+            b"XTOM" => tex.extend(strings(data)),
+            // The skybox model (MOSB) is followed like a doodad.
+            b"NDOM" | b"BSOM" => doodads.extend(strings(data)),
+            b"DHOM" => groups = u32_at(data, 4).unwrap_or(0).min(512),
+            _ => {}
+        }
+    }
+    (tex, doodads, groups)
+}
+
+/// The names a model refers to (candidates: the walker keeps those the data has). M2: skin
+/// profiles, file-named textures, `.anim` files. WMO root: textures, groups, doodads, skybox
+/// (a group file names nothing). ADT: textures (and their `_s` companions), M2s, WMOs.
+pub fn model_refs(name: &str, bytes: &[u8]) -> Vec<String> {
+    let key = name_key(name);
+    let mut out = Vec::new();
+    if key.ends_with(".m2") {
+        let stem = &name[..name.len() - 3];
+        let (views, tex) = m2_refs(bytes);
+        for i in 0..views.max(1) {
+            out.push(format!("{stem}{i:02}.skin"));
+        }
+        out.extend(tex);
+        if let Ok(anims) = benilla_m2::anim_paths(bytes, name) {
+            out.extend(anims.into_iter().map(|(_, a)| a));
+        }
+    } else if key.ends_with(".wmo") {
+        let stem = &name[..name.len() - 4];
+        let is_group = stem.len() > 4
+            && stem.as_bytes()[stem.len() - 4] == b'_'
+            && stem[stem.len() - 3..].bytes().all(|b| b.is_ascii_digit());
+        if is_group {
+            return out;
+        }
+        let (tex, doodads, groups) = wmo_refs(bytes);
+        // The repo's parser agrees on the texture list; it is the one the renderer trusts.
+        if let Ok(benilla_wmo::ParsedWmo::Root(root)) =
+            benilla_wmo::parse_wmo(&mut Cursor::new(bytes))
+        {
+            out.extend(root.textures.iter().cloned());
+        }
+        out.extend(tex);
+        for g in 0..groups {
+            out.push(format!("{stem}_{g:03}.wmo"));
+        }
+        out.extend(doodads.iter().map(|d| m2_name(d)));
+    } else if key.ends_with(".adt") {
+        let Ok(benilla_adt::ParsedAdt::Root(adt)) = benilla_adt::parse_adt(&mut Cursor::new(bytes))
+        else {
+            return out;
+        };
+        for t in &adt.textures {
+            out.push(t.clone());
+            // The specular/height companions some terrain textures ship with.
+            if let Some(stem) = t.strip_suffix(".blp").or_else(|| t.strip_suffix(".BLP")) {
+                out.push(format!("{stem}_s.blp"));
+            }
+        }
+        out.extend(adt.models.iter().map(|m| m2_name(m)));
+        out.extend(adt.wmos.iter().cloned());
+    }
+    out
+}
+
+/// What one model names (candidate names, before the existence check), per model key: shared
+/// between walkers so `--size-report` reads and parses each model once however many instances
+/// use it.
+pub type RefsCache = std::cell::RefCell<std::collections::HashMap<String, Vec<String>>>;
+
+/// The ADT tiles `[x0, x1, y0, y1]` (inclusive) a map entry streams: `tiles`, else the tiles
+/// under the world `box`, else under the zone's world-map rect, each widened by `marginTiles`;
+/// else the whole map. The note says when a zone had no rect.
+pub fn tile_rect(cat: &Catalogs, m: &MapSpec) -> ([u32; 4], Option<String>) {
+    let grow = |a: u32, b: u32| {
+        (a.min(b).saturating_sub(m.margin_tiles), (a.max(b) + m.margin_tiles).min(63))
+    };
+    let corners = |a: (u32, u32), b: (u32, u32)| {
+        let (x0, x1) = grow(a.0, b.0);
+        let (y0, y1) = grow(a.1, b.1);
+        [x0, x1, y0, y1]
+    };
+    if let Some([tx0, tx1, ty0, ty1]) = m.tiles {
+        return (corners((tx0.min(63), ty0.min(63)), (tx1.min(63), ty1.min(63))), None);
+    }
+    if let Some([wx0, wx1, wy0, wy1]) = m.world_box {
+        // world_to_tile(world x, world y) -> (tile x from world y, tile y from world x)
+        let a = benilla_formats::world_to_tile(wx0, wy0);
+        let b = benilla_formats::world_to_tile(wx1, wy1);
+        return (corners(a, b), None);
+    }
+    if let Some(zone) = m.zone {
+        return match cat.zone_rect.get(&zone) {
+            // left/right are world Y, top/bottom world X
+            Some(&(left, right, top, bottom)) => (
+                corners(
+                    benilla_formats::world_to_tile(top, left),
+                    benilla_formats::world_to_tile(bottom, right),
+                ),
+                None,
+            ),
+            None => (
+                [0, 63, 0, 63],
+                Some(format!("zone {zone}: no WorldMapArea rect; taking the whole map")),
+            ),
+        };
+    }
+    ([0, 63, 0, 63], None)
+}
+
+/// The walker: collects names in discovery order, each once (MPQ name rules).
+pub struct Walker<'a, S: Source> {
+    src: &'a S,
+    seen: HashSet<String>,
+    current: Vec<String>,
+    queue: VecDeque<String>,
+    refs: Option<&'a RefsCache>,
+    pub notes: Vec<String>,
+}
+
+impl<'a, S: Source> Walker<'a, S> {
+    pub fn new(src: &'a S) -> Self {
+        Self {
+            src,
+            seen: HashSet::new(),
+            current: Vec::new(),
+            queue: VecDeque::new(),
+            refs: None,
+            notes: Vec::new(),
+        }
+    }
+
+    /// A walker that already knows `seen` (names a shared base holds: never emitted again) and
+    /// shares parsed model references through `refs`.
+    pub fn seeded(src: &'a S, seen: &HashSet<String>, refs: Option<&'a RefsCache>) -> Self {
+        let mut w = Self::new(src);
+        w.seen = seen.clone();
+        w.refs = refs;
+        w
+    }
+
+    /// Every name key this walker has emitted or was seeded with.
+    pub fn seen(&self) -> &HashSet<String> {
+        &self.seen
+    }
+
+    /// Add one name if the data has it; models are queued for [`Walker::drain`].
+    pub fn add(&mut self, name: &str) -> bool {
+        let name = name.trim().replace('/', "\\");
+        if name.is_empty() {
+            return false;
+        }
+        let key = name_key(&name);
+        if self.seen.contains(&key) {
+            return true;
+        }
+        if !self.src.contains(&name) {
+            return false;
+        }
+        self.seen.insert(key.clone());
+        self.current.push(name.clone());
+        if key.ends_with(".m2") || key.ends_with(".wmo") || key.ends_with(".adt") {
+            self.queue.push_back(name);
+        }
+        true
+    }
+
+    pub fn add_model(&mut self, path: &str) -> bool {
+        self.add(&m2_name(path))
+    }
+
+    /// Follow every queued model's references until nothing new turns up.
+    pub fn drain(&mut self) {
+        while let Some(name) = self.queue.pop_front() {
+            let key = name_key(&name);
+            let cached = self.refs.and_then(|c| c.borrow().get(&key).cloned());
+            let refs = match cached {
+                Some(r) => r,
+                None => {
+                    let Some(bytes) = self.src.read(&name) else {
+                        continue;
+                    };
+                    let r = model_refs(&name, &bytes);
+                    if let Some(c) = self.refs {
+                        c.borrow_mut().insert(key, r.clone());
+                    }
+                    r
+                }
+            };
+            for r in refs {
+                self.add(&r);
+            }
+        }
+    }
+
+    /// Everything listed under `prefix` (any case).
+    pub fn add_prefix(&mut self, all: &[String], prefix: &str) -> usize {
+        let p = name_key(prefix);
+        let mut n = 0;
+        for name in all {
+            if name_key(name).starts_with(&p) && self.add(name) {
+                n += 1;
+            }
+        }
+        n
+    }
+
+    /// One map: WDT, WDL, tiles (optionally only a zone's, a box's or a tile rect), loading
+    /// screen, minimap tiles.
+    pub fn add_map(&mut self, cat: &Catalogs, m: &MapSpec) {
+        let Some(dir) = cat.map_dir.get(&m.id).cloned() else {
+            self.notes.push(format!("map {}: not in Map.dbc", m.id));
+            return;
+        };
+        let base = format!("World\\Maps\\{dir}\\{dir}");
+        self.add(&format!("{base}.wdl"));
+        if let Some(ls) = cat.loading_screen.get(&m.id) {
+            self.add(ls);
+        }
+        let wdt_name = format!("{base}.wdt");
+        if !self.add(&wdt_name) {
+            self.notes.push(format!("map {} ({dir}): no WDT", m.id));
+            return;
+        }
+        let Some(bytes) = self.src.read(&wdt_name) else {
+            return;
+        };
+        let wdt = match benilla_formats::WdtReader::new(
+            Cursor::new(bytes.as_slice()),
+            benilla_formats::WowVersion::Classic,
+        )
+        .read()
+        {
+            Ok(w) => w,
+            Err(e) => {
+                self.notes
+                    .push(format!("map {} ({dir}): WDT unreadable: {e}", m.id));
+                return;
+            }
+        };
+        if let Some(g) = wdt.global_wmo() {
+            self.add(&g.model);
+        }
+        let ([x0, x1, y0, y1], note) = tile_rect(cat, m);
+        if let Some(n) = note {
+            self.notes.push(n);
+        }
+        let mut tiles = 0;
+        for y in y0..=y1 {
+            for x in x0..=x1 {
+                if !wdt
+                    .get_tile(x as usize, y as usize)
+                    .is_some_and(|t| t.has_adt)
+                {
+                    continue;
+                }
+                if self.add(&format!("{base}_{x}_{y}.adt")) {
+                    tiles += 1;
+                }
+                if let Some(h) = cat.minimap.as_ref().and_then(|t| t.tile(&dir, x, y)) {
+                    self.add(&format!("Textures\\Minimap\\{h}"));
+                }
+            }
+        }
+        self.notes.push(format!(
+            "map {} ({dir}): {tiles} tiles x {x0}..{x1} y {y0}..{y1}",
+            m.id
+        ));
+    }
+
+    pub fn add_creature(&mut self, cat: &Catalogs, display: u32) {
+        let Some((model, tex, bake)) = cat.creature.get(&display) else {
+            return;
+        };
+        let m2 = m2_name(model);
+        self.add(&m2);
+        let dir = dir_of(&m2).to_owned();
+        for t in tex {
+            self.add(&format!("{dir}{t}.blp"));
+        }
+        if let Some(b) = bake {
+            let b = if b.contains('.') {
+                b.clone()
+            } else {
+                format!("{b}.blp")
+            };
+            self.add(&format!("Textures\\BakedNpcTextures\\{b}"));
+        }
+    }
+
+    pub fn add_gameobject(&mut self, cat: &Catalogs, display: u32) {
+        if let Some(model) = cat.gameobject.get(&display) {
+            self.add_model(model);
+        }
+    }
+
+    /// Close the current tier: its names, in discovery order.
+    pub fn take(&mut self) -> Vec<String> {
+        std::mem::take(&mut self.current)
+    }
+}
+
+/// Walk `tiers` of `spec` in order; each tier's list excludes earlier tiers' names.
+pub fn walk<S: Source>(
+    src: &S,
+    cat: &Catalogs,
+    spec: &SliceSpec,
+    tiers: &[u32],
+    displays: &[Display],
+) -> Vec<TierNames> {
+    let mut w = Walker::new(src);
+    let mut listed: Option<Vec<String>> = None;
+    let mut out = Vec::new();
+    for t in spec.tiers.iter().filter(|t| tiers.contains(&t.tier)) {
+        if !t.prefixes.is_empty() && listed.is_none() {
+            listed = Some(src.list());
+        }
+        for p in &t.prefixes {
+            let n = w.add_prefix(listed.as_deref().unwrap_or(&[]), p);
+            w.notes.push(format!("prefix {p}: {n} files"));
+        }
+        for n in &t.names {
+            if !w.add(n) {
+                w.notes.push(format!("name not in the data: {n}"));
+            }
+        }
+        for m in &t.maps {
+            w.add_map(cat, m);
+        }
+        let maps: HashSet<u32> = t.maps.iter().map(|m| m.id).collect();
+        let (mut c, mut g) = (0, 0);
+        let mine = |d: &&Display| match d.tier {
+            Some(n) => n == t.tier,
+            None => maps.contains(&d.map),
+        };
+        for d in displays.iter().filter(mine) {
+            if d.kind == 'c' {
+                w.add_creature(cat, d.id);
+                c += 1;
+            } else {
+                w.add_gameobject(cat, d.id);
+                g += 1;
+            }
+        }
+        if c + g > 0 {
+            w.notes
+                .push(format!("{c} creature and {g} object displays"));
+        }
+        w.drain();
+        out.push(TierNames {
+            tier: t.tier,
+            name: t.name.clone(),
+            names: w.take(),
+            notes: std::mem::take(&mut w.notes),
+        });
+    }
+    out
+}
+
