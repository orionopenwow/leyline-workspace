+    } else if (typeof stage === 'string' && stage.startsWith('glue:')) {
+      window.__wenilla_glue_screen = stage.slice(5);
+    } else if (typeof stage === 'string' && stage.startsWith('reconnect:')) {
+      reconnectOverlay(Number(stage.slice(10)) || 0);
+    } else if (stage === 'reconnecting') {
+      reconnectOverlay(-1);
+    } else if (typeof stage === 'string' && stage.startsWith('port:')) {
+      // An in-world port: warm the destination's tier now, at full priority (the cover is up).
+      WORLD.focus = stage.slice(5);
+      if (!skipPrefetch) prefetchWorld({ urgent: true }).catch(() => {});
+    } else if (typeof stage === 'string' && stage.startsWith('focus:')) {
+      reconnectOverlay(null);
+      WORLD.focus = stage.slice(6);
