+/// Spinners and sliders, posed from the phase tick exactly as the simulation poses them.
+fn animate_movers(golf: Res<Golf>, time: Res<Time>, mut transforms: Query<&mut Transform, Without<FlyCam>>) {
+    if golf.movers.is_empty() {
+        return;
+    }
+    let phase = match &golf.roll {
+        // During a roll, the roll's own frame: the bar the ball meets is where the ball meets it.
+        Some(r) => r.phase + ((time.elapsed_secs() - r.start).max(0.0) * golf::TICK_HZ as f32) as i64,
+        None => golf.phase_now(time.elapsed_secs()),
+    };
+    for (e, piece) in &golf.movers {
+        if let Ok(mut t) = transforms.get_mut(*e) {
+            let (c, r) = piece_pose(piece, phase);
+            t.translation = golf.world(c);
+            t.rotation = golf.world_rot(&r);
+        }
+    }
+}
