+/// [`TexCoords::Corners`] for `Texture:SetRotation`: each screen corner of the quad samples the
+/// unit square's matching corner turned by `-radians` about `(cx, cy)`, so the art turns
+/// counterclockwise on screen. Worked in a y-up frame, as the screen's, then flipped back to the
+/// texture's y-down `v`.
+pub(crate) fn rotated_tex_coords(radians: f32, cx: f32, cy: f32) -> TexCoords {
+    let (sin, cos) = radians.sin_cos();
+    // The corner's offset from the pivot in y-up texture units, turned clockwise (`-radians`).
+    let turn = |u: f32, v: f32| -> [f32; 2] {
+        let (x, y) = (u - cx, cy - v);
+        let (rx, ry) = (x * cos + y * sin, -x * sin + y * cos);
+        [cx + rx, cy - ry]
+    };
