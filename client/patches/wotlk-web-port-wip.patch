+/// `UIParent:SetScale` scales the whole UI about the screen's TOPLEFT as the stock game does: the
+/// parent still fills the screen (its own-space size is the screen over the scale), so a frame
+/// anchored to its left or right edge stays on screen at any scale.
+#[test]
+fn a_scaled_uiparent_still_fills_the_screen() {
+    let mut s = script();
+    s.set_screen_size(1024.0, 768.0);
+    s.run(
+        r#"
+        local p = CreateFrame("Frame", "UIParent") p:SetAllPoints()
+        l = CreateFrame("Frame", "LeftKid", UIParent)
+        l:SetPoint("TOPLEFT", 100, -100); l:SetWidth(50); l:SetHeight(50)
+        r = CreateFrame("Frame", "RightKid", UIParent)
+        r:SetPoint("RIGHT", -10, 0); r:SetWidth(50); r:SetHeight(50)
+    "#,
+    )
+    .unwrap();
+    for scale in [0.5_f32, 0.78, 1.25] {
+        s.run(&format!("UIParent:SetScale({scale})")).unwrap();
+        s.resolve();
+        let got: (f32, f32, f32, f32, f32) = s
+            .eval(
+                "return UIParent:GetWidth(), UIParent:GetHeight(), LeftKid:GetLeft(), \
+                 LeftKid:GetTop(), RightKid:GetRight()",
+            )
+            .unwrap();
+        let (w, h) = (1024.0 / scale, 768.0 / scale);
+        let near = |a: f32, b: f32| (a - b).abs() < 0.05;
+        assert!(near(got.0, w) && near(got.1, h), "{scale}: fills {got:?}");
+        assert!(near(got.2, 100.0) && near(got.3, h - 100.0), "{scale}: TOPLEFT {got:?}");
+        assert!(near(got.4, w - 10.0), "{scale}: RIGHT {got:?}");
+    }
+}
