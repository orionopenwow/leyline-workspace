+/// The local player's aim: A/D (or the arrows) turn, W/S zoom, hold Space to swing the power,
+/// release to shoot. The HUD's keyboard frame keeps these keys away from movement meanwhile.
+fn aim_input(
+    mut golf: ResMut<Golf>,
+    keys: Res<ButtonInput<KeyCode>>,
+    capture: Res<crate::ui_script::UiKeyboardCapture>,
+    time: Res<Time>,
+    script: Option<NonSend<benilla_ui::script::UiScript>>,
+) {
+    // Typing in a box (chat, a macro) never turns or swings the putt.
+    if golf.roll.is_some() || capture.typing {
+        return;
+    }
+    // During the hole's fly-over the aim waits; Space skips the fly-over.
+    if golf.flyover.is_some() {
+        if keys.just_pressed(KeyCode::Space) {
+            golf.flyover = None;
+            golf.cam = None;
+        }
+        return;
+    }
+    let dt = time.delta_secs().min(0.1);
+    let now = time.elapsed_secs();
+    let zoom_in = keys.pressed(KeyCode::KeyW) || keys.pressed(KeyCode::ArrowUp);
+    let zoom_out = keys.pressed(KeyCode::KeyS) || keys.pressed(KeyCode::ArrowDown);
+    if golf.aim.is_some() {
+        if zoom_in {
+            golf.zoom = (golf.zoom - dt * 0.9).max(0.55);
+        }
+        if zoom_out {
+            golf.zoom = (golf.zoom + dt * 0.9).min(2.6);
+        }
+    }
+    let Some(aim) = golf.aim.as_mut() else {
+        return;
+    };
+    let fine = keys.pressed(KeyCode::ShiftLeft) || keys.pressed(KeyCode::ShiftRight);
+    let rate = AIM_RATE * if fine { 0.2 } else { 1.0 };
+    if keys.pressed(KeyCode::KeyA) || keys.pressed(KeyCode::ArrowLeft) {
+        aim.angle -= rate * dt;
+    }
+    if keys.pressed(KeyCode::KeyD) || keys.pressed(KeyCode::ArrowRight) {
+        aim.angle += rate * dt;
+    }
+    aim.angle = aim.angle.rem_euclid(3600.0);
+    if keys.just_pressed(KeyCode::Space) {
+        aim.charging = Some(now);
+    }
+    if let Some(t0) = aim.charging {
+        // Up to full and back down, again and again, until released.
+        let u = ((now - t0) / CHARGE_CYCLE).fract() * 2.0;
+        aim.power = (if u <= 1.0 { u } else { 2.0 - u } * 1000.0).clamp(0.0, 1000.0);
+        if !keys.pressed(KeyCode::Space) {
+            let power = (aim.power as i32).max(15);
+            LAST_POWER.store(power.max(150), std::sync::atomic::Ordering::Relaxed);
+            let angle = aim.angle.round() as i32 % 3600;
+            aim.charging = None;
+            call_hud(script.as_deref(), &format!("OnShoot({angle}, {power})"));
+            // The realm answers with the shot for everyone (this client included); until then the
+            // aim is parked so a second release can't fire twice.
+            golf.aim = None;
+        }
+    }
+}
