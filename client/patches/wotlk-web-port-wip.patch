+        cat.creature.insert(1, ("Creature\\Wolf\\Wolf.mdx".into(), vec![], None));
+        cat.creature.insert(2, ("Creature\\Guard\\Guard.mdx".into(), vec![], None));
+        let spec = SliceSpec::parse(
+            r#"{"order":["base","stormwind","northshire"],"tiers":[{"key":"base"},
+                {"key":"stormwind","maps":[{"id":0,"zone":1519}]},
+                {"key":"northshire","maps":[{"id":0,"box":[-9200,-8550,-480,80]}]}]}"#,
+        )
+        .unwrap();
+        // the guard is spawned in Stormwind (tier 1), the wolf in Northshire (tier 2): both map 0
+        let displays = parse_displays("c\t0\t2\t1\nc\t0\t1\t2\n");
+        let out = walk(&src, &cat, &spec, &[0, 1, 2], &displays);
+        let has = |t: usize, n: &str| out[t].names.iter().any(|x| name_key(x) == n);
+        assert!(has(1, "creature\\guard\\guard.m2") && !has(1, "creature\\wolf\\wolf.m2"));
+        assert!(has(2, "creature\\wolf\\wolf.m2") && has(2, "creature\\wolf\\wolf.blp"));
+        // a seeded walker sharing a refs cache finds the same names, and skips the seed
+        let refs = RefsCache::default();
+        let mut a = Walker::seeded(&src, &HashSet::new(), Some(&refs));
+        a.add_creature(&cat, 1);
+        a.drain();
+        let first = a.take();
+        let mut seed = HashSet::new();
+        seed.insert(name_key("Creature\\Wolf\\Wolf.blp"));
+        let mut b = Walker::seeded(&src, &seed, Some(&refs));
+        b.add_creature(&cat, 1);
+        b.drain();
+        let second = b.take();
+        assert_eq!(first.len(), 3);
+        assert_eq!(second.len(), 2);
+        assert!(refs.borrow().contains_key("creature\\wolf\\wolf.m2"));
+    }
+
+    #[test]
+    fn m2_and_wmo_references_are_followed() {
+        let mut root = chunk(b"DHOM", &[0, 0, 0, 0, 2, 0, 0, 0]);
+        root.extend(chunk(b"XTOM", b"World\\T\\Wall.blp\0\0"));
+        root.extend(chunk(b"NDOM", b"World\\D\\Lamp.mdx\0"));
+        root.extend(chunk(b"BSOM", b"Env\\Sky.m2\0"));
+        let src = Fake::new(&[
+            ("World\\W\\Keep.wmo", root),
+            ("World\\W\\Keep_000.wmo", vec![1]),
+            ("World\\W\\Keep_001.wmo", vec![1]),
+            ("World\\T\\Wall.blp", vec![1]),
+            ("World\\D\\Lamp.m2", m2(2, "World\\D\\Lamp.blp")),
+            ("World\\D\\Lamp00.skin", vec![1]),
+            ("World\\D\\Lamp01.skin", vec![1]),
+            ("World\\D\\Lamp.blp", vec![1]),
+            ("Env\\Sky.m2", m2(1, "Env\\Sky.blp")),
+            ("Env\\Sky00.skin", vec![1]),
+        ]);
+        let mut w = Walker::new(&src);
+        assert!(w.add("world/w/keep.wmo"));
+        w.drain();
+        let got: HashSet<String> = w.take().iter().map(|n| name_key(n)).collect();
+        for want in [
+            "world\\w\\keep_000.wmo",
+            "world\\w\\keep_001.wmo",
+            "world\\t\\wall.blp",
+            "world\\d\\lamp.m2",
+            "world\\d\\lamp01.skin",
+            "world\\d\\lamp.blp",
+            "env\\sky00.skin",
+        ] {
+            assert!(got.contains(want), "missing {want}: {got:?}");
+        }
+        // Env\Sky.blp is not in the data: never emitted.
+        assert!(!got.contains("env\\sky.blp"));
+    }
+
+    #[test]
+    fn later_tiers_exclude_earlier_names_and_creatures_resolve() {
+        let src = Fake::new(&[
+            ("Interface\\A.blp", vec![1]),
+            ("Creature\\Bear\\Bear.m2", m2(1, "")),
+            ("Creature\\Bear\\Bear00.skin", vec![1]),
+            ("Creature\\Bear\\BearSkinBrown.blp", vec![1]),
+            ("Textures\\BakedNpcTextures\\Npc1.blp", vec![1]),
+        ]);
+        let mut cat = Catalogs::default();
+        cat.creature.insert(
+            7,
+            (
+                "Creature\\Bear\\Bear.mdx".into(),
+                vec!["BearSkinBrown".into()],
+                Some("Npc1.blp".into()),
+            ),
+        );
+        let spec = SliceSpec::parse(
+            r#"{"tiers":[{"tier":0,"prefixes":["interface\\"]},
+                {"tier":1,"names":["Interface\\A.blp"],"maps":[{"id":608}]}]}"#,
+        )
+        .unwrap();
+        let displays = parse_displays("c\t608\t7\n");
+        let out = walk(&src, &cat, &spec, &[0, 1], &displays);
+        assert_eq!(out[0].names, ["interface\\a.blp"]);
+        let t1: HashSet<String> = out[1].names.iter().map(|n| name_key(n)).collect();
+        assert!(!t1.contains("interface\\a.blp"));
+        assert!(t1.contains("creature\\bear\\bear00.skin"));
+        assert!(t1.contains("creature\\bear\\bearskinbrown.blp"));
+        assert!(t1.contains("textures\\bakednpctextures\\npc1.blp"));
+        assert!(out[1].notes.iter().any(|n| n.contains("not in Map.dbc")));
+    }
+}
