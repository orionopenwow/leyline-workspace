+//! wasm32: the mixer's kira backend in the browser — Web Audio, scheduled by us.
+//!
+//! The browser has no audio thread we can run Rust on (no wasm threads), so the mix is rendered on
+//! the main thread and handed to Web Audio as a queue of `AudioBufferSourceNode`s, each started at
+//! an exact `AudioContext` time. The only thing that decides whether that stutters is how far
+//! ahead of the playhead the queue reaches: a main-thread stall longer than the lead (a stream-in
+//! burst, a collider build, a long frame) leaves the device with nothing to play.
+//!
+//! This used to be cpal 0.17's `webaudio` host, which keeps two 2048-frame buffers in flight and
+//! refills one when the other ends: about 40 ms of lead (measured 28–45 ms at 44.1 kHz on an idle
+//! page), and after an underrun it starts the late buffers "in the past", where they overlap the
+//! next ones and garble until its cursor catches up. In-world stalls are routinely longer than
+//! that, which is the stutter players heard.
+//!
+//! [`Scheduler`] keeps the same main-thread mix but:
+//! - queues short chunks ([`CHUNK_FRAMES`]) up to a target lead, refilled from every chunk's
+//!   `ended` (an audio event, so it keeps running in a background tab where timers are throttled);
+//! - adapts the lead: an underrun grows it (×1.5, up to [`MAX_LEAD_S`]) unless the stall was
+//!   longer than any lead could cover; a quiet stretch walks it back down one chunk at a time to
+//!   the floor, so latency is only paid while the page is janky;
+//! - on an underrun, resyncs the cursor to just ahead of the playhead — one gap, never overlap;
+//! - reuses its `AudioBuffer`s (a pool refilled on `ended`) instead of allocating per chunk.
+//!
+//! `?audiolead=<ms>` (`WOW_AUDIOLEAD`) sets the floor for experiments; `window.__wenilla_audio`
+//! reports `{ underruns, lead_ms }` as it changes.
+//!
+//! Ours rather than kira's own `CpalBackend`: kira 0.12.4's is written against cpal 0.18, whose
+//! `alsa-sys` 0.4 cannot share a lockfile with the 0.3 every other cpal in the graph links. cpal
+//! stays the device probe in `mixer::backend_settings`; the stream is this file's.
+
+use std::cell::RefCell;
+use std::rc::{Rc, Weak};
+
+use cpal::StreamConfig;
+use kira::backend::{Backend, Renderer};
+use wasm_bindgen::closure::Closure;
+use wasm_bindgen::{JsCast, JsValue};
+use web_sys::{
+    AudioBuffer, AudioBufferSourceNode, AudioContext, AudioContextOptions,
+    AudioScheduledSourceNode, Event,
+};
+
+/// The stream config to open, as `mixer::backend_settings` negotiated it; `None` is the default
+/// device's default config. Only its rate and channel count are used: the chunking is ours.
+pub(super) type WebBackendSettings = Option<StreamConfig>;
+
+/// Frames per scheduled chunk: ~23 ms at 44.1 kHz. Short enough that the lead is adjustable in
+/// fine steps and an underrun costs little; long enough that the per-chunk JS calls (create,
+/// connect, start) stay negligible.
+const CHUNK_FRAMES: usize = 1024;
+/// The lead floor: how far ahead of the playhead the queue reaches on a page that keeps up.
+const MIN_LEAD_S: f64 = 0.08;
+/// The lead ceiling an underrun-prone page can grow to.
+const MAX_LEAD_S: f64 = 0.35;
+/// After an underrun, the first chunk starts this far ahead of the playhead.
+const RESYNC_MARGIN_S: f64 = 0.01;
+/// How long the queue must run without an underrun before the lead starts stepping down. Long
+/// enough to ride out world entry's streaming stalls, which come a few seconds apart.
+const DECAY_AFTER_S: f64 = 5.0;
+/// Then one chunk per this long: ceiling to floor in ~12 s. (One chunk per 8 s, as first shipped,
+/// left the lead at 230+ ms a minute after world entry, measured in-world.)
+const DECAY_STEP_S: f64 = 1.0;
+
+enum State {
+    Empty,
+    Uninitialized { config: StreamConfig },
+    Initialized { _scheduler: Rc<RefCell<Scheduler>> },
+}
+
+/// kira's [`Backend`] over the browser's default output device.
+pub(super) struct WebBackend {
+    state: State,
+}
+
+impl Backend for WebBackend {
+    type Settings = WebBackendSettings;
+    type Error = anyhow::Error;
+
+    fn setup(
+        settings: Self::Settings,
+        _internal_buffer_size: usize,
+    ) -> Result<(Self, u32), Self::Error> {
+        let config = match settings {
+            Some(config) => config,
+            None => {
+                use cpal::traits::{DeviceTrait, HostTrait};
+                cpal::default_host()
+                    .default_output_device()
+                    .ok_or_else(|| anyhow::anyhow!("no default audio output device"))?
+                    .default_output_config()?
+                    .config()
+            }
+        };
+        let sample_rate = config.sample_rate;
+        Ok((
+            Self {
+                state: State::Uninitialized { config },
+            },
+            sample_rate,
+        ))
+    }
+
+    fn start(&mut self, renderer: Renderer) -> Result<(), Self::Error> {
+        let State::Uninitialized { config } = std::mem::replace(&mut self.state, State::Empty)
+        else {
+            anyhow::bail!("the audio backend was started twice");
+        };
+        let scheduler = Scheduler::start(&config, renderer).map_err(js_err)?;
+        self.state = State::Initialized {
+            _scheduler: scheduler,
+        };
+        Ok(())
+    }
+}
+
+/// The chunk queue: renders the mix and keeps it [`Scheduler::lead`] ahead of the playhead.
+struct Scheduler {
+    ctx: AudioContext,
+    renderer: Renderer,
+    channels: usize,
+    rate: f32,
+    /// Seconds per chunk.
+    step: f64,
+    /// Context time the next chunk starts at; 0 until the first pump.
+    cursor: f64,
+    lead: f64,
+    min_lead: f64,
+    /// Context time of the last underrun.
+    last_underrun: f64,
+    /// Context time of the last lead step-down.
+    last_step: f64,
+    underruns: u32,
+    interleaved: Vec<f32>,
+    planar: Vec<f32>,
+    /// Buffers whose chunk has ended, ready to be refilled.
+    free: Vec<AudioBuffer>,
+    on_ended: Option<Closure<dyn FnMut(Event)>>,
+}
+
+impl Scheduler {
+    fn start(config: &StreamConfig, renderer: Renderer) -> Result<Rc<RefCell<Self>>, JsValue> {
+        let opts = AudioContextOptions::new();
+        opts.set_sample_rate(config.sample_rate as f32);
+        let ctx = AudioContext::new_with_context_options(&opts)?;
+        let destination = ctx.destination();
+        if u32::from(config.channels) <= destination.max_channel_count() {
+            destination.set_channel_count(u32::from(config.channels));
+        }
+        let channels = usize::from(config.channels);
+        let min_lead = crate::webenv::var("WOW_AUDIOLEAD")
+            .and_then(|v| v.trim().parse::<f64>().ok())
+            .filter(|ms| ms.is_finite() && *ms > 0.0)
+            .map_or(MIN_LEAD_S, |ms| (ms / 1000.0).min(MAX_LEAD_S));
+        let scheduler = Rc::new(RefCell::new(Self {
+            ctx,
+            renderer,
+            channels,
+            rate: config.sample_rate as f32,
+            step: CHUNK_FRAMES as f64 / f64::from(config.sample_rate),
+            cursor: 0.0,
+            lead: min_lead,
+            min_lead,
+            last_underrun: 0.0,
+            last_step: 0.0,
+            underruns: 0,
+            interleaved: vec![0.0; CHUNK_FRAMES * channels],
+            planar: vec![0.0; CHUNK_FRAMES],
+            free: Vec::new(),
+            on_ended: None,
+        }));
+        let weak: Weak<RefCell<Self>> = Rc::downgrade(&scheduler);
+        let on_ended = Closure::<dyn FnMut(Event)>::new(move |event: Event| {
+            let Some(scheduler) = weak.upgrade() else {
+                return;
+            };
+            // Re-entrancy cannot happen (events are tasks), but a panic elsewhere could leave the
+            // cell borrowed; skip the pump rather than abort the page.
+            let Ok(mut s) = scheduler.try_borrow_mut() else {
+                return;
+            };
+            if let Some(buffer) = event
+                .target()
+                .and_then(|t| t.dyn_into::<AudioBufferSourceNode>().ok())
+                .and_then(|source| source.buffer())
+            {
+                s.free.push(buffer);
+            }
+            s.pump();
+        });
+        {
+            let mut s = scheduler.borrow_mut();
+            s.on_ended = Some(on_ended);
+            bevy::log::info!(
+                "audio: {} Hz, {} ch, {CHUNK_FRAMES}-frame chunks, lead {:.0}–{:.0} ms",
+                config.sample_rate,
+                channels,
+                min_lead * 1000.0,
+                MAX_LEAD_S * 1000.0,
+            );
+            s.pump();
+            s.publish();
+        }
+        Ok(scheduler)
+    }
+
+    /// Top the queue up to the target lead, first resyncing (and growing the lead) if the
+    /// playhead overtook it.
+    fn pump(&mut self) {
+        let now = self.ctx.current_time();
+        if self.cursor < now + RESYNC_MARGIN_S {
+            if self.cursor > 0.0 {
+                self.underruns += 1;
+                // A stall no lead could have covered — world entry's loads, a hidden tab — says
+                // nothing about the lead being short; growing it would only add latency for the
+                // next minute. Grow only when the stall was within reach of the ceiling.
+                let stall = self.lead + (now - self.cursor);
+                if stall <= MAX_LEAD_S {
+                    self.lead = (self.lead * 1.5).min(MAX_LEAD_S);
+                }
+                self.publish();
+            }
+            self.cursor = now + RESYNC_MARGIN_S;
+            self.last_underrun = now;
+        } else if self.lead > self.min_lead
+            && now - self.last_underrun > DECAY_AFTER_S
+            && now - self.last_step > DECAY_STEP_S
+        {
+            self.lead = (self.lead - self.step).max(self.min_lead);
+            self.last_step = now;
+            self.publish();
+        }
+        while self.cursor < now + self.lead {
+            if let Err(e) = self.schedule_chunk() {
+                bevy::log::warn!("audio: scheduling a chunk failed: {e:?}");
+                return;
+            }
+        }
+    }
+
+    /// Render one chunk of the mix and start it at the cursor.
+    fn schedule_chunk(&mut self) -> Result<(), JsValue> {
+        self.renderer.on_start_processing();
+        self.renderer.process(&mut self.interleaved, self.channels as u16);
+        let buffer = match self.free.pop() {
+            Some(buffer) => buffer,
+            None => self
+                .ctx
+                .create_buffer(self.channels as u32, CHUNK_FRAMES as u32, self.rate)?,
+        };
+        for channel in 0..self.channels {
+            for (frame, out) in self.planar.iter_mut().enumerate() {
+                *out = self.interleaved[frame * self.channels + channel];
+            }
+            buffer.copy_to_channel(&self.planar, channel as i32)?;
+        }
+        let source = self.ctx.create_buffer_source()?;
+        source.set_buffer(Some(&buffer));
+        source.connect_with_audio_node(&self.ctx.destination())?;
+        if let Some(on_ended) = &self.on_ended {
+            AudioScheduledSourceNode::set_onended(&source, Some(on_ended.as_ref().unchecked_ref()));
+        }
+        source.start_with_when(self.cursor)?;
+        self.cursor += self.step;
+        Ok(())
+    }
+
+    /// `window.__wenilla_audio = { underruns, lead_ms }`: only written when either changes.
+    fn publish(&self) {
+        let Some(window) = web_sys::window() else {
+            return;
+        };
+        let stats = js_sys::Object::new();
+        let _ = js_sys::Reflect::set(&stats, &"underruns".into(), &self.underruns.into());
+        let _ = js_sys::Reflect::set(
+            &stats,
+            &"lead_ms".into(),
+            &(self.lead * 1000.0).round().into(),
+        );
+        let _ = js_sys::Reflect::set(&window, &"__wenilla_audio".into(), &stats);
+    }
+}
+
+fn js_err(e: JsValue) -> anyhow::Error {
+    anyhow::anyhow!("{e:?}")
+}
diff --git a/crates/benilla-app/src/sound/web_load.rs b/crates/benilla-app/src/sound/web_load.rs
new file mode 100644
index 00000000..ea2fa425
--- /dev/null
+++ b/crates/benilla-app/src/sound/web_load.rs
@@ -0,0 +1,292 @@
+//! wasm32: the zone soundscape's loads, taken off the frame — and since then every other audio
+//! load the browser build makes: the one-shot SFX cache (`kit::deferred`), the glue theme
+//! ([`super::glue`]) and the cinematic narration ([`super::cinematic`]) all come through
+//! [`begin`].
+//!
+//! ## The freeze this closes
+//!
+//! Crossing a zone line or a doorway changes the player's area, and [`super::zone`]'s
+//! area/interior edge swaps the music bed and the ambience bed on it. On native both halves of
+//! that swap are cheap: the chain read is a disk read out of an MPQ, and kira decodes the music
+//! on its own decode thread. On wasm both halves were on the **main thread**, because the two
+//! primitives the edge reaches for degrade there and nothing said so at the call site:
+//!
+//! - `Chain::read` is a synchronous `XMLHttpRequest` (`benilla-formats`' `web.rs` — it is called
+//!   from ~60 non-async sites, and sync XHR is the one browser primitive that can return bytes
+//!   from a function that must return before it does).
+//! - `mixer::stream_from_bytes` does not stream on wasm at all: kira drops its streaming module
+//!   there (no decode threads), so its wasm arm decodes the **whole file** up front.
+//!
+//! Measured on the Lion's Pride Inn doorway, over loopback — where the fetch is nearly free and
+//! the host answers the 1.1 MB file in 1 ms:
+//!
+//! ```text
+//! blocking audio music fetch:     60 ms — Sound\Music\ZoneMusic\TavernAlliance\TavernAlliance02.mp3
+//! blocking audio music decode:    91 ms — …
+//! blocking audio ambience fetch:  46 ms — Sound\Ambience\WMOAmbience\Tavern.wav
+//! blocking audio ambience decode:  9 ms — …
+//! long frame: 220 ms (main thread blocked this long)
+//! ```
+//!
+//! 206 of a 220 ms frame, every doorway and every zone line. Over a real network the two `fetch`
+//! halves stop being the cheap ones and carry the whole download.
+//!
+//! ## The fix: hand both halves to the browser
+//!
+//! The browser has threads where we do not, and it will use them for exactly these two jobs:
+//!
+//! - **The fetch** is `fetch`, not sync XHR. [`super::zone`] asks the chain only for the URL
+//!   ([`benilla_formats::Chain::url_for_name`]) and drops the lock, so nothing is held across an
+//!   await and no request runs on the frame.
+//! - **The decode** is `decodeAudioData`, which decodes off the main thread and hands back an
+//!   `AudioBuffer`. Copying its planar channels into kira's interleaved [`Frame`]s is a memcpy
+//!   where a full MP3 decode used to be.
+//!
+//! It runs on an [`web_sys::OfflineAudioContext`] rather than the playing `AudioContext`: this
+//! context only ever decodes, it is never started, and an offline one is outside the autoplay
+//! policy entirely — so nothing here can perturb the output device the mixer owns.
+//!
+//! **The fallback is load-bearing.** WoW ships IMA/MS-ADPCM WAVs; `decodeAudioData` rejects them
+//! where kira's own decoder (its `adpcm` feature) accepts them. A refusal falls back to decoding
+//! the fetched bytes in wasm — which does cost a frame, but only for the formats that need it and
+//! never for music, which is the expensive one.
+//!
+//! ## What defers, and why that is safe
+//!
+//! A load now completes some frames after the edge that asked for it. Both slots absorb that by
+//! construction: the ambience bed comes in under its own 5.0 s crossfade (its incoming leg is a
+//! per-frame envelope that simply starts later), and the music slot's only fade is the *outgoing*
+//! one, which [`super::zone`] still starts at the edge exactly as before. The one disclosed
+//! divergence is the intro fanfare's `MinDelayMinutes` stamp: it is taken when the load *starts*
+//! rather than when the track plays, so a load that fails consumes the cooldown.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+
+use bevy::prelude::*;
+use kira::Frame;
+use wasm_bindgen::JsCast;
+
+use super::mixer::StaticSoundData;
+
+/// One soundscape load in flight.
+///
+/// The fields the completion needs are carried here rather than re-derived: by the time the
+/// browser answers, the kit tables may have picked a different variant and the area may have
+/// changed again, and a completion must fill the slot with what was *asked for*.
+pub(super) struct Pending {
+    /// The `SoundEntries` kit this load is for.
+    pub(super) kit_id: u32,
+    /// The kit's base volume, multiplied under the category slider.
+    pub(super) kit_vol: f32,
+    /// The chain name — the log line and the error wording, and nothing else.
+    pub(super) path: String,
+    /// Ambience only: the crossfade this bed was asked to arrive under.
+    pub(super) fade_ms: u64,
+    /// `Arc<Mutex>` rather than `Rc<RefCell>` so a `Pending` is `Send`: the SFX cache that
+    /// holds these is a Bevy `Resource` and the narration's is a `Local`, both of which demand
+    /// it. wasm has one thread, so the lock is never contended — it is a type-level formality.
+    slot: Arc<Mutex<Option<Result<StaticSoundData, String>>>>,
+    request_id: u64,
+}
+
+impl Pending {
+    /// The result, once the browser has it. `None` = still in flight.
+    ///
+    /// Dropping a pending load aborts its fetch. A decode already in progress may finish,
+    /// but cancellation prevents its PCM copy and the weak completion retains no result.
+    pub(super) fn take(&mut self) -> Option<Result<StaticSoundData, String>> {
+        self.slot.lock().unwrap_or_else(|p| p.into_inner()).take()
+    }
+}
+
+// JS handles cannot be carried in a Send Bevy resource. Only the numeric ID
+// lives in Pending; this registry is accessed on the browser's sole thread.
+thread_local! {
+    static REQUESTS: RefCell<HashMap<u64, web_sys::AbortController>> = RefCell::new(HashMap::new());
+    static NEXT_REQUEST: Cell<u64> = const { Cell::new(0) };
+}
+
+impl Drop for Pending {
+    fn drop(&mut self) {
+        REQUESTS.with(|requests| {
+            if let Some(controller) = requests.borrow_mut().remove(&self.request_id) {
+                controller.abort();
+            }
+        });
+    }
+}
+
+/// [`begin`] for a one-shot SFX file (`kit::deferred`): no kit volume or fade rides along —
+/// the play that asked carries its own — and a one-shot never loops whole-file.
+pub(super) fn begin_sfx(url: String, path: String) -> Pending {
+    begin(url, path, 0, 1.0, 0, false)
+}
+
+/// Begin a load. Returns immediately — nothing after this point runs on the frame until
+/// [`Pending::take`] answers.
+///
+/// `looping` marks the whole-file loop a bed needs (the native bed's `loop_region(..)` on the
+/// synchronous path): music never loops, an ambience bed always does.
+pub(super) fn begin(
+    url: String,
+    path: String,
+    kit_id: u32,
+    kit_vol: f32,
+    fade_ms: u64,
+    looping: bool,
+) -> Pending {
+    let slot: Arc<Mutex<Option<Result<StaticSoundData, String>>>> = Arc::new(Mutex::new(None));
+    let write = Arc::downgrade(&slot);
+    let request_id = NEXT_REQUEST.with(|next| {
+        let id = next.get();
+        next.set(id.wrapping_add(1));
+        id
+    });
+    match web_sys::AbortController::new() {
+        Ok(controller) => {
+            REQUESTS.with(|requests| requests.borrow_mut().insert(request_id, controller.clone()));
+            wasm_bindgen_futures::spawn_local(async move {
+                let signal = controller.signal();
+                let out = fetch_and_decode(&url, looping, &signal).await;
+                REQUESTS.with(|requests| requests.borrow_mut().remove(&request_id));
+                if let Some(write) = write.upgrade() {
+                    *write.lock().unwrap_or_else(|p| p.into_inner()) = Some(out);
+                }
+            });
+        }
+        Err(error) => *slot.lock().unwrap_or_else(|p| p.into_inner()) = Some(Err(js_err(error))),
+    }
+    Pending {
+        kit_id,
+        kit_vol,
+        path,
+        fade_ms,
+        slot,
+        request_id,
+    }
+}
+
+/// `fetch` the bytes, then decode them — in the browser where possible, in wasm where not.
+async fn fetch_and_decode(
+    url: &str,
+    looping: bool,
+    signal: &web_sys::AbortSignal,
+) -> Result<StaticSoundData, String> {
+    let window = web_sys::window().ok_or("no window: fetch is browser-only")?;
+    let options = web_sys::RequestInit::new();
+    options.set_signal(Some(signal));
+    let resp: web_sys::Response =
+        wasm_bindgen_futures::JsFuture::from(window.fetch_with_str_and_init(url, &options))
+            .await
+            .map_err(js_err)?
+            .dyn_into()
+            .map_err(|_| "fetch() did not resolve to a Response".to_string())?;
+    if !resp.ok() {
+        return Err(format!("HTTP {}", resp.status()));
+    }
+    let buf: js_sys::ArrayBuffer =
+        wasm_bindgen_futures::JsFuture::from(resp.array_buffer().map_err(js_err)?)
+            .await
+            .map_err(js_err)?
+            .dyn_into()
+            .map_err(|_| "body did not resolve to an ArrayBuffer".to_string())?;
+
+    if signal.aborted() {
+        return Err("audio load cancelled".into());
+    }
+
+    // The fallback copy MUST be taken here: `decodeAudioData` DETACHES the buffer it is given, so
+    // a copy taken afterwards would be empty. It is one memcpy of the compressed file (~1 MB), not
+    // of the decoded PCM, and it is what makes the ADPCM fallback below possible at all.
+    let bytes = js_sys::Uint8Array::new(&buf).to_vec();
+
+    let data = match decode_in_browser(&buf, signal).await {
+        Ok(data) => data,
+        Err(e) => {
+            if signal.aborted() {
+                return Err("audio load cancelled".into());
+            }
+            debug!("web_load: decodeAudioData refused ({e}) — decoding in wasm instead");
+            super::mixer::sfx_from_bytes(bytes).map_err(|e| format!("{e:#}"))?
+        }
+    };
+    Ok(if looping { data.loop_region(..) } else { data })
+}
+
+/// `decodeAudioData` on the decode-only offline context, into kira's PCM.
+async fn decode_in_browser(
+    buf: &js_sys::ArrayBuffer,
+    signal: &web_sys::AbortSignal,
+) -> Result<StaticSoundData, String> {
+    let ctx = decode_context()?;
+    let promise = ctx.decode_audio_data(buf).map_err(js_err)?;
+    let audio: web_sys::AudioBuffer = wasm_bindgen_futures::JsFuture::from(promise)
+        .await
+        .map_err(js_err)?
+        .dyn_into()
+        .map_err(|_| "decodeAudioData did not resolve to an AudioBuffer".to_string())?;
+    // decodeAudioData itself cannot be aborted; avoid PCM copies after cancellation.
+    if signal.aborted() {
+        return Err("audio load cancelled".into());
+    }
+    // The one part of this that IS on the main thread: copying the browser's planar channels
+    // into kira's interleaved frames — a memcpy, measured under the 8 ms floor at every size in
+    // the corpus, where the decode it replaces was 91 ms.
+    frames_from(&audio)
+}
+
+/// The one context this module decodes on, built on first use and kept.
+///
+/// Offline, and 1 frame long: its only job is to own `decodeAudioData`. The length and rate are
+/// the constructor's required arguments, not a choice about the audio — `decodeAudioData` sizes
+/// its own output from the file, and we read the rate back off the buffer it returns.
+fn decode_context() -> Result<web_sys::OfflineAudioContext, String> {
+    thread_local! {
+        static CTX: RefCell<Option<web_sys::OfflineAudioContext>> = const { RefCell::new(None) };
+    }
+    CTX.with(|cell| {
+        let mut cell = cell.borrow_mut();
+        if cell.is_none() {
+            *cell = Some(
+                web_sys::OfflineAudioContext::new_with_number_of_channels_and_length_and_sample_rate(
+                    2, 1, 44_100.0,
+                )
+                .map_err(js_err)?,
+            );
+        }
+        Ok(cell.as_ref().expect("just filled").clone())
+    })
+}
+
+/// An `AudioBuffer`'s planar channels → kira's interleaved [`Frame`]s.
+///
+/// Mono is duplicated to both sides rather than left half-silent (`Frame::from_mono`, the same
+/// answer kira's own decoder gives a mono file); anything above two channels takes the first two,
+/// which is every file in the corpus and all the mixer can place anyway.
+fn frames_from(audio: &web_sys::AudioBuffer) -> Result<StaticSoundData, String> {
+    let left = audio.get_channel_data(0).map_err(js_err)?;
+    let frames: Arc<[Frame]> = if audio.number_of_channels() > 1 {
+        let right = audio.get_channel_data(1).map_err(js_err)?;
+        left.iter()
+            .zip(right.iter())
+            .map(|(l, r)| Frame {
+                left: *l,
+                right: *r,
+            })
+            .collect()
+    } else {
+        left.iter().map(|s| Frame::from_mono(*s)).collect()
+    };
+    Ok(StaticSoundData {
+        sample_rate: audio.sample_rate() as u32,
+        frames,
+        settings: Default::default(),
+        slice: None,
+    })
+}
+
+fn js_err(e: wasm_bindgen::JsValue) -> String {
+    format!("{e:?}")
+}
