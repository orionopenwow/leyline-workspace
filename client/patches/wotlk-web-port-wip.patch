+/// A tiled Texture's UVs: each tiled axis spans the region's layout size in texels from the
+/// mapping's start edge, `rect / scale / texels` repeats, one texel per layout unit, as the art
+/// draws untiled at its texel size. The stock game tiles only the whole image (Forever UI's
+/// `Templates.lua:121`, "3.3.5 can only tile a whole image"), so a crop's start edge is kept and
+/// its far edge moved; an eight-corner mapping is left alone. The rule that one texel is one
+/// layout unit is inferred from how sized art draws, not traced.
+pub(crate) fn tile_tex_coords(
+    base: Option<TexCoords>,
+    (horiz, vert): (bool, bool),
+    (width, height): (f32, f32),
+    scale: f32,
+    (texels_w, texels_h): (u32, u32),
+) -> Option<TexCoords> {
+    if let Some(TexCoords::Corners(_)) = base {
+        return base;
+    }
+    let [l, mut r, t, mut b] = base.map_or([0.0, 1.0, 0.0, 1.0], |tc| tc.edges());
+    let scale = if scale > 0.0 { scale } else { 1.0 };
+    if horiz && texels_w > 0 && width > 0.0 {
+        let span = width / scale / texels_w as f32;
+        r = l + span.copysign(r - l);
+    }
+    if vert && texels_h > 0 && height > 0.0 {
+        let span = height / scale / texels_h as f32;
+        b = t + span.copysign(b - t);
+    }
+    Some(TexCoords::Rect([l, r, t, b]))
+}
