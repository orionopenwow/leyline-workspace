+/// A tile's layer and cube texture bodies read ahead, by normalized key: each layer's `_s`
+/// variant and plain file as `read_layer` would try them, each cube's plain file.
+#[derive(Default)]
+struct Prefetched {
+    /// `(spec, plain)`: the `_s` body (`None` when absent) and the plain one, read together.
+    layers: HashMap<String, (Option<Vec<u8>>, Option<Vec<u8>>)>,
+    cubes: HashMap<String, Option<Vec<u8>>>,
+}
+
+#[cfg(target_arch = "wasm32")]
+impl Prefetched {
+    /// Every unique layer key (and env cube key) the loop will ask for, read at once.
+    async fn read(tile: &benilla_formats::TileMesh) -> Self {
+        let mut layer_keys: Vec<String> = Vec::new();
+        let mut cube_keys: Vec<String> = Vec::new();
+        let mut seen = std::collections::HashSet::new();
+        let mut seen_cube = std::collections::HashSet::new();
+        for chunk in tile.chunks.iter().filter(|c| c.indices.len() >= 3) {
+            for name in chunk.layer_textures.iter().take(4) {
+                let key = normalize_path(name);
+                if seen.insert(key.clone()) {
+                    layer_keys.push(key);
+                }
+            }
+            if let Some(name) = chunk.layer_textures.first().filter(|_| chunk.env_base) {
+                let key = normalize_path(name);
+                if seen_cube.insert(key.clone()) {
+                    cube_keys.push(key);
+                }
+            }
+        }
+        // The `_s` probe and the plain file both, when the index cannot rule `_s` out; the plain
+        // one only when `_s` is absent; so the loop's choice never waits on a second trip.
+        let mut names: Vec<String> = Vec::new();
+        let mut slots: Vec<(Option<usize>, usize)> = Vec::new();
+        for key in &layer_keys {
+            let spec = key
+                .strip_suffix(".blp")
+                .map(|stem| format!("{stem}_s.blp"))
+                .filter(|s| crate::web_read::may_exist(s));
+            let si = spec.map(|s| {
+                names.push(s);
+                names.len() - 1
+            });
+            names.push(key.clone());
+            slots.push((si, names.len() - 1));
+        }
+        for key in &cube_keys {
+            names.push(key.clone());
+        }
+        let mut bodies = crate::web_read::read_all(&names).await;
+        let mut out = Prefetched::default();
+        for (key, (si, pi)) in layer_keys.into_iter().zip(slots) {
+            let spec = si.and_then(|i| bodies[i].take());
+            let plain = bodies[pi].take();
+            out.layers.insert(key, (spec, plain));
+        }
+        let base = names.len() - cube_keys.len();
+        for (j, key) in cube_keys.into_iter().enumerate() {
+            out.cubes.insert(key, bodies[base + j].take());
+        }
