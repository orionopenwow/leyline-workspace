+
+/// Holds [`ViewDistance::farclip`] at the request under the current map's [`farclip_cap`]; writes
+/// only on a change. Units are not under it: their draw is the server's visibility stream
+/// (`model_render::visibility` culls doodads and WMOs only).
+pub fn apply_farclip_cap(
+    request: Option<Res<FarclipRequest>>,
+    map: Option<Res<crate::world_map::CurrentMap>>,
+    catalog: Option<Res<benilla_assets::MapCatalogRes>>,
+    mut view: ResMut<ViewDistance>,
+) {
+    let Some(request) = request else {
+        return;
+    };
+    let expansion = map
+        .as_ref()
+        .zip(catalog.as_ref())
+        .and_then(|(m, c)| c.0.expansion(m.0));
+    let want = request
+        .0
+        .clamp(*FARCLIP_RANGE.start(), *FARCLIP_RANGE.end())
+        .min(farclip_cap(expansion));
+    if view.farclip != want {
+        view.farclip = want;
+    }
+}
 
