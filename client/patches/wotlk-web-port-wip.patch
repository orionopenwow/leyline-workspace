index 00000000..04274fbd
--- /dev/null
+++ b/crates/benilla-world/src/graphics_plus.rs
@@ -0,0 +1,363 @@
+//! WrathUnleashed's graphics additions, each off or neutral by default so the stock look is
+//! what a fresh install draws: the world camera's field of view ([`CameraFov`]), the sharpen and
+//! colour grade in the FFXGlow combine ([`PostGrade`], `shaders/ffx_glow.wgsl`), and Darker Nights
+//! ([`DarkerNights`]), a deeper night on the `Light.dbc` curves, held off in battlegrounds and
+//! arenas. The CVars that drive them live in `benilla-app`'s `graphics_plus`.
+
+use std::ops::RangeInclusive;
+
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+
+use crate::lighting::WowLighting;
+
+/// The stock game camera's own field of view in degrees (π/2 = 90 at its
+/// start); our vertical [`crate::view::CAM_FOVY`] stands for that 90.
+pub const CAMERA_FOV_REFERENCE: f32 = 90.0;
+
+/// The `cameraFov` range, awesome_wotlk's documented 90 to 150, the same on every map.
+pub const CAMERA_FOV_RANGE: RangeInclusive<f32> = 90.0..=150.0;
+
+/// The world camera's field of view, the `cameraFov` CVar in the stock camera's degrees. The
+/// ratio to 90 scales [`crate::view::CAM_FOVY`], the vertical angle, so a wider window (ultrawide)
+/// still widens only horizontally, as it does at the default.
+#[derive(Resource, Clone, Copy, PartialEq, Debug)]
+pub struct CameraFov {
+    pub degrees: f32,
+}
+
+impl Default for CameraFov {
+    /// 90, the stock game's own: the projection is exactly [`crate::view::CAM_FOVY`].
+    fn default() -> Self {
+        Self {
+            degrees: CAMERA_FOV_REFERENCE,
+        }
+    }
+}
+
+impl CameraFov {
+    /// The world projection's vertical field of view in radians.
+    pub fn fovy(self) -> f32 {
+        let degrees = self
+            .degrees
+            .clamp(*CAMERA_FOV_RANGE.start(), *CAMERA_FOV_RANGE.end());
+        if degrees == CAMERA_FOV_REFERENCE {
+            // Exact, not `x · 90/90`: the default projection is bit for bit the shipped one.
+            return crate::view::CAM_FOVY;
+        }
+        crate::view::CAM_FOVY * degrees / CAMERA_FOV_REFERENCE
+    }
+}
+
+/// The settable ranges of [`PostGrade`]'s four knobs.
+pub const SHARPNESS_RANGE: RangeInclusive<f32> = 0.0..=1.0;
+pub const CONTRAST_RANGE: RangeInclusive<f32> = 0.5..=1.5;
+pub const SATURATION_RANGE: RangeInclusive<f32> = 0.0..=2.0;
+pub const VIBRANCE_RANGE: RangeInclusive<f32> = -1.0..=1.0;
+
+/// The world view's sharpen and colour grade, run in the FFXGlow combine on the gamma bytes after
+/// the glow add. At [`PostGrade::NEUTRAL`] the combine skips both blocks, so the frame is the
+/// reference combine's, byte for byte. The player's world view only: portraits, model panes and
+/// the glue scene keep the stock combine.
+#[derive(Resource, Clone, Copy, PartialEq, Debug, ExtractResource)]
+pub struct PostGrade {
+    /// Contrast-adaptive sharpening (AMD FidelityFX CAS's kernel), 0 off to 1 strongest.
+    pub sharpness: f32,
+    /// Contrast about mid-grey, 1 neutral.
+    pub contrast: f32,
+    /// Saturation, 1 neutral, 0 greyscale.
+    pub saturation: f32,
+    /// Vibrance: saturation weighted toward the dull colours, 0 neutral.
+    pub vibrance: f32,
+}
+
+impl Default for PostGrade {
+    fn default() -> Self {
+        Self::NEUTRAL
+    }
+}
+
+impl PostGrade {
+    /// Everything off: the stock combine.
+    pub const NEUTRAL: Self = Self {
+        sharpness: 0.0,
+        contrast: 1.0,
+        saturation: 1.0,
+        vibrance: 0.0,
+    };
+
+    /// The four knobs, each clamped to its range.
+    pub fn clamped(self) -> Self {
+        Self {
+            sharpness: self
+                .sharpness
+                .clamp(*SHARPNESS_RANGE.start(), *SHARPNESS_RANGE.end()),
+            contrast: self
+                .contrast
+                .clamp(*CONTRAST_RANGE.start(), *CONTRAST_RANGE.end()),
+            saturation: self
+                .saturation
+                .clamp(*SATURATION_RANGE.start(), *SATURATION_RANGE.end()),
+            vibrance: self
+                .vibrance
+                .clamp(*VIBRANCE_RANGE.start(), *VIBRANCE_RANGE.end()),
+        }
+    }
+
+    /// Whether the grade block moves any pixel.
+    pub fn grades(self) -> bool {
+        let g = self.clamped();
+        g.contrast != 1.0 || g.saturation != 1.0 || g.vibrance != 0.0
+    }
+
+    /// The combine's two extra lanes: `post = (sharpness, contrast, saturation, vibrance)` and
+    /// `gate = (sharpen on, grade on, 0, 0)`. The shader runs a block only on its gate, so neutral
+    /// knobs take the stock path, not an identity computed in floats.
+    pub fn lanes(self) -> [f32; 8] {
+        let g = self.clamped();
+        let on = |b: bool| if b { 1.0 } else { 0.0 };
+        [
+            g.sharpness,
+            g.contrast,
+            g.saturation,
+            g.vibrance,
+            on(g.sharpness > 0.0),
+            on(self.grades()),
+            0.0,
+            0.0,
+        ]
+    }
+}
+
+/// Rec. 601 luma, the weights the combine's own death pass reads.
+fn luma(c: [f32; 3]) -> f32 {
+    c[0] * 0.299 + c[1] * 0.587 + c[2] * 0.114
+}
+
+/// The grade block of `ffx_glow.wgsl`'s `post_grade`, on one gamma-space colour; the CPU mirror the
+/// tests hold the shader's arithmetic to.
+pub fn grade_rgb(c: [f32; 3], g: PostGrade) -> [f32; 3] {
+    let g = g.clamped();
+    let contrasted = c.map(|v| (v - 0.5) * g.contrast + 0.5);
+    let y = luma(contrasted);
+    let saturated = contrasted.map(|v| y + (v - y) * g.saturation);
+    let max = saturated.iter().copied().fold(f32::MIN, f32::max);
+    let min = saturated.iter().copied().fold(f32::MAX, f32::min);
+    // Vibrance boosts by how unsaturated the colour already is.
+    let amount = g.vibrance * (1.0 - (max - min).clamp(0.0, 1.0));
+    let y2 = luma(saturated);
+    saturated.map(|v| (y2 + (v - y2) * (1.0 + amount)).clamp(0.0, 1.0))
+}
+
+/// The sharpen block, CAS's cross kernel on the centre and its four neighbours, each in `[0, 1]`:
+/// the weight shrinks where the neighbourhood is already near black or white, so edges do not ring.
+pub fn cas_rgb(
+    centre: [f32; 3],
+    north: [f32; 3],
+    west: [f32; 3],
+    east: [f32; 3],
+    south: [f32; 3],
+    sharpness: f32,
+) -> [f32; 3] {
+    let s = sharpness.clamp(*SHARPNESS_RANGE.start(), *SHARPNESS_RANGE.end());
+    std::array::from_fn(|i| {
+        let (c, n, w, e, so) = (centre[i], north[i], west[i], east[i], south[i]);
+        let mn = c.min(n).min(w).min(e).min(so);
+        let mx = c.max(n).max(w).max(e).max(so);
+        let amp = (mn.min(1.0 - mx) / mx.max(1.0e-5)).clamp(0.0, 1.0).sqrt();
+        let peak = -1.0 / (8.0 + (5.0 - 8.0) * s);
+        let wt = amp * peak;
+        (((n + w + e + so) * wt + c) / (1.0 + 4.0 * wt)).clamp(0.0, 1.0)
+    })
+}
+
+/// The light's share at the depth of night under Darker Nights: the night bands are scaled to it.
+pub const DARKER_NIGHTS_SCALE: f32 = 0.5;
+
+/// Darker Nights never takes a colour below this luma, so a moonless night stays readable.
+pub const DARKER_NIGHTS_FLOOR: f32 = 0.06;
+
+/// Darker Nights, the `darkerNights` CVar: the night segment of the `Light.dbc` curves scaled by
+/// [`DARKER_NIGHTS_SCALE`] over the client's own night track (the SIDN fraction, 1 from
+/// 21:30 to 06:00 with hour-long ramps), floored at [`DARKER_NIGHTS_FLOOR`] luma. Held off in a
+/// battleground or arena, where it would favour whoever left it off.
+#[derive(Resource, Clone, Copy, Default, PartialEq, Debug)]
+pub struct DarkerNights {
+    /// The player's switch.
+    pub enabled: bool,
+    /// The map is a battleground or an arena (`Map.dbc` `InstanceType` 3 or 4).
+    pub forced_off: bool,
+}
+
+impl DarkerNights {
+    pub fn active(self) -> bool {
+        self.enabled && !self.forced_off
+    }
+}
+
+/// One colour under Darker Nights at night fraction `night`: scaled toward
+/// [`DARKER_NIGHTS_SCALE`], never under the floor, and never brightened (a colour already under
+/// the floor is left as it is).
+pub fn darken_rgb(c: [f32; 3], night: f32) -> [f32; 3] {
+    let night = night.clamp(0.0, 1.0);
+    if night == 0.0 {
+        return c;
+    }
+    let k = 1.0 + (DARKER_NIGHTS_SCALE - 1.0) * night;
+    let y = luma(c);
+    if y <= DARKER_NIGHTS_FLOOR {
+        return c;
+    }
+    let k = k.max(DARKER_NIGHTS_FLOOR / y);
+    c.map(|v| v * k)
+}
+
+/// Darker Nights on a resolved light: the ambient, the sun's diffuse, the fog and the sky dome,
+/// at the light's own SIDN night fraction. Specular, water and clouds keep the stock game's bands.
+pub(crate) fn darken_lighting(l: &mut WowLighting) {
+    let night = l.sidn_night;
+    l.ambient = darken_rgb(l.ambient, night);
+    l.diffuse = darken_rgb(l.diffuse, night);
+    l.fog_color = darken_rgb(l.fog_color, night);
+    l.wmo_fog_color = darken_rgb(l.wmo_fog_color, night);
+    for stop in &mut l.sky {
+        *stop = darken_rgb(*stop, night);
+    }
+}
+
+/// `Map.dbc` `InstanceType` 3, a battleground, and 4, an arena.
+pub fn is_pvp_instance(instance_type: Option<u32>) -> bool {
+    matches!(instance_type, Some(3 | 4))
+}
+
+/// Holds Darker Nights off on a battleground or arena map; writes only on a change.
+pub fn gate_darker_nights(
+    map: Option<Res<crate::world_map::CurrentMap>>,
+    catalog: Option<Res<benilla_assets::MapCatalogRes>>,
+    mut dn: ResMut<DarkerNights>,
+) {
+    let pvp = is_pvp_instance(
+        map.as_ref()
+            .zip(catalog.as_ref())
+            .and_then(|(m, c)| c.0.instance_type(m.0)),
+    );
+    if dn.forced_off != pvp {
+        dn.forced_off = pvp;
+    }
+}
+
