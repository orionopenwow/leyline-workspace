+
+impl PendingList {
+    fn new(rows: &[FilterPattern], list: &'static str) -> Self {
+        PendingList {
+            list,
+            rows: rows.to_vec(),
+            next_row: 0,
+            patterns: Vec::with_capacity(rows.len()),
+            done: PatternList {
+                sets: Vec::new(),
+                each: Vec::with_capacity(rows.len()),
+            },
+        }
+    }
+
+    /// Compile until `budget` is spent (at least one expression or one set), then report whether
+    /// the list is complete: every row compiled or skipped, every set built.
+    fn step(&mut self, budget: std::time::Duration) -> bool {
+        let start = bevy::platform::time::Instant::now();
+        while self.next_row < self.rows.len() {
+            let row = &self.rows[self.next_row];
+            self.next_row += 1;
+            let translated = translate(&row.pattern);
+            match Regex::new(&translated) {
+                Ok(re) => {
+                    self.patterns.push(translated);
+                    self.done.each.push(re);
+                }
+                // A row the regex engine refuses (`{性}交`'s bare braces) is skipped, quietly: the
+                // count of skips is in the compile's own summary.
+                Err(e) => debug!(
+                    "skipping {} expression {:?} (record ID {}): {e}",
+                    self.list, row.pattern, row.id
+                ),
+            }
+            if start.elapsed() >= budget {
+                return false;
+            }
+        }
+        // Built from the strings that compiled, so they agree with `each`.
+        loop {
+            let base = self.done.sets.len() * SET_CHUNK;
+            if base >= self.patterns.len() {
+                return true;
+            }
+            let end = (base + SET_CHUNK).min(self.patterns.len());
+            match RegexSet::new(&self.patterns[base..end]) {
+                Ok(set) => self.done.sets.push((base, set)),
+                Err(e) => {
+                    error!(
+                        "{}: the pattern set would not build ({e}) — the filter is off",
+                        self.list
+                    );
+                    self.done.sets.clear();
+                    self.patterns.clear();
+                    self.done.each.clear();
+                    return true;
+                }
+            }
+            if start.elapsed() >= budget {
+                return false;
+            }
+        }
+    }
 }
 
