@@ -0,0 +1,377 @@
+//! Web-target chain plumbing: `wasm32-unknown-unknown` has no filesystem, so [`crate::Chain`]
+//! answers every read/existence/listing question with an HTTP call against the Data URL scheme a
+//! companion web host (`wenilla-host`, Lane H) serves — `GET {origin}/data/{encoded name}`,
+//! `HEAD` for existence, `GET /data/__index` for the name list. This module is that HTTP shim.
+//!
+//! [`encode_name`] is plain string math with no browser dependency, so it is exercised natively
+//! (`tests/web_names.rs`); [`data_base`], [`fetch_sync`], and [`exists_sync`] need `web-sys` and
+//! only make sense — and only compile their bodies — on `wasm32`.
+
+/// Percent-encode `name` exactly like JavaScript's `encodeURIComponent`: the unreserved set is
+/// `A-Za-z0-9-_.!~*'()`; every other byte, including `\` (chain names are internally
+/// backslash-separated), becomes `%XX` uppercase-hex. This is the client half of the Data URL
+/// scheme's "the full name percent-encoded as one component" rule — the web host's decode must be
+/// this function's exact inverse, so it is kept pure and unit-tested rather than left to whatever
+/// a URL-building crate happens to escape.
+pub fn encode_name(name: &str) -> String {
+    const UNRESERVED: &[u8] =
+        b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.!~*'()";
+    let mut out = String::with_capacity(name.len());
+    for &byte in name.as_bytes() {
+        if UNRESERVED.contains(&byte) {
+            out.push(byte as char);
+        } else {
+            out.push_str(&format!("%{byte:02X}"));
+        }
+    }
+    out
+}
+
+#[cfg(target_arch = "wasm32")]
+mod wasm {
+    use wasm_bindgen::prelude::wasm_bindgen;
+    use wasm_bindgen::JsValue;
+    use web_sys::XmlHttpRequest;
+
+    /// The root every chain fetch is served from: `/data` under this page's own origin. The web
+    /// host answers both the client bundle and the `/data/*` routes from one process (Lane H), so
+    /// there is never a cross-origin question to configure — this is the whole answer.
+    pub fn data_base() -> String {
+        let origin = web_sys::window()
+            .expect("benilla_formats::web only runs inside a browser tab")
+            .location()
+            .origin()
+            .expect("window.location.origin");
+        format!("{origin}/data")
+    }
+
+    /// Append `name` to the page's boot-read trace, if the page armed one — the input to
+    /// `web/boot-manifest.json` (see `web/boot.js`). A page that wants the trace defines
+    /// `window.__wenilla_boottrace = []` before `init()` (the `?boottrace=1` switch does);
+    /// every chain read then pushes its raw backslash name in true first-need order, and a
+    /// person copies the deduplicated array out of the console into the manifest. Without the
+    /// array this is one snapshotted `Reflect::get` for the whole session and per-call nothing —
+    /// tracing must cost the boot it measures as close to zero as possible.
+    pub fn trace(name: &str) {
+        use wasm_bindgen::JsCast;
+        thread_local! {
+            static TRACE: std::cell::OnceCell<Option<js_sys::Array>> =
+                const { std::cell::OnceCell::new() };
+        }
+        TRACE.with(|cell| {
+            let arr = cell.get_or_init(|| {
+                let window = web_sys::window()?;
+                js_sys::Reflect::get(&window, &"__wenilla_boottrace".into())
+                    .ok()?
+                    .dyn_into::<js_sys::Array>()
+                    .ok()
+            });
+            if let Some(arr) = arr {
+                arr.push(&name.into());
+            }
+        });
+    }
+
+    /// The page's half of the reads: the boot prefetch's bodies (`web/boot.js` keeps each fetched
+    /// boot file in `globalThis.__wenilla_prefetch`, keyed by its `/data/...` path), taken once,
+    /// and the synchronous GET with its body turned into bytes in JavaScript.
+    ///
+    /// The bytes come out of `responseText` (a sync XHR's `responseType` is stuck at text, see
+    /// [`fetch_sync`]) in a JavaScript loop into a `Uint8Array`, copied into linear memory once.
+    /// Through a Rust `String` instead, every byte above 0x7f of the `x-user-defined` text
+    /// (U+F780..U+F7FF) is three UTF-8 bytes: a 60 MB `Spell.dbc` was a 180 MB transient in
+    /// linear memory, which never shrinks, and two passes over it.
+    #[wasm_bindgen(inline_js = r#"
+// The page's body store (web/boot.js): normalized chain name -> ArrayBuffer. Names are matched as
+// the chain matches them, any case and `/` = `\`, so a prefetch by the host's spelling answers
+// the client's.
+function keyOf(url) {
+    const i = url.indexOf('/data/');
+    let name = i < 0 ? url : url.slice(i + 6);
+    try { name = decodeURIComponent(name); } catch (_) {}
+    return name.replace(/\//g, '\\').toLowerCase();
+}
+// Bodies up to this size stay in the store after a read (a second read is free: the client asks
+// for some files many times); bigger ones are read once and dropped.
+const KEEP_MAX = 4 * 1024 * 1024;
+export function take_prefetched(url) {
+    const m = globalThis.__wenilla_prefetch;
+    if (!m) return undefined;
+    const key = keyOf(url);
+    const body = m.get(key);
+    if (body === undefined) return undefined;
+    if (body.byteLength > KEEP_MAX && key !== '__index') {
+        m.delete(key);
+        (globalThis.__wenilla_taken ??= new Set()).add(key); // read once: never fetched again
+    }
+    return new Uint8Array(body);
+}
+// The page's name-index generation: bumped when a player folder is mounted over the slice.
+export function index_gen() {
+    return (globalThis.__wenilla_index_gen | 0) >>> 0;
+}
+export function sync_get(url) {
+    const t0 = performance.now();
+    const x = new XMLHttpRequest();
+    x.open('GET', url, false);
+    x.overrideMimeType('text/plain; charset=x-user-defined');
+    x.send();
+    // Every read the store could not answer, for the manifests: `window.__wenilla_dump_misses()`.
+    const misses = (globalThis.__wenilla_misses ??= []);
+    const phase = globalThis.__wenilla_phase || 'boot';
+    misses.push({ name: keyOf(url), phase,
+                  t: Math.round(t0), ms: Math.round(performance.now() - t0), status: x.status });
+    // In the world a synchronous read freezes the frame for a round trip: name the caller.
+    if (phase === 'world') {
+        console.warn(`sync read in the world: ${keyOf(url)} (${Math.round(performance.now() - t0)} ms)`,
+                     new Error().stack);
+    }
+    if (x.status !== 200) return x.status;
+    const t = x.responseText;
+    const n = t.length;
+    const u = new Uint8Array(n);
+    for (let i = 0; i < n; i++) u[i] = t.charCodeAt(i);
+    if (n <= KEEP_MAX) (globalThis.__wenilla_prefetch ??= new Map()).set(keyOf(url), u.buffer.slice(0));
+    return u;
+}
+// Fetch every URL at once into the store; resolves when all have landed (or failed).
+export function prefetch_urls(urls) {
+    const m = (globalThis.__wenilla_prefetch ??= new Map());
+    const inflight = (globalThis.__wenilla_inflight ??= new Map());
+    const failed = (globalThis.__wenilla_failed ??= new Set());
+    return Promise.all(urls.map((u) => {
+        const key = keyOf(u);
+        if (m.has(key) || failed.has(key)) return null;
+        if (inflight.has(key)) return inflight.get(key);
+        const p = fetch(u).then((r) => (r.ok ? r.arrayBuffer() : null))
+            .then((b) => { if (b) m.set(key, b); else failed.add(key); }, () => failed.add(key))
+            .finally(() => inflight.delete(key));
+        inflight.set(key, p);
+        return p;
+    }));
+}
+// Whether a read of `url` needs no request: its body is stored, or its fetch already failed.
+export function settled_in_store(url) {
+    const key = keyOf(url);
+    return !!((globalThis.__wenilla_prefetch && globalThis.__wenilla_prefetch.has(key))
+        || (globalThis.__wenilla_failed && globalThis.__wenilla_failed.has(key)));
+}
+export function now_ms() {
+    return performance.now();
+}
+export function slow(msg) {
+    console.warn(msg);
+}
+"#)]
+    extern "C" {
+        fn take_prefetched(url: &str) -> Option<js_sys::Uint8Array>;
+        /// `globalThis.__wenilla_index_gen`, 0 until the page bumps it.
+        pub fn index_gen() -> u32;
+        #[wasm_bindgen(catch)]
+        fn sync_get(url: &str) -> Result<JsValue, JsValue>;
+        fn now_ms() -> f64;
+        fn prefetch_urls(urls: js_sys::Array) -> js_sys::Promise;
+        fn settled_in_store(url: &str) -> bool;
+        fn slow(msg: &str);
+    }
+
+    /// The session's read totals ([`read_stats`]).
+    #[derive(Clone, Copy, Default, Debug)]
+    pub struct ReadStats {
+        /// Files read (`GET`s that returned a body).
+        pub reads: u32,
+        /// Of those, answered from the boot prefetch's bodies with no request.
+        pub prefetched: u32,
+        pub bytes: u64,
+        /// Wall time spent inside the reads, request and copy.
+        pub ms: f64,
+    }
+
+    thread_local! {
+        static STATS: std::cell::Cell<ReadStats> = const {
+            std::cell::Cell::new(ReadStats { reads: 0, prefetched: 0, bytes: 0, ms: 0.0 })
+        };
+    }
+
+    /// What the chain's reads have cost so far this session.
+    pub fn read_stats() -> ReadStats {
+        STATS.with(|s| s.get())
+    }
+
+    /// Reads slower than this, and main-thread work between two reads longer than [`SLOW_GAP_MS`],
+    /// are named on the console: the boot's slow spots, without a profiler.
+    const SLOW_READ_MS: f64 = 1000.0;
+    const SLOW_GAP_MS: f64 = 1000.0;
+
+    thread_local! {
+        static LAST: std::cell::RefCell<(f64, String)> = const {
+            std::cell::RefCell::new((0.0, String::new()))
+        };
+    }
+
+    /// Name a read that took long, or a long stretch of work since the previous read ended.
+    fn watch(url: &str, start: f64, end: f64, how: &str, bytes: usize) {
+        LAST.with(|last| {
+            let mut last = last.borrow_mut();
+            let gap = start - last.0;
+            if last.0 > 0.0 && gap > SLOW_GAP_MS {
+                slow(&format!(
+                    "web read: {gap:.0} ms with no synchronous read between {} and {} (frames and \
+                     async loads ran in between: not one long task)",
+                    short(&last.1),
+                    short(url)
+                ));
+            }
+            if end - start > SLOW_READ_MS {
+                slow(&format!(
+                    "web read: {} took {:.0} ms ({how}, {:.1} MB)",
+                    short(url),
+                    end - start,
+                    bytes as f64 / (1024.0 * 1024.0)
+                ));
+            }
+            *last = (end, url.to_string());
+        });
+    }
+
+    fn short(url: &str) -> &str {
+        url.find("/data/").map_or(url, |i| &url[i + 6..])
+    }
+
+    fn count(prefetched: bool, bytes: usize, ms: f64) {
+        STATS.with(|s| {
+            let mut v = s.get();
+            v.reads += 1;
+            v.prefetched += prefetched as u32;
+            v.bytes += bytes as u64;
+            v.ms += ms;
+            s.set(v);
+        });
+    }
+
+    /// Fetch `names` (chain names) into the page's body store, all at once: the promise resolves
+    /// when every one has landed or failed, and the synchronous reads after it find them with no
+    /// round trip each.
+    pub fn prefetch_into_store(names: &[String]) -> js_sys::Promise {
+        let base = data_base();
+        let urls = js_sys::Array::new();
+        for n in names {
+            urls.push(&format!("{base}/{}", crate::web::encode_name(n)).into());
+        }
+        prefetch_urls(urls)
+    }
+
+    /// Whether every one of `names` (chain names) can be read with no round trip: each is stored,
+    /// or absent per the name index, or its fetch already failed. Starts the fetch of the rest, all
+    /// at once, so a caller that polls this once a frame waits about one round trip in all.
+    pub fn ready_or_prefetch(names: &[String]) -> bool {
+        let base = data_base();
+        let mut missing = Vec::new();
+        for n in names {
+            if crate::web::host_lacks(n) {
+                continue;
+            }
+            if !settled_in_store(&format!("{base}/{}", crate::web::encode_name(n))) {
+                missing.push(n.clone());
+            }
+        }
+        if missing.is_empty() {
+            return true;
+        }
+        let _ = prefetch_into_store(&missing);
+        false
+    }
+
+    /// The page's body store's copy of `url`'s file, if it holds one: the async readers' first
+    /// stop, as it is the synchronous one's.
+    pub fn stored(url: &str) -> Option<Vec<u8>> {
+        take_prefetched(url).map(|b| b.to_vec())
+    }
+
+    /// A blocking `XMLHttpRequest` GET, returning the raw response bytes.
+    ///
+    /// Synchronous on purpose: [`crate::Chain::read`] is called from Bevy systems on the main
+    /// thread today — `WorldAssets` and ~60 other call sites read the chain synchronously — and
+    /// making the whole call chain async to reach it would ripple through every one of them. A
+    /// *synchronous* `XMLHttpRequest` is the one browser primitive that can return bytes from a
+    /// call that must return before the function does; the Bevy `AssetReader` path
+    /// (`benilla-assets`) is already `async` end to end, so it uses `fetch` instead (no such
+    /// constraint there).
+    ///
+    /// A sync XHR's `responseType` is stuck at the default `""` (text), so an `arraybuffer`
+    /// response type — the normal way to get binary out of an XHR — isn't available here. The
+    /// standard workaround, used below, is `override_mime_type("text/plain; charset=x-user-defined")`:
+    /// it forces the browser to decode the response body as one code unit (0x00-0xFF) per byte
+    /// instead of guessing UTF-8 and mangling anything non-ASCII into U+FFFD, so the text
+    /// round-trips arbitrary binary losslessly through `& 0xFF` (done in JavaScript, above).
+    ///
+    /// A body the boot prefetch already holds is taken from it instead, with no request at all.
+    pub fn fetch_sync(url: &str) -> std::io::Result<Vec<u8>> {
+        let t0 = now_ms();
+        if let Some(body) = take_prefetched(url) {
+            let bytes = body.to_vec();
+            let t1 = now_ms();
+            count(true, bytes.len(), t1 - t0);
+            watch(url, t0, t1, "prefetched", bytes.len());
+            return Ok(bytes);
+        }
+        let got = sync_get(url).map_err(js_err)?;
+        if let Some(status) = got.as_f64() {
+            return match status as u16 {
+                404 => Err(std::io::Error::new(
+                    std::io::ErrorKind::NotFound,
+                    url.to_string(),
+                )),
+                status => Err(std::io::Error::other(format!("{url}: HTTP {status}"))),
+            };
+        }
+        let bytes = js_sys::Uint8Array::new(&got).to_vec();
+        let t1 = now_ms();
+        count(false, bytes.len(), t1 - t0);
+        watch(url, t0, t1, "XHR", bytes.len());
+        Ok(bytes)
+    }
+
+    /// A blocking `HEAD` request: does the web host have this name? No body to decode, so no mime
+    /// override is needed — just the status line.
+    pub fn exists_sync(url: &str) -> bool {
+        let Ok(xhr) = XmlHttpRequest::new() else {
+            return false;
+        };
+        if xhr.open_with_async("HEAD", url, false).is_err() {
+            return false;
+        }
+        if xhr.send().is_err() {
+            return false;
+        }
+        xhr.status().map(|status| status == 200).unwrap_or(false)
+    }
+
+    fn js_err(e: JsValue) -> std::io::Error {
+        std::io::Error::other(format!("{e:?}"))
+    }
+}
+
+/// Whether the web host's name index says it has no file `name` (a streamed slice holds only its
+/// tiers): a caller with a fallback takes it instead of a request that 404s. Natively, and when the
+/// index is unavailable, `false`.
+pub fn host_lacks(name: &str) -> bool {
+    #[cfg(target_arch = "wasm32")]
+    {
+        static CHAIN: std::sync::OnceLock<crate::Chain> = std::sync::OnceLock::new();
+        CHAIN
+            .get_or_init(|| crate::Chain::open(std::path::Path::new("")).expect("web chain"))
+            .index_says_absent(name)
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let _ = name;
+        false
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+pub use wasm::{
+    data_base, exists_sync, fetch_sync, index_gen, prefetch_into_store, read_stats,
+    ready_or_prefetch, stored, trace, ReadStats,
+};
