diff --git a/crates/benilla-ui/src/script/mod_api.lua b/crates/benilla-ui/src/script/mod_api.lua
new file mode 100644
index 00000000..45bc191d
--- /dev/null
+++ b/crates/benilla-ui/src/script/mod_api.lua
@@ -0,0 +1,353 @@
+-- The Open Mod API 0.1: one global table, `Mod`, WrathUnleashed's own design (docs/mod-api.md
+-- beside this crate). Everything here is real: a capability `Mod.Api.Has` reports is one that
+-- works on this client, and a hook point is listed only where something really fires it.
+--
+-- The chunk is handed the host's natives (`native`), so nothing else lands in `_G`:
+--   native.watch(event, on)        route `event` through `native.set_dispatcher`'s function
+--   native.set_dispatcher(fn)      fn(phase, event, ...) runs before ("pre") and after ("post")
+--                                  every frame's OnEvent for each watched event
+--   native.mods()                  the mod.toml manifests the loader read, as tables
+--   native.send_self(text)         queue an addon whisper to the player, raw bytes, no escape scan
+local native = ...
+
+local type, pairs, ipairs, tostring, select, error, pcall = type, pairs, ipairs, tostring, select, error, pcall
+local format, sub, find, match, gsub = string.format, string.sub, string.find, string.match, string.gsub
+local tinsert, tremove, tconcat, floor = table.insert, table.remove, table.concat, math.floor
+
+local Mod = {}
+local function report(err)
+    local handler = geterrorhandler and geterrorhandler()
+    if handler then handler(err) end
+end
+local function safecall(fn, ...)
+    local ok, err = pcall(fn, ...)
+    if not ok then report(err) end
+end
+
+-- Events ---------------------------------------------------------------------------------------
+-- phase -> event -> list of functions
+local handlers = { pre = {}, post = {} }
+local function watched(event)
+    return (handlers.pre[event] and #handlers.pre[event] > 0)
+        or (handlers.post[event] and #handlers.post[event] > 0)
+end
+local function add(phase, event, fn)
+    local list = handlers[phase][event]
+    if not list then
+        list = {}
+        handlers[phase][event] = list
+    end
+    tinsert(list, fn)
+    native.watch(event, true)
+    return function()
+        for i = #list, 1, -1 do
+            if list[i] == fn then tremove(list, i) end
+        end
+        if not watched(event) then native.watch(event, false) end
+    end
+end
+native.set_dispatcher(function(phase, event, ...)
+    local list = handlers[phase][event]
+    if not list then return end
+    -- A copy: a handler may unregister itself or another.
+    local n = #list
+    if n == 0 then return end
+    local run = {}
+    for i = 1, n do run[i] = list[i] end
+    for i = 1, n do safecall(run[i], ...) end
+end)
+
+-- Mod.On(event, fn) -> cancel: fn(...) gets the event's arguments, after every frame's OnEvent.
+function Mod.On(event, fn)
+    if type(event) ~= "string" or type(fn) ~= "function" then
+        error('Usage: Mod.On("EVENT", fn)', 2)
+    end
+    return add("post", event, fn)
+end
+
+-- Slash commands -------------------------------------------------------------------------------
+-- Mod.Slash.Register("KEY", "/cmd" | { "/cmd", "/alias" }, fn(msg)): a stock SlashCmdList row.
+Mod.Slash = {}
+function Mod.Slash.Register(name, cmds, fn)
+    if type(name) ~= "string" or not match(name, "^[%w_]+$") or type(fn) ~= "function" then
+        error('Usage: Mod.Slash.Register("KEY", "/cmd" or {"/cmd", ...}, fn)', 2)
+    end
+    if type(cmds) == "string" then cmds = { cmds } end
+    if type(cmds) ~= "table" or #cmds == 0 then
+        error('Usage: Mod.Slash.Register("KEY", "/cmd" or {"/cmd", ...}, fn)', 2)
+    end
+    SlashCmdList = SlashCmdList or {}
+    local key = string.upper(name)
+    for i, cmd in ipairs(cmds) do
+        cmd = tostring(cmd)
+        if sub(cmd, 1, 1) ~= "/" then cmd = "/" .. cmd end
+        _G["SLASH_" .. key .. i] = cmd
+    end
+    SlashCmdList[key] = fn
+end
+
+-- Storage --------------------------------------------------------------------------------------
+-- One saved global, `OVMOD_STORE = { account = { [id] = {} }, character = { ["Realm-Name"] =
+-- { [id] = {} } } }`, saved through `RegisterForSave` with the interface's own settings: written
+-- at logout, run back before addons load.
+local function idcheck(id, usage)
+    if type(id) ~= "string" or not match(id, "^[%w_%.%-]+$") or #id > 32 then error(usage, 3) end
+end
+local registered = false
+local function store()
+    if type(OVMOD_STORE) ~= "table" then OVMOD_STORE = {} end
+    if not registered and RegisterForSave then
+        RegisterForSave("OVMOD_STORE")
+        registered = true
+    end
+    OVMOD_STORE.account = type(OVMOD_STORE.account) == "table" and OVMOD_STORE.account or {}
+    OVMOD_STORE.character = type(OVMOD_STORE.character) == "table" and OVMOD_STORE.character or {}
+    return OVMOD_STORE
+end
+-- A store loaded from file is kept even in a session where no mod asks for it.
+add("post", "VARIABLES_LOADED", function()
+    if OVMOD_STORE ~= nil then store() end
+end)
+Mod.Store = {}
+function Mod.Store.Account(id)
+    idcheck(id, 'Usage: Mod.Store.Account("modId")')
+    local s = store().account
+    if type(s[id]) ~= "table" then s[id] = {} end
+    return s[id]
+end
+function Mod.Store.Character(id)
+    idcheck(id, 'Usage: Mod.Store.Character("modId")')
+    local name = UnitName and UnitName("player")
+    if not name or name == "" then
+        error("Mod.Store.Character: no character yet (call it once the player exists)", 2)
+    end
+    local key = (GetRealmName and GetRealmName() or "") .. "-" .. name
+    local chars = store().character
+    if type(chars[key]) ~= "table" then chars[key] = {} end
+    if type(chars[key][id]) ~= "table" then chars[key][id] = {} end
+    return chars[key][id]
+end
+
+-- Hooks ----------------------------------------------------------------------------------------
+-- point -> { phases = { pre = true, post = true }, attach = fn(phase, fn) }
+local points = {}
+local function eventpoint(event, shape)
+    return {
+        phases = { pre = true, post = true },
+        attach = function(phase, fn)
+            return add(phase, event, function(...) fn(shape(...)) end)
+        end,
+    }
+end
+local function same(...) return ... end
+local function withplate(unit)
+    return unit, C_NamePlate and C_NamePlate.GetNamePlateForUnit(unit)
+end
+points["nameplate:added"] = eventpoint("NAME_PLATE_UNIT_ADDED", withplate)
+points["nameplate:removed"] = eventpoint("NAME_PLATE_UNIT_REMOVED", withplate)
+points["spellcast:start"] = eventpoint("UNIT_SPELLCAST_START", same)
+points["spellcast:stop"] = eventpoint("UNIT_SPELLCAST_STOP", same)
+points["spellcast:succeeded"] = eventpoint("UNIT_SPELLCAST_SUCCEEDED", same)
+points["combatlog"] = eventpoint("COMBAT_LOG_EVENT_UNFILTERED", same)
+
+-- Tooltip points: after the stock tooltip has its lines, on GameTooltip.
+local tooltipHooks = { unit = {}, item = {} }
+local tooltipAttached = false
+local function runTooltip(kind, ...)
+    for _, fn in ipairs(tooltipHooks[kind]) do safecall(fn, ...) end
+end
+local itemSetters = {
+    SetHyperlink = function(link) return link end,
+    SetBagItem = function(bag, slot) return GetContainerItemLink and GetContainerItemLink(bag, slot) end,
+    SetInventoryItem = function(unit, slot) return GetInventoryItemLink and GetInventoryItemLink(unit, slot) end,
+    SetLootItem = function(slot) return GetLootSlotLink and GetLootSlotLink(slot) end,
+    SetMerchantItem = function(i) return GetMerchantItemLink and GetMerchantItemLink(i) end,
+}
+local function attachTooltip()
+    local tip = GameTooltip
+    if tooltipAttached or type(tip) ~= "table" then return tooltipAttached end
+    tip:HookScript("OnTooltipSetUnit", function(self) runTooltip("unit", self) end)
+    for setter, linkOf in pairs(itemSetters) do
+        if type(tip[setter]) == "function" then
+            hooksecurefunc(tip, setter, function(self, ...)
+                local link = linkOf(...)
+                if type(link) == "string" and find(link, "item:%d") then runTooltip("item", self, link) end
+            end)
+        end
+    end
+    tooltipAttached = true
+    return true
+end
+local function tooltipPoint(kind)
+    return {
+        phases = { post = true },
+        ready = function() return type(GameTooltip) == "table" end,
+        attach = function(_, fn)
+            if not attachTooltip() then
+                -- Before the interface: attach once it has loaded.
+                local cancel
+                cancel = add("post", "VARIABLES_LOADED", function() attachTooltip() cancel() end)
+            end
+            tinsert(tooltipHooks[kind], fn)
+            return function()
+                for i = #tooltipHooks[kind], 1, -1 do
+                    if tooltipHooks[kind][i] == fn then tremove(tooltipHooks[kind], i) end
+                end
+            end
+        end,
+    }
+end
+points["tooltip:unit"] = tooltipPoint("unit")
+points["tooltip:item"] = tooltipPoint("item")
+
+-- Chat filter: the stock ChatFrame_AddMessageEventFilter, on every player chat lane; the filter
+-- returns true to hide the line, or false plus replacement arguments, as the stock filter does.
+local chatEvents = {
+    "CHAT_MSG_SAY", "CHAT_MSG_YELL", "CHAT_MSG_WHISPER", "CHAT_MSG_WHISPER_INFORM",
+    "CHAT_MSG_PARTY", "CHAT_MSG_RAID", "CHAT_MSG_RAID_LEADER", "CHAT_MSG_RAID_WARNING",
+    "CHAT_MSG_GUILD", "CHAT_MSG_OFFICER", "CHAT_MSG_CHANNEL", "CHAT_MSG_EMOTE",
+    "CHAT_MSG_TEXT_EMOTE", "CHAT_MSG_BATTLEGROUND", "CHAT_MSG_BATTLEGROUND_LEADER",
+    "CHAT_MSG_SYSTEM", "CHAT_MSG_MONSTER_SAY", "CHAT_MSG_MONSTER_YELL", "CHAT_MSG_MONSTER_EMOTE",
+    "CHAT_MSG_MONSTER_WHISPER", "CHAT_MSG_AFK", "CHAT_MSG_DND",
+}
+points["chat:filter"] = {
+    phases = { pre = true },
+    ready = function() return type(ChatFrame_AddMessageEventFilter) == "function" end,
+    attach = function(_, fn)
+        for _, e in ipairs(chatEvents) do ChatFrame_AddMessageEventFilter(e, fn) end
+        return function()
+            if ChatFrame_RemoveMessageEventFilter then
+                for _, e in ipairs(chatEvents) do ChatFrame_RemoveMessageEventFilter(e, fn) end
+            end
+        end
+    end,
+}
+
+-- Mod.Hook(point, fn [, "pre" | "post"]) -> cancel. The default phase is the point's only one, or
+-- "post" where it has both.
+function Mod.Hook(point, fn, phase)
+    local p = points[point]
+    if not p then error("Mod.Hook: no hook point '" .. tostring(point) .. "'", 2) end
+    if type(fn) ~= "function" then error('Usage: Mod.Hook("point", fn [, "pre"|"post"])', 2) end
+    if phase == nil then phase = p.phases.post and "post" or "pre" end
+    if not p.phases[phase] then
+        error(format("Mod.Hook: '%s' has no %s phase", point, tostring(phase)), 2)
+    end
+    if p.ready and not p.ready() and point == "chat:filter" then
+        error("Mod.Hook: chat:filter needs the stock chat frame (ChatFrame_AddMessageEventFilter)", 2)
+    end
+    return p.attach(phase, fn)
+end
+
+-- Packets: mod messages over addon whispers to oneself --------------------------------------------
+-- Wire (docs/mod-api.md): prefix "OVMOD", one whisper per part,
+--   <modId> TAB <name> TAB <i>/<n> TAB <data>
+-- parts 1-based in any order; a client part keeps "OVMOD\t"..text within 255 bytes (the core drops
+-- longer ones silently). Replies come from the server as a whisper whose sender is the player.
+local PREFIX = "OVMOD"
+local LIMIT = 249 -- 255 - #"OVMOD\t"
+local MAX_PARTS = 64
+local packetMods, packetHandlers, buffers = {}, {}, {}
+local function wireid(s) return type(s) == "string" and #s >= 1 and #s <= 32 and not find(s, "[^%w_%.%-]") end
+
+Mod.Packet = {}
+function Mod.Packet.Register(modId)
+    if not wireid(modId) then error('Usage: Mod.Packet.Register("modId") with 1-32 of [A-Za-z0-9_.-]', 2) end
+    packetMods[modId] = true
+    return true
+end
+
+-- The parts of one message: the data of each part sized so its whole line fits.
+local function split(modId, name, data)
+    local n = 1
+    while true do
+        local room = LIMIT - #modId - #name - #(n .. "/" .. n) - 3
+        if room < 1 then return nil end
+        local need = math.max(1, math.ceil(#data / room))
+        if need <= n then
+            local parts = {}
+            for i = 1, n do
+                parts[i] = format("%s\t%s\t%d/%d\t%s", modId, name, i, n, sub(data, (i - 1) * room + 1, i * room))
+            end
+            return parts
+        end
+        n = need
+        if n > MAX_PARTS then return nil end
+    end
+end
+
+function Mod.Packet.Send(modId, name, payload)
+    if not packetMods[modId] then error("Mod.Packet.Send: '" .. tostring(modId) .. "' is not registered", 2) end
+    if not wireid(name) then error('Usage: Mod.Packet.Send("modId", "name", "payload")', 2) end
+    payload = payload == nil and "" or tostring(payload)
+    if find(payload, "\0", 1, true) then error("Mod.Packet.Send: a payload cannot hold a NUL byte", 2) end
+    local parts = split(modId, name, payload)
+    if not parts then error("Mod.Packet.Send: payload too large", 2) end
+    for i = 1, #parts do native.send_self(PREFIX .. "\t" .. parts[i]) end
+    return #parts
+end
+
+function Mod.Packet.On(modId, name, fn)
+    if not packetMods[modId] then error("Mod.Packet.On: '" .. tostring(modId) .. "' is not registered", 2) end
+    if not wireid(name) or type(fn) ~= "function" then error('Usage: Mod.Packet.On("modId", "name", fn(data))', 2) end
+    packetHandlers[modId .. "\t" .. name] = fn
+end
+
+add("post", "CHAT_MSG_ADDON", function(prefix, text, channel, sender)
+    if prefix ~= PREFIX or channel ~= "WHISPER" or sender ~= (UnitName and UnitName("player")) then return end
+    local modId, name, i, n, data = match(text, "^([^\t]+)\t([^\t]+)\t(%d+)/(%d+)\t(.*)$")
+    if not modId then return end
+    local key = modId .. "\t" .. name
+    local fn = packetHandlers[key]
+    if not fn then return end
+    i, n = tonumber(i), tonumber(n)
+    if n < 1 or n > MAX_PARTS or i < 1 or i > n then return end
+    if n == 1 then return safecall(fn, data) end
+    local b = buffers[key]
+    if not b or b.n ~= n then
+        b = { n = n, got = 0, parts = {} }
+        buffers[key] = b
+    end
+    if b.parts[i] == nil then
+        b.parts[i] = data
+        b.got = b.got + 1
+    end
+    if b.got == n then
+        buffers[key] = nil
+        safecall(fn, tconcat(b.parts, "", 1, n))
+    end
+end)
+
+-- Capabilities ---------------------------------------------------------------------------------
+-- The backport calls whose presence `compat:` reports.
+local compat = {
+    C_NamePlate = true, UnitTokenFromGUID = true, GetSpellBaseCooldown = true,
+    GetItemInfoInstant = true, UnitOwner = true, UnitOccupations = true, UnitIsControlled = true,
+    UnitIsDisarmed = true, FlashWindow = true, IsWindowFocused = true, FocusWindow = true,
+    CopyToClipboard = true,
+}
+local features = { on = true, slash = true, store = true, packet = true, hook = true }
+
+Mod.Api = { Version = "0.1" }
+function Mod.Api.Has(cap)
+    if type(cap) ~= "string" then return false end
+    local kind, what = match(cap, "^(%a+):(.+)$")
+    if kind == "compat" then return compat[what] == true and _G[what] ~= nil end
+    if kind == "hook" then
+        local p = points[what]
+        return p ~= nil and (not p.ready or p.ready())
+    end
+    if kind == "api" then return what == Mod.Api.Version end
+    return features[cap] == true
+end
+function Mod.Api.Mods()
+    return native.mods()
+end
+function Mod.Api.HookPoints()
+    local out = {}
+    for name in pairs(points) do out[#out + 1] = name end
+    table.sort(out)
+    return out
+end
+
+_G.Mod = Mod
diff --git a/crates/benilla-ui/src/script/mod_api.rs b/crates/benilla-ui/src/script/mod_api.rs
new file mode 100644
index 00000000..5491a476
--- /dev/null
+++ b/crates/benilla-ui/src/script/mod_api.rs
@@ -0,0 +1,146 @@
+//! The Open Mod API 0.1, the one global `Mod` (`mod_api.lua`, documented in `docs/mod-api.md`):
+//! WrathUnleashed's own surface for mods, on top of the 3.3.5a API rather than inside it. This
+//! file is its host half: the event pre/post dispatch the hooks stand on, the self-whisper the
+//! packet transport sends, and the mod manifests the loader seats.
+
+use std::collections::HashSet;
+
+use mlua::{Lua, MultiValue, Value};
+
+use super::addon_message::{AddonDistribution, AddonSend};
+
+/// One `mod.toml` beside an addon's `.toc`, as `Mod.Api.Mods()` lists it.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ModManifest {
+    /// The addon folder the manifest sits in.
+    pub addon: String,
+    pub id: String,
+    pub name: String,
+    pub version: String,
+    /// The Mod API version the mod is written against (`"0.1"`).
+    pub api: String,
+    /// What the mod declares it uses (`"packet"`, `"store"`, ...); listed, not enforced.
+    pub permissions: Vec<String>,
+}
+
+/// The VM's mod state: the events the Lua side watches, and the manifests.
+#[derive(Default)]
+struct ModState {
+    watched: HashSet<String>,
+    manifests: Vec<ModManifest>,
+}
+
+const REG_DISPATCH: &str = "benilla.mod_api.dispatch";
+
+/// Run the Lua dispatcher for `event` in `phase` (`"pre"` before the frames' handlers, `"post"`
+/// after the all-events frames), only when a mod watches it: an unwatched event costs one set
+/// lookup.
+pub(crate) fn dispatch(lua: &Lua, phase: &str, event: &str, args: &[Value]) {
+    let watched = lua
+        .app_data_ref::<ModState>()
+        .is_some_and(|s| s.watched.contains(event));
+    if !watched {
+        return;
+    }
+    let Ok(f) = lua.named_registry_value::<mlua::Function>(REG_DISPATCH) else {
+        return;
+    };
+    let mut call: Vec<Value> = Vec::with_capacity(args.len() + 2);
+    let made = (|| -> mlua::Result<()> {
+        call.push(Value::String(lua.create_string(phase)?));
+        call.push(Value::String(lua.create_string(event)?));
+        Ok(())
+    })();
+    if let Err(e) = made {
+        crate::script::model_mut_of(lua).record_script_error(e.to_string());
+        return;
+    }
+    call.extend(args.iter().cloned());
+    if let Err(e) = f.call::<()>(MultiValue::from_vec(call)) {
+        crate::script::model_mut_of(lua).record_script_error(e.to_string());
+    }
+}
+
+impl super::UiScript {
+    /// Seat the `mod.toml` manifests the addon loader read, for `Mod.Api.Mods()`.
+    pub fn set_mod_manifests(&self, manifests: Vec<ModManifest>) {
+        let lua = self.lua();
+        if lua.app_data_ref::<ModState>().is_none() {
+            lua.set_app_data(ModState::default());
+        }
+        lua.app_data_mut::<ModState>().expect("mod state").manifests = manifests;
+    }
+}
+
+pub(super) fn install(lua: &Lua) -> mlua::Result<()> {
+    if lua.app_data_ref::<ModState>().is_none() {
+        lua.set_app_data(ModState::default());
+    }
+    let native = lua.create_table()?;
+    native.set(
+        "watch",
+        lua.create_function(|lua, (event, on): (String, bool)| {
+            let mut s = lua.app_data_mut::<ModState>().expect("mod state");
+            if on {
+                s.watched.insert(event);
+            } else {
+                s.watched.remove(&event);
+            }
+            Ok(())
+        })?,
+    )?;
+    native.set(
+        "set_dispatcher",
+        lua.create_function(|lua, f: mlua::Function| lua.set_named_registry_value(REG_DISPATCH, f))?,
+    )?;
+    native.set(
+        "mods",
+        lua.create_function(|lua, ()| {
+            let manifests = lua
+                .app_data_ref::<ModState>()
+                .map(|s| s.manifests.clone())
+                .unwrap_or_default();
+            let out = lua.create_table()?;
+            for (i, m) in manifests.into_iter().enumerate() {
+                let t = lua.create_table()?;
+                t.set("addon", m.addon)?;
+                t.set("id", m.id)?;
+                t.set("name", m.name)?;
+                t.set("version", m.version)?;
+                t.set("api", m.api)?;
+                t.set("permissions", lua.create_sequence_from(m.permissions)?)?;
+                out.raw_set(i + 1, t)?;
+            }
+            Ok(out)
+        })?,
+    )?;
+    // The packet transport's send: a whisper to the player, the text as Lua's bytes, past the
+    // `SendAddonMessage` escape scan (a payload is data, not chat).
+    native.set(
+        "send_self",
+        lua.create_function(|lua, text: mlua::String| {
+            let me = {
+                let model = lua
+                    .app_data_ref::<crate::script::ModelCell>()
+                    .expect("model app_data");
+                model.unit("player").and_then(|u| u.name.clone())
+            };
+            let Some(me) = me.filter(|n| !n.is_empty()) else {
+                return Err(mlua::Error::RuntimeError(
+                    "Mod.Packet.Send: no player to whisper yet".into(),
+                ));
+            };
+            crate::script::model_mut_of(lua).addon_sends.push(AddonSend {
+                text: text.as_bytes().to_vec(),
+                distribution: AddonDistribution::Whisper,
+                target: Some(me),
+            });
+            Ok(())
+        })?,
+    )?;
+    lua.load(MOD_LUA)
+        .set_name("=mod_api.lua")
+        .call::<()>(native)
+}
+
+const MOD_LUA: &str = include_str!("mod_api.lua");
