+/// An idle slot is `"UNKNOWN"`, which stock `MirrorTimer.lua:83` hides on; a running one counts
+/// by its rate on the `GetTime` clock and stops when paused.
+#[test]
+fn the_mirror_timer_verbs_read_the_restated_slots() {
+    let mut s = script();
+    let idle: (String, i64, i64, i64, i64, String) =
+        s.eval("return GetMirrorTimerInfo(2)").unwrap();
+    assert_eq!(idle, ("UNKNOWN".into(), 0, 0, 0, 0, String::new()));
+    assert!(s
+        .eval::<bool>("return GetMirrorTimerInfo(4) == nil")
+        .unwrap());
+    s.set_mirror_timer(
+        1,
+        Some(MirrorTimerView {
+            name: "BREATH".into(),
+            value_ms: 60_000,
+            max_ms: 60_000,
+            scale: -1,
+            paused: false,
+            label: "Breath".into(),
+        }),
+    );
+    s.tick(2.0);
+    let (name, value, max, scale, paused, label): (String, i64, i64, i64, i64, String) =
+        s.eval("return GetMirrorTimerInfo(2)").unwrap();
+    assert_eq!(
+        (name.as_str(), max, scale, paused),
+        ("BREATH", 60_000, -1, 0)
+    );
+    assert_eq!(label, "Breath");
+    assert!(
+        (57_900..=58_100).contains(&value),
+        "two seconds drained: {value}"
+    );
+    assert_eq!(
+        s.eval::<i64>("return GetMirrorTimerProgress('BREATH')")
+            .unwrap(),
+        value
+    );
+    s.pause_mirror_timer(1, true);
+    s.tick(5.0);
+    let (_, held): (String, i64) = s.eval("return GetMirrorTimerInfo(2)").unwrap();
+    assert_eq!(held, value, "paused: the value holds");
+    s.set_mirror_timer(1, None);
+    assert!(s
+        .eval::<bool>(
+            "return GetMirrorTimerInfo(2) == 'UNKNOWN' and GetMirrorTimerProgress('BREATH') == nil"
+        )
+        .unwrap());
+}
