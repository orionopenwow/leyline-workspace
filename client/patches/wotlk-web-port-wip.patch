+#[inline(always)]
+pub unsafe fn luaL_checkstack(L: *mut lua_State, sz: c_int, msg: *const c_char) {
+    if lua_checkstack(L, sz + LUA_MINSTACK) == 0 {
+        if !msg.is_null() {
+            luaL_error(L, cstr!("stack overflow (%s)"), msg);
+        } else {
+            lua_pushliteral(L, c"stack overflow");
+            lua_error(L);
+        }
+    }
