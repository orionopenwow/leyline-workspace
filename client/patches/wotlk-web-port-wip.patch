+                );
+            } else if t == "#ifdef GAMMA_OUT" {
+                keep.push(gamma_out);
+            } else if t == "#else" {
+                let top = keep.pop().unwrap();
+                keep.push(!top);
+            } else if t == "#endif" {
+                keep.pop();
+            } else if keep.iter().all(|k| *k) {
+                out.push_str(line);
+                out.push('\n');
+            }
+        }
+        out
+    }
