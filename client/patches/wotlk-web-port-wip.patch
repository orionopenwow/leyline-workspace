@@ -0,0 +1,611 @@
+//! The minimal character-select and character-create backdrop: a clean "room" in the faction's
+//! colour in place of the `UI_<Race>` scene.
+//!
+//! Deviation (the owner's ask): the stock game draws the race's background model, its doodads,
+//! particles and ambience. Here the scene model is read stage-only
+//! ([`benilla_assets::M2LoadSettings`]: no texture, no emitter), for the camera, the character's
+//! stage spot and the light rig, so the character stands and is lit exactly as before; none of it
+//! is drawn. Behind the character stand two quads on the glue booth's layer:
+//!
+//! - a wall facing the camera, filling the view at any aspect, lighter behind the character and
+//!   darker at the edges (a radial vignette);
+//! - a floor at the stage's height, darker than the wall, with a soft elliptical contact shadow
+//!   under the feet. Where it meets the wall is the horizon.
+//!
+//! The colour is the selected character's faction (the race being previewed on create); a Death
+//! Knight at select, or no character, is neutral. A change eases over [`EASE_SECS`]. The camera's
+//! clears take the edge colour, so a pillarboxed box has no band.
+
+use bevy::asset::RenderAssetUsages;
+use bevy::camera::visibility::RenderLayers;
+use bevy::image::{ImageSampler, ImageSamplerDescriptor};
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+
+use super::glue_booth::GlueLook;
+
+/// The minimal backdrop: off (owner, 2026-10-25: "put the animated background back"). The race's
+/// own animated scene stands behind the character at select and create again; flip to `true` for
+/// the plain faction room.
+pub(crate) const MINIMAL_GLUE_BACKDROP: bool = false;
+
+/// Whether `token`'s scene gets the minimal backdrop: character select and create, not the login
+/// screen's.
+pub(crate) fn minimal_for(token: &str) -> bool {
+    MINIMAL_GLUE_BACKDROP && !token.starts_with("MainMenu")
+}
+
+/// The time a faction change takes to ease to the new colour.
+pub(crate) const EASE_SECS: f32 = 0.25;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum Faction {
+    Alliance,
+    Horde,
+    Neutral,
+}
+
+/// The playable races' factions (`ChrRaces`): Human, Dwarf, Night Elf, Gnome and Draenei are
+/// Alliance; Orc, Undead, Tauren, Troll and Blood Elf are Horde.
+pub(crate) fn faction_of_race(race: u8) -> Faction {
+    match race {
+        1 | 3 | 4 | 7 | 11 => Faction::Alliance,
+        2 | 5 | 6 | 8 | 10 => Faction::Horde,
+        _ => Faction::Neutral,
+    }
+}
+
+/// The backdrop's faction for the look on the stage: create takes the previewed race whatever the
+/// class; select takes the character's race, a Death Knight (`dk_scene`) neutral; nobody, neutral.
+pub(crate) fn faction_of(look: Option<&GlueLook>, dk_scene: bool) -> Faction {
+    match look {
+        Some(GlueLook::Create(l)) => faction_of_race(l.race),
+        Some(GlueLook::Select(_)) if dk_scene => Faction::Neutral,
+        Some(GlueLook::Select(l)) => faction_of_race(l.race),
+        None => Faction::Neutral,
+    }
+}
+
+/// The wall's centre colour (sRGB) per faction.
+pub(crate) fn centre_srgb(f: Faction) -> [u8; 3] {
+    match f {
+        Faction::Alliance => [0x2f, 0x5d, 0x9a],
+        Faction::Horde => [0x9a, 0x2f, 0x2f],
+        Faction::Neutral => [0x3a, 0x3f, 0x55],
+    }
+}
+
+/// The edge over the centre, in sRGB terms: #12233f over #2f5d9a, #3f1212 over #9a2f2f.
+const EDGE_RATIO: f32 = 0.39;
+/// The floor over the centre: #1a2f52 over #2f5d9a, #521a1a over #9a2f2f.
+const FLOOR_RATIO: f32 = 0.53;
+
+/// The edge colour (the clears) for a centre colour, linear: the centre times [`EDGE_RATIO`] in
+/// sRGB terms, as the mask's sRGB-encoded texels give the wall's edge.
+fn edge_of(centre: LinearRgba) -> LinearRgba {
+    let s = Color::LinearRgba(centre).to_srgba();
+    Color::srgb(s.red * EDGE_RATIO, s.green * EDGE_RATIO, s.blue * EDGE_RATIO).to_linear()
+}
+
+fn linear_of(srgb: [u8; 3]) -> LinearRgba {
+    Color::srgb_u8(srgb[0], srgb[1], srgb[2]).to_linear()
+}
+
+/// Marks the wall and floor quads; their transforms follow the camera every frame.
+#[derive(Component, Clone, Copy, PartialEq, Eq, Debug)]
+pub(crate) enum BackdropPart {
+    Wall,
+    Floor,
+    Shadow,
+}
+
+/// The backdrop's shared assets and its colour state.
+#[derive(Resource)]
+pub(crate) struct GlueBackdrop {
+    quad: Handle<Mesh>,
+    wall: Handle<StandardMaterial>,
+    floor: Handle<StandardMaterial>,
+    shadow: Handle<StandardMaterial>,
+    /// The void fill's wall behind the animated scene: the wall's vignette in the edge colour.
+    void: Handle<StandardMaterial>,
+    /// The colour shown now and the one easing in, linear.
+    pub(crate) shown: LinearRgba,
+    target: LinearRgba,
+    from: LinearRgba,
+    since: f32,
+    pub(crate) faction: Option<Faction>,
+    /// The parts spawned since the quads were last fitted, which a refit must reach.
+    refit: bool,
+    last_view: Option<[f32; 14]>,
+    /// The glue camera whose clears carry the edge colour now, so a camera spawned after the
+    /// colour settled (or respawned) gets them too.
+    clears_on: Option<Entity>,
+}
+
+/// A greyscale mask, `size`×`size`, sRGB-encoded so the GPU's decode multiplies in linear.
+fn mask_image(size: u32, f: impl Fn(f32, f32) -> (f32, f32)) -> Image {
+    let mut data = Vec::with_capacity((size * size * 4) as usize);
+    for y in 0..size {
+        for x in 0..size {
+            let (u, v) = ((x as f32 + 0.5) / size as f32, (y as f32 + 0.5) / size as f32);
+            let (lum, alpha) = f(u, v);
+            let l = (lum.clamp(0.0, 1.0) * 255.0).round() as u8;
+            data.extend_from_slice(&[l, l, l, (alpha.clamp(0.0, 1.0) * 255.0).round() as u8]);
+        }
+    }
+    let mut image = Image::new(
+        Extent3d {
+            width: size,
+            height: size,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        data,
+        TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor::linear());
+    image
+}
+
+fn smoothstep(e0: f32, e1: f32, x: f32) -> f32 {
+    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// The wall's mask: 1 behind the character, [`EDGE_RATIO`] at the edges. The quad is
+/// [`WALL_ASPECT`] wide, so the ellipse is drawn in its own aspect.
+pub(crate) fn wall_lum(u: f32, v: f32) -> f32 {
+    let dx = (u - 0.5) * WALL_ASPECT / 1.6;
+    let dy = (v - 0.45) / 0.85;
+    1.0 - (1.0 - EDGE_RATIO) * smoothstep(0.0, 1.0, (dx * dx + dy * dy).sqrt())
+}
+
+/// The floor's mask: [`FLOOR_RATIO`] under the character, darkening to the edge colour far off.
+pub(crate) fn floor_lum(u: f32, v: f32) -> f32 {
+    let r = ((u - 0.5).hypot(v - 0.5) * 2.0).min(1.0);
+    FLOOR_RATIO - (FLOOR_RATIO - EDGE_RATIO) * smoothstep(0.05, 0.9, r)
+}
+
+/// The contact shadow's alpha: a soft ellipse, densest under the feet.
+pub(crate) fn shadow_alpha(u: f32, v: f32) -> f32 {
+    let r = ((u - 0.5).hypot(v - 0.5) * 2.0).min(1.0);
+    0.55 * (1.0 - smoothstep(0.15, 1.0, r))
+}
+
+/// The wall quad's width over its height: wider than any window (21:9 and past) so it always
+/// fills the view.
+const WALL_ASPECT: f32 = 4.0;
+/// The wall's distance behind the stage, in eye-to-target lengths past the target.
+const WALL_DEPTH: f32 = 2.5;
+/// The shadow's footprint, model units (a standing character is about 2 tall).
+const SHADOW_SIZE: Vec2 = Vec2::new(1.5, 1.0);
+
+impl GlueBackdrop {
+    pub(crate) fn new(
+        meshes: &mut Assets<Mesh>,
+        images: &mut Assets<Image>,
+        materials: &mut Assets<StandardMaterial>,
+    ) -> Self {
+        let quad = meshes.add(Rectangle::new(1.0, 1.0));
+        let neutral = linear_of(centre_srgb(Faction::Neutral));
+        let mat = |materials: &mut Assets<StandardMaterial>, tex: Handle<Image>, blend: bool| {
+            materials.add(StandardMaterial {
+                base_color: Color::LinearRgba(neutral),
+                base_color_texture: Some(tex),
+                unlit: true,
+                fog_enabled: false,
+                cull_mode: None,
+                alpha_mode: if blend {
+                    AlphaMode::Blend
+                } else {
+                    AlphaMode::Opaque
+                },
+                ..default()
+            })
+        };
+        let wall_tex = images.add(mask_image(128, |u, v| (wall_lum(u, v), 1.0)));
+        let floor_tex = images.add(mask_image(128, |u, v| (floor_lum(u, v), 1.0)));
+        let shadow_tex = images.add(mask_image(64, |u, v| (0.0, shadow_alpha(u, v))));
+        let void = mat(materials, wall_tex.clone(), false);
+        let wall = mat(materials, wall_tex, false);
+        let floor = mat(materials, floor_tex, false);
+        let shadow = materials.add(StandardMaterial {
+            base_color: Color::WHITE,
+            base_color_texture: Some(shadow_tex),
+            unlit: true,
+            fog_enabled: false,
+            cull_mode: None,
+            alpha_mode: AlphaMode::Blend,
+            ..default()
+        });
+        GlueBackdrop {
+            quad,
+            wall,
+            floor,
+            shadow,
+            void,
+            clears_on: None,
+            shown: neutral,
+            target: neutral,
+            from: neutral,
+            since: 0.0,
+            faction: None,
+            refit: true,
+            last_view: None,
+        }
+    }
+
+    /// Spawn the three quads under `root` on `layer` (a scene respawn despawns them with it).
+    pub(crate) fn spawn(&self, commands: &mut Commands, root: Entity, layer: &RenderLayers) {
+        // `refit` is raised by the caller holding the resource mutably ([`Self::mark_spawned`]).
+        for (part, mat) in [
+            (BackdropPart::Wall, &self.wall),
+            (BackdropPart::Floor, &self.floor),
+            (BackdropPart::Shadow, &self.shadow),
+        ] {
+            let child = commands
+                .spawn((
+                    Mesh3d(self.quad.clone()),
+                    MeshMaterial3d(mat.clone()),
+                    Transform::IDENTITY,
+                    Visibility::Visible,
+                    layer.clone(),
+                    part,
+                    bevy::light::NotShadowCaster,
+                    bevy::light::NotShadowReceiver,
+                ))
+                .id();
+            commands.entity(root).add_child(child);
+        }
+    }
+
+    /// Spawn the void fill's one wall under the animated scene's `root` on `layer`.
+    pub(crate) fn spawn_void_fill(&self, commands: &mut Commands, root: Entity, layer: &RenderLayers) {
+        let child = commands
+            .spawn((
+                Mesh3d(self.quad.clone()),
+                MeshMaterial3d(self.void.clone()),
+                Transform::IDENTITY,
+                Visibility::Visible,
+                layer.clone(),
+                BackdropPart::Wall,
+                bevy::light::NotShadowCaster,
+                bevy::light::NotShadowReceiver,
+            ))
+            .id();
+        commands.entity(root).add_child(child);
+    }
+
+    /// New parts stand at the origin until the next fit.
+    pub(crate) fn mark_spawned(&mut self) {
+        self.refit = true;
+    }
+
+    /// Ease toward `faction`'s colour; returns whether the shown colour moved.
+    pub(crate) fn ease_to(&mut self, faction: Faction, now: f32) -> bool {
+        let want = linear_of(centre_srgb(faction));
+        if self.faction != Some(faction) {
+            // The first pick shows at once; a switch eases from where it stands.
+            let first = self.faction.is_none();
+            self.faction = Some(faction);
+            self.from = if first { want } else { self.shown };
+            self.target = want;
+            self.since = now;
+        }
+        let t = ((now - self.since) / EASE_SECS).clamp(0.0, 1.0);
+        let t = t * t * (3.0 - 2.0 * t);
+        let mix = |a: f32, b: f32| a + (b - a) * t;
+        let next = LinearRgba::new(
+            mix(self.from.red, self.target.red),
+            mix(self.from.green, self.target.green),
+            mix(self.from.blue, self.target.blue),
+            1.0,
+        );
+        let next = if t >= 1.0 { self.target } else { next };
+        let moved = next != self.shown;
+        self.shown = next;
+        moved
+    }
+
+}
+
+impl BackdropView {
+    fn key(&self) -> [f32; 14] {
+        [
+            self.eye.x, self.eye.y, self.eye.z, self.fwd.x, self.fwd.y, self.fwd.z, self.up.x,
+            self.up.y, self.up.z, self.vert_fov, self.target_dist, self.stage.x, self.stage.y,
+            self.stage.z + self.void_fill.unwrap_or(0.0),
+        ]
+    }
+}
+
+impl GlueBackdrop {
+    /// The edge colour now: the camera's clears.
+    pub(crate) fn edge(&self) -> Color {
+        Color::LinearRgba(edge_of(self.shown))
+    }
+}
+
+/// The view the backdrop fits: the scene camera's eye, its forward and up, its vertical opening,
+/// the target distance, and the stage spot the floor stands at.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct BackdropView {
+    pub(crate) eye: Vec3,
+    pub(crate) fwd: Vec3,
+    pub(crate) up: Vec3,
+    pub(crate) vert_fov: f32,
+    pub(crate) target_dist: f32,
+    pub(crate) stage: Vec3,
+    /// `Some(far)` behind the animated scene: only the wall stands, just inside the scene
+    /// camera's authored far plane, behind every part of the scene.
+    pub(crate) void_fill: Option<f32>,
+}
+
+/// Each part's transform for `view`: the wall square to the camera and filling the view (with
+/// margin) at [`WALL_DEPTH`] past the target; the floor level at the stage, reaching the wall; the
+/// shadow just above the floor at the stage spot.
+pub(crate) fn part_transform(part: BackdropPart, view: &BackdropView) -> Transform {
+    let depth = view.target_dist * (1.0 + WALL_DEPTH);
+    // The void fill stands behind the whole scene, not just past the stage.
+    let depth = view.void_fill.map_or(depth, |far| (far * 0.95).max(depth));
+    match part {
+        BackdropPart::Wall => {
+            let half_h = depth * (view.vert_fov * 0.5).tan() * 1.25;
+            let centre = view.eye + view.fwd * depth;
+            Transform::from_translation(centre)
+                .looking_at(view.eye, view.up)
+                .with_scale(Vec3::new(half_h * 2.0 * WALL_ASPECT, half_h * 2.0, 1.0))
+        }
+        BackdropPart::Floor => {
+            // A Rectangle lies in XY; laid flat it faces up (+Y).
+            let size = depth * 4.0;
+            Transform::from_translation(view.stage)
+                .with_rotation(Quat::from_rotation_x(-std::f32::consts::FRAC_PI_2))
+                .with_scale(Vec3::new(size, size, 1.0))
+        }
+        BackdropPart::Shadow => Transform::from_translation(view.stage + Vec3::Y * 0.005)
+            .with_rotation(Quat::from_rotation_x(-std::f32::consts::FRAC_PI_2))
+            .with_scale(Vec3::new(SHADOW_SIZE.x, SHADOW_SIZE.y, 1.0)),
+    }
+}
+
+/// `Update`, after the scene: fit the quads to the view, ease the colour, tint the clears. The
+/// writes go through commands, so this system shares no component access with the frame's other
+/// `Transform` and `Camera` writers.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn drive_glue_backdrop(
+    mut commands: Commands,
+    preview: Res<super::glue_booth::GluePreview>,
+    scene: Res<super::glue_booth::CreateScene>,
+    backdrop: Option<ResMut<GlueBackdrop>>,
+    parts: Query<(Entity, &BackdropPart)>,
+    cams: Query<(Entity, &super::BoothCam)>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+    real: Res<Time<bevy::time::Real>>,
+    mut setup: (ResMut<Assets<Mesh>>, ResMut<Assets<Image>>),
+) {
+    // The assets first, whenever a glue scene is up: the scene's spawn waits on them, and the view
+    // exists only after that spawn, so creating them on the view stood both waiting for ever (the
+    // black character screen of 2026-10-25).
+    let Some(mut backdrop) = backdrop else {
+        // The void fill needs the assets too, so they are made for every glue scene.
+        if preview.scene.is_some() {
+            commands.insert_resource(GlueBackdrop::new(
+                &mut setup.0,
+                &mut setup.1,
+                &mut materials,
+            ));
+        }
+        return;
+    };
+    let Some(view) = scene.backdrop_view() else {
+        return;
+    };
+    // The void fill: one wall behind the animated scene, spawned once the scene is up (a scene
+    // rebuild despawns it with the root, and this puts it back).
+    if view.void_fill.is_some() && scene.is_spawned() && parts.is_empty() {
+        backdrop.spawn_void_fill(
+            &mut commands,
+            scene.root(),
+            &RenderLayers::layer(super::GLUE_LAYER),
+        );
+        backdrop.mark_spawned();
+        return;
+    }
+    let key = view.key();
+    if backdrop.refit || backdrop.last_view != Some(key) {
+        for (e, part) in parts.iter() {
+            commands.entity(e).insert(part_transform(*part, &view));
+        }
+        backdrop.last_view = Some(key);
+        backdrop.refit = parts.is_empty();
+    }
+    let dk = scene.token_is("DeathKnight");
+    let faction = faction_of(preview.look.as_ref(), dk);
+    let fresh = backdrop.faction.is_none();
+    let eased = backdrop.ease_to(faction, real.elapsed_secs()) || fresh;
+    if eased {
+        if view.void_fill.is_some() {
+            if let Some(m) = materials.get_mut(&backdrop.void) {
+                m.base_color = backdrop.edge();
+            }
+        } else {
+            let shown = Color::LinearRgba(backdrop.shown);
+            for h in [&backdrop.wall, &backdrop.floor] {
+                if let Some(m) = materials.get_mut(h) {
+                    m.base_color = shown;
+                }
+            }
+        }
+    }
+    // The clears carry the edge colour in both modes (owner, 800x868 on 20261025m: a black wedge
+    // above the scene's skyline, where neither the art nor the void wall reached): whatever a
+    // window shape or projection sees past every part, it is the dim faction tone, never black.
+    let edge = backdrop.edge();
+    let glue_cam = cams
+        .iter()
+        .find(|(_, b)| b.0 == super::glue_booth::GLUE_SLOT)
+        .map(|(e, _)| e);
+    if let Some(e) = glue_cam.filter(|&e| eased || backdrop.clears_on != Some(e)) {
+        backdrop.clears_on = Some(e);
+        commands.queue(move |world: &mut World| set_clears(world, e, edge, edge));
+    }
+}
+
+/// The glue camera's two clears: inside its viewport and outside it.
+fn set_clears(world: &mut World, cam: Entity, inside: Color, outside: Color) {
+    if let Some(mut c) = world.get_mut::<Camera>(cam) {
+        c.clear_color = ClearColorConfig::Custom(inside);
+        c.output_mode = bevy::camera::CameraOutputMode::Write {
+            blend_state: None,
+            clear_color: ClearColorConfig::Custom(outside),
+        };
+    }
+}
+
+/// Put the glue camera's clears back to the stock game's (transparent scene, black outside the
+/// box) once the minimal backdrop is down (the login screen, the world).
+pub(super) fn restore_glue_clears(
+    mut commands: Commands,
+    scene: Res<super::glue_booth::CreateScene>,
+    mut backdrop: Option<ResMut<GlueBackdrop>>,
+    cams: Query<(Entity, &super::BoothCam)>,
+) {
+    if scene.backdrop_view().is_some() {
+        return;
+    }
+    let Some(b) = backdrop.as_mut().filter(|b| b.faction.is_some()) else {
+        return;
+    };
+    b.faction = None;
+    b.last_view = None;
+    b.clears_on = None;
+    for (e, booth) in cams.iter() {
+        if booth.0 == super::glue_booth::GLUE_SLOT {
+            commands.queue(move |world: &mut World| set_clears(world, e, Color::NONE, Color::BLACK));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// No pixel of the character screen is pure black: the clears take the edge colour, and every
+    /// faction's edge is a visible tone, inside the camera's viewport and outside it.
+    #[test]
+    fn the_clears_are_the_faction_tone_never_black() {
+        for f in [Faction::Alliance, Faction::Horde, Faction::Neutral] {
+            let edge = Color::LinearRgba(edge_of(linear_of(centre_srgb(f)))).to_srgba();
+            let max = edge.red.max(edge.green).max(edge.blue);
+            assert!(max * 255.0 >= 16.0, "{f:?}: edge {edge:?} reads as black");
+        }
+        let mut w = World::new();
+        let cam = w.spawn(Camera::default()).id();
+        let tone = Color::srgb(0.07, 0.14, 0.25);
+        set_clears(&mut w, cam, tone, tone);
+        let c = w.get::<Camera>(cam).unwrap();
+        assert!(matches!(c.clear_color, ClearColorConfig::Custom(x) if x == tone));
+        match &c.output_mode {
+            bevy::camera::CameraOutputMode::Write { clear_color, .. } => {
+                assert!(matches!(clear_color, ClearColorConfig::Custom(x) if *x == tone));
+            }
+            _ => panic!("the outside-the-box clear must be written"),
+        }
+    }
+
+    #[test]
+    fn the_colour_follows_the_faction() {
+        assert_eq!(faction_of_race(1), Faction::Alliance);
+        assert_eq!(faction_of_race(11), Faction::Alliance);
+        assert_eq!(faction_of_race(2), Faction::Horde);
+        assert_eq!(faction_of_race(10), Faction::Horde);
+        assert_eq!(faction_of(None, false), Faction::Neutral);
+        assert_eq!(centre_srgb(Faction::Alliance), [0x2f, 0x5d, 0x9a]);
+        assert_eq!(centre_srgb(Faction::Horde), [0x9a, 0x2f, 0x2f]);
+        assert_eq!(centre_srgb(Faction::Neutral), [0x3a, 0x3f, 0x55]);
+    }
+
+    #[test]
+    fn a_switch_eases_over_a_quarter_second_and_the_first_pick_is_instant() {
+        let mut b = GlueBackdrop {
+            quad: Handle::default(),
+            wall: Handle::default(),
+            floor: Handle::default(),
+            shadow: Handle::default(),
+            void: Handle::default(),
+            clears_on: None,
+            shown: LinearRgba::BLACK,
+            target: LinearRgba::BLACK,
+            from: LinearRgba::BLACK,
+            since: 0.0,
+            faction: None,
+            refit: true,
+            last_view: None,
+        };
+        let blue = linear_of(centre_srgb(Faction::Alliance));
+        let red = linear_of(centre_srgb(Faction::Horde));
+        b.ease_to(Faction::Alliance, 10.0);
+        assert_eq!(b.shown, blue, "first pick: no ease from black");
+        b.ease_to(Faction::Horde, 11.0);
+        assert_eq!(b.shown, blue, "the switch starts where it stood");
+        b.ease_to(Faction::Horde, 11.125);
+        assert!(b.shown.red > blue.red && b.shown.red < red.red, "half way");
+        b.ease_to(Faction::Horde, 11.25);
+        assert_eq!(b.shown, red, "done at 250 ms");
+    }
+
+    #[test]
+    fn the_masks_match_the_specified_colours() {
+        // Centre 1.0 (#2f5d9a); edge ~0.39 (#12233f); the floor ~0.53 (#1a2f52) under the stage.
+        assert!((wall_lum(0.5, 0.45) - 1.0).abs() < 1e-3);
+        assert!((wall_lum(0.0, 0.0) - EDGE_RATIO).abs() < 1e-3);
+        assert!((floor_lum(0.5, 0.5) - FLOOR_RATIO).abs() < 1e-3);
+        assert!(shadow_alpha(0.5, 0.5) > 0.5 && shadow_alpha(0.0, 0.5) < 1e-3);
+        let edge = edge_of(linear_of([0x2f, 0x5d, 0x9a]));
+        let srgb = Color::LinearRgba(edge).to_srgba();
+        let want = [0x12, 0x23, 0x3f];
+        for (got, want) in [srgb.red, srgb.green, srgb.blue].into_iter().zip(want) {
+            assert!((got * 255.0 - want as f32).abs() < 4.0, "{got} vs {want}");
+        }
+    }
+
+    /// The wall fills the view at every aspect up to 21:9 and the phone's tall 390x844: its half
+    /// height at its depth exceeds the frustum's, and its half width the widest frustum's.
+    #[test]
+    fn the_wall_covers_the_canvas_at_every_aspect() {
+        let view = BackdropView {
+            eye: Vec3::new(0.0, 1.0, 5.0),
+            fwd: Vec3::NEG_Z,
+            up: Vec3::Y,
+            vert_fov: 0.8,
+            target_dist: 5.0,
+            stage: Vec3::ZERO,
+            void_fill: None,
+        };
+        let t = part_transform(BackdropPart::Wall, &view);
+        let depth = (t.translation - view.eye).length();
+        let frustum_half_h = depth * (view.vert_fov * 0.5).tan();
+        for (w, h) in [(16.0, 9.0), (16.0, 10.0), (21.0, 9.0), (390.0, 844.0), (844.0, 390.0)] {
+            let aspect: f32 = w / h;
+            assert!(t.scale.y * 0.5 > frustum_half_h, "{w}x{h}: height");
+            assert!(t.scale.x * 0.5 > frustum_half_h * aspect, "{w}x{h}: width");
+        }
+        // The void fill stands just inside the authored far plane and still covers every shape.
+        let far = 60.0;
+        let fill = BackdropView {
+            void_fill: Some(far),
+            ..view
+        };
+        let t = part_transform(BackdropPart::Wall, &fill);
+        let depth = (t.translation - fill.eye).length();
+        assert!((depth - far * 0.95).abs() < 1e-3, "behind the scene: {depth}");
+        let frustum_half_h = depth * (fill.vert_fov * 0.5).tan();
+        for (w, h) in [(16.0, 9.0), (504.0, 958.0), (800.0, 868.0), (21.0, 9.0)] {
+            let aspect: f32 = w / h;
+            assert!(t.scale.y * 0.5 > frustum_half_h, "{w}x{h}: height");
+            assert!(t.scale.x * 0.5 > frustum_half_h * aspect, "{w}x{h}: width");
+        }
+    }
+}
