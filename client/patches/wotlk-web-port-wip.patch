@@ -0,0 +1,538 @@
+//! `--size-report`: how much disk every part of the game would take on the stream server, measured
+//! from the game data without writing any game file. The same static walk as `--deps` (this
+//! module only adds the bookkeeping), so a number here is what `--export` would write.
+//!
+//! Units, each measured separately:
+//! - the **base** (tier 0 of the slice plus the client's boot lists): shared by everything;
+//! - every **tier** of the slice (Dalaran, the capitals, the starter areas, ...);
+//! - every **instance** in `Map.dbc` (instance types 1 dungeon, 2 raid, 3 battleground, 4 arena),
+//!   read from the DBC at run time, whatever the slice holds.
+//!
+//! Every unit after the base is counted **beyond the base**: a file the base already ships (the
+//! UI, player models, item textures, spell effects) costs that unit nothing. Units also share
+//! files with each other (two Northrend dungeons use the same rocks and torches): each unit's
+//! number is what it costs *alone* on top of the base, so the sum of all units is more than they
+//! take together. The report says both: the sum, and the union (everything at once, each file
+//! once), and the difference between them is the sharing.
+//!
+//! Sizes are the bytes `--export` writes: the uncompressed file (the size in the archive's block
+//! table), and for "lite" textures (`lite` in the slice) the cut-down BLP. Both lite and full are
+//! reported per unit.
+
+use std::collections::{HashMap, HashSet};
+
+use anyhow::{Context, Result};
+
+use crate::data::name_key;
+use crate::deps::{Catalogs, Display, MapSpec, RefsCache, SliceSpec, Source, Walker};
+use crate::export::{lite_blp, Lite};
+
+/// One measured unit.
+#[derive(Debug, Clone)]
+pub struct Unit {
+    /// `base`, `tier`, `dungeon`, `raid`, `battleground`, `arena`.
+    pub kind: String,
+    pub name: String,
+    /// Map id for an instance; tier number for a tier.
+    pub id: u32,
+    /// `Classic`, `TBC`, `Wrath` for an instance (from `Map.dbc`'s ExpansionID).
+    pub expansion: String,
+    pub files: usize,
+    pub full_bytes: u64,
+    pub lite_bytes: u64,
+    /// Walk notes (tiles, missing WDT).
+    pub notes: Vec<String>,
+}
+
+pub struct Report {
+    pub units: Vec<Unit>,
+    /// Every unit beyond the base, each file once.
+    pub union_full: u64,
+    pub union_lite: u64,
+    pub union_files: usize,
+}
+
+/// A `Map.dbc` row: what the report needs.
+#[derive(Debug, Clone, PartialEq)]
+pub struct MapRow {
+    pub id: u32,
+    pub instance_type: u32,
+    pub name: String,
+    pub expansion: u32,
+}
+
+/// Map.dbc, 3.3.5a (AzerothCore `MapEntryfmt`, `DBCStructure.h` `MapEntry`): field 0 ID, 2
+/// map_type (0 none, 1 dungeon, 2 raid, 3 battleground, 4 arena), 5 name (enUS), 63 expansionID.
+pub fn parse_map_dbc(b: &[u8]) -> Result<Vec<MapRow>> {
+    if b.len() < 20 || &b[0..4] != b"WDBC" {
+        anyhow::bail!("Map.dbc: not a WDBC file");
+    }
+    let rd = |at: usize| -> u32 { u32::from_le_bytes([b[at], b[at + 1], b[at + 2], b[at + 3]]) };
+    let (records, fields, size, strings) = (rd(4) as usize, rd(8) as usize, rd(12) as usize, rd(16) as usize);
+    let str_at = 20 + records * size;
+    if fields < 6 || size < fields * 4 || b.len() < str_at + strings {
+        anyhow::bail!("Map.dbc: unexpected layout ({fields} fields, {size} bytes a record)");
+    }
+    let string = |ofs: u32| -> String {
+        let s = &b[str_at + (ofs as usize).min(strings)..str_at + strings];
+        String::from_utf8_lossy(s.split(|&c| c == 0).next().unwrap_or(&[])).into_owned()
+    };
+    let mut out = Vec::with_capacity(records);
+    for r in 0..records {
+        let at = 20 + r * size;
+        let f = |i: usize| rd(at + i * 4);
+        out.push(MapRow {
+            id: f(0),
+            instance_type: f(2),
+            name: string(f(5)),
+            expansion: if fields > 63 { f(63) } else { 0 },
+        });
+    }
+    Ok(out)
+}
+
+/// Sizes of names: the listed size when the chain lists the file, else its read length.
+pub struct Sizer<'a, S: Source> {
+    src: &'a S,
+    listed: HashMap<String, u64>,
+    lite: Option<&'a Lite>,
+}
+
+impl<'a, S: Source> Sizer<'a, S> {
+    pub fn new(src: &'a S, listed: HashMap<String, u64>, lite: Option<&'a Lite>) -> Self {
+        Self { src, listed, lite }
+    }
+
+    /// (full bytes, lite bytes) of one name.
+    pub fn size(&self, name: &str) -> (u64, u64) {
+        let key = name_key(name);
+        let lite_applies = self.lite.is_some_and(|l| l.applies(name));
+        if !lite_applies {
+            if let Some(&n) = self.listed.get(&key) {
+                if n > 0 {
+                    return (n, n);
+                }
+            }
+        }
+        let Some(bytes) = self.src.read(name) else {
+            return (0, 0);
+        };
+        let full = bytes.len() as u64;
+        let lite = match self.lite.filter(|_| lite_applies) {
+            Some(l) => lite_blp(&bytes, l.max_px).map_or(full, |s| s.len() as u64),
+            None => full,
+        };
+        (full, lite)
+    }
+
+    fn total(&self, names: &[String]) -> (u64, u64) {
+        names.iter().fold((0, 0), |(a, b), n| {
+            let (f, l) = self.size(n);
+            (a + f, b + l)
+        })
+    }
+}
+
+fn expansion_name(e: u32) -> &'static str {
+    match e {
+        0 => "Classic",
+        1 => "TBC",
+        2 => "Wrath",
+        _ => "?",
+    }
+}
+
+fn kind_name(t: u32) -> &'static str {
+    match t {
+        1 => "dungeon",
+        2 => "raid",
+        3 => "battleground",
+        4 => "arena",
+        _ => "map",
+    }
+}
+
+/// Walk and measure. `boot`: the client's boot read-sets (part of the base). `progress` is told
+/// each unit as it is done.
+#[allow(clippy::too_many_arguments)]
+pub fn measure<S: Source>(
+    src: &S,
+    cat: &Catalogs,
+    spec: &SliceSpec,
+    maps: &[MapRow],
+    displays: &[Display],
+    boot: &[String],
+    sizer: &Sizer<S>,
+    progress: &mut dyn FnMut(&Unit),
+) -> Report {
+    let refs = RefsCache::default();
+    let mut units = Vec::new();
+    // The base: tier 0 + the boot lists.
+    let base_tier = spec.tiers.iter().find(|t| t.tier == 0);
+    let mut w = Walker::seeded(src, &HashSet::new(), Some(&refs));
+    for n in boot {
+        w.add(n);
+    }
+    if let Some(t) = base_tier {
+        walk_tier(&mut w, src, cat, t, displays);
+    }
+    w.drain();
+    let names = w.take();
+    let base_seen = w.seen().clone();
+    let (full, lite) = sizer.total(&names);
+    let u = Unit {
+        kind: "base".into(),
+        name: base_tier.map_or("base".into(), |t| t.name.clone()),
+        id: 0,
+        expansion: String::new(),
+        files: names.len(),
+        full_bytes: full,
+        lite_bytes: lite,
+        notes: std::mem::take(&mut w.notes),
+    };
+    progress(&u);
+    units.push(u);
+    drop(w);
+
+    let mut union: HashSet<String> = HashSet::new();
+    let mut union_names: Vec<String> = Vec::new();
+    let mut keep = |names: &[String]| {
+        for n in names {
+            if union.insert(name_key(n)) {
+                union_names.push(n.clone());
+            }
+        }
+    };
+    // The slice's own tiers (cities, starter areas, Dalaran, and the instance tiers again: the
+    // instance list below measures each instance map once more, alone).
+    for t in spec.tiers.iter().filter(|t| t.tier != 0) {
+        let mut w = Walker::seeded(src, &base_seen, Some(&refs));
+        walk_tier(&mut w, src, cat, t, displays);
+        w.drain();
+        let names = w.take();
+        let (full, lite) = sizer.total(&names);
+        keep(&names);
+        let u = Unit {
+            kind: "tier".into(),
+            name: format!("tier {} {}", t.tier, t.name),
+            id: t.tier,
+            expansion: String::new(),
+            files: names.len(),
+            full_bytes: full,
+            lite_bytes: lite,
+            notes: std::mem::take(&mut w.notes),
+        };
+        progress(&u);
+        units.push(u);
+    }
+    // Every instance in Map.dbc.
+    let mut inst: Vec<&MapRow> = maps.iter().filter(|m| (1..=4).contains(&m.instance_type)).collect();
+    inst.sort_by_key(|m| m.id);
+    for m in inst {
+        let mut w = Walker::seeded(src, &base_seen, Some(&refs));
+        w.add_map(cat, &MapSpec::whole(m.id));
+        for d in displays.iter().filter(|d| d.map == m.id) {
+            if d.kind == 'c' {
+                w.add_creature(cat, d.id);
+            } else {
+                w.add_gameobject(cat, d.id);
+            }
+        }
+        w.drain();
+        let names = w.take();
+        let (full, lite) = sizer.total(&names);
+        keep(&names);
+        let u = Unit {
+            kind: kind_name(m.instance_type).into(),
+            name: m.name.clone(),
+            id: m.id,
+            expansion: expansion_name(m.expansion).into(),
+            files: names.len(),
+            full_bytes: full,
+            lite_bytes: lite,
+            notes: std::mem::take(&mut w.notes),
+        };
+        progress(&u);
+        units.push(u);
+    }
+    let (union_full, union_lite) = sizer.total(&union_names);
+    Report { units, union_full, union_lite, union_files: union_names.len() }
+}
+
+fn walk_tier<S: Source>(w: &mut Walker<S>, src: &S, cat: &Catalogs, t: &crate::deps::TierSpec, displays: &[Display]) {
+    if !t.prefixes.is_empty() {
+        let all = src.list();
+        for p in &t.prefixes {
+            let n = w.add_prefix(&all, p);
+            w.notes.push(format!("prefix {p}: {n} files"));
+        }
+    }
+    for n in &t.names {
+        w.add(n);
+    }
+    for m in &t.maps {
+        w.add_map(cat, m);
+    }
+    let maps: HashSet<u32> = t.maps.iter().map(|m| m.id).collect();
+    for d in displays.iter().filter(|d| match d.tier {
+        Some(n) => n == t.tier,
+        None => maps.contains(&d.map) && t.maps.iter().any(|m| m.id == d.map && m.zone.is_none() && m.world_box.is_none() && m.tiles.is_none()),
+    }) {
+        if d.kind == 'c' {
+            w.add_creature(cat, d.id);
+        } else {
+            w.add_gameobject(cat, d.id);
+        }
+    }
+}
+
+fn mb(b: u64) -> f64 {
+    b as f64 / (1024.0 * 1024.0)
+}
+
+/// The report as Markdown: a table sorted by size (lite), biggest first, then the totals.
+pub fn markdown(r: &Report, title: &str) -> String {
+    let base = &r.units[0];
+    let mut s = format!("# {title}\n\n");
+    s.push_str(&format!(
+        "Measured from the game data by `wenilla-host --size-report`: the bytes `--export` would write \
+         (uncompressed files; \"lite\" = item textures cut to the slice's lite size, \"full\" = as in \
+         the archives). Nothing was exported.\n\n\
+         **The base** ({}: login, character create, the UI, spells, player and item models) is \
+         **{:.1} MB lite / {:.1} MB full**, {} files. Every place below is counted **beyond the \
+         base**: what it adds on top of it, alone. Places also share files with each other, so the \
+         sum of the rows ({:.1} MB lite) is more than all of them together ({:.1} MB lite, {:.1} MB \
+         full, {} files, each file once): {:.1} MB is shared between places.\n\n",
+        base.name,
+        mb(base.lite_bytes),
+        mb(base.full_bytes),
+        base.files,
+        mb(r.units[1..].iter().map(|u| u.lite_bytes).sum()),
+        mb(r.union_lite),
+        mb(r.union_full),
+        r.union_files,
+        mb(r.units[1..].iter().map(|u| u.lite_bytes).sum::<u64>().saturating_sub(r.union_lite)),
+    ));
+    let mut rows: Vec<&Unit> = r.units[1..].iter().collect();
+    rows.sort_by(|a, b| b.lite_bytes.cmp(&a.lite_bytes).then(a.name.cmp(&b.name)));
+    s.push_str("| # | place | kind | expansion | map / tier | files | MB lite | MB full |\n");
+    s.push_str("|---:|---|---|---|---:|---:|---:|---:|\n");
+    for (i, u) in rows.iter().enumerate() {
+        s.push_str(&format!(
+            "| {} | {} | {} | {} | {} | {} | {:.1} | {:.1} |\n",
+            i + 1,
+            u.name.replace('|', "/"),
+            u.kind,
+            u.expansion,
+            u.id,
+            u.files,
+            mb(u.lite_bytes),
+            mb(u.full_bytes)
+        ));
+    }
+    let by = |k: &str| -> (usize, u64) {
+        let v: Vec<&&Unit> = rows.iter().filter(|u| u.kind == k).collect();
+        (v.len(), v.iter().map(|u| u.lite_bytes).sum())
+    };
+    s.push_str("\n## Totals by kind (sum of rows, beyond the base, lite)\n\n| kind | count | MB |\n|---|---:|---:|\n");
+    for k in ["tier", "dungeon", "raid", "battleground", "arena"] {
+        let (n, b) = by(k);
+        s.push_str(&format!("| {k} | {n} | {:.1} |\n", mb(b)));
+    }
+    s.push_str(&format!(
+        "\nEverything (base + every place, each file once): **{:.1} MB lite, {:.1} MB full**.\n",
+        mb(base.lite_bytes + r.union_lite),
+        mb(base.full_bytes + r.union_full)
+    ));
+    let empty: Vec<&&Unit> = rows.iter().filter(|u| u.files == 0).collect();
+    if !empty.is_empty() {
+        s.push_str("\nRows with 0 files have no WDT in this data (test or unused maps in Map.dbc).\n");
+    }
+    s
+}
+
+pub fn to_json(r: &Report) -> serde_json::Value {
+    serde_json::json!({
+        "base": unit_json(&r.units[0]),
+        "union_beyond_base": {"files": r.union_files, "full_bytes": r.union_full, "lite_bytes": r.union_lite},
+        "units": r.units[1..].iter().map(unit_json).collect::<Vec<_>>(),
+    })
+}
+
+fn unit_json(u: &Unit) -> serde_json::Value {
+    serde_json::json!({
+        "kind": u.kind, "name": u.name, "id": u.id, "expansion": u.expansion, "files": u.files,
+        "full_bytes": u.full_bytes, "lite_bytes": u.lite_bytes, "notes": u.notes,
+    })
+}
+
+/// The `--size-report` command: open the chain's catalogs, walk, write `<out>/size-report.md` and
+/// `.json`, print the table.
+pub fn run(
+    chain: &mut benilla_formats::Chain,
+    spec_text: &str,
+    displays: &[Display],
+    boot: &[String],
+    lite: Option<&Lite>,
+    out: &std::path::Path,
+) -> Result<Report> {
+    let spec = SliceSpec::parse(spec_text)?;
+    let cat = Catalogs::load(chain)?;
+    for w in &cat.warnings {
+        eprintln!("warning: {w}");
+    }
+    let map_bytes = chain.read("DBFilesClient\\Map.dbc").context("reading Map.dbc")?;
+    let maps = parse_map_dbc(&map_bytes)?;
+    let listed: HashMap<String, u64> = chain
+        .list()
+        .map(|v| v.into_iter().map(|e| (name_key(&e.name), e.size)).collect())
+        .unwrap_or_default();
+    let chain = &*chain;
+    let sizer = Sizer::new(chain, listed, lite);
+    let n_inst = maps.iter().filter(|m| (1..=4).contains(&m.instance_type)).count();
+    eprintln!(
+        "measuring the base, {} slice tiers and {n_inst} instances from Map.dbc...",
+        spec.tiers.len().saturating_sub(1)
+    );
+    let mut done = 0usize;
+    let report = measure(chain, &cat, &spec, &maps, displays, boot, &sizer, &mut |u| {
+        done += 1;
+        eprintln!(
+            "  [{done:>3}] {:<44} {:>7} files {:>9.1} MB lite {:>9.1} MB full",
+            u.name.chars().take(44).collect::<String>(),
+            u.files,
+            mb(u.lite_bytes),
+            mb(u.full_bytes)
+        );
+    });
+    std::fs::create_dir_all(out)?;
+    let md = markdown(&report, "Stream server disk: every 3.3.5a instance, the base and the slice's tiers");
+    std::fs::write(out.join("size-report.md"), &md)?;
+    std::fs::write(out.join("size-report.json"), serde_json::to_vec_pretty(&to_json(&report))?)?;
+    print!("{md}");
+    Ok(report)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn map_dbc(rows: &[(u32, u32, &str, u32)]) -> Vec<u8> {
+        let fields = 66usize;
+        let mut strings = vec![0u8];
+        let mut body = Vec::new();
+        for &(id, ty, name, exp) in rows {
+            let ofs = strings.len() as u32;
+            strings.extend(name.as_bytes());
+            strings.push(0);
+            let mut rec = vec![0u32; fields];
+            rec[0] = id;
+            rec[2] = ty;
+            rec[5] = ofs;
+            rec[63] = exp;
+            body.extend(rec.iter().flat_map(|v| v.to_le_bytes()));
+        }
+        let mut b = b"WDBC".to_vec();
+        for v in [rows.len() as u32, fields as u32, (fields * 4) as u32, strings.len() as u32] {
+            b.extend(v.to_le_bytes());
+        }
+        b.extend(body);
+        b.extend(strings);
+        b
+    }
+
+    struct Fake(HashMap<String, Vec<u8>>);
+    impl Source for Fake {
+        fn contains(&self, n: &str) -> bool {
+            self.0.contains_key(&name_key(n))
+        }
+        fn read(&self, n: &str) -> Option<Vec<u8>> {
+            self.0.get(&name_key(n)).cloned()
+        }
+        fn list(&self) -> Vec<String> {
+            self.0.keys().cloned().collect()
+        }
+    }
+
+    #[test]
+    fn units_are_counted_beyond_the_base_and_the_union_once() {
+        let mut files = HashMap::new();
+        for (n, len) in [
+            ("interface\\a.blp", 100usize),
+            ("world\\maps\\a\\a.wdl", 10),
+            ("world\\maps\\b\\b.wdl", 20),
+            ("interface\\glues\\loading\\shared.blp", 7),
+            ("dbfilesclient\\map.dbc", 5),
+        ] {
+            files.insert(n.to_string(), vec![0u8; len]);
+        }
+        let src = Fake(files);
+        let mut cat = Catalogs::default();
+        cat.map_dir.insert(1, "A".into());
+        cat.map_dir.insert(2, "B".into());
+        // both instances use one loading screen: shared, counted in each, once in the union
+        cat.loading_screen.insert(1, "Interface\\Glues\\Loading\\Shared.blp".into());
+        cat.loading_screen.insert(2, "Interface\\Glues\\Loading\\Shared.blp".into());
+        let spec = SliceSpec::parse(r#"{"order":["base"],"tiers":[{"key":"base","names":["Interface\\A.blp"]}]}"#).unwrap();
+        let maps = vec![
+            MapRow { id: 1, instance_type: 1, name: "Alpha".into(), expansion: 0 },
+            MapRow { id: 2, instance_type: 2, name: "Beta".into(), expansion: 2 },
+            MapRow { id: 0, instance_type: 0, name: "Continent".into(), expansion: 0 },
+        ];
+        let sizer = Sizer::new(&src, HashMap::new(), None);
+        let boot = vec!["DBFilesClient\\Map.dbc".to_string()];
+        let r = measure(&src, &cat, &spec, &maps, &[], &boot, &sizer, &mut |_| {});
+        assert_eq!(r.units[0].full_bytes, 105);
+        assert_eq!(r.units.len(), 3, "base + two instances (the continent is not one)");
+        let a = r.units.iter().find(|u| u.name == "Alpha").unwrap();
+        let b = r.units.iter().find(|u| u.name == "Beta").unwrap();
+        assert_eq!((a.full_bytes, a.kind.as_str()), (17, "dungeon"));
+        assert_eq!((b.full_bytes, b.kind.as_str(), b.expansion.as_str()), (27, "raid", "Wrath"));
+        assert_eq!(r.union_full, 37, "the shared loading screen once");
+        let md = markdown(&r, "t");
+        assert!(md.contains("| 1 | Beta | raid | Wrath |"), "{md}");
+        assert!(md.contains("7.0") || md.contains("0.0"));
+        assert_eq!(to_json(&r)["units"].as_array().unwrap().len(), 2);
+    }
+
+    #[test]
+    fn lite_sizes_come_from_the_cut_blp() {
+        let mut b = vec![0u8; 1172];
+        b[0..4].copy_from_slice(b"BLP2");
+        b[4] = 1;
+        b[8] = 3;
+        b[9] = 8;
+        b[11] = 1;
+        b[12..16].copy_from_slice(&512u32.to_le_bytes());
+        b[16..20].copy_from_slice(&512u32.to_le_bytes());
+        let (mut w, mut i) = (512u32, 0usize);
+        while w >= 1 {
+            let at = b.len() as u32;
+            let size = w * w * 4;
+            b[20 + i * 4..24 + i * 4].copy_from_slice(&at.to_le_bytes());
+            b[84 + i * 4..88 + i * 4].copy_from_slice(&size.to_le_bytes());
+            b.extend(std::iter::repeat_n(0u8, size as usize));
+            if w == 1 { break; }
+            w /= 2;
+            i += 1;
+        }
+        let full = b.len() as u64;
+        let mut files = HashMap::new();
+        files.insert("item\\objectcomponents\\x.blp".to_string(), b);
+        let src = Fake(files);
+        let lite = Lite { max_px: 256, prefixes: vec!["Item\\ObjectComponents\\".into()] };
+        let sizer = Sizer::new(&src, HashMap::new(), Some(&lite));
+        let (f, l) = sizer.size("Item\\ObjectComponents\\X.blp");
+        assert_eq!(f, full);
+        assert!(l < f / 3, "{l} vs {f}");
+    }
+
+    #[test]
+    fn map_dbc_rows() {
+        let rows = parse_map_dbc(&map_dbc(&[(0, 0, "Eastern Kingdoms", 0), (389, 1, "Ragefire Chasm", 0), (631, 2, "Icecrown Citadel", 2)])).unwrap();
+        assert_eq!(rows.len(), 3);
+        assert_eq!(rows[1], MapRow { id: 389, instance_type: 1, name: "Ragefire Chasm".into(), expansion: 0 });
+        assert_eq!(rows[2].expansion, 2);
+        assert!(parse_map_dbc(b"nope").is_err());
+    }
+}
diff --git a/crates/wenilla-host/src/static_site.rs b/crates/wenilla-host/src/static_site.rs
new file mode 100644
index 00000000..bad47c40
--- /dev/null
+++ b/crates/wenilla-host/src/static_site.rs
@@ -0,0 +1,61 @@
+//! Static hosting for the browser build's output directory (`index.html`, `wenilla.js`,
+//! `wenilla_bg.wasm`) — everything `scripts/web-build.sh` writes to `web/dist/`.
+//!
+//! Everything under `--www` gets `no-cache` rather than the immutable long cache the `/data/*`
+//! route uses — that directory holds only `index.html`/`wenilla.js`/`wenilla_bg.wasm`,
+//! and the wasm bundle changes on every rebuild but keeps the same filename (no content-hash),
+//! so a long cache would pin a stale client against a server that has already moved on — dev-
+//! cycle friction the `/data/*` files don't have (those are content the game itself never
+//! changes).
+
+use std::path::Path;
+
+use axum::http::{HeaderName, HeaderValue};
+use tower_http::services::ServeDir;
+use tower_http::set_header::SetResponseHeaderLayer;
+
+pub fn router(www: &Path) -> axum::Router {
+    let no_cache = HeaderValue::from_static("no-cache");
+    // Precompressed, not compressed on the fly: the wasm is ~90 MB, and brotli-ing that per
+    // request is seconds of CPU for every page load. `scripts/web-build.sh` writes the
+    // `.br`/`.gz` siblings once; a browser that accepts neither gets the plain file.
+    let serve = ServeDir::new(www)
+        .append_index_html_on_directories(true)
+        .precompressed_br()
+        .precompressed_gzip();
+    axum::Router::new().fallback_service(
+        tower::ServiceBuilder::new()
+            .layer(SetResponseHeaderLayer::overriding(
+                axum::http::header::CACHE_CONTROL,
+                no_cache,
+            ))
+            // Cross-origin isolation. Together these two put the page in the state where
+            // `SharedArrayBuffer` is constructible and `crossOriginIsolated` is true — the
+            // browser's precondition for ever running this client's wasm on more than one
+            // thread, and for `performance.measureUserAgentSpecificMemory()`.
+            //
+            // Groundwork, not a feature: nothing in the tree uses either yet (the client is
+            // single-threaded, and `sound/mix_tap.rs` and `sound/probe.rs` say so in as many
+            // words). It is here because it is nearly free to be correct about now and
+            // genuinely awkward to retrofit later — the headers have to be on the *document*
+            // response, and every subresource has to consent.
+            //
+            // Safe here because the page has no cross-origin subresources at all: `index.html`
+            // links nothing external, and the wasm, the glue, `/data/*` and `/ws/*` are all
+            // served by this one process on one origin. `require-corp` rather than
+            // `credentialless` for that reason — there is nothing to be lenient towards.
+            //
+            // The cost is real but narrow: COOP `same-origin` severs `window.opener`, so a page
+            // that embeds this client in a cross-origin iframe, or opens it as a popup and then
+            // talks to it, stops working. Nothing in this repo does either.
+            .layer(SetResponseHeaderLayer::overriding(
+                HeaderName::from_static("cross-origin-opener-policy"),
+                HeaderValue::from_static("same-origin"),
+            ))
+            .layer(SetResponseHeaderLayer::overriding(
+                HeaderName::from_static("cross-origin-embedder-policy"),
+                HeaderValue::from_static("require-corp"),
+            ))
+            .service(serve),
+    )
+}
diff --git a/crates/wenilla-host/src/ws.rs b/crates/wenilla-host/src/ws.rs
new file mode 100644
index 00000000..18b3cfdc
--- /dev/null
+++ b/crates/wenilla-host/src/ws.rs
@@ -0,0 +1,143 @@
+//! `GET /ws/{port}` — the other half of the shared WebSocket scheme (Lane T ↔ Lane H): a browser
+//! tab cannot open a raw TCP socket, so `benilla-protocol::transport::web::Conn` opens this
+//! instead, and this proxy relays its binary frames to and from the real login (3724) / world
+//! (8085) TCP ports. `port` is checked against an explicit allowlist, not just "any u16" — this
+//! host runs on a Tailscale-reachable bind address, so an unchecked proxy would be an open relay
+//! onto whatever else is listening on the box.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use axum::extract::ws::{Message, WebSocket, WebSocketUpgrade};
+use axum::extract::{Path, Query, State};
+use axum::http::StatusCode;
+use axum::response::{IntoResponse, Response};
+use axum::routing::get;
+use axum::Router;
+use futures_util::{SinkExt, StreamExt};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpStream;
+
+#[derive(Clone)]
+struct WsState {
+    /// Port → host the proxy dials for it — plain hostname/IP, not a URL. The key set *is* the
+    /// allowlist: a port with no entry is refused. One host for every port is the single-box
+    /// deployment (`main.rs` defaults to loopback); a host per port is the containerised one,
+    /// where realmd (3724) and mangosd (8085) are different services.
+    upstreams: Arc<HashMap<u16, Arc<str>>>,
+}
+
+/// Build the `/ws/{port}` router with one upstream host for every allowed port. `allowed` is the
+/// exact port set the proxy will dial — production passes `{3724, 8085}` (the plan's shared
+/// scheme: "only 3724 and 8085 are allowed"); tests pass their own echo-server port so the
+/// allowlist check doesn't have to be bypassed to exercise it.
+pub fn router(upstream: impl Into<Arc<str>>, allowed: impl IntoIterator<Item = u16>) -> Router {
+    let upstream: Arc<str> = upstream.into();
+    router_map(allowed.into_iter().map(|p| (p, Arc::clone(&upstream))))
+}
+
+/// Build the `/ws/{port}` router from an explicit port → host map; the keys are the allowlist.
+pub fn router_map(upstreams: impl IntoIterator<Item = (u16, Arc<str>)>) -> Router {
+    Router::new()
+        .route("/ws/{port}", get(upgrade))
+        .with_state(WsState {
+            upstreams: Arc::new(upstreams.into_iter().collect()),
+        })
+}
+
+/// `host` arrives as `?host=` — logging only (the shared scheme's own words); the proxy always
+/// dials `state.upstream`, never the client-supplied value, so a client can't redirect the socket
+/// somewhere else on the network.
+async fn upgrade(
+    State(state): State<WsState>,
+    Path(port): Path<u16>,
+    Query(params): Query<HashMap<String, String>>,
+    ws: WebSocketUpgrade,
+) -> Response {
+    let Some(upstream) = state.upstreams.get(&port).cloned() else {
+        return StatusCode::FORBIDDEN.into_response();
+    };
+    let host_label = params.get("host").cloned().unwrap_or_default();
+    ws.on_upgrade(move |socket| async move {
+        if let Err(e) = relay(socket, &upstream, port).await {
+            tracing::warn!(error = %e, host = %host_label, port, "ws proxy session ended");
+        }
+    })
+}
+
+/// Relay one session: dial the upstream TCP port, then pump bytes both directions until both
+/// sides have closed. "One TCP read chunk = one binary frame, any frame = one `write_all`"
+/// (shared scheme) — no re-framing or buffering beyond the OS's own read/write granularity.
+///
+/// Each direction propagates its own end-of-stream to the *other* transport, rather than the two
+/// futures racing in a `select!`: a `select!` here would drop whichever direction lost the race
+/// mid-flight, which for the ws->tcp direction means the client's Close frame never gets echoed
+/// back (tungstenite then reports a `ResetWithoutClosingHandshake` protocol error instead of a
+/// clean close — caught by `tests/ws_proxy.rs`'s close-handshake test hanging, then failing,
+/// before this shape). `join!` runs both to their own natural end instead:
+/// receiving a WS Close (or a read error) shuts down our TCP write half, which the upstream reads
+/// as EOF and — for a well-behaved peer — closes its own side, which our TCP read then sees as
+/// EOF and answers with our own Close frame back to the client.
+async fn relay(ws: WebSocket, upstream: &str, port: u16) -> anyhow::Result<()> {
+    let tcp = TcpStream::connect((upstream, port)).await?;
+    tcp.set_nodelay(true)?;
+    let (mut tcp_r, mut tcp_w) = tcp.into_split();
+    let (mut ws_tx, mut ws_rx) = ws.split();
+
+    let tcp_to_ws = async {
+        let mut buf = [0u8; 65536];
+        loop {
+            match tcp_r.read(&mut buf).await {
+                Ok(0) | Err(_) => {
+                    // If the client already sent its own Close, tungstenite auto-queues a reply
+                    // the moment `ws_rx` reads it (the behaviour `Message::Close`'s docs mention:
+                    // "axum will automatically respond with a close frame if necessary") — but
+                    // only *queues* it; nothing has driven a write-side poll since, so it's still
+                    // sitting unflushed. `send` here fails with a "send after closing" protocol
+                    // error in that case (there's already a Close in flight); flushing instead is
+                    // what actually puts those bytes on the wire. Without this the socket would
+                    // just drop with the reply never sent — tungstenite calls that a
+                    // `ResetWithoutClosingHandshake`, and it's exactly the shape
+                    // `tests/ws_proxy.rs`'s close test hit before this fallback existed.
+                    if ws_tx.send(Message::Close(None)).await.is_err() {
+                        let _ = ws_tx.flush().await;
+                    }
+                    break;
+                }
+                Ok(n) => {
+                    if ws_tx
+                        .send(Message::binary(buf[..n].to_vec()))
+                        .await
+                        .is_err()
+                    {
+                        break;
+                    }
+                }
+            }
+        }
+    };
+
+    let ws_to_tcp = async {
+        loop {
+            match ws_rx.next().await {
+                Some(Ok(Message::Binary(data))) => {
+                    if tcp_w.write_all(&data).await.is_err() {
+                        break;
+                    }
+                }
+                Some(Ok(Message::Text(text))) => {
+                    if tcp_w.write_all(text.as_bytes()).await.is_err() {
+                        break;
+                    }
+                }
+                Some(Ok(Message::Ping(_) | Message::Pong(_))) => {}
+                Some(Ok(Message::Close(_))) | Some(Err(_)) | None => break,
+            }
+        }
+        // Half-close our write side so the upstream sees EOF, not just a dangling socket.
+        let _ = tcp_w.shutdown().await;
+    };
+
+    tokio::join!(tcp_to_ws, ws_to_tcp);
+    Ok(())
+}
diff --git a/crates/wenilla-host/tests/data.rs b/crates/wenilla-host/tests/data.rs
new file mode 100644
index 00000000..cccec1c0
--- /dev/null
+++ b/crates/wenilla-host/tests/data.rs
@@ -0,0 +1,128 @@
+//! Exercises the `/data/*` route against the *real* MPQ chain — set `WOW_DATA` to the client's
+//! `Data` directory to run it for real; skips (not fails) when no install is found, so `cargo
+//! test` stays green on a box without the 5.1 GB of game data checked out.
+
+use std::sync::Arc;
+
+use benilla_formats::Chain;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpStream;
+
+/// A GET/HEAD with no request body needs no HTTP client crate — one socket round trip. Async, not
+/// `std::net` blocking I/O: the server under test runs as a `tokio::spawn`ed task on this same
+/// `#[tokio::test]` runtime, and a blocking call here would starve that task of the single
+/// current-thread executor's only thread — a deadlock, not a slow test (caught the hard way: the
+/// first version of this test hung until an outer `timeout` killed it).
+async fn raw_request(addr: std::net::SocketAddr, method: &str, path: &str) -> (u16, Vec<u8>) {
+    let (status, _head, body) = raw_request_with(addr, method, path, "").await;
+    (status, body)
+}
+
+/// As above, plus arbitrary extra request headers and the response's header block (lowercased)
+/// — what the content-negotiation assertions need and the original two did not.
+async fn raw_request_with(
+    addr: std::net::SocketAddr,
+    method: &str,
+    path: &str,
+    extra: &str,
+) -> (u16, String, Vec<u8>) {
+    let mut stream = TcpStream::connect(addr).await.expect("connect");
+    stream
+        .write_all(
+            format!(
+                "{method} {path} HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n{extra}\r\n"
+            )
+            .as_bytes(),
+        )
+        .await
+        .expect("write request");
+    let mut raw = Vec::new();
+    stream.read_to_end(&mut raw).await.expect("read response");
+    let split = raw
+        .windows(4)
+        .position(|w| w == b"\r\n\r\n")
+        .expect("header/body separator");
+    let head = String::from_utf8_lossy(&raw[..split]).into_owned();
+    let status: u16 = head
+        .lines()
+        .next()
+        .expect("status line")
+        .split_whitespace()
+        .nth(1)
+        .expect("status code")
+        .parse()
+        .expect("status code is numeric");
+    (status, head.to_ascii_lowercase(), raw[split + 4..].to_vec())
+}
+
+#[tokio::test]
+async fn serves_a_known_file_and_404s_a_missing_one() {
+    let Some(data_dir) = benilla_formats::wow_data() else {
+        eprintln!("skip: no WoW Data directory found (set WOW_DATA)");
+        return;
+    };
+    let chain = Arc::new(Chain::open(&data_dir).expect("open chain"));
+    let app = wenilla_host::data::router(chain);
+
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind");
+    let addr = listener.local_addr().expect("local addr");
+    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+
+    // `Interface\Glues\Common\Glue-Panel-Button-Up.blp` -> one percent-encoded path segment,
+    // `\` -> `%5C`, per the shared Data URL scheme.
+    let (status, body) = raw_request(
+        addr,
+        "GET",
+        "/data/Interface%5CGlues%5CCommon%5CGlue-Panel-Button-Up.blp",
+    )
+    .await;
+    assert_eq!(status, 200);
+    assert_eq!(&body[..4], b"BLP2");
+
+    let (status, _) = raw_request(addr, "GET", "/data/nope.x").await;
+    assert_eq!(status, 404);
+}
+
+/// The compression contract end to end, against the real chain: the name index — the single
+/// largest uncompressed body this route ever served, and the one `web/boot-manifest.json` now
+/// pulls during boot — comes back encoded, while a BLP does not. The unit tests in
+/// `src/data.rs` pin the predicate and the classifier; this pins that they are actually wired
+/// to the bytes on the socket.
+#[tokio::test]
+async fn compresses_the_index_and_leaves_blp_texels_alone() {
+    let Some(data_dir) = benilla_formats::wow_data() else {
+        eprintln!("skip: no WoW Data directory found (set WOW_DATA)");
+        return;
+    };
+    let chain = Arc::new(Chain::open(&data_dir).expect("open chain"));
+    let app = wenilla_host::data::router(chain);
+
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind");
+    let addr = listener.local_addr().expect("local addr");
+    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+
+    let (status, head, _) =
+        raw_request_with(addr, "GET", "/data/__index", "accept-encoding: br\r\n").await;
+    assert_eq!(status, 200);
+    assert!(
+        head.contains("content-encoding: br"),
+        "the index should compress:\n{head}"
+    );
+
+    let (status, head, _) = raw_request_with(
+        addr,
+        "GET",
+        "/data/Interface%5CGlues%5CCommon%5CGlue-Panel-Button-Up.blp",
+        "accept-encoding: br\r\n",
+    )
+    .await;
+    assert_eq!(status, 200);
+    assert!(
+        !head.contains("content-encoding:"),
+        "DXT blocks should not be re-compressed:\n{head}"
+    );
+}
diff --git a/crates/wenilla-host/tests/slice.rs b/crates/wenilla-host/tests/slice.rs
