+      goToast();
+      logMemory('entering the world');
+      dropGlueBodies();
+      // Settled numbers, once the entry's own transients are gone.
+      setTimeout(() => logMemory('in world (+20 s)'), 20000);
+    }
+  };
+  // The reads no store answered, as a manifest (`{"names": [...]}`, first-need order, one entry
+  // per name), optionally one phase only: `copy(__wenilla_dump_misses('enter'))` in the console.
+  window.__wenilla_dump_misses = (phase) => {
+    const seen = new Set();
+    const names = [];
