+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::script::{UiScript, UnitGuids, UnitState};
+    use std::collections::HashMap;
+
+    const ME: u64 = 0x10;
+    const WOLF: u64 = 0xF130_0000_0000_0001;
+    const PET: u64 = 0xF140_0000_0000_0007;
+
+    #[test]
+    fn guids_parse_in_unit_guids_spelling_only() {
+        let lua = Lua::new();
+        let s = |t: &str| Value::String(lua.create_string(t).unwrap());
+        assert_eq!(parse_guid(&s("0xF130000000000001")), Some(WOLF));
+        assert_eq!(parse_guid(&s("0xf130000000000001")), Some(WOLF));
+        assert_eq!(parse_guid(&s("F130000000000001")), Some(WOLF));
+        assert_eq!(parse_guid(&s("0x0000000000000000")), None);
+        assert_eq!(parse_guid(&s("Wolf")), None);
+        assert_eq!(parse_guid(&s("0x1F130000000000001")), None);
+        assert_eq!(parse_guid(&Value::Integer(5)), None);
+    }
+
+    fn unit(guid: u64, name: &str) -> UnitState {
+        UnitState {
+            exists: true,
+            has_object: true,
+            guid,
+            name: Some(name.into()),
+            ..Default::default()
+        }
+    }
+
+    fn vm() -> UiScript {
+        let mut s = UiScript::new().unwrap();
+        s.set_unit_guids(&UnitGuids {
+            player: ME,
+            target: WOLF,
+            pet: PET,
+            held: HashMap::from([(ME, WOLF), (WOLF, 0), (PET, 0)]),
+            ..Default::default()
+        });
+        s.set_unit("player", Some(unit(ME, "Me")));
+        let mut wolf = unit(WOLF, "Wolf");
+        wolf.flags = unit_flags::STUNNED | unit_flags::SILENCED;
+        wolf.npc_flags = 0x81;
+        s.set_unit("target", Some(wolf));
+        let mut pet = unit(PET, "Fluffy");
+        pet.owner = ME;
+        pet.flags = unit_flags::DISARMED;
+        s.set_unit("pet", Some(pet));
+        s
+    }
+
+    #[test]
+    fn unit_token_from_guid_names_a_current_token() {
+        let s = vm();
+        let tok = |g: &str| {
+            s.eval::<Option<String>>(&format!("return UnitTokenFromGUID('{g}')"))
+                .unwrap()
+        };
+        assert_eq!(tok("0x0000000000000010").as_deref(), Some("player"));
+        assert_eq!(tok("0xF130000000000001").as_deref(), Some("target"));
+        assert_eq!(tok("0xF140000000000007").as_deref(), Some("pet"));
+        assert_eq!(tok("0xF130000000000099"), None);
+        assert!(s.eval::<bool>("return UnitTokenFromGUID(UnitGUID('target')) == 'target'").unwrap());
+        assert!(s.eval::<bool>("return UnitTokenFromGUID() == nil").unwrap());
+    }
+
+    #[test]
+    fn descriptor_reads_answer_from_the_unit_flags_and_owner() {
+        let s = vm();
+        assert!(s.eval::<bool>("return UnitIsControlled('target')").unwrap());
+        assert!(!s.eval::<bool>("return UnitIsControlled('pet')").unwrap());
+        assert!(s.eval::<bool>("return UnitIsDisarmed('pet')").unwrap());
+        assert!(!s.eval::<bool>("return UnitIsDisarmed('target')").unwrap());
+        assert!(!s.eval::<bool>("return UnitIsControlled('focus')").unwrap());
+        assert!(s.eval::<bool>("return UnitIsSilenced('target')").unwrap());
+        assert!(!s.eval::<bool>("return UnitIsSilenced('player')").unwrap());
+        // The voice form is untouched.
+        assert!(s.eval::<bool>("return UnitIsSilenced('Bob', 'Party') == nil").unwrap());
+        assert!(s.eval::<bool>("return UnitIsSilenced('Bob') == nil").unwrap());
+        assert_eq!(s.eval::<i64>("return UnitOccupations('target')").unwrap(), 0x81);
+        assert!(s.eval::<bool>("return UnitOccupations('focus') == nil").unwrap());
+        let (name, guid): (String, String) = s.eval("return UnitOwner('pet')").unwrap();
+        assert_eq!((name.as_str(), guid.as_str()), ("Me", "0x0000000000000010"));
+        assert!(s.eval::<bool>("return UnitOwner('target') == nil").unwrap());
+        assert!(s.run("UnitOwner()").is_err());
+    }
+
+    #[test]
+    fn the_own_name_answers_only_for_the_players_guid() {
+        let s = vm();
+        assert_eq!(s.own_name_for(ME).as_deref(), Some("Me"));
+        assert_eq!(s.own_name_for(WOLF), None);
+        assert_eq!(s.own_name_for(0), None);
+    }
+
+    #[test]
+    fn base_cooldowns_come_from_the_spell_table() {
+        let s = UiScript::new().unwrap();
+        s.set_spell_info(
+            [(
+                2136,
+                crate::script::SpellInfo {
+                    name: "Fire Blast".into(),
+                    cooldown_ms: 8000,
+                    gcd_ms: 1500,
+                    ..Default::default()
+                },
+            )]
+            .into_iter()
+            .collect(),
+        );
+        let (cd, gcd): (i64, i64) = s.eval("return GetSpellBaseCooldown(2136)").unwrap();
+        assert_eq!((cd, gcd), (8000, 1500));
+        assert!(s.eval::<bool>("return GetSpellBaseCooldown(1) == nil").unwrap());
+    }
+
+    #[test]
+    fn item_info_instant_reads_the_cache_and_asks_on_a_miss() {
+        let mut s = UiScript::new().unwrap();
+        assert!(s.eval::<bool>("return GetItemInfoInstant(25) == nil").unwrap());
+        assert_eq!(s.take_item_stat_asks(), vec![25]);
+        s.set_item_template(
+            25,
+            crate::script::ItemTemplateView {
+                name: "Worn Shortsword".into(),
+                class: 2,
+                subclass: 7,
+                inventory_type: 13,
+                item_type: Some("Weapon".into()),
+                item_sub_type: Some("One-Handed Swords".into()),
+                icon: Some("Interface\\Icons\\INV_Sword_04".into()),
+                ..Default::default()
+            },
+        );
+        for arg in ["25", "'25'", "'item:25:0:0:0'", "'|cffffffff|Hitem:25:0:0:0|h[Worn Shortsword]|h|r'", "'worn shortsword'"] {
+            let (id, ty, sub, loc, icon, class, subclass): (i64, String, String, String, String, i64, i64) =
+                s.eval(&format!("return GetItemInfoInstant({arg})")).unwrap();
+            assert_eq!(
+                (id, ty.as_str(), sub.as_str(), loc.as_str(), icon.as_str(), class, subclass),
+                (25, "Weapon", "One-Handed Swords", "INVTYPE_WEAPON", "Interface\\Icons\\INV_Sword_04", 2, 7),
+                "{arg}"
+            );
+        }
+        assert!(s.eval::<bool>("return GetItemInfoInstant('No Such Thing') == nil").unwrap());
+        assert!(s.run("GetItemInfoInstant({})").is_err());
+    }
+
+    #[test]
+    fn window_calls_exist_only_for_what_the_platform_declares() {
+        let s = UiScript::new().unwrap();
+        assert!(s
+            .eval::<bool>("return FlashWindow == nil and IsWindowFocused == nil and FocusWindow == nil and CopyToClipboard == nil")
+            .unwrap());
+        s.set_window_caps(WindowCaps {
+            focused: true,
+            clipboard: true,
+            ..Default::default()
+        })
+        .unwrap();
+        assert!(s
+            .eval::<bool>("return FlashWindow == nil and FocusWindow == nil and type(IsWindowFocused) == 'function' and type(CopyToClipboard) == 'function'")
+            .unwrap());
+        assert!(s.eval::<bool>("return IsWindowFocused() == nil").unwrap());
+        s.set_window_focused(true);
+        assert!(s.eval::<bool>("return IsWindowFocused() == 1").unwrap());
+        s.run("CopyToClipboard('hello')").unwrap();
+        assert!(s.run("CopyToClipboard()").is_err());
+        s.set_window_caps(WindowCaps {
+            flash: true,
+            focus: true,
+            ..Default::default()
+        })
+        .unwrap();
+        s.run("FlashWindow() FocusWindow()").unwrap();
+        assert_eq!(
+            s.take_window_requests(),
+            [
+                WindowRequest::Copy("hello".into()),
+                WindowRequest::Flash,
+                WindowRequest::Focus
+            ]
+        );
+        assert!(s.take_window_requests().is_empty());
+        assert!(s.eval::<bool>("return type(CopyToClipboard) == 'function'").unwrap());
+    }
+}
