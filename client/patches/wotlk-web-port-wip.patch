+/// One log line each time the box holding the keyboard changes: every key goes to it, none to the
+/// bindings, so a box that keeps focus unseen reads as "the keyboard does nothing".
+fn log_focus_change(script: &UiScript, typing: bool) {
+    static LAST: std::sync::Mutex<Option<String>> = std::sync::Mutex::new(None);
+    let now = typing.then(|| script.focused_editbox_name().unwrap_or_else(|| "<unnamed>".into()));
+    let mut last = LAST.lock().unwrap_or_else(|e| e.into_inner());
+    if *last != now {
+        match &now {
+            Some(name) => info!("ui: keyboard focus held by EditBox {name}: keys go to it, not the bindings"),
+            None => info!("ui: keyboard focus released"),
+        }
+        // The page's text proxy follows: it takes the DOM focus while a box is typing, so phone
+        // keyboards, IME and paste reach the box (`web/boot.js`).
+        crate::webprogress::signal(if now.is_some() { "textfocus:1" } else { "textfocus:0" });
+        *last = now;
+    }
+}
