@@ -0,0 +1,110 @@
+//! The rest of the backport's plate surface: `C_NamePlate.GetNamePlateByGUID`,
+//! `C_NamePlate.GetNamePlateTokenByGUID`, the plate's `unit` field, `UnitTokenFromGUID` on a plate
+//! unit, and `NAME_PLATE_OWNER_CHANGED` registering harmlessly (a plate changing hands is always a
+//! remove then an add here, so it never fires).
+
+use crate::script::{PlateGeometry, PlateState, UiScript, UnitState};
+
+const WOLF: u64 = 0xF130_0000_0000_0001;
+const BEAR: u64 = 0xF130_0000_0000_0002;
+
+fn geometry() -> PlateGeometry {
+    PlateGeometry {
+        modern: false,
+        border: 1.0,
+        cast_height: 6.0,
+        elite_size: 14.0,
+        width: 128.0,
+        height: 32.0,
+        bar_off_x: 4.0,
+        bar_off_y: 4.0,
+        bar_width: 103.0,
+        bar_height: 9.0,
+        level_off_x: 11.8,
+        level_off_y: 9.1,
+        skull_size: 12.8,
+        raid_size: 25.6,
+        name_height: 12.8,
+        level_height: 11.0,
+        shadow_offset: 1.0,
+    }
+}
+
+fn plate(guid: u64, name: &str) -> PlateState {
+    PlateState {
+        target: false,
+        elite: false,
+        cast: None,
+        key: guid,
+        top_centre: (500.0, 400.0),
+        health: 30.0,
+        max_health: 40.0,
+        bar_colour: [1.0, 0.0, 0.0],
+        name: name.to_string(),
+        level: Some(12),
+        skull: false,
+        level_colour: [1.0, 1.0, 0.0],
+        raid_icon: None,
+        alpha: 1.0,
+        lit: false,
+        hovered: false,
+    }
+}
+
+fn frame(s: &mut UiScript, units: &[(u64, &str)]) {
+    for &(g, name) in units {
+        s.set_unit_by_guid(
+            g,
+            Some(UnitState {
+                exists: true,
+                has_object: true,
+                guid: g,
+                name: Some(name.into()),
+                ..Default::default()
+            }),
+        );
+    }
+    let states: Vec<PlateState> = units.iter().map(|&(g, n)| plate(g, n)).collect();
+    s.sync_nameplates(geometry(), &states);
+    s.resolve();
+}
+
+#[test]
+fn plates_answer_by_guid_and_carry_their_unit() {
+    let mut s = UiScript::new().unwrap();
+    s.set_screen_size(1024.0, 768.0);
+    s.run(
+        r#"WorldFrame = CreateFrame("WorldFrame", "WorldFrame") WorldFrame:SetAllPoints()
+           OWNER = 0
+           local f = CreateFrame("Frame")
+           f:RegisterEvent("NAME_PLATE_OWNER_CHANGED")
+           f:SetScript("OnEvent", function() OWNER = OWNER + 1 end)"#,
+    )
+    .unwrap();
+    s.resolve();
+    frame(&mut s, &[(WOLF, "Wolf"), (BEAR, "Bear")]);
+    assert!(s
+        .eval::<bool>(
+            r#"local a, b = WorldFrame:GetChildren()
+               return C_NamePlate.GetNamePlateByGUID("0xF130000000000001") == a
+                  and C_NamePlate.GetNamePlateByGUID(UnitGUID("nameplate2")) == b
+                  and C_NamePlate.GetNamePlateTokenByGUID("0xf130000000000002") == "nameplate2"
+                  and C_NamePlate.GetNamePlateByGUID("0xF130000000000099") == nil
+                  and C_NamePlate.GetNamePlateTokenByGUID(nil) == nil
+                  and a.unit == "nameplate1" and b.unit == "nameplate2"
+                  and UnitTokenFromGUID("0xF130000000000001") == "nameplate1""#
+        )
+        .unwrap());
+
+    frame(&mut s, &[(BEAR, "Bear")]);
+    assert!(s
+        .eval::<bool>(
+            r#"local a, b = WorldFrame:GetChildren()
+               return a.unit == nil and b.unit == "nameplate2"
+                  and C_NamePlate.GetNamePlateByGUID("0xF130000000000001") == nil
+                  and C_NamePlate.GetNamePlateTokenByGUID("0xF130000000000001") == nil
+                  and UnitTokenFromGUID("0xF130000000000001") == nil"#
+        )
+        .unwrap());
+    assert_eq!(s.eval::<i64>("return OWNER").unwrap(), 0);
+}
