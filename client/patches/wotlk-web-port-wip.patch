diff --git a/crates/benilla-ui/src/script/tests/mod_api.rs b/crates/benilla-ui/src/script/tests/mod_api.rs
new file mode 100644
index 00000000..cc60c222
--- /dev/null
+++ b/crates/benilla-ui/src/script/tests/mod_api.rs
@@ -0,0 +1,207 @@
+//! The Open Mod API 0.1 (`Mod`): capabilities, events and hooks in their phases, slash commands,
+//! the saved store, the packet transport's wire, and the mod manifests.
+
+use crate::script::{AddonDistribution, ModManifest, UiScript, UnitState};
+
+fn vm() -> UiScript {
+    UiScript::new().unwrap()
+}
+
+fn with_player(s: &mut UiScript, name: &str) {
+    s.set_unit(
+        "player",
+        Some(UnitState {
+            exists: true,
+            has_object: true,
+            guid: 0x10,
+            name: Some(name.into()),
+            ..Default::default()
+        }),
+    );
+}
+
+#[test]
+fn the_api_reports_only_what_is_real() {
+    let s = vm();
+    assert_eq!(s.eval::<String>("return Mod.Api.Version").unwrap(), "0.1");
+    for (cap, want) in [
+        ("api:0.1", true),
+        ("api:0.2", false),
+        ("compat:C_NamePlate", true),
+        ("compat:UnitTokenFromGUID", true),
+        ("compat:FlashWindow", false), // no platform declared it in a bare VM
+        ("compat:GetSpellInfo", false), // stock, not a backport capability
+        ("hook:nameplate:added", true),
+        ("hook:combatlog", true),
+        ("hook:tooltip:unit", false), // no GameTooltip yet
+        ("hook:chat:filter", false),  // no stock chat frame
+        ("hook:loginscreen", false),
+        ("packet", true),
+        ("store", true),
+        ("teleport", false),
+    ] {
+        assert_eq!(
+            s.eval::<bool>(&format!("return Mod.Api.Has({cap:?})")).unwrap(),
+            want,
+            "{cap}"
+        );
+    }
+    s.run(r#"GameTooltip = CreateFrame("GameTooltip", "GameTooltip")"#).unwrap();
+    assert!(s.eval::<bool>(r#"return Mod.Api.Has("hook:tooltip:unit")"#).unwrap());
+}
+
+#[test]
+fn events_and_hooks_run_in_their_phases() {
+    let mut s = vm();
+    s.run(
+        r#"ORDER = {}
+           local f = CreateFrame("Frame")
+           f:RegisterEvent("UNIT_SPELLCAST_START")
+           f:SetScript("OnEvent", function(_, e, unit) table.insert(ORDER, "frame:" .. unit) end)
+           Mod.Hook("spellcast:start", function(unit, spell) table.insert(ORDER, "pre:" .. unit .. ":" .. tostring(spell)) end, "pre")
+           Mod.Hook("spellcast:start", function(unit) table.insert(ORDER, "post:" .. unit) end)
+           CANCEL = Mod.On("UNIT_SPELLCAST_START", function(unit) table.insert(ORDER, "on:" .. unit) end)"#,
+    )
+    .unwrap();
+    use crate::script::ScriptValue::Str;
+    s.fire_event(
+        "UNIT_SPELLCAST_START",
+        vec![Str("player".into()), Str("Fireball".into()), Str("Rank 1".into())],
+    );
+    assert_eq!(
+        s.eval::<Vec<String>>("return ORDER").unwrap(),
+        ["pre:player:Fireball", "frame:player", "post:player", "on:player"]
+    );
+    s.run("ORDER = {} CANCEL()").unwrap();
+    s.fire_event("UNIT_SPELLCAST_START", vec![Str("target".into())]);
+    assert_eq!(
+        s.eval::<Vec<String>>("return ORDER").unwrap(),
+        ["pre:target:nil", "frame:target", "post:target"]
+    );
+    // A raising hook is reported, and the rest still run.
+    s.run(r#"ORDER = {} Mod.On("UNIT_SPELLCAST_START", function() error("boom") end)"#)
+        .unwrap();
+    s.fire_event("UNIT_SPELLCAST_START", vec![Str("focus".into())]);
+    assert_eq!(s.eval::<i64>("return #ORDER").unwrap(), 3);
+    for bad in [
+        r#"Mod.Hook("nope", function() end)"#,
+        r#"Mod.Hook("tooltip:unit", function() end, "pre")"#,
+        r#"Mod.Hook("combatlog", function() end, "sideways")"#,
+        r#"Mod.Hook("chat:filter", function() end)"#,
+        r#"Mod.On(5, print)"#,
+    ] {
+        assert!(s.run(bad).is_err(), "{bad}");
+    }
+}
+
+#[test]
+fn a_tooltip_item_hook_sees_the_link_after_the_stock_setter() {
+    let s = vm();
+    s.run(
+        r#"GameTooltip = CreateFrame("GameTooltip", "GameTooltip", nil, "")
+           SEEN = nil
+           Mod.Hook("tooltip:item", function(tip, link) SEEN = link end)
+           GameTooltip:SetOwner(UIParent or WorldFrame or CreateFrame("Frame"), "ANCHOR_NONE")
+           GameTooltip:SetHyperlink("item:25:0:0:0")"#,
+    )
+    .unwrap();
+    assert_eq!(s.eval::<String>("return SEEN").unwrap(), "item:25:0:0:0");
+}
+
+#[test]
+fn slash_commands_land_in_the_stock_table() {
+    let mut s = vm();
+    s.run(r#"GOT = nil Mod.Slash.Register("pings", { "/ping", "pg" }, function(msg) GOT = msg end)"#)
+        .unwrap();
+    assert_eq!(s.eval::<String>("return SLASH_PINGS1").unwrap(), "/ping");
+    assert_eq!(s.eval::<String>("return SLASH_PINGS2").unwrap(), "/pg");
+    assert!(s.run_slash_command("pg", "attack here"));
+    assert_eq!(s.eval::<String>("return GOT").unwrap(), "attack here");
+    assert!(s.run(r#"Mod.Slash.Register("bad key", "/x", print)"#).is_err());
+}
+
+#[test]
+fn the_store_is_one_saved_global() {
+    let mut s = vm();
+    s.run(r#"local a = Mod.Store.Account("pings") a.volume = 3"#).unwrap();
+    assert!(s.eval::<bool>(r#"return Mod.Store.Account("pings").volume == 3 and OVMOD_STORE.account.pings.volume == 3"#).unwrap());
+    assert!(s.saved_variable_names().contains(&"OVMOD_STORE".to_string()));
+    let err = s.run(r#"Mod.Store.Character("pings")"#).unwrap_err().to_string();
+    assert!(err.contains("no character yet"), "{err}");
+    with_player(&mut s, "Me");
+    s.set_realm_name("Azeroth");
+    s.run(r#"Mod.Store.Character("pings").markers = 2"#).unwrap();
+    assert!(s.eval::<bool>(r#"return OVMOD_STORE.character["Azeroth-Me"].pings.markers == 2"#).unwrap());
+    // A store loaded from the file is re-registered on VARIABLES_LOADED with no mod asking.
+    let mut fresh = vm();
+    fresh.run(r#"OVMOD_STORE = { account = { x = { y = 1 } } }"#).unwrap();
+    assert!(!fresh.saved_variable_names().contains(&"OVMOD_STORE".to_string()));
+    fresh.fire_event("VARIABLES_LOADED", vec![]);
+    assert!(fresh.saved_variable_names().contains(&"OVMOD_STORE".to_string()));
+    assert!(s.run(r#"Mod.Store.Account("bad id!")"#).is_err());
+}
+
+#[test]
+fn a_packet_is_split_to_fit_the_cores_255_byte_line_and_reassembled_in_any_order() {
+    let mut s = vm();
+    assert!(s.run(r#"Mod.Packet.Send("pings", "ping", "x")"#).is_err(), "unregistered");
+    s.run(r#"Mod.Packet.Register("pings")"#).unwrap();
+    assert!(s.run(r#"Mod.Packet.Send("pings", "ping", "x")"#).is_err(), "no player yet");
+    with_player(&mut s, "Me");
+    let parts: i64 = s
+        .eval(r#"return Mod.Packet.Send("pings", "ping", string.rep("abc|\t", 200))"#)
+        .unwrap();
+    let sends = s.take_addon_sends();
+    assert_eq!(sends.len() as i64, parts);
+    assert!(parts > 1);
+    let mut data = Vec::new();
+    for (i, send) in sends.iter().enumerate() {
+        assert_eq!(send.distribution, AddonDistribution::Whisper);
+        assert_eq!(send.target.as_deref(), Some("Me"));
+        assert!(send.text.len() <= 255, "part {i}: {} bytes", send.text.len());
+        let head = format!("OVMOD\tpings\tping\t{}/{parts}\t", i + 1);
+        assert!(send.text.starts_with(head.as_bytes()), "part {i}");
+        data.extend_from_slice(&send.text[head.len()..]);
+    }
+    assert_eq!(data, "abc|\t".repeat(200).as_bytes());
+    // A one-part send, and an empty payload is still one part.
+    s.run(r#"Mod.Packet.Send("pings", "marker", "")"#).unwrap();
+    assert_eq!(s.take_addon_sends()[0].text, b"OVMOD\tpings\tmarker\t1/1\t");
+
+    s.run(
+        r#"GOT = {} Mod.Packet.On("pings", "ping", function(d) table.insert(GOT, d) end)"#,
+    )
+    .unwrap();
+    // Out of order, then whole; a stranger's or a party line's are ignored.
+    s.deliver_addon_message(b"OVMOD\tpings\tping\t2/2\tworld", "WHISPER", "Me");
+    s.deliver_addon_message(b"OVMOD\tpings\tping\t1/1\tsolo", "WHISPER", "Other");
+    s.deliver_addon_message(b"OVMOD\tpings\tping\t1/1\tsolo", "PARTY", "Me");
+    s.deliver_addon_message(b"OVMOD\tpings\tping\t1/2\thello \t", "WHISPER", "Me");
+    s.deliver_addon_message(b"OVMOD\tpings\tping\t1/1\t1.5,2,3,0,attack,7,Me", "WHISPER", "Me");
+    s.deliver_addon_message(b"OVMOD\tpings\tdenied\t1/1\trate", "WHISPER", "Me");
+    assert_eq!(
+        s.eval::<Vec<String>>("return GOT").unwrap(),
+        ["hello \tworld", "1.5,2,3,0,attack,7,Me"]
+    );
+}
+
+#[test]
+fn manifests_list_what_the_loader_read() {
+    let s = vm();
+    assert_eq!(s.eval::<i64>("return #Mod.Api.Mods()").unwrap(), 0);
+    s.set_mod_manifests(vec![ModManifest {
+        addon: "OVPings".into(),
+        id: "pings".into(),
+        name: "Pings & World Markers".into(),
+        version: "1.0.0".into(),
+        api: "0.1".into(),
+        permissions: vec!["packet".into(), "store".into()],
+    }]);
+    assert!(s
+        .eval::<bool>(
+            r#"local m = Mod.Api.Mods()[1]
+               return m.id == "pings" and m.addon == "OVPings" and m.api == "0.1"
+                  and m.permissions[2] == "store""#
+        )
+        .unwrap());
+}
