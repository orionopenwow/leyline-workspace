+//! Plain values for the page bridge (`benilla-app` `webbridge`): Lua results and event arguments
+//! as JSON-shaped data, with no mlua handle, so the host can hand them to JavaScript.
+
+use mlua::Value;
+
+use super::ScriptValue;
+
+/// A JSON-shaped value. Tables become a `List` when their keys are exactly `1..=n`, else a `Map`
+/// keyed by the stringified keys.
+#[derive(Clone, Debug, PartialEq)]
+pub enum PlainValue {
+    Null,
+    Bool(bool),
+    Num(f64),
+    Str(String),
+    List(Vec<PlainValue>),
+    Map(Vec<(String, PlainValue)>),
+}
+
+/// How deep a table converts; deeper ones answer `Null`.
+const MAX_DEPTH: usize = 4;
+/// How many values one conversion produces in all; the rest answer `Null`.
+const MAX_VALUES: usize = 512;
+
+impl From<&ScriptValue> for PlainValue {
+    fn from(v: &ScriptValue) -> Self {
+        match v {
+            ScriptValue::Nil => PlainValue::Null,
+            ScriptValue::Bool(b) => PlainValue::Bool(*b),
+            ScriptValue::Int(i) => PlainValue::Num(*i as f64),
+            ScriptValue::Number(n) => PlainValue::Num(*n),
+            ScriptValue::Str(s) => PlainValue::Str(s.clone()),
+        }
+    }
+}
+
+/// One Lua value as a plain one, within the depth and count bounds.
+pub(crate) fn from_lua(v: &Value, depth: usize, budget: &mut usize) -> PlainValue {
+    if *budget == 0 {
+        return PlainValue::Null;
+    }
+    *budget -= 1;
+    match v {
+        Value::Nil => PlainValue::Null,
+        Value::Boolean(b) => PlainValue::Bool(*b),
+        Value::Integer(i) => PlainValue::Num(*i as f64),
+        Value::Number(n) => PlainValue::Num(*n),
+        Value::String(s) => PlainValue::Str(s.to_string_lossy().to_string()),
+        Value::Table(t) if depth < MAX_DEPTH => {
+            let mut pairs: Vec<(Value, Value)> = Vec::new();
+            for pair in t.clone().pairs::<Value, Value>() {
+                let Ok(pair) = pair else { break };
+                pairs.push(pair);
+                if pairs.len() > MAX_VALUES {
+                    break;
+                }
+            }
+            let n = pairs.len();
+            let is_list = n > 0
+                && (1..=n).all(|i| {
+                    pairs
+                        .iter()
+                        .any(|(k, _)| matches!(k, Value::Integer(j) if *j as usize == i)
+                            || matches!(k, Value::Number(f) if *f == i as f64))
+                });
+            if is_list {
+                let mut items = vec![PlainValue::Null; n];
+                for (k, v) in &pairs {
+                    let i = match k {
+                        Value::Integer(j) => *j as usize,
+                        Value::Number(f) => *f as usize,
+                        _ => continue,
+                    };
+                    items[i - 1] = from_lua(v, depth + 1, budget);
+                }
+                PlainValue::List(items)
+            } else {
+                PlainValue::Map(
+                    pairs
+                        .iter()
+                        .map(|(k, v)| {
+                            let key = match k {
+                                Value::String(s) => s.to_string_lossy().to_string(),
+                                Value::Integer(i) => i.to_string(),
+                                Value::Number(n) => n.to_string(),
+                                Value::Boolean(b) => b.to_string(),
+                                _ => "?".to_string(),
+                            };
+                            (key, from_lua(v, depth + 1, budget))
+                        })
+                        .collect(),
+                )
+            }
+        }
+        // A frame object, a function or a table past the depth: its kind, as text.
+        Value::Table(_) => PlainValue::Str("table".into()),
+        Value::Function(_) => PlainValue::Str("function".into()),
+        other => PlainValue::Str(other.type_name().into()),
+    }
+}
+
+/// The page's copy of every fired event while armed ([`super::UiScript::set_event_tap`]).
+#[derive(Default)]
+pub(crate) struct EventTap(pub(crate) Option<Vec<(String, Vec<ScriptValue>)>>);
