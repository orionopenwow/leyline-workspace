+// bridge.js — the page-side face of the JavaScript bridge (`benilla-app/src/webbridge`).
+//
+// The wasm looks up `window.__wenilla_bridge` once a frame and, when it is there, calls
+// `onFrame(snapshot)` and `onEvent(name, payload)` on it and drains its `queue` of command
+// objects. This module creates that object and wraps the raw contract in `wenilla`: a
+// listener registry, promise-returning Lua evaluation and world verbs, a gamepad mapper, the
+// hidden-tab keepalive, and desktop notifications. The automation library on top of it
+// (`wenilla.auto`) is `automate.js`, loaded from here. `web/README.md` § "JavaScript bridge" documents the
+// snapshot and event schema; this file is the API.
+//
+// Dynamic, unawaited, never load-bearing — the same posture as platform.js: a page that never
+// imports it runs the game exactly as before, at the cost of one `Reflect.get` per frame.
+
+const hook = (window.__wenilla_bridge ??= {});
+Object.assign(hook, {
+  version: 1,
+  hz: hook.hz ?? 20,            // onFrame calls per second (0 = every frame)
+  radius: hook.radius ?? 60,    // yards; units[] is everything within it
+  maxUnits: hook.maxUnits ?? 64,
+  events: hook.events ?? [],    // Lua event names to relay, or '*'
+  queue: hook.queue ?? [],      // commands, drained by the wasm every frame
+});
+
+const listeners = new Map();
+const emit = (name, payload) => {
+  const set = listeners.get(name);
+  if (!set) return;
+  for (const cb of set) {
+    try {
+      cb(payload);
+    } catch (e) {
+      console.error(`wenilla: listener for ${name} threw`, e);
+    }
+  }
+};
+
+const pendingLua = new Map();
+let luaSeq = 0;
+const pendingAct = new Map();
+let actSeq = 0;
+/** A guid as the wasm takes it: a unit row, or its hex string. */
+const guidOf = (u) => (typeof u === 'string' ? u : u?.guid);
+const act = (op, fields = {}, timeoutMs = 5000) => {
+  const id = ++actSeq;
+  return new Promise((resolve) => {
+    const timer = setTimeout(() => {
+      pendingAct.delete(id);
+      resolve({ op, ok: false, reason: 'timed out (is the game running?)' });
+    }, timeoutMs);
+    pendingAct.set(id, { resolve, timer });
+    push({ op, id, ...fields });
+  });
+};
+const push = (cmd) => hook.queue.push(cmd);
+
+// Bridge-level event names; anything else passed to `on()` is taken as a Lua event name and
+// subscribed to on the page's behalf.
+const BRIDGE_EVENTS = new Set([
+  'frame', 'ready', 'commands', 'state', 'map', 'zone', 'chat', 'lua', 'act', 'event', 'input',
+  'error',
+]);
+
+hook.onFrame = (snapshot) => {
+  wenilla.state = snapshot;
+  emit('frame', snapshot);
+};
+hook.onEvent = (name, payload) => {
+  if (name === 'ready') {
+    wenilla.ready = true;
+    wenilla.commands = payload.commands;
+    // The wasm re-reads `events` every frame; a subscription made before boot is honoured now.
+  } else if (name === 'commands') {
+    wenilla.commands = payload;
+  } else if (name === 'lua') {
+    const p = pendingLua.get(payload.id);
+    if (p) {
+      pendingLua.delete(payload.id);
+      clearTimeout(p.timer);
+      payload.ok ? p.resolve(payload.values) : p.reject(new Error(payload.error));
+    }
+  } else if (name === 'act') {
+    const p = pendingAct.get(payload.id);
+    if (p) {
+      pendingAct.delete(payload.id);
+      clearTimeout(p.timer);
+      p.resolve(payload);
+    }
+  } else if (name === 'event') {
+    emit(payload.name, payload.args);
+  } else if (name === 'error') {
+    console.warn('wenilla: bridge error', payload);
+  }
+  emit(name, payload);
+};
+
+export const wenilla = {
+  /** The last `onFrame` snapshot (see README for the schema), or null before the first. */
+  state: null,
+  /** `[{name, category}]` — every command `hold`/`fire` accepts, from `ready` and `commands`. */
+  commands: [],
+  ready: false,
+
+  /** Listen for a bridge event ('frame', 'chat', 'state', …) or any Lua UI event name. */
+  on(name, cb) {
+    if (!listeners.has(name)) listeners.set(name, new Set());
+    listeners.get(name).add(cb);
+    if (!BRIDGE_EVENTS.has(name)) this.subscribe(name);
+    return () => this.off(name, cb);
+  },
+  off(name, cb) {
+    listeners.get(name)?.delete(cb);
+  },
+  /** Ask the wasm to relay these Lua events (`'*'` for all — debugging only, it is a firehose). */
+  subscribe(...names) {
+    if (hook.events === '*') return;
+    if (names.includes('*')) {
+      hook.events = '*';
+      return;
+    }
+    hook.events = [...new Set([...hook.events, ...names])];
+  },
+
+  /** Assert (or release) a held command by name — MOVEFORWARD, STRAFELEFT, TURNLEFT… */
+  hold(cmd, down = true) {
+    push({ op: 'hold', cmd, down });
+  },
+  release(cmd) {
+    push({ op: 'hold', cmd, down: false });
+  },
+  releaseAll() {
+    push({ op: 'release' });
+  },
+  /** Fire a command once: JUMP, SITORSTAND, TARGETNEARESTENEMY, ACTIONBUTTON1, CAMERAZOOMIN… */
+  fire(cmd, amount = 1) {
+    push({ op: 'fire', cmd, amount });
+  },
+  /** Turn the character's aim by `dyaw` radians (positive = left / counter-clockwise). */
+  look(dyaw) {
+    push({ op: 'look', dyaw });
+  },
+  /** Evaluate a Lua chunk in the UI VM; resolves to its return values as plain JS values. */
+  lua(chunk, timeoutMs = 10000) {
+    const id = ++luaSeq;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        pendingLua.delete(id);
+        reject(new Error('wenilla.lua: timed out (is the game running and in a state with a VM?)'));
+      }, timeoutMs);
+      pendingLua.set(id, { resolve, reject, timer });
+      push({ op: 'lua', id, chunk });
+    });
+  },
+  /** A line as if typed into the chat box: `/say hi`, `/target Bob`, `/follow`, `.gm on`. */
+  chat(text) {
+    push({ op: 'chat', text });
+  },
+  /**
+   * Use a bag item by name, id or link, as a right-click on it does (`UseItemByName`: a name the
+   * item cache has not seen yet is matched against the bags' links). Resolves to the Lua result.
+   */
+  useItem(item) {
+    return this.lua(`UseItemByName(${JSON.stringify(item)})`);
+  },
+  /**
+   * Put the camera `yards` behind the character. `CameraZoomOut` stops at the zoom limit,
+   * `cameraDistanceMax` × `cameraDistanceMaxFactor` (15 yd by default, where the camera already
+   * starts, so a plain zoom-out does nothing); this raises the factor to reach `yards` (up to the
+   * 50 yd ceiling) and zooms there. The factor is the player's CVar: it is saved like any setting.
+   */
+  camera(yards) {
+    const d = Math.max(0, Math.min(50, Number(yards) || 0));
+    return this.lua(
+      `local d = ${d}; local m = tonumber(GetCVar("cameraDistanceMax")) or 15; if m <= 0 then m = 15 end ` +
+      `SetCVar("cameraDistanceMaxFactor", d / m); CameraZoomOut(50); return d`,
+    );
+  },
+
+  // World verbs. Each resolves to the wasm's answer, `{op, ok, reason?}` — it never rejects.
+  /** Select a unit (a `units[]` row or its guid) — what a left-click on it does. */
+  target(unit) {
+    return act('target', { guid: guidOf(unit) });
+  },
+  /**
+   * Interact with an object (a row or a guid) — what a right-click on it does: talk to an NPC,
+   * loot or skin a body, use a GameObject, attack an enemy. In the client's own reach only.
+   * `{autoLoot: true}` opens a body or container with 1.12's auto-loot (the Shift-click), which
+   * takes everything — the only way a script loots: the client refuses a scripted loot-button
+   * click, as the original did.
+   */
+  interact(unit, { autoLoot = false } = {}) {
+    return act('interact', { guid: guidOf(unit), ...(autoLoot ? { autoLoot: true } : {}) });
+  },
+  /**
+   * Start walking in a straight line to a WoW position `[x, y, z]` (Click to Move's ground walk).
+   * Resolves when the walk starts; `state.self.autoMove` turns false when it ends — arrived,
+   * blocked, or cancelled by any movement command. `wenilla.auto.moveTo` waits for arrival.
+   */
+  moveTo(pos) {
+    return act('moveto', { pos: [pos[0], pos[1], pos[2]] });
+  },
+  /** End a walk in flight. */
+  stop() {
+    return act('stop');
+  },
+  /**
+   * Find a walkable way from the player to `pos` through the loaded collision world (A* on a
+   * one-yard grid). Resolves `{ok, points, partial, expanded}`: `points` are WoW positions, the
+   * player's first; `partial` means the goal was out of reach and the points end at the nearest
+   * place found. `budget` caps the cells searched (default 12000, ~0.1-0.5 s of one frame).
+   */
+  path(pos, { budget } = {}) {
+    return act('path', { pos: [pos[0], pos[1], pos[2]], ...(budget ? { budget } : {}) }, 15000);
+  },
+
+  /** Resolve with the next payload of a bridge or Lua event, or null after `timeoutMs`. */
+  once(name, timeoutMs = 10000) {
+    return new Promise((resolve) => {
+      const off = this.on(name, (p) => {
+        clearTimeout(timer);
+        off();
+        resolve(p ?? true);
+      });
+      const timer = setTimeout(() => {
+        off();
+        resolve(null);
+      }, timeoutMs);
+    });
+  },
+  /** Resolve when `pred(state)` holds on a frame (true), or false after `timeoutMs`. */
+  waitFor(pred, timeoutMs = 10000) {
+    return new Promise((resolve) => {
+      const check = (s) => {
+        try {
+          return s && pred(s);
+        } catch {
+          return false;
+        }
+      };
+      if (check(this.state)) return resolve(true);
+      const off = this.on('frame', (s) => {
+        if (!check(s)) return;
+        clearTimeout(timer);
+        off();
+        resolve(true);
+      });
+      const timer = setTimeout(() => {
+        off();
+        resolve(false);
+      }, timeoutMs);
+    });
+  },
+  /** Live knobs: `{hz, radius, maxUnits, backgroundHz}`. */
+  set({ hz, radius, maxUnits, backgroundHz } = {}) {
+    if (hz !== undefined) hook.hz = hz;
+    if (radius !== undefined) hook.radius = radius;
+    if (maxUnits !== undefined) hook.maxUnits = maxUnits;
+    if (backgroundHz !== undefined) background.hz = backgroundHz;
+  },
