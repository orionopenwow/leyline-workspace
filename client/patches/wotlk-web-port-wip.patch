+/// A list still compiling: the translated rows, how far the expressions and the sets have got.
+struct PendingList {
+    list: &'static str,
+    rows: Vec<FilterPattern>,
+    next_row: usize,
+    /// The translated text of each expression in `done.each`, for the sets.
+    patterns: Vec<String>,
