+/// The Dungeon Finder's role button (`LFGRoleButtonTemplate`, Forever UI's `createRole`): a 24-unit
+/// CheckButton hung off its 64-unit Button's BOTTOMLEFT at (-5, -5), half outside it. A click
+/// anywhere on the box toggles it, the part outside the parent included, and a click with no
+/// move before it (a tap, a synthetic click) hits as well as a hovered one.
+#[test]
+fn a_role_checkbox_takes_clicks_on_all_of_its_box_with_no_hover_first() {
+    let mut s = script();
+    s.set_screen_size(1024.0, 768.0);
+    s.run(
+        r#"
+        role = CreateFrame("Button", "RoleB", UIParent)
+        role:SetWidth(64) role:SetHeight(64) role:SetPoint("BOTTOMLEFT", 100, 100)
+        check = CreateFrame("CheckButton", "RoleC", role)
+        check:SetWidth(24) check:SetHeight(24) check:SetPoint("BOTTOMLEFT", role, "BOTTOMLEFT", -5, -5)
+        clicks = 0
+        check:SetScript("OnClick", function() clicks = clicks + 1 end)
+        role:SetScript("OnClick", function() check:Click() end)
+    "#,
+    )
+    .unwrap();
+    s.resolve();
+    // Inside the box but outside the parent (x 95..100), inside both, and on the parent alone.
+    for (i, (x, y)) in [(97.0, 110.0), (110.0, 110.0), (150.0, 150.0)].into_iter().enumerate() {
+        s.mouse_button(x, y, "LeftButton", true);
+        s.mouse_button(x, y, "LeftButton", false);
+        assert_eq!(
+            s.eval::<i64>("return clicks").unwrap(),
+            i as i64 + 1,
+            "click {i} at ({x}, {y})"
+        );
+    }
+}
