+/// draw that binds it, and the whole 3D view stopped drawing after a map change into an instance.
+/// More siblings instead, each a bounded allocation.
+const POOL_MAX_CAPACITY: u32 = 128;
+
+/// A new sibling's layer count after the largest of its key so far: ×4, within the device's
+/// layer limit and [`POOL_MAX_CAPACITY`].
+fn next_capacity(largest: Option<u32>, max_layers: u32) -> u32 {
+    largest
+        .map_or(POOL_BASE_CAPACITY, |c| c.saturating_mul(4))
+        .min(max_layers)
+        .min(POOL_MAX_CAPACITY)
+}
+
+#[cfg(test)]
+mod capacity_tests {
+    /// No array past 128 layers, however many textures a city and an instance pool.
+    #[test]
+    fn siblings_grow_to_a_bounded_array() {
+        let mut c = None;
+        let mut seen = Vec::new();
+        for _ in 0..6 {
+            let n = super::next_capacity(c, 2048);
+            seen.push(n);
+            c = Some(n);
+        }
+        assert_eq!(seen, [8, 32, 128, 128, 128, 128]);
+        assert_eq!(super::next_capacity(Some(32), 64), 64, "the device limit still wins");
+    }
+}
