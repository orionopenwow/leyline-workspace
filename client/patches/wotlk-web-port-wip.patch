index 00000000..7182cd37
--- /dev/null
+++ b/web/examples/idle.js
@@ -0,0 +1,46 @@
+// examples/idle.js — the smallest "idle-RPG" loop: pick the nearest hostile, attack it, cast
+// something while it lives, sit when hurt. A sketch of the control API, not a bot; adjust the
+// spell and the thresholds. Run with `import('./examples/idle.js')` or `?bridge=idle`.
+import { wenilla } from '../bridge.js';
+
+const SPELL = null; // e.g. 'Frostbolt' — null means auto-attack only
+const REST_BELOW = 0.35;
+
+let resting = false;
+export const idle = {
+  running: true,
+  stop() {
+    this.running = false;
+    wenilla.releaseAll();
+  },
+};
+
+setInterval(async () => {
+  if (!idle.running) return;
+  const s = wenilla.state;
+  const me = s?.self;
+  if (!me || me.dead || me.ghost) return;
+
+  const hurt = me.health / Math.max(1, me.maxHealth) < REST_BELOW;
+  if (!me.inCombat && hurt) {
+    if (!resting) {
+      wenilla.chat('/sit');
+      resting = true;
+    }
+    return;
+  }
+  if (resting && !hurt) {
+    wenilla.chat('/stand');
+    resting = false;
+  }
+
+  const t = s.target;
+  if (!t || t.dead || !t.hostile) {
+    wenilla.fire('TARGETNEARESTENEMY');
+    return;
+  }
+  if (!me.inCombat) wenilla.fire('ATTACKTARGET');
+  if (SPELL && !me.casting) {
+    await wenilla.lua(`CastSpellByName(${JSON.stringify(SPELL)})`).catch(() => {});
+  }
+}, 500);
diff --git a/web/index.html b/web/index.html
new file mode 100644
index 00000000..0db8347e
--- /dev/null
+++ b/web/index.html
@@ -0,0 +1,122 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>wenilla</title>
+<style>
+  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #000; }
+  #benilla { display: block; width: 100vw; height: 100vh; }
+  /* Matches the realm page's #bar corner, so the two pages behave the same. */
+  #fs { position: fixed; top: 0; right: 0; z-index: 10; padding: .3rem .6rem; color: #ddd;
+        background: rgba(0,0,0,.55); border: 0; border-bottom-left-radius: 6px; cursor: pointer;
+        font: 12px system-ui, sans-serif; text-decoration: underline; }
+  /* The notifications bell (web/bridge.js `wenilla.notify`), left of the full-screen button. */
+  #bell { position: fixed; top: 0; right: 6.2rem; z-index: 10; padding: .2rem .5rem; color: #ddd;
+          background: rgba(0,0,0,.55); border: 0; border-bottom-left-radius: 6px; cursor: pointer;
+          font: 14px system-ui, sans-serif; opacity: .7; }
+  #bell.on { opacity: 1; }
+</style>
+<script>
+  // Sound: the browser suspends any AudioContext created before the first user gesture (autoplay
+  // policy), and the mixer (kira/cpal) creates its at startup and never resumes it — so the tab
+  // stayed silent. Remember every context the page creates and resume them on the first
+  // click/key, which is the only place a browser lets that happen.
+  (() => {
+    const contexts = [];
+    for (const name of ['AudioContext', 'webkitAudioContext']) {
+      const Orig = window[name];
+      if (!Orig) continue;
+      const Patched = function (...args) {
+        const ctx = new Orig(...args);
+        contexts.push(ctx);
+        return ctx;
+      };
+      Patched.prototype = Orig.prototype;
+      window[name] = Patched;
+    }
+    const resume = () => {
+      console.log(`audio: gesture — ${contexts.length} context(s): ${contexts.map((c) => c.state).join(',') || 'none'}`);
+      for (const ctx of contexts) {
+        if (ctx.state !== 'running') {
+          ctx.resume().then(() => console.log(`audio: context resumed (${ctx.state})`), () => {});
+        }
+      }
+    };
+    for (const ev of ['pointerdown', 'keydown', 'touchstart']) {
+      window.addEventListener(ev, resume, { capture: true, passive: true });
+    }
+  })();
+</script>
+<script type="importmap">{"imports":{"wasi_snapshot_preview1":"./wasi_stubs.js"}}</script>
+<script>
+  // WGSL compile errors are otherwise invisible: wgpu's browser backend never asks the module for
+  // its compilation info, so Chrome only prints the "[Invalid ShaderModule] … previous error"
+  // cascade. Ask on its behalf and print the real diagnostics — cheap, and only speaks on errors.
+  if (navigator.gpu && window.GPUDevice) {
+    const orig = GPUDevice.prototype.createShaderModule;
+    GPUDevice.prototype.createShaderModule = function (desc) {
+      const m = orig.call(this, desc);
+      m.getCompilationInfo().then((info) => {
+        const errs = info.messages.filter((x) => x.type === 'error');
+        if (!errs.length) return;
+        const lines = (desc.code || '').split('\n');
+        for (const e of errs) {
+          console.error(`WGSL error in ${desc.label || '(unlabeled)'} @${e.lineNum}:${e.linePos}: ${e.message}\n    ${lines[e.lineNum - 1] || ''}`);
+        }
+      });
+      return m;
+    };
+  }
+</script>
+<button type="button" id="fs" title="Full screen. Captures Esc, Tab and Ctrl+W for the game — press and hold Esc to leave.">full screen</button>
+<button type="button" id="bell" title="Desktop notifications while this tab is in the background: level-ups, death, whispers, invites, mail, combat. Asks the browser once.">🔔</button>
+<canvas id="benilla"></canvas>
+<script>
+  // Dev page: allow `?user=&pass=&char=` links to log in. A hosting page that fetched the
+  // credentials itself sets `window.__wenilla_env = {user, pass, host}` here instead, and the
+  // client then never reads credentials from the URL (`benilla_app::webenv`).
+  window.__wenilla_env = { dev_query_creds: '1' };
+</script>
+<script type="module">
+  import init from './wenilla.js';
+  import { bind } from './wasi_stubs.js';
+  import { boot } from './boot.js';
+  // `boot(init)` is the loading overlay + parallel data prefetch (see boot.js's header); it calls
+  // `init()` with a byte-counted Response, and `init()` instantiates the wasm module, which runs
+  // `#[wasm_bindgen(start)] start()` as part of instantiation (`wenilla/src/lib.rs`) — that's the
+  // whole boot, canvas included (`boot.rs` binds to `#benilla` by id, so no query/lookup belongs
+  // here). `bind(w.memory)` comes AFTER on purpose: the wasm Lua VM's WASI shims
+  // (`wasi_stubs.js`'s own header) can only zero a WASI caller's out-pointers once the module's
+  // linear memory exists to write into, and `init()` is what creates it.
+  // Full-screen key capture (Esc/Tab/Ctrl+W reach the game) + durable settings storage. Same
+  // module and same contract as the realm page: dynamic, unawaited, and never load-bearing —
+  // see web/platform.js. The dev page has no WebGPU gate to sit behind, so on a browser that
+  // prompts for persistent storage (Firefox) this is where the player would see it.
+  import('./platform.js')
+    .then(({ installFullscreenToggle, requestPersistentStorage }) => {
+      requestPersistentStorage();
+      installFullscreenToggle(document.getElementById('fs'), {
+        focusTarget: document.getElementById('benilla'),
+      });
+    })
+    .catch((e) => console.warn('platform.js:', e));
+  // The JavaScript bridge (web/bridge.js, `window.wenilla` in the console): live game state
+  // out, commands in, the hidden-tab keepalive and desktop notifications. Same posture as
+  // platform.js — dynamic, never load-bearing. `?bridge=hud` / `?bridge=idle` mount an example
+  // from web/examples/ on top; `?bridge=0` turns the bridge off for the session (webbridge.rs).
+  import('./bridge.js')
+    .then(({ wenilla }) => {
+      const bell = document.getElementById('bell');
+      const offTitle = bell.title; // captured before the first toggle, so it can come back
+      bell.addEventListener('click', async () => {
+        const on = wenilla.notify.enabled ? (wenilla.notify.disable(), false) : await wenilla.notify.enable();
+        bell.classList.toggle('on', on);
+        bell.title = on ? 'Notifications on — click to turn off.' : offTitle;
+      });
+      const example = new URLSearchParams(location.search).get('bridge');
+      if (example && /^[a-z]+$/.test(example) && example !== '0') {
+        import(`./examples/${example}.js`).catch((e) => console.warn(`examples/${example}.js:`, e));
+      }
+    })
+    .catch((e) => console.warn('bridge.js:', e));
+  const w = await boot(init);
+  bind(w.memory);
+</script>
diff --git a/web/platform.js b/web/platform.js
new file mode 100644
index 00000000..61364195
--- /dev/null
+++ b/web/platform.js
@@ -0,0 +1,108 @@
+// platform.js — browser-platform glue the client cannot ask for itself: full-screen key capture
+// and durable storage. Shared by the dev page (web/index.html) and the realm page
+// (crates/wenilla-realm/templates/play.html), the same way boot.js is.
+//
+// Everything here is best-effort. Every entry point is feature-detected and every failure is
+// swallowed: none of it is load-bearing for booting the client, and a browser that refuses one
+// of these must still play exactly as it does today. Both pages import this module
+// *dynamically*, off the boot path, so even a missing platform.js only costs the button.
+
+// Ask the browser to exempt this origin's quota storage from eviction.
+//
+// What this protects is the player's own state, not the game archives. The client keeps its
+// state folder — config.toml (CVars), key bindings, macros, layouts, chat settings, saved
+// variables, the remembered account name — in `localStorage`, one entry per file
+// (benilla-app/src/local_state.rs). localStorage is quota-managed storage, and a browser under
+// storage pressure evicts a "best-effort" origin's quota storage as a unit, silently: the
+// player comes back to default keybinds. `persist()` moves the origin to the persistent bucket,
+// which Chrome then clears only when the user clears site data.
+//
+// It does NOT protect the downloaded game data. `/data/*` is served
+// `private, max-age=31536000, immutable` (wenilla-host/src/data.rs) and boot.js prefetches the
+// boot read-set into that cache, but that is the HTTP cache — a separate, browser-wide LRU that
+// the Storage API does not govern, so a persistent origin can still lose it and pay a cold boot.
+// Holding the archives across eviction would mean rehosting them in the Cache API (quota
+// storage), which is a much bigger decision than this call — see web/README.md.
+//
+// The grant is heuristic (site engagement, installed PWA, notification permission) and in Chrome
+// there is no prompt — it can simply return false, and there is nothing to fall back to. Firefox
+// does prompt, which is why both pages call this only after the WebGPU gate: a browser that
+// cannot run the client never asks the player for anything.
+export async function requestPersistentStorage() {
+  if (!navigator.storage || !navigator.storage.persist) return false;
+  try {
+    // Already granted: don't ask again, the answer is sticky for the origin.
+    if (await navigator.storage.persisted()) return true;
+    const granted = await navigator.storage.persist();
+    console.log(`storage: persistent = ${granted}`);
+    return granted;
+  } catch (_) {
+    return false;
+  }
+}
+
+// The keys the game needs more than the browser does, as KeyboardEvent.code values. Keyboard
+// Lock only takes effect in full screen, and only for the codes named here — locking everything
+// (`lock()` with no argument) would take Ctrl+T, Ctrl+Tab and the rest hostage for no gain.
+//
+//   Escape — WoW's close-window / game-menu key. bindings/chord.rs maps it as "ESCAPE" and
+//            login/mod.rs + char_select/ bind it directly. Unlocked, every press leaves full
+//            screen and drops the pointer lock instead of ever reaching the client.
+//   Tab    — target cycling. Unlocked, it walks browser focus out of the canvas.
+//   KeyW   — forward. W already reaches the page on its own; locking the code is what keeps
+//            Ctrl+W / Cmd+W from closing the tab mid-pull.
+const LOCK_KEYS = ['Escape', 'Tab', 'KeyW'];
+
+// Keep Keyboard Lock tied to the document's actual full-screen state, and optionally wire a
+// button to toggle it.
+//
+// `button` may be null: the lock still follows F11 and every other way into full screen. When a
+// button is given it also gets its label and aria-pressed kept in sync, and is hidden outright
+// on a browser with no Fullscreen API.
+//
+// `focusTarget` (the canvas) gets focus back after every toggle: the click leaves focus on the
+// button, and a focused button eats Space and Enter before winit's canvas listeners see them.
+export function installFullscreenToggle(button, { target = document.documentElement, focusTarget = null } = {}) {
+  const supported = !!(target.requestFullscreen && document.exitFullscreen);
+  if (!supported) {
+    if (button) button.hidden = true;
+    return;
+  }
+
+  const lockKeys = async () => {
+    if (!navigator.keyboard || !navigator.keyboard.lock) return;
+    // Chrome shows its own "press and hold Esc to exit full screen" toast on the first lock.
+    try { await navigator.keyboard.lock(LOCK_KEYS); } catch (_) { /* denied; keys stay browser-owned */ }
+  };
+  const unlockKeys = () => {
+    if (!navigator.keyboard || !navigator.keyboard.unlock) return;
+    try { navigator.keyboard.unlock(); } catch (_) {}
+  };
+
+  // Driven by `fullscreenchange`, not by the click: F11, the Esc long-press and the browser's
+  // own exit affordances never go through our handler, and the lock has to follow all of them.
+  // `initial` marks the install-time call, which only paints the button — stealing focus on
+  // page load (before there is a client to type into) is not this module's business.
+  const sync = (initial) => {
+    const full = document.fullscreenElement !== null;
+    if (button) {
+      button.textContent = full ? 'exit full screen' : 'full screen';
+      button.setAttribute('aria-pressed', String(full));
+    }
+    if (full) lockKeys(); else unlockKeys();
+    if (!initial && focusTarget) focusTarget.focus?.();
+  };
+
+  if (button) {
+    button.addEventListener('click', async () => {
+      try {
+        if (document.fullscreenElement) await document.exitFullscreen();
+        else await target.requestFullscreen({ navigationUI: 'hide' });
+      } catch (e) {
+        console.warn('fullscreen:', e);
+      }
+    });
+  }
+  document.addEventListener('fullscreenchange', () => sync(false));
+  sync(true);
+}
diff --git a/web/tests/automate.test.mjs b/web/tests/automate.test.mjs
new file mode 100644
index 00000000..6910bf45
--- /dev/null
+++ b/web/tests/automate.test.mjs
@@ -0,0 +1,99 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { install } from '../automate.js';
+
+/** A bridge stand-in: a fixed snapshot, a scripted `lua()`, and an event registry. */
+function fakeBridge(state, luaAnswers = []) {
+  const listeners = new Map();
+  const calls = [];
+  const w = {
+    state,
+    subscribed: [],
+    subscribe: (...names) => w.subscribed.push(...names),
+    on(name, cb) {
+      if (!listeners.has(name)) listeners.set(name, new Set());
+      listeners.get(name).add(cb);
+      return () => listeners.get(name).delete(cb);
+    },
+    emit: (name, payload) => listeners.get(name)?.forEach((cb) => cb(payload)),
+    lua: async (chunk) => {
+      calls.push(chunk);
+      return luaAnswers.shift() ?? [];
+    },
+    calls,
+  };
+  return w;
+}
+
+const unit = (fields) => ({
+  kind: 'unit', name: 'Kobold Vermin', level: 2, dist: 10, pos: [0, 0, 0], hostile: true, friendly: false,
+  dead: false, lootable: false, tapped: false, inCombat: false, isPlayer: false, services: [],
+  questStatus: null, targetGuid: null, ...fields,
+});
+
+test('unit filters combine every condition, nearest first', () => {
+  const w = fakeBridge({
+    self: { guid: '0x1', pos: [0, 0, 0] },
+    units: [
+      unit({ guid: '0xa', dist: 5, dead: true, lootable: true }),
+      unit({ guid: '0xb', dist: 8 }),
+      unit({ guid: '0xc', dist: 12, name: 'Brother Danil', hostile: false, friendly: true, services: ['vendor'] }),
+      unit({ guid: '0xd', dist: 20, level: 9 }),
+      unit({ guid: '0xe', dist: 25, targetGuid: '0x1', inCombat: true }),
+    ],
+  });
+  const auto = install(w);
+  assert.equal(auto.nearest({ hostile: true, alive: true }).guid, '0xb');
+  assert.equal(auto.nearest({ lootable: true }).guid, '0xa');
+  assert.equal(auto.nearest({ service: 'vendor' }).name, 'Brother Danil');
+  assert.equal(auto.nearest({ name: /^brother/i }).guid, '0xc');
+  assert.equal(auto.nearest({ name: 'kobold vermin', maxLevel: 3, minLevel: 3 }), null);
+  assert.deepEqual(auto.units({ hostile: true, alive: true, maxDist: 21 }).map((u) => u.guid), ['0xb', '0xd']);
+  assert.deepEqual(auto.attackers().map((u) => u.guid), ['0xe']);
+  assert.equal(auto.nearest((u) => u.level > 5).guid, '0xd');
+});
+
+test('the library subscribes to the events its waits depend on', () => {
+  const w = fakeBridge({ units: [] });
+  install(w);
+  for (const e of ['MERCHANT_SHOW', 'LOOT_OPENED', 'LOOT_CLOSED', 'QUEST_DETAIL', 'PLAYER_DEAD', 'PLAYER_ENTER_COMBAT']) {
+    assert.ok(w.subscribed.includes(e), e);
+  }
+});
+
+test('swing and death edges are tracked from the event stream', () => {
+  const w = fakeBridge({ self: { pos: [1, 2, 3] }, units: [] });
+  const auto = install(w);
+  w.emit('PLAYER_ENTER_COMBAT');
+  assert.equal(auto.attacking, true);
+  w.emit('PLAYER_DEAD');
+  assert.equal(auto.attacking, false);
+  assert.deepEqual(auto.deathPos, [1, 2, 3]);
+});
+
+test('bag rows decode links, and a table that came back keyed reads as a sequence', async () => {
+  const link = '|cff9d9d9d|Hitem:3300:0:0:0|h[Rabbit\'s Foot]|h|r';
+  const white = '|cffffffff|Hitem:117:0:0:0|h[Tough Jerky]|h|r';
+  // One row as an array, one as the keyed object lua() produces for a table it could not read
+  // as a list.
+  const w = fakeBridge({ units: [] }, [[[[0, 1, link, 2], { 1: 0, 2: 3, 3: white, 4: 5 }]]]);
+  const auto = install(w);
+  const bags = await auto.bags();
+  assert.deepEqual(
+    bags.map(({ bag, slot, id, name, quality, count }) => [bag, slot, id, name, quality, count]),
+    [
+      [0, 1, 3300, "Rabbit's Foot", 0, 2],
+      [0, 3, 117, 'Tough Jerky', 1, 5],
+    ],
+  );
+});
+
+test('sellJunk sells only grey items, through UseContainerItem', async () => {
+  const grey = '|cff9d9d9d|Hitem:1:0:0:0|h[Junk]|h|r';
+  const green = '|cff1eff00|Hitem:2:0:0:0|h[Ring]|h|r';
+  const w = fakeBridge({ units: [] }, [[[[0, 4, grey, 1], [1, 2, green, 1], [2, 7, grey, 3]]]]);
+  const auto = install(w);
+  assert.equal(await auto.sellJunk(), 2);
+  assert.deepEqual(w.calls.filter((c) => c.startsWith('UseContainerItem')), ['UseContainerItem(0, 4)', 'UseContainerItem(2, 7)']);
+});
diff --git a/web/tests/boot.test.mjs b/web/tests/boot.test.mjs
new file mode 100644
index 00000000..efeb390e
--- /dev/null
+++ b/web/tests/boot.test.mjs
@@ -0,0 +1,160 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+
+const source = (await readFile(new URL('../boot.js', import.meta.url), 'utf8'))
+  .replaceAll('import.meta.url', JSON.stringify(new URL('../boot.js', import.meta.url).href));
+const { boot } = await import('data:text/javascript;base64,' + Buffer.from(source).toString('base64'));
+const wasmBytes = new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0]);
+const deferred = () => {
+  let resolve;
+  const promise = new Promise(r => { resolve = r; });
+  return { promise, resolve };
+};
+
+function setup(t, fetch) {
+  const children = new Map();
+  const element = () => ({
+    style: {}, classList: { add() {} }, remove() {},
+    querySelector(selector) {
+      if (!children.has(selector)) children.set(selector, element());
+      return children.get(selector);
+    },
+  });
+  for (const [key, value] of Object.entries({
+    fetch, location: { search: '' }, window: {},
+    document: { createElement: element, body: { appendChild() {} } },
+    setTimeout: () => 0, clearTimeout: () => {},
+  })) {
+    const descriptor = Object.getOwnPropertyDescriptor(globalThis, key);
+    Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+    t.after(() => descriptor ? Object.defineProperty(globalThis, key, descriptor) : delete globalThis[key]);
+  }
+  return children;
+}
+
+for (const mime of ['application/wasm', 'application/octet-stream', 'application/wasm; charset=utf-8']) {
+  test(`compilation overlaps prefetch and init waits (${mime})`, async t => {
+    const manifest = deferred();
+    const compiled = deferred();
+    const original = WebAssembly[mime === 'application/wasm' ? 'compileStreaming' : 'compile'];
+    const method = mime === 'application/wasm' ? 'compileStreaming' : 'compile';
+    t.mock.method(WebAssembly, method, async input => {
+      const module = await original.call(WebAssembly, input);
+      compiled.resolve();
+      return module;
+    });
+    setup(t, async url => String(url).endsWith('boot-manifest.json') ? manifest.promise :
+      new Response(wasmBytes, { headers: { 'content-type': mime } }));
+    let started = false;
+    const result = boot(async ({ module_or_path }) => {
+      started = true;
+      assert.ok(module_or_path instanceof WebAssembly.Module);
+      return { memory: 'bound by caller' };
+    });
+    await compiled.promise;
+    assert.equal(started, false);
+    manifest.resolve(new Response(JSON.stringify({ names: [] })));
+    assert.deepEqual(await result, { memory: 'bound by caller' });
+  });
+}
+
+test('download failure is reported while prefetch is still pending', async t => {
+  const manifest = deferred();
+  const children = setup(t, async url => String(url).endsWith('boot-manifest.json') ? manifest.promise :
+    new Response('unavailable', { status: 503 }));
+  await assert.rejects(boot(() => assert.fail('must not initialize')), /HTTP 503/);
+  assert.match(children.get('.stage').textContent, /client failed to start.*HTTP 503/);
+  manifest.resolve(new Response('{}'));
+});
+
+test('missing manifest degrades to ordinary startup', async t => {
+  setup(t, async url => String(url).endsWith('boot-manifest.json') ? new Response('', { status: 404 }) :
+    new Response(wasmBytes, { headers: { 'content-type': 'application/wasm' } }));
+  assert.equal(await boot(async () => 'started'), 'started');
+});
+
+test('invalid wasm reports compilation failure and never starts the client', async t => {
+  const children = setup(t, async url => String(url).endsWith('boot-manifest.json') ? new Response('{}') :
+    new Response('invalid', { headers: { 'content-type': 'application/wasm' } }));
+  await assert.rejects(boot(() => assert.fail('must not initialize')), WebAssembly.CompileError);
+  assert.match(children.get('.stage').textContent, /client failed to start/);
+});
+
+test('a reconnect overlay goes when the character list, the world or a cancel arrives', async () => {
+  const { reconnectDismissedBy } = await import('../boot.js');
+  for (const s of ['reconnect-cancel', 'glue:charselect', 'glue:charcreate', 'enter', 'world']) {
+    assert.ok(reconnectDismissedBy(s), s);
+  }
+  assert.ok(!reconnectDismissedBy('glue:login'));
+  assert.ok(!reconnectDismissedBy('reconnect:2'));
+});
+
+test('a touch on the canvas becomes the mouse: move, press, drag, release', async () => {
+  const { touchToMouse } = await import('../boot.js');
+  const touch = (type, extra = {}) => ({ type, pointerType: 'touch', isPrimary: true, pointerId: 7, clientX: 10, clientY: 20, ...extra });
+  const down = touchToMouse(touch('pointerdown'));
+  assert.deepEqual(down.map((e) => e.type), ['pointermove', 'pointerdown']);
+  assert.equal(down[1].init.pointerType, 'mouse');
+  assert.equal(down[1].init.button, 0);
+  assert.equal(down[1].init.buttons, 1);
+  assert.equal(down[1].init.pointerId, 7);
+  assert.equal(touchToMouse(touch('pointermove'))[0].init.buttons, 1);
+  const up = touchToMouse(touch('pointerup'));
+  assert.deepEqual([up[0].type, up[0].init.button, up[0].init.buttons], ['pointerup', 0, 0]);
+  assert.equal(touchToMouse(touch('pointercancel'))[0].type, 'pointerup');
+  assert.equal(touchToMouse(touch('pointerdown', { isPrimary: false })), null, 'a second finger is left alone');
+  assert.equal(touchToMouse({ type: 'pointerdown', pointerType: 'mouse', isPrimary: true }), null, 'a mouse is untouched');
+});
+
+test('a guest pass covers with the inn line, and a share link names where it goes', async () => {
+  const { coverLabel, goToastText } = await import('../boot.js');
+  assert.equal(coverLabel(true), 'Opening the Goldshire Inn…');
+  assert.equal(coverLabel(false), 'Loading…');
+  assert.equal(goToastText({ kind: 'h', id: 'goldshire' }), 'Taking you to the goldshire hangout…');
+  assert.equal(goToastText({ kind: 'u', id: 'Elza' }), 'Taking you to Elza…');
+  assert.equal(goToastText({ kind: 'x', id: 'a' }), null);
+  assert.equal(goToastText(null), null);
+});
+
+test('at world entry only the glue models and sounds leave the store; the interface files stay', async () => {
+  const { glueBodyDroppable } = await import('data:text/javascript;base64,' + Buffer.from(source).toString('base64'));
+  for (const kept of [
+    'interface\\gluexml\\charactercreate.lua',
+    'interface\\gluexml\\glueparent.xml',
+    'interface\\glues\\common\\glue-panel-button-up.blp',
+    'interface\\addons\\foreverui\\glue\\login.lua',
+  ]) assert.equal(glueBodyDroppable(kept), false, kept);
+  for (const dropped of [
+    'interface\\glues\\models\\ui_human\\ui_human.m2',
+    'interface\\glues\\models\\ui_human\\ui_human00.skin',
+    'interface\\glues\\music\\gs_lichking.mp3',
+  ]) assert.equal(glueBodyDroppable(dropped), true, dropped);
+  assert.equal(glueBodyDroppable('world\\maps\\northrend\\northrend_30_21.adt'), false);
+});
+
+test('a long task is labelled by the client spans inside it, longest first', async () => {
+  const { labelLongTask, loadTraceView } = await import('data:text/javascript;base64,' + Buffer.from(source).toString('base64'));
+  const spans = [
+    { label: 'frame (inworld, covered): pipeline warm: 24 rigs', at: 1000, ms: 2900 },
+    { label: 'wmo world/wmo/northrend/dalaran/nd_dalaran.wmo', at: 3950, ms: 40 },
+    { label: 'wmo world/wmo/northrend/dalaran/nd_dalaran.wmo', at: 3990, ms: 30 },
+    { label: 'm2 far away', at: 9000, ms: 50 },
+  ];
+  assert.equal(
+    labelLongTask({ at: 1000, ms: 3050 }, spans),
+    'frame (inworld, covered): pipeline warm: 24 rigs 2900 ms + wmo world/wmo/northrend/dalaran/nd_dalaran.wmo 70 ms',
+  );
+  assert.match(labelLongTask({ at: 20000, ms: 80 }, spans), /^outside the client's spans/);
+  const view = loadTraceView({
+    phases: [
+      { phase: 'charselect', at: 5000, ms: 0 },
+      { phase: 'enter', at: 9000, ms: 4000 },
+      { phase: 'cover lifted', at: 169000, ms: 160000 },
+    ],
+    tasks: [{ label: 'x', ms: 3000, at: 1 }],
+  }, [{ label: 'y', ms: 3001.4, at: 2.2 }]);
+  assert.equal(view.enterToCoverLiftedMs, 160000);
+  assert.deepEqual(view.phases[1], { phase: 'enter', ms: 4000 });
+  assert.deepEqual(view.longtasks, [{ label: 'y', ms: 3001, at: 2 }]);
+});
diff --git a/web/tests/journal.test.mjs b/web/tests/journal.test.mjs
