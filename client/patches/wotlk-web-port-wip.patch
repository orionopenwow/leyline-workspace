+//! The 3.3.5a verbs Forever UI (github.com/Adrestie/mod-forever-ui) reached on top of the stock
+//! interface: `IsProtected`, the button's pushed-label offset and motion scripts, the FontString's
+//! string height, the scrolling message frame's scroll offset, `GetPlayerFacing`, the mirror
+//! timers' read verbs, the quest POI icons and `SetPortraitToTexture` on a texture object.
+
+use super::common::script;
+use crate::script::{MirrorTimerView, UiScript, WorldMapFeed, WorldMapPlayer};
+
+fn load(s: &UiScript, xml: &str) {
+    let doc = crate::framexml::parse(xml).expect("valid FrameXML");
+    let report = crate::loader::load(s, &doc, &|_| None);
+    assert!(report.errors.is_empty(), "fixture: {:?}", report.errors);
+}
+
+/// `protected="true"`, on the element or through its template, is the explicit answer; an
+/// ancestor of a protected frame is protected but not explicitly; a region answers its owner's.
+#[test]
+fn is_protected_reads_the_xml_flag_and_climbs_to_the_ancestors() {
+    let s = script();
+    load(
+        &s,
+        r#"<Ui>
+             <Frame name="SecureProbeTemplate" protected="true" virtual="true"/>
+             <Frame name="Outer">
+               <Frames>
+                 <Frame name="$parentInner" inherits="SecureProbeTemplate"/>
+               </Frames>
+             </Frame>
+             <Frame name="Plain"/>
+           </Ui>"#,
+    );
+    s.run("OuterTex = Outer:CreateTexture() PlainTex = Plain:CreateTexture()")
+        .unwrap();
+    let ask = |who: &str| -> (Option<i64>, Option<i64>) {
+        s.eval(&format!("return {who}:IsProtected()")).unwrap()
+    };
+    assert_eq!(
+        ask("OuterInner"),
+        (Some(1), Some(1)),
+        "inherited explicitly"
+    );
+    assert_eq!(ask("Outer"), (Some(1), None), "protected through its child");
+    assert_eq!(ask("Plain"), (None, None));
+    assert_eq!(
+        ask("OuterTex"),
+        (Some(1), None),
+        "a region answers its owner"
+    );
+    assert_eq!(ask("PlainTex"), (None, None));
+    // A Lua frame from a protected template is explicit too, which `SecureHandlerWrapScript`
+    // demands of its header (`SecureHandlers.lua:661`).
+    s.run(r#"Made = CreateFrame("Frame", "Made", UIParent, "SecureProbeTemplate")"#)
+        .unwrap();
+    assert_eq!(ask("Made"), (Some(1), Some(1)));
+    // One function on the Region map, as `SetSize` is.
+    assert!(s
+        .eval::<bool>("return Plain.IsProtected == PlainTex.IsProtected")
+        .unwrap());
+}
