--- /dev/null
+++ b/crates/benilla-ui/src/script/backport.rs
@@ -0,0 +1,595 @@
+//! Beyond 12340: the awesome_wotlk API surface modern 3.3.5a addons feature-detect, each built
+//! from data this client really holds and reimplemented from the fork's documented behaviour
+//! (no fork code). A call is defined only when its answer is real; one whose data the client
+//! lacks stays undefined, since addons read a function's presence as the feature's.
+//!
+//! - `UnitTokenFromGUID(guid)`: a token naming the unit now, or nil.
+//! - `GetSpellBaseCooldown(spell)`: `Spell.dbc`'s cooldown and global cooldown, in ms.
+//! - `GetItemInfoInstant(item)`: the cached item template's class columns, without a query.
+//! - `UnitOwner(unit)`, `UnitOccupations(unit)`, `UnitIsControlled(unit)`,
+//!   `UnitIsDisarmed(unit)` and the one-argument `UnitIsSilenced(unit)`: descriptor reads.
+//! - The window calls (`FlashWindow`, `IsWindowFocused`, `FocusWindow`, `CopyToClipboard`), each
+//!   defined only once the host says its platform does it ([`WindowCaps`]).
+
+use mlua::{Lua, MultiValue, Value};
+
+use super::Model;
+
+/// `UNIT_FIELD_FLAGS` bits the descriptor reads test (AzerothCore `UnitDefines.h` `UnitFlags`).
+pub(crate) mod unit_flags {
+    pub const SILENCED: u32 = 0x0000_2000;
+    pub const STUNNED: u32 = 0x0004_0000;
+    pub const DISARMED: u32 = 0x0020_0000;
+    pub const CONFUSED: u32 = 0x0040_0000;
+    pub const FLEEING: u32 = 0x0080_0000;
+    pub const POSSESSED: u32 = 0x0100_0000;
+    /// Loss of control as the fork documents `UnitIsControlled`: stunned, confused, feared or
+    /// mind-controlled. Pacify (`0x20000`) alone leaves the unit acting, so it is not one.
+    pub const CONTROLLED: u32 = STUNNED | CONFUSED | FLEEING | POSSESSED;
+}
+
+/// A guid argument: the `"0x%016X"` string `UnitGUID` answers, case-insensitive, with or without
+/// the `0x`. Anything else, 0 included, is no guid.
+pub(crate) fn parse_guid(v: &Value) -> Option<u64> {
+    let Value::String(s) = v else {
+        return None;
+    };
+    let s = s.to_str().ok()?;
+    let s = s.trim();
+    let hex = s
+        .strip_prefix("0x")
+        .or_else(|| s.strip_prefix("0X"))
+        .unwrap_or(s);
+    if hex.is_empty() || hex.len() > 16 {
+        return None;
+    }
+    u64::from_str_radix(hex, 16).ok().filter(|&g| g != 0)
+}
+
+/// `"0x%016X"`, `UnitGUID`'s spelling.
+fn guid_string(g: u64) -> String {
+    format!("0x{g:016X}")
+}
+
+/// A token naming `guid` now, in the order an addon most expects to see one: `player`, `target`,
+/// `focus`, `mouseover`, then the event fan-out's order (pet, party, raid, npc, nameplate).
+pub(super) fn token_from_guid(model: &Model, guid: u64) -> Option<String> {
+    let ug = &model.unit_guids;
+    for (token, g) in [
+        ("player", ug.player),
+        ("target", ug.target),
+        ("focus", ug.focus),
+        ("mouseover", ug.mouseover),
+    ] {
+        if g == guid && ug.guid_of(token) == Some(guid) {
+            return Some(token.to_string());
+        }
+    }
+    ug.tokens_naming(guid).into_iter().next()
+}
+
+/// The unit a token names, by its getters' own resolve.
+fn unit_of<'m>(model: &'m Model, token: &str) -> Option<&'m super::UnitState> {
+    model.unit(token).filter(|u| u.exists)
+}
+
+/// A unit's name by guid from whatever snapshot holds it: a token's, or the by-guid feed's.
+pub(super) fn name_of_guid(model: &Model, guid: u64) -> Option<String> {
+    model
+        .units_by_guid
+        .get(&guid)
+        .and_then(|u| u.name.clone())
+        .or_else(|| {
+            model
+                .units_by_lower
+                .values()
+                .find(|u| u.exists && u.guid == guid)
+                .and_then(|u| u.name.clone())
+        })
+}
+
+/// What the host's platform layer really does, declared once per VM. Each `true` defines its
+/// call; a `false` leaves it undefined, so an addon that tests for it takes its fallback.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct WindowCaps {
+    /// `FlashWindow()`: ask for the user's attention (taskbar flash, title flash in a tab).
+    pub flash: bool,
+    /// `IsWindowFocused()`: the host pushes the focus with [`super::UiScript::set_window_focused`].
+    pub focused: bool,
+    /// `FocusWindow()`: raise and focus the game window.
+    pub focus: bool,
+    /// `CopyToClipboard(text)`: write the system clipboard.
+    pub clipboard: bool,
+}
+
+/// One window request a call queued, drained by the host with
+/// [`super::UiScript::take_window_requests`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum WindowRequest {
+    Flash,
+    Focus,
+    Copy(String),
+}
+
+/// The window state the calls read and write, in the VM's app data.
+#[derive(Default)]
+struct WindowState {
+    caps: WindowCaps,
+    focused: bool,
+    requests: Vec<WindowRequest>,
+}
+
+impl super::UiScript {
+    /// Declare what the platform's window layer does and define those calls; idempotent, and a
+    /// capability once declared stays (a VM never loses a call an addon has already seen).
+    pub fn set_window_caps(&self, caps: WindowCaps) -> mlua::Result<()> {
+        let lua = self.lua();
+        let had = lua
+            .app_data_ref::<WindowState>()
+            .map(|w| w.caps)
+            .unwrap_or_default();
+        let now = WindowCaps {
+            flash: had.flash || caps.flash,
+            focused: had.focused || caps.focused,
+            focus: had.focus || caps.focus,
+            clipboard: had.clipboard || caps.clipboard,
+        };
+        if lua.app_data_ref::<WindowState>().is_none() {
+            lua.set_app_data(WindowState::default());
+        }
+        lua.app_data_mut::<WindowState>().expect("window state").caps = now;
+        let g = lua.globals();
+        fn queue(lua: &Lua, r: WindowRequest) {
+            if let Some(mut w) = lua.app_data_mut::<WindowState>() {
+                w.requests.push(r);
+            }
+        }
+        if now.flash && !had.flash {
+            g.set(
+                "FlashWindow",
+                lua.create_function(|lua, _: MultiValue| {
+                    queue(lua, WindowRequest::Flash);
+                    Ok(())
+                })?,
+            )?;
+        }
+        if now.focus && !had.focus {
+            g.set(
+                "FocusWindow",
+                lua.create_function(|lua, _: MultiValue| {
+                    queue(lua, WindowRequest::Focus);
+                    Ok(())
+                })?,
+            )?;
+        }
+        if now.focused && !had.focused {
+            g.set(
+                "IsWindowFocused",
+                lua.create_function(|lua, _: MultiValue| {
+                    let focused = lua.app_data_ref::<WindowState>().is_some_and(|w| w.focused);
+                    Ok(if focused { Value::Integer(1) } else { Value::Nil })
+                })?,
+            )?;
+        }
+        if now.clipboard && !had.clipboard {
+            g.set(
+                "CopyToClipboard",
+                lua.create_function(|lua, text: Value| {
+                    let text = super::binding_abi::string_arg(
+                        lua,
+                        text,
+                        r#"Usage: CopyToClipboard("text")"#,
+                    )?;
+                    queue(lua, WindowRequest::Copy(text));
+                    Ok(())
+                })?,
+            )?;
+        }
+        Ok(())
+    }
+
+    /// The player's own name when `guid` is the player's, from the `player` snapshot: an addon
+    /// whisper to oneself (AIO, `OVMOD`) is answered under it without a name query.
+    pub fn own_name_for(&self, guid: u64) -> Option<String> {
+        let model = self.model_ref();
+        if guid == 0 || model.unit_guids.player != guid {
+            return None;
+        }
+        model.unit("player").and_then(|u| u.name.clone())
+    }
+
+    /// Push whether the game window has the input focus, for `IsWindowFocused`.
+    pub fn set_window_focused(&self, focused: bool) {
+        let lua = self.lua();
+        if lua.app_data_ref::<WindowState>().is_none() {
+            lua.set_app_data(WindowState::default());
+        }
+        lua.app_data_mut::<WindowState>().expect("window state").focused = focused;
+    }
+
+    /// Drain the window requests the calls queued since the last drain.
+    pub fn take_window_requests(&self) -> Vec<WindowRequest> {
+        self.lua()
+            .app_data_mut::<WindowState>()
+            .map(|mut w| std::mem::take(&mut w.requests))
+            .unwrap_or_default()
+    }
+}
+
+/// An item argument as the fork documents it: an id, an `item:` string or hyperlink, or the name
+/// of a cached item.
+fn item_id_of(model: &Model, v: &Value) -> mlua::Result<Option<u32>> {
+    const USAGE: &str = r#"Usage: GetItemInfoInstant(itemID|"name"|"itemlink")"#;
+    let text = match v {
+        Value::Integer(i) => return Ok(u32::try_from(*i).ok()),
+        Value::Number(n) => return Ok((*n >= 0.0 && *n <= f64::from(u32::MAX)).then_some(*n as u32)),
+        Value::String(s) => s.to_string_lossy(),
+        _ => return Err(mlua::Error::RuntimeError(USAGE.into())),
+    };
+    let t = text.trim();
+    if let Ok(id) = t.parse::<u32>() {
+        return Ok(Some(id));
+    }
+    if let Some(at) = t.find("item:") {
+        let digits: String = t[at + 5..].chars().take_while(char::is_ascii_digit).collect();
+        return Ok(digits.parse().ok());
+    }
+    Ok(model
+        .item_templates
+        .iter()
+        .filter(|(_, v)| v.name.eq_ignore_ascii_case(t))
+        .map(|(&id, _)| id)
+        .min())
+}
+
+pub(super) fn install(lua: &Lua) -> mlua::Result<()> {
+    let g = lua.globals();
+    fn model_of(lua: &Lua) -> mlua::AppDataRef<'_, crate::script::ModelCell> {
+        lua.app_data_ref::<crate::script::ModelCell>()
+            .expect("model app_data")
+    }
+
+    // UnitTokenFromGUID(guid) -> a token naming the unit now, nil for none.
+    g.set(
+        "UnitTokenFromGUID",
+        lua.create_function(|lua, (guid, _): (Value, MultiValue)| {
+            let token = parse_guid(&guid).and_then(|g| token_from_guid(&model_of(lua), g));
+            match token {
+                Some(t) => Ok(Value::String(lua.create_string(t)?)),
+                None => Ok(Value::Nil),
+            }
+        })?,
+    )?;
+
+    // GetSpellBaseCooldown(spellId | "name") -> cooldownMs, gcdMs: `Spell.dbc`'s own cooldown
+    // (the larger of `RecoveryTime` and `CategoryRecoveryTime`) and `StartRecoveryTime`, before
+    // talents and haste; nothing for an unknown spell.
+    g.set(
+        "GetSpellBaseCooldown",
+        lua.create_function(|lua, (spell, _): (Value, MultiValue)| {
+            let model = model_of(lua);
+            let Some(info) = super::wrath_api::resolve(&model, &spell)
+                .and_then(|id| model.spell_info.as_ref()?.get(&id).cloned())
+            else {
+                return Ok(MultiValue::new());
+            };
+            Ok(MultiValue::from_vec(vec![
+                Value::Integer(info.cooldown_ms),
+                Value::Integer(info.gcd_ms),
+            ]))
+        })?,
+    )?;
+
+    // GetItemInfoInstant(item) -> itemID, itemType, itemSubType, itemEquipLoc, icon, classID,
+    // subclassID, from the cached template and never a query: an uncached item answers nothing
+    // and records the ask, so a later call (or `GetItemInfo`) finds it.
+    g.set(
+        "GetItemInfoInstant",
+        lua.create_function(|lua, (item, _): (Value, MultiValue)| {
+            let found = {
+                let model = model_of(lua);
+                let id = item_id_of(&model, &item)?;
+                id.map(|id| (id, model.item_templates.get(&id).cloned()))
+            };
+            let Some((id, view)) = found else {
+                return Ok(MultiValue::new());
+            };
+            let Some(v) = view else {
+                if id != 0 {
+                    crate::script::model_mut_of(lua).item_stat_asks.insert(id);
+                }
+                return Ok(MultiValue::new());
+            };
+            let s = |t: &str| lua.create_string(t).map(Value::String);
+            Ok(MultiValue::from_vec(vec![
+                Value::Integer(i64::from(id)),
+                s(v.item_type.as_deref().unwrap_or(""))?,
+                s(v.item_sub_type.as_deref().unwrap_or(""))?,
+                s(super::item_stats::equip_loc_token(v.inventory_type))?,
+                match &v.icon {
+                    Some(i) => s(i)?,
+                    None => Value::Nil,
+                },
+                Value::Integer(i64::from(v.class)),
+                Value::Integer(i64::from(v.subclass)),
+            ]))
+        })?,
+    )?;
+
+    // UnitOwner(unit) -> ownerName, ownerGuid: the summoner, else the charmer, else the creator;
+    // nothing for a unit with no owner. The name is nil while no snapshot names the owner.
+    g.set(
+        "UnitOwner",
+        lua.create_function(|lua, (unit, _): (Value, MultiValue)| {
+            let unit = super::binding_abi::string_arg(lua, unit, r#"Usage: UnitOwner("unit")"#)?;
+            let (owner, name) = {
+                let model = model_of(lua);
+                let Some(owner) = unit_of(&model, &unit).map(|u| u.owner).filter(|&o| o != 0)
+                else {
+                    return Ok(MultiValue::new());
+                };
+                (owner, name_of_guid(&model, owner))
+            };
+            Ok(MultiValue::from_vec(vec![
+                match name {
+                    Some(n) => Value::String(lua.create_string(n)?),
+                    None => Value::Nil,
+                },
+                Value::String(lua.create_string(guid_string(owner))?),
+            ]))
+        })?,
+    )?;
+
+    // UnitOccupations(unit) -> `UNIT_NPC_FLAGS`, the services an NPC offers (gossip 0x1, quest
+    // giver 0x2, ...); 0 for a player, nil for nobody.
+    g.set(
+        "UnitOccupations",
+        lua.create_function(|lua, (unit, _): (Value, MultiValue)| {
+            let unit =
+                super::binding_abi::string_arg(lua, unit, r#"Usage: UnitOccupations("unit")"#)?;
+            let model = model_of(lua);
+            Ok(match unit_of(&model, &unit) {
+                Some(u) => Value::Integer(i64::from(u.npc_flags)),
+                None => Value::Nil,
+            })
+        })?,
+    )?;
+
+    // UnitIsControlled(unit) / UnitIsDisarmed(unit) -> bool from `UNIT_FIELD_FLAGS`.
+    for (name, mask, usage) in [
+        (
+            "UnitIsControlled",
+            unit_flags::CONTROLLED,
+            r#"Usage: UnitIsControlled("unit")"#,
+        ),
+        (
+            "UnitIsDisarmed",
+            unit_flags::DISARMED,
+            r#"Usage: UnitIsDisarmed("unit")"#,
+        ),
+    ] {
+        g.set(
+            name,
+            lua.create_function(move |lua, (unit, _): (Value, MultiValue)| {
+                let unit = super::binding_abi::string_arg(lua, unit, usage)?;
+                let model = model_of(lua);
+                Ok(unit_of(&model, &unit).is_some_and(|u| u.flags & mask != 0))
+            })?,
+        )?;
+    }
+
+    // UnitIsSilenced: 12340's is the voice query `(name, channel)`, which answers nil with no
+    // voice session; the fork's one-argument form on a unit token reads `UNIT_FLAG_SILENCED`.
+    // A second argument, or a first that names no unit, keeps the voice answer.
+    let voice: mlua::Function = g.get("UnitIsSilenced")?;
+    g.set(
+        "UnitIsSilenced",
+        lua.create_function(move |lua, args: MultiValue| {
+            let first = args.front().cloned().unwrap_or(Value::Nil);
+            let second = args.get(1).cloned().unwrap_or(Value::Nil);
+            if second.is_nil() {
+                if let Value::String(s) = &first {
+                    let token = s.to_string_lossy();
+                    let model = model_of(lua);
+                    if model.unit_guids.guid_of(&token).is_some() {
+                        let silenced =
+                            unit_of(&model, &token).is_some_and(|u| u.flags & unit_flags::SILENCED != 0);
+                        return Ok(MultiValue::from_vec(vec![Value::Boolean(silenced)]));
+                    }
+                }
+            }
+            voice.call::<MultiValue>(args)
+        })?,
+    )?;
+    Ok(())
+}
