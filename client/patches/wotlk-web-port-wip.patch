+//! Widget methods the shipped addons call that were unbuilt: `Frame:HookScript` (the hook runs
+//! after the handler, becomes it when none is set, and stacks) and `GameTooltip:GetUnit`.
+
+use super::common::script;
+
+#[test]
+fn a_hook_runs_after_the_handler_and_stacks() {
+    let s = script();
+    s.run(
+        r#"LOG = {}
+           f = CreateFrame("Frame")
+           f:HookScript("OnEvent", function(_, e, a) table.insert(LOG, "first:" .. e .. a) end)
+           f:SetScript("OnEvent", function(_, e, a) table.insert(LOG, "handler:" .. a) end)
+           f:HookScript("OnEvent", function(_, e, a) table.insert(LOG, "hook1:" .. a) end)
+           f:HookScript("OnEvent", function(_, e, a) table.insert(LOG, "hook2:" .. a) end)
+           f:RegisterEvent("PLAYER_LOGIN")"#,
+    )
+    .unwrap();
+    s.run(r#"local h = f:GetScript("OnEvent") h(f, "PLAYER_LOGIN", "x")"#).unwrap();
+    assert_eq!(
+        s.eval::<Vec<String>>("return LOG").unwrap(),
+        ["handler:x", "hook1:x", "hook2:x"]
+    );
+    assert!(s.run(r#"f:HookScript("OnNothing", function() end)"#).is_err());
+    assert!(s.run(r#"f:HookScript("OnEvent")"#).is_err());
+}
+
+#[test]
+fn get_unit_answers_the_shown_unit_and_a_token_for_it() {
+    use crate::script::{UnitGuids, UnitState};
+    let mut s = script();
+    s.set_screen_size(800.0, 600.0);
+    const WOLF: u64 = 0xF130_0000_4500_0001;
+    s.set_unit_guids(&UnitGuids {
+        player: 0x10,
+        target: WOLF,
+        held: std::collections::HashMap::from([(0x10, WOLF), (WOLF, 0)]),
+        ..Default::default()
+    });
+    s.set_unit(
+        "target",
+        Some(UnitState {
+            exists: true,
+            guid: WOLF,
+            name: Some("Timber Wolf".into()),
+            level: 10,
+            ..Default::default()
+        }),
+    );
+    let (name, unit): (String, String) = s
+        .eval(
+            r#"local a = CreateFrame("Button", "UF1") a:SetPoint("CENTER") a:SetWidth(10) a:SetHeight(10)
+               TT = CreateFrame("GameTooltip", "TT")
+               assert(TT:GetUnit() == nil)
+               TT:SetOwner(a, "ANCHOR_RIGHT")
+               assert(TT:SetUnit("target") == 1)
+               return TT:GetUnit()"#,
+        )
+        .unwrap();
+    assert_eq!((name.as_str(), unit.as_str()), ("Timber Wolf", "target"));
+}
