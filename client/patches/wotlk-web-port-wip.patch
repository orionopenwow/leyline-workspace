@@ -0,0 +1,74 @@
+//! Seats the spell table behind `GetSpellInfo` and `GetSpellLink` into each new UI VM: one row
+//! per `Spell.dbc` record, joined with its icon, range and cast-time rows, built once per VM.
+
+use std::collections::HashMap;
+
+use bevy::prelude::*;
+use benilla_ui::script::{SpellInfo, UiScript};
+
+use crate::ui_action::Spells;
+
+pub(crate) struct UiSpellInfoPlugin;
+
+impl Plugin for UiSpellInfoPlugin {
+    fn build(&self, app: &mut App) {
+        app.add_systems(Update, seat_spell_info);
+    }
+}
+
+/// The level `GetSpellInfo`'s cast time is resolved at: a max-level caster, the realm's.
+const CASTER_LEVEL: u32 = 80;
+
+/// Power types whose DBC cost is in tenths (rage 1, runic power 6).
+fn cost_divisor(power_type: u32) -> u32 {
+    if matches!(power_type, 1 | 6) {
+        10
+    } else {
+        1
+    }
+}
+
+fn seat_spell_info(
+    script: Option<NonSend<UiScript>>,
+    spells: Option<Res<Spells>>,
+    mut memory: Local<crate::ui_script::VmMemo<bool>>,
+) {
+    let (Some(script), Some(spells)) = (script, spells) else {
+        return;
+    };
+    let seated = memory.get(&script);
+    if *seated {
+        return;
+    }
+    let mut table = HashMap::with_capacity(spells.catalog.len());
+    for (id, d) in spells.catalog.iter() {
+        let (min_range, max_range) = spells
+            .ranges
+            .get(d.range_index)
+            .map_or((0.0, 0.0), |r| r.pair(false));
+        let cast_ms = spells
+            .cast_times
+            .get(d.casting_time_index)
+            .map_or(0, |row| row.resolved_ms(CASTER_LEVEL, d.base_level));
+        table.insert(
+            id,
+            SpellInfo {
+                name: d.name.clone(),
+                rank: d.rank.clone().unwrap_or_default(),
+                icon: d.icon.clone(),
+                cost: i64::from(d.mana_cost / cost_divisor(d.power_type)),
+                funnel: false,
+                power_type: i64::from(d.power_type),
+                cast_ms: i64::from(cast_ms.max(0)),
+                min_range: f64::from(min_range),
+                max_range: f64::from(max_range),
+                // `GetSpellBaseCooldown`: the unmodified DBC cooldowns.
+                cooldown_ms: i64::from(d.recovery_ms.max(d.category_recovery_ms)),
+                gcd_ms: i64::from(d.start_recovery_ms),
+            },
+        );
+    }
+    debug!("ui_spell_info: {} spells seated for GetSpellInfo", table.len());
+    script.set_spell_info(table);
+    *seated = true;
+}
