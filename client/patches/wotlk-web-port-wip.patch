+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The halving case leaves the animation frame (33.3 ms reads), and the loop comes back only
+    /// once frames are well inside a vblank; between the two thresholds it stays put.
+    #[test]
+    fn slow_browser_frames_leave_the_animation_frame_with_hysteresis() {
+        use WebPacing::*;
+        assert_eq!(web_pacing(AnimationFrame, 16.7), AnimationFrame);
+        assert_eq!(web_pacing(AnimationFrame, 33.3), FreeRun, "the 30 fps halving");
+        assert_eq!(web_pacing(FreeRun, 20.0), FreeRun, "~50 fps of 20 ms frames keeps running");
+        assert_eq!(web_pacing(FreeRun, 16.0), FreeRun, "inside the band: no flapping");
+        assert_eq!(web_pacing(FreeRun, 10.0), AnimationFrame);
+        assert_eq!(web_pacing(AnimationFrame, 17.0), AnimationFrame);
+        match free_run_mode() {
+            UpdateMode::Reactive { wait, .. } => assert_eq!(wait, Duration::ZERO),
+            UpdateMode::Continuous => panic!("free run is a zero-wait reactive loop"),
+        }
+    }
+
+    /// The pane case: the page is visible but no window reads focused. Free-running is wanted by
+    /// visibility alone, and it must land in `unfocused_mode` too, the mode bevy runs unfocused.
+    #[test]
+    fn an_unfocused_visible_pane_free_runs_in_both_modes() {
+        use WebPacing::*;
+        let cap = FrameCap::default();
+        assert_eq!(pacing_wanted(AnimationFrame, 33.3, 0, true), FreeRun);
+        assert_eq!(pacing_wanted(AnimationFrame, 33.3, 0, false), AnimationFrame, "hidden tab");
+        assert_eq!(pacing_wanted(FreeRun, 33.3, 0, false), AnimationFrame);
+        assert_eq!(pacing_wanted(AnimationFrame, 33.3, 60, true), AnimationFrame, "a cap rules");
+        let free = pacing_settings(FreeRun, cap);
+        for (focused, mode) in [(true, free.focused_mode), (false, free.unfocused_mode)] {
+            assert_eq!(free.update_mode(focused), mode);
+            match mode {
+                UpdateMode::Reactive { wait, .. } => assert_eq!(wait, Duration::ZERO),
+                UpdateMode::Continuous => panic!("free run is a zero-wait reactive loop"),
+            }
+        }
+        let back = pacing_settings(AnimationFrame, cap);
+        let shipped = winit_settings(cap);
+        assert_eq!(
+            (back.focused_mode, back.unfocused_mode),
+            (shipped.focused_mode, shipped.unfocused_mode),
+            "back on the animation frame, the caps' own loop returns"
+        );
+        assert_eq!(FreeRun.label(), "free-run");
+    }
+
+    #[test]
+    fn the_default_caps_are_the_loop_bevy_already_ran() {
+        let shipped = winit_settings(FrameCap::default());
+        let game = WinitSettings::game();
+        assert_eq!(shipped.focused_mode, game.focused_mode);
+        assert_eq!(shipped.unfocused_mode, game.unfocused_mode);
+    }
+
+    #[test]
+    fn a_cap_wakes_on_its_timer_alone_in_front() {
+        match update_mode(144, false) {
+            UpdateMode::Reactive {
+                wait,
+                react_to_device_events,
+                react_to_user_events,
+                react_to_window_events,
+            } => {
+                assert!((wait.as_secs_f64() - 1.0 / 144.0).abs() < 1e-9);
+                assert!(
+                    !react_to_device_events && !react_to_user_events && !react_to_window_events
+                );
+            }
+            UpdateMode::Continuous => panic!("a cap is not continuous"),
+        }
+        assert_eq!(update_mode(0, false), UpdateMode::Continuous);
+        assert_eq!(update_mode(0, true), UpdateMode::Continuous);
+        assert_eq!(
+            update_mode(30, true),
+            UpdateMode::reactive_low_power(Duration::from_secs_f64(1.0 / 30.0))
+        );
+    }
+
+    #[test]
+    fn a_cap_value_is_zero_or_inside_the_bounds() {
+        assert_eq!(cap_fps(0.0), 0);
+        assert_eq!(cap_fps(-5.0), 0);
+        assert_eq!(cap_fps(f32::NAN), 0);
+        assert_eq!(cap_fps(0.5), 0);
+        assert_eq!(cap_fps(1.0), MIN_CAP_FPS);
+        assert_eq!(cap_fps(143.6), 144);
+        assert_eq!(cap_fps(240.0), 240);
+        assert_eq!(cap_fps(1.0e9), MAX_CAP_FPS);
+    }
+
+    /// The VM's `GetCVarMin`/`GetCVarMax` for `farclip`, which the stock View Distance slider spans,
+    /// are the engine's own clamp.
+    #[test]
+    fn the_vm_range_verbs_and_the_engine_clamp_agree() {
+        let s = benilla_ui::script::UiScript::new().unwrap();
+        s.register_cvars(crate::cvars::registered_pairs());
+        let (lo, hi): (f32, f32) = s
