+    }
+
+    /// The Graphics+ page joins the stock Video Options window's category list, opens on the live
+    /// values, writes only what moved on Okay, and Defaults puts back the registered defaults.
+    #[test]
+    fn the_graphics_page_stages_and_writes_its_cvars() {
+        let mut s = benilla_ui::script::UiScript::new().unwrap();
+        s.register_cvars(crate::cvars::registered_pairs());
+        // The stock window's registrar, as `OptionsFrameTemplates.lua` defines it.
+        s.run(
+            r#"VideoOptionsFrame = CreateFrame("Frame", "VideoOptionsFrame")
+               VideoOptionsFrame.categoryList = {}
+               function OptionsFrame_AddCategory(frame, panel)
+                   table.insert(frame.categoryList, panel)
+               end"#,
+        )
+        .unwrap();
+        crate::ui_script::load_ui_for_test(&s, "FrameXMLFixes.xml");
+        let (n, name): (i64, String) = s
+            .eval("return #VideoOptionsFrame.categoryList, VideoOptionsFrame.categoryList[1].name")
+            .unwrap();
+        assert_eq!((n, name.as_str()), (1, "Graphics+"));
+        s.run("BenillaGraphicsPlusPanel:refresh()").unwrap();
+        let fov: f64 = s
+            .eval("return BenillaGraphicsPlusSlider1:GetValue()")
+            .unwrap();
+        assert_eq!(fov, 90.0, "opens on the live value");
+        let _ = s.take_cvar_changes();
+        s.run(
+            "BenillaGraphicsPlusSlider1:SetValue(120)              BenillaGraphicsPlusCheck1:SetChecked(1)              BenillaGraphicsPlusPanel:okay()",
+        )
+        .unwrap();
+        assert_eq!(s.cvar("cameraFov").as_deref(), Some("120"));
+        assert_eq!(s.cvar("darkerNights").as_deref(), Some("1"));
+        let changes = s.take_cvar_changes();
+        assert_eq!(changes.len(), 2, "only what moved is written: {changes:?}");
+        s.run("BenillaGraphicsPlusPanel:default()").unwrap();
+        assert_eq!(s.cvar("cameraFov").as_deref(), Some("90"));
+        assert_eq!(s.cvar("darkerNights").as_deref(), Some("0"));
+        let errors = s.take_errors();
+        assert!(errors.is_empty(), "{errors:?}");
+    }
+
+    /// The rows reach their knobs, clamped, and the defaults are the knobs' own.
+    #[test]
+    fn the_rows_reach_their_knobs() {
+        let mut app = App::new();
+        app.add_plugins(bevy::MinimalPlugins)
+            .add_plugins(GraphicsPlusPlugin)
+            .insert_resource(WinitSettings::game());
+        let row = |name: &str| {
+            crate::cvars::registered_rows()
+                .find(|r| r.name == name)
+                .unwrap_or_else(|| panic!("{name} registered"))
+                .default
+                .parse::<f32>()
+                .unwrap()
+        };
+        assert_eq!(row("cameraFov"), CameraFov::default().degrees);
+        assert_eq!(row("casSharpness"), PostGrade::NEUTRAL.sharpness);
+        assert_eq!(row("colorContrast"), PostGrade::NEUTRAL.contrast);
+        assert_eq!(row("colorSaturation"), PostGrade::NEUTRAL.saturation);
+        assert_eq!(row("colorVibrance"), PostGrade::NEUTRAL.vibrance);
+        assert_eq!(row("darkerNights") != 0.0, DarkerNights::default().enabled);
+        assert_eq!(row("maxFPS") as u32, FrameCap::default().foreground);
+        assert_eq!(row("maxFPSBk") as u32, FrameCap::default().background);
+
+        let mut set = |name: &str, value: &str| {
+            app.world_mut().trigger(crate::cvars::CvarChanged {
+                name: name.into(),
+                old: String::new(),
+                new: value.into(),
+            });
+            app.update();
+        };
+        set("cameraFov", "200");
+        set("casSharpness", "0.3");
+        set("colorSaturation", "1.2");
+        set("darkerNights", "1");
+        set("maxFPS", "144");
+        set("maxFPSBk", "0");
+        set("farclip", "5000");
+        let w = app.world();
+        assert_eq!(
+            w.resource::<CameraFov>().degrees,
+            150.0,
+            "same range everywhere"
+        );
+        assert_eq!(w.resource::<PostGrade>().sharpness, 0.3);
+        assert_eq!(w.resource::<PostGrade>().saturation, 1.2);
+        assert!(w.resource::<DarkerNights>().enabled);
+        assert_eq!(
+            *w.resource::<FrameCap>(),
+            FrameCap {
+                foreground: 144,
+                background: 0
+            }
+        );
+        assert_eq!(w.resource::<FarclipRequest>().0, *FARCLIP_RANGE.end());
+        let settings = w.resource::<WinitSettings>();
+        assert_eq!(settings.focused_mode, update_mode(144, false));
+        assert_eq!(settings.unfocused_mode, UpdateMode::Continuous);
+    }
+}
