+/// The golf camera: a hole fly-over, then behind the ball along the aim, then after the roll.
+fn golf_camera(mut golf: ResMut<Golf>, time: Res<Time>, mut cams: Query<&mut Transform, With<FlyCam>>) {
+    if !golf.active() {
+        return;
+    }
+    let Some(hole) = golf.hole().cloned() else {
+        return;
+    };
+    let now = time.elapsed_secs();
+    let dt = time.delta_secs().min(0.1);
+    let mut want: Option<(Vec3, Vec3, f32)> = None; // eye, look at, follow rate
+    if let Some(t0) = golf.flyover {
+        let u = ((now - t0) / FLYOVER_SECS).clamp(0.0, 1.0);
+        if u >= 1.0 {
+            golf.flyover = None;
+        } else {
+            let e = u * u * (3.0 - 2.0 * u);
+            let cup = golf.world(hole.cup);
+            let tee = golf.world(hole.tee);
+            let back = golf.world_dir(V3::new(0.0, 0.0, -1.0));
+            let from = cup + Vec3::Y * 9.0 + back * -3.0;
+            let to = tee + back * 5.0 + Vec3::Y * 3.2;
+            let eye = from.lerp(to, e);
+            let look = cup.lerp(tee + (cup - tee) * 0.4, e);
+            want = Some((eye, look, 30.0));
+        }
+    }
+    if let Some(roll) = &golf.roll {
+        let f = ((now - roll.start) * golf::TICK_HZ as f32) as usize;
+        let frames = &roll.outcome.frames;
+        let p = golf.world(frames[f.min(frames.len() - 1)]);
+        let start = golf.world(frames[0]);
+        let mut dir = p - start;
+        dir.y = 0.0;
+        let dir = if dir.length() > 0.5 { dir.normalize() } else { golf.world_dir(V3::new(0.0, 0.0, 1.0)) };
+        let eye = p - dir * 4.2 * golf.zoom + Vec3::Y * 2.4 * golf.zoom;
+        want = Some((eye, p, 3.5));
+    } else if let (None, Some(aim)) = (golf.flyover, &golf.aim) {
+        if let Some(ball) = golf.balls.get(&aim.name) {
+            let p = golf.world(ball.pos);
+            let (s, c) = benilla_mode::detmath::sin_cos_tenths(aim.angle.round() as i32);
+            let dir = golf.world_dir(V3::new(s, 0.0, c));
+            let eye = p - dir * 3.4 * golf.zoom + Vec3::Y * 1.55 * golf.zoom;
+            want = Some((eye, p + dir * 2.0, 9.0));
+        }
+    }
+    let Some((eye, look, rate)) = want else {
+        golf.cam = None;
+        return;
+    };
+    let target = Transform::from_translation(eye).looking_at(look, Vec3::Y);
+    let k = 1.0 - (-rate * dt).exp();
+    let smooth = match golf.cam {
+        Some(c) => Transform {
+            translation: c.translation.lerp(target.translation, k),
+            rotation: c.rotation.slerp(target.rotation, k),
+            ..target
+        },
+        None => target,
+    };
+    golf.cam = Some(smooth);
+    if let Ok(mut t) = cams.single_mut() {
+        t.translation = smooth.translation;
+        t.rotation = smooth.rotation;
+    }
+}
