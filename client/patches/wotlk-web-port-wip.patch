+/// Dalaran's streets (map 571): the city floats over Crystalsong Forest, whose terrain tiles are
+/// all the outdoor minimap has, and its groups are exterior, so the indoor gate never opens.
+/// Deviation, as the later clients draw it: inside the city's box and above [`DALARAN_FLOOR_Z`],
+/// the minimap shows the city WMO's own tiles, every group that has them.
+const DALARAN_MAP: u32 = 571;
+const DALARAN_CENTRE: [f32; 2] = [5804.0, 625.0];
+const DALARAN_RADIUS_YD: f32 = 420.0;
+const DALARAN_FLOOR_Z: f32 = 450.0;
+
+/// Whether a WoW-space point is in the Dalaran box: map 571, within the radius, above the floor.
+pub(crate) fn in_dalaran_box(map_id: Option<u32>, wow: [f32; 3]) -> bool {
+    map_id == Some(DALARAN_MAP)
+        && wow[2] > DALARAN_FLOOR_Z
+        && (wow[0] - DALARAN_CENTRE[0]).hypot(wow[1] - DALARAN_CENTRE[1]) <= DALARAN_RADIUS_YD
