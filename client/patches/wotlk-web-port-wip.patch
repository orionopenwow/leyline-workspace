+fn log_key_swallow(script: &UiScript, key: &str) {
+    static SEEN: std::sync::Mutex<Vec<String>> = std::sync::Mutex::new(Vec::new());
+    let Some(frame) = script.last_key_frame() else {
+        return;
+    };
+    let mut seen = SEEN.lock().unwrap_or_else(|e| e.into_inner());
+    if !seen.contains(&frame) {
+        info!("ui: keyboard frame {frame} took the key {key} (its OnKeyDown runs, no binding fires)");
+        seen.push(frame);
+    }
+}
