index 00000000..6b88caee
--- /dev/null
+++ b/crates/wenilla-host/src/data.rs
@@ -0,0 +1,713 @@
+//! `GET`/`HEAD /data/{*name}` and `GET /data/__index` — the Data URL scheme Lane A's wasm
+//! `Chain` fetches against verbatim (see the plan's "Shared interfaces"): the browser build has
+//! no filesystem, so every asset load the client makes becomes one of these requests, answered
+//! straight from the same [`Chain`] the native client reads off disk.
+//!
+//! The name in the URL is percent-decoded here, not left to axum's own path-segment decoding —
+//! `Chain` names use `\` as their separator (`Interface\Glues\...`), and the wildcard capture
+//! would otherwise hand us a single decoded segment with no way to tell an encoded `/` (a literal
+//! path separator in some other scheme) apart from an encoded `\`. Decoding the raw tail
+//! ourselves and mapping `/` -> `\` afterward matches exactly what the client's `encode_name`
+//! produces on the way out.
+
+use std::sync::Arc;
+
+use axum::body::Bytes;
+use axum::extract::State;
+use axum::http::{header, HeaderName, HeaderValue, Method, StatusCode, Uri};
+use axum::response::{IntoResponse, Response};
+use axum::routing::get;
+use axum::Router;
+use benilla_formats::Chain;
+use tokio::sync::OnceCell;
+use tower_http::compression::predicate::{DefaultPredicate, NotForContentType, Predicate};
+use tower_http::compression::CompressionLayer;
+use tower_http::set_header::SetResponseHeaderLayer;
+
+/// Router state: the opened patch chain. `Chain::read`/`list` are `&self` and lock-free (see the
+/// chain module doc). The serialized index is shared across requests for this mounted chain.
+#[derive(Clone)]
+pub struct DataState {
+    /// `None` only for a slice host (`--only-listed` with no `--data`): no archives at all.
+    pub chain: Option<Arc<Chain>>,
+    index: Arc<IndexCache>,
+    /// `--only-listed`: answer only names present in the patch folder; the chain and the loose
+    /// folder are never consulted, so a box holding just a slice cannot fall back to anything.
+    only_listed: bool,
+    /// `--record`: every name served (200, GET or HEAD) is appended to a manifest, once.
+    record: Option<Arc<Recorder>>,
+    /// The player's own loose `Interface` folder beside `Data` (addons, addon art), served under
+    /// `Interface\...` names when the chain lacks them, as the desktop client reads them off disk.
+    loose: Option<Arc<std::path::PathBuf>>,
+    /// A patch folder laid OVER the chain: any game file placed there (a DBC, a texture, a
+    /// FrameXML file, at its chain path) is served instead of the archive's copy. The way to edit
+    /// the client's data without building MPQs.
+    patch: Option<Arc<std::path::PathBuf>>,
+}
+
+/// Single-flight initialization; transient list errors are retried on the next request.
+#[derive(Default)]
+struct IndexCache(Arc<OnceCell<Bytes>>);
+
+impl IndexCache {
+    async fn get(
+        &self,
+        build: impl FnOnce() -> anyhow::Result<Vec<u8>> + Send + 'static,
+    ) -> anyhow::Result<Bytes> {
+        if let Some(bytes) = self.0.get() {
+            return Ok(bytes.clone());
+        }
+        let cell = Arc::clone(&self.0);
+        // The initializer owns the cell independently of this request. Dropping a request
+        // cannot cancel spawn_blocking, so keep its result and single-flight guard alive too.
+        tokio::spawn(async move {
+            cell.get_or_try_init(|| async move {
+                tokio::task::spawn_blocking(build).await?.map(Bytes::from)
+            })
+            .await
+            .cloned()
+        })
+        .await?
+    }
+}
+
+/// Build the `/data/*` router. Kept separate from `static_site`'s and `ws`'s so `main.rs` can
+/// merge them with `Router::merge` and each test file can stand its half up alone.
+pub fn router(chain: Arc<Chain>) -> Router {
+    router_with_loose(chain, None)
+}
+
+/// [`router`] plus a loose `Interface` folder (the player's own `Interface\AddOns` and addon art)
+/// layered under the chain: a name the chain lacks is looked up there, and the index lists it.
+pub fn router_with_loose(chain: Arc<Chain>, loose: Option<std::path::PathBuf>) -> Router {
+    router_with_layers(chain, loose, None)
+}
+
+/// [`router_with_loose`] plus a patch folder served before the chain ([`DataState::patch`]).
+pub fn router_with_layers(
+    chain: Arc<Chain>,
+    loose: Option<std::path::PathBuf>,
+    patch: Option<std::path::PathBuf>,
+) -> Router {
+    router_with_config(DataConfig {
+        chain: Some(chain),
+        loose,
+        patch,
+        ..DataConfig::default()
+    })
+}
+
+/// Everything the `/data` router can be built from ([`router_with_config`]).
+#[derive(Default)]
+pub struct DataConfig {
+    /// The MPQ chain; `None` is only meaningful with `only_listed`.
+    pub chain: Option<Arc<Chain>>,
+    /// The player's loose `Interface` folder (see [`DataState::loose`]).
+    pub loose: Option<std::path::PathBuf>,
+    /// The patch folder laid over the chain (see [`DataState::patch`]).
+    pub patch: Option<std::path::PathBuf>,
+    /// Serve the patch folder and nothing else (see [`DataState::only_listed`]).
+    pub only_listed: bool,
+    /// Append each served name to this manifest (see [`Recorder`]).
+    pub record: Option<Arc<Recorder>>,
+}
+
+/// The `/data/*` router from a full [`DataConfig`].
+pub fn router_with_config(cfg: DataConfig) -> Router {
+    let DataConfig {
+        chain,
+        loose,
+        patch,
+        only_listed,
+        record,
+    } = cfg;
+    Router::new()
+        .route("/data/__index", get(index))
+        // A slice's per-tier file lists (`--export` writes them to `<patch>/.tiers/`), for the
+        // browser's "Download this section". Behind the same gate as the rest of /data.
+        .route("/data/__tier/{file}", get(tier_list))
+        // axum's matchit picks the more specific literal route above over this wildcard on its
+        // own — registration order here doesn't matter.
+        .route("/data/{*name}", get(file).head(file))
+        // On the fly, not precompressed like `static_site`'s: that route serves the handful of
+        // files `web-build.sh` writes and can pay brotli once at build time, while this one
+        // serves an arbitrary slice of a 5 GB install nobody can enumerate ahead of time.
+        // What keeps the cost sane is the predicate, not the level — see [`content_type`].
+        .layer(CompressionLayer::new().compress_when(compressible()))
+        // COEP `require-corp` on the document (see `static_site`) makes every subresource prove
+        // it consents to being embedded. Same-origin responses pass that check without a header,
+        // and today `/data` is always same-origin with the page — this is the belt to that
+        // braces, so an operator who ever fronts the two from different origins gets a
+        // recognisable failure instead of a world that loads with holes in it.
+        .layer(SetResponseHeaderLayer::overriding(
+            HeaderName::from_static("cross-origin-resource-policy"),
+            HeaderValue::from_static("same-origin"),
+        ))
+        .with_state(DataState {
+            chain,
+            index: Arc::default(),
+            only_listed,
+            record,
+            loose: loose.map(Arc::new),
+            patch: patch.map(Arc::new),
+        })
+}
+
+/// The manifest `--record` writes: one chain name per line, appended the first time each name is
+/// served, flushed per line so a capture session that is killed keeps everything it saw. Names
+/// already in the file (an earlier session) are not written again; the comparison is the MPQ
+/// one, any case and `/` = `\`, because the client asks for one file under several spellings.
+pub struct Recorder {
+    state: std::sync::Mutex<(std::collections::HashSet<String>, std::fs::File)>,
+}
+
+/// The key two spellings of one chain name share.
+pub fn name_key(name: &str) -> String {
+    name.replace('/', "\\").to_ascii_lowercase()
+}
+
+impl Recorder {
+    /// Open (or create) `path` for appending, remembering the names it already holds.
+    pub fn open(path: &std::path::Path) -> anyhow::Result<Self> {
+        use anyhow::Context;
+        let mut seen = std::collections::HashSet::new();
+        if let Ok(text) = std::fs::read_to_string(path) {
+            for line in text.lines() {
+                let line = line.trim();
+                if !line.is_empty() && !line.starts_with('#') {
+                    seen.insert(name_key(line));
+                }
+            }
+        }
+        let file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+            .with_context(|| format!("opening {} to record into", path.display()))?;
+        Ok(Self {
+            state: std::sync::Mutex::new((seen, file)),
+        })
+    }
+
+    /// Record one served name; `true` when it was new.
+    pub fn note(&self, name: &str) -> bool {
+        use std::io::Write;
+        let mut guard = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let (seen, file) = &mut *guard;
+        if !seen.insert(name_key(name)) {
+            return false;
+        }
+        if let Err(e) = writeln!(file, "{name}").and_then(|_| file.flush()) {
+            tracing::error!(error = %e, "could not append to the record manifest");
+        }
+        true
+    }
+}
+
+/// Read one chain name through the layers, the way `GET /data/{name}` does: the patch folder
+/// first, then the chain, then the loose `Interface` folder; with `only_listed`, the patch folder
+/// alone. `Ok((bytes, editable))`, or an error [`is_missing`] recognises for "no such file".
+/// Shared with `--export`, so a slice holds exactly the bytes the capture session was served.
+pub fn read_layered(
+    chain: Option<&Chain>,
+    loose: Option<&std::path::Path>,
+    patch: Option<&std::path::Path>,
+    only_listed: bool,
+    name: &str,
+) -> anyhow::Result<(Vec<u8>, bool)> {
+    // `true` = a file the player edits on disk (patch or loose): never cached as immutable.
+    if let Some(path) = patch.and_then(|r| patch_file(r, name)) {
+        return std::fs::read(path).map(|b| (b, true)).map_err(anyhow::Error::from);
+    }
+    let missing = || anyhow::anyhow!("file not in patch chain: {name}");
+    if only_listed {
+        return Err(missing());
+    }
+    let from_chain = match chain {
+        Some(c) => c.read(name),
+        None => Err(missing()),
+    };
+    match from_chain {
+        Err(e) if is_missing(&e) => match loose.and_then(|r| loose_file(r, name)) {
+            Some(path) => std::fs::read(path).map(|b| (b, true)).map_err(anyhow::Error::from),
+            None => Err(e),
+        },
+        other => other.map(|b| (b, false)),
+    }
+}
+
+/// Which bodies are worth compressing, as a value rather than inline in [`router`] so the tests
+/// can put the real predicate behind a stub handler — otherwise it could only be exercised
+/// against a chain, and every assertion about it would skip on a box with no game install.
+///
+/// `DefaultPredicate` already contributes the size floor and skips `image/*`; naming
+/// `NotForContentType::IMAGES` again keeps the BLP half of [`content_type`]'s contract visible
+/// where the decision is made, and `audio/mpeg` is the one family it does not cover.
+fn compressible() -> impl Predicate {
+    DefaultPredicate::new()
+        .and(NotForContentType::IMAGES)
+        .and(NotForContentType::const_new("audio/mpeg"))
+}
+
+/// The `Content-Type` for a chain name — chosen for what it tells the compression predicate,
+/// not for the browser, which never looks (the wasm `Chain` reads bytes and parses them by
+/// signature).
+///
+/// The chain hands us *inflated* bytes: `Chain::read` has already undone the MPQ's own zlib, so
+/// a DBC or an ADT arrives here as the raw structured form and compresses like one. Two families
+/// do not, and they are most of the volume:
+///
+/// - **BLP** — the texels are DXT blocks (or a palette + indices). Already compressed; brotli
+///   spends CPU to add bytes. `image/x-blp` puts them in the family `DefaultPredicate` skips.
+/// - **MP3** — likewise, and audio is *not* in that default skip set, so it needs naming.
+///
+/// Anything else falls through to `application/octet-stream` and gets compressed. That is the
+/// right default: the unlisted formats are DBC, ADT, WDT, WDL, M2, WMO and the FrameXML `.lua`
+/// / `.xml` / `.toc` text, and every one of them is structured and redundant. A `.wav` lands
+/// here too, deliberately — vanilla's are uncompressed PCM.
+fn content_type(name: &str) -> &'static str {
+    let ext = name.rsplit('.').next().unwrap_or_default();
+    if ext.eq_ignore_ascii_case("blp") {
+        "image/x-blp"
+    } else if ext.eq_ignore_ascii_case("mp3") {
+        "audio/mpeg"
+    } else {
+        "application/octet-stream"
+    }
+}
+
+/// A chain-read failure that means "this path doesn't exist in the composite" — the two shapes
+/// `Chain::read` produces for a missing file (never mounted at all, or tombstoned by a patch) —
+/// as opposed to a real I/O fault reading a corrupt archive, which is a 500, not a 404.
+pub fn is_missing(err: &anyhow::Error) -> bool {
+    let msg = err.to_string();
+    msg.contains("not in patch chain") || msg.contains("deleted from patch chain")
+}
+
+async fn file(method: Method, uri: Uri, State(state): State<DataState>) -> Response {
+    let raw = uri.path().strip_prefix("/data/").unwrap_or("");
+    let decoded = percent_encoding::percent_decode_str(raw).decode_utf8_lossy();
+    let name = decoded.replace('/', "\\");
+    // Before the move into `spawn_blocking` — the classification is pure string math on the
+    // name and yields a `&'static str`, so it costs nothing to take it out of the task's way.
+    let content_type = content_type(&name);
+
+    let chain = state.chain.clone();
+    let loose = state.loose.clone();
+    let patch = state.patch.clone();
+    let only_listed = state.only_listed;
+    let record = state.record.clone();
+    // `Chain::read` does synchronous file I/O (through benilla-mpq's blocking reads); running it
+    // on the async runtime thread would stall every other in-flight request behind one disk seek.
+    let read = tokio::task::spawn_blocking(move || {
+        let got = read_layered(
+            chain.as_deref(),
+            loose.as_deref().map(|p| p.as_path()),
+            patch.as_deref().map(|p| p.as_path()),
+            only_listed,
+            &name,
+        );
+        if let (Ok(_), Some(r)) = (&got, &record) {
+            r.note(&name);
+        }
+        got
+    })
+    .await;
+    match read {
+        Ok(Ok((bytes, editable))) => {
+            let body = if method == Method::HEAD {
+                Vec::new()
+            } else {
+                bytes
+            };
+            (
+                StatusCode::OK,
+                [
+                    (header::CONTENT_TYPE, content_type),
+                    // `private`: the bytes are the operator's game files — cacheable by the player's
+                    // browser (they never change under one name), never by a shared cache.
+                    (
+                        header::CACHE_CONTROL,
+                        if editable {
+                            "no-cache"
+                        } else {
+                            "private, max-age=31536000, immutable"
+                        },
+                    ),
+                ],
+                body,
+            )
+                .into_response()
+        }
+        Ok(Err(e)) if is_missing(&e) => StatusCode::NOT_FOUND.into_response(),
+        Ok(Err(e)) => {
+            tracing::error!(error = %e, "chain read failed");
+            StatusCode::INTERNAL_SERVER_ERROR.into_response()
+        }
+        Err(join_err) => {
+            tracing::error!(error = %join_err, "chain read task panicked");
+            StatusCode::INTERNAL_SERVER_ERROR.into_response()
+        }
+    }
+}
+
+/// `GET /data/__tier/{n}.txt` and `/data/__tier/index.json`: the slice's per-tier file lists from
+/// `<patch>/.tiers/` (written by `--export`). 404 without a patch folder or for any other name.
+async fn tier_list(
+    axum::extract::Path(file): axum::extract::Path<String>,
+    State(state): State<DataState>,
+) -> Response {
+    let ok_name = file == "index.json"
+        || file
+            .strip_suffix(".txt")
+            .is_some_and(|n| !n.is_empty() && n.len() <= 3 && n.bytes().all(|b| b.is_ascii_digit()));
+    let Some(root) = state.patch.clone().filter(|_| ok_name) else {
+        return StatusCode::NOT_FOUND.into_response();
+    };
+    let path = root.join(".tiers").join(&file);
+    match tokio::task::spawn_blocking(move || std::fs::read(path)).await {
+        Ok(Ok(bytes)) => (
+            [
+                // `no-cache`: a new slice upload changes the lists under the same names.
+                (header::CACHE_CONTROL, "no-cache"),
+                (
+                    header::CONTENT_TYPE,
+                    if file.ends_with(".json") { "application/json" } else { "text/plain; charset=utf-8" },
+                ),
+            ],
+            bytes,
+        )
+            .into_response(),
+        _ => StatusCode::NOT_FOUND.into_response(),
+    }
+}
+
+/// `GET /data/__index` — every name [`Chain::list`] can enumerate, for the wasm `Chain::list`
+/// (Lane A) to mirror the native directory walk it can't do in a browser.
+async fn index(State(state): State<DataState>) -> Response {
+    let chain = state.chain.clone();
+    let loose = state.loose.clone();
+    let patch = state.patch.clone();
+    let only_listed = state.only_listed;
+    let listed = state
+        .index
+        .get(move || {
+            let mut names: Vec<String> = Vec::new();
+            if !only_listed {
+                if let Some(chain) = chain.as_deref() {
+                    names.extend(chain.list()?.into_iter().map(|e| e.name));
+                }
+                if let Some(root) = loose.as_deref() {
+                    loose_names(root, "Interface", &mut names);
+                }
+            }
+            if let Some(root) = patch.as_deref() {
+                let mut extra = Vec::new();
+                loose_names(root, "", &mut extra);
+                names.extend(extra.into_iter().map(|n| n.trim_start_matches('\\').to_string()));
+            }
+            Ok(serde_json::to_vec(&names)?)
+        })
+        .await;
+    match listed {
+        Ok(bytes) => (
+            [
+                // `no-cache`: the list changes when the player adds an addon, and a stale copy hides it.
+                (header::CACHE_CONTROL, "no-cache"),
+                (header::CONTENT_TYPE, "application/json"),
+            ],
+            bytes,
+        )
+            .into_response(),
+        Err(e) => {
+            tracing::error!(error = %e, "chain index initialization failed");
+            StatusCode::INTERNAL_SERVER_ERROR.into_response()
+        }
+    }
+}
+
+/// Map a chain-style `Interface\...` name onto a file under the loose `Interface` root, each
+/// component matched case-insensitively as on Windows. Any other prefix, an empty or dot
+/// component, is refused, so a request cannot leave the folder.
+fn loose_file(root: &std::path::Path, name: &str) -> Option<std::path::PathBuf> {
+    let (head, rest) = name.split_once('\\')?;
+    if !head.eq_ignore_ascii_case("interface") {
+        return None;
+    }
+    let mut at = root.to_path_buf();
+    for comp in rest.split('\\') {
+        if comp.is_empty() || comp.starts_with('.') {
+            return None;
+        }
+        let direct = at.join(comp);
+        at = if direct.exists() {
+            direct
+        } else {
+            std::fs::read_dir(&at).ok()?.flatten().find(|e| {
+                e.file_name().to_str().is_some_and(|n| n.eq_ignore_ascii_case(comp))
+            })?.path()
+        };
+    }
+    at.is_file().then_some(at)
+}
+
+/// Map any chain name onto a file under the patch root, each component matched
+/// case-insensitively; empty or dot components refused.
+fn patch_file(root: &std::path::Path, name: &str) -> Option<std::path::PathBuf> {
+    let mut at = root.to_path_buf();
+    for comp in name.split('\\') {
+        if comp.is_empty() || comp.starts_with('.') {
+            return None;
+        }
+        let direct = at.join(comp);
+        at = if direct.exists() {
+            direct
+        } else {
+            std::fs::read_dir(&at).ok()?.flatten().find(|e| {
+                e.file_name().to_str().is_some_and(|n| n.eq_ignore_ascii_case(comp))
+            })?.path()
+        };
+    }
+    at.is_file().then_some(at)
+}
+
+/// Every file under `dir`, as `prefix\rel\path` chain names, for the index.
+fn loose_names(dir: &std::path::Path, prefix: &str, out: &mut Vec<String>) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for e in entries.flatten() {
+        let Some(n) = e.file_name().to_str().map(str::to_owned) else {
+            continue;
+        };
+        if n.starts_with('.') {
+            continue;
+        }
+        let name = format!("{prefix}\\{n}");
+        let path = e.path();
+        if path.is_dir() {
+            loose_names(&path, &name, out);
+        } else if path.is_file() {
+            out.push(name);
+        }
+    }
+}
