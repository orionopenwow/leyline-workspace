+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[derive(Resource, Default)]
+    struct Order(Vec<&'static str>);
+
+    fn load_a(mut o: ResMut<Order>) {
+        o.0.push("a");
+    }
+    fn load_b(mut o: ResMut<Order>) {
+        o.0.push("b");
+    }
+
+    fn app(defer: bool) -> App {
+        let mut app = App::new();
+        app.add_plugins(MinimalPlugins)
+            .init_resource::<Order>()
+            .init_resource::<DeferredLoads>()
+            .add_systems(PreUpdate, run_deferred_loads);
+        add_deferred_load_with(&mut app, "a", load_a, defer);
+        add_deferred_load_with(&mut app, "b", load_b, defer);
+        app
+    }
+
+    /// Deferred, nothing runs before the first glue screen's frames; then the queue runs in
+    /// registration order and every loader runs once.
+    #[test]
+    fn deferred_loads_wait_for_the_first_frames_then_run_in_order_once() {
+        let mut app = app(true);
+        for _ in 0..FRAMES_BEFORE_DEFERRED {
+            app.update();
+            assert!(app.world().resource::<Order>().0.is_empty());
+        }
+        for _ in 0..4 {
+            app.update();
+        }
+        assert_eq!(app.world().resource::<Order>().0, ["a", "b"]);
+    }
+
+    /// The world session's drain runs what is left at once, even before the first frames.
+    #[test]
+    fn the_drain_runs_the_rest_at_once() {
+        let mut app = app(true);
+        app.update();
+        drain(app.world_mut());
+        assert_eq!(app.world().resource::<Order>().0, ["a", "b"]);
+        app.update();
+        app.update();
+        app.update();
+        assert_eq!(app.world().resource::<Order>().0, ["a", "b"], "never twice");
+    }
+
+    fn connected() -> benilla_protocol::SessionEvent {
+        benilla_protocol::SessionEvent::Connected {
+            self_guid: 1,
+            name: "Me".into(),
+            billing_time_rested: 0,
+            expansion: 2,
+            tutorial_flags: None,
+            addon_info: None,
+        }
+    }
+
+    /// With loads left at the world session's start, `Connected` passes and everything after it
+    /// waits, in order, until the queue is empty; then it is released whole.
+    #[test]
+    fn the_world_packets_wait_for_the_deferred_loads_in_order() {
+        use benilla_protocol::SessionEvent as E;
+        let mut app = app(true);
+        app.init_resource::<HeldWorldEvents>();
+        let w = app.world_mut();
+        let out = gate_world_events(w, vec![E::LoggedOut, connected(), E::CharacterLoginFailed { result: 1 }]);
+        assert_eq!(out.len(), 2, "up to and including Connected");
+        assert!(gate_world_events(w, vec![E::LoggedOut]).is_empty(), "held while loads remain");
+        drain(w);
+        let out = gate_world_events(w, vec![]);
+        assert!(matches!(out.as_slice(), [E::CharacterLoginFailed { .. }, E::LoggedOut]));
+        assert_eq!(gate_world_events(w, vec![E::LoggedOut]).len(), 1, "no hold once empty");
+    }
+
+    /// The queue waits while the character screen's model is assembling, then runs; the wait is
+    /// bounded, so a model that never builds cannot starve the catalogs.
+    #[test]
+    fn deferred_loads_wait_for_the_character_model_a_bounded_while() {
+        let mut app = app(true);
+        app.init_resource::<crate::portrait::GluePreview>()
+            .init_resource::<crate::portrait::GluePreviewBake>();
+        let look = crate::portrait::GlueLook::Select(crate::portrait::SelectLook::from(
+            &crate::char_select::test_character(1, "Aya"),
+        ));
+        app.world_mut()
+            .resource_mut::<crate::portrait::GluePreview>()
+            .look = Some(look);
+        for _ in 0..FRAMES_BEFORE_DEFERRED + 4 {
+            app.update();
+        }
+        assert!(app.world().resource::<Order>().0.is_empty(), "held for the model");
+        app.world_mut()
+            .resource_mut::<crate::portrait::GluePreviewBake>()
+            .look = Some(look);
+        app.update();
+        app.update();
+        assert_eq!(app.world().resource::<Order>().0, ["a", "b"], "the model stood: run");
+        // Bounded: a model that never builds holds the queue only GLUE_MODEL_HOLD_MS.
+        let mut app2 = app_with_pending_look(look);
+        for _ in 0..FRAMES_BEFORE_DEFERRED + 2 {
+            app2.update();
+        }
+        app2.world_mut()
+            .resource_mut::<DeferredLoads>()
+            .held_since = Some(page_ms() - GLUE_MODEL_HOLD_MS - 1.0);
+        app2.update();
+        app2.update();
+        assert_eq!(app2.world().resource::<Order>().0, ["a", "b"]);
+    }
+
+    fn app_with_pending_look(look: crate::portrait::GlueLook) -> App {
+        let mut app = app(true);
+        app.init_resource::<crate::portrait::GluePreview>()
+            .init_resource::<crate::portrait::GluePreviewBake>();
+        app.world_mut()
+            .resource_mut::<crate::portrait::GluePreview>()
+            .look = Some(look);
+        app
+    }
+
+    /// Not deferred (native), the loaders are plain `Startup` systems.
+    #[test]
+    fn undeferred_loads_run_at_startup() {
+        let mut app = app(false);
+        app.update();
+        assert_eq!(app.world().resource::<Order>().0.len(), 2);
+    }
+}
