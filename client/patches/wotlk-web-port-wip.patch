+  if (boost) boost.add = (k) => { for (let i = 0; i < k; i++) running.push(worker()); };
+  await Promise.all(running);
+  // Workers added late are awaited too.
+  while (running.length > n) await Promise.all(running.splice(n));
+}
+
+/// The world-entry read-set, warmed into the HTTP cache while the player is at the glue screens,
+/// for the character standing on the select screen: the client names the ADT under them
+/// (`__wenilla_progress('focus:<adt>')`, on each change of selection), and the streamed slice's
+/// tier that holds that tile is fetched, its terrain tiles nearest first. A new selection
+/// retargets it. Without tier lists (own game files, a plain wenilla-host) the checked-in
+/// `world-manifest.json`, when it lists anything. Twelve at a time at low priority: the glue
+/// screens' own reads never wait behind it.
+const WORLD = { gen: 0, tiers: null, focus: null, manifestDone: false, corner: null };
