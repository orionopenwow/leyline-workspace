+/// The aim line (a short preview of the real path), the cup marker and the hole-in celebration.
+fn golf_gizmos(golf: Res<Golf>, time: Res<Time>, mut gizmos: Gizmos) {
+    let Some(hole) = golf.hole() else {
+        return;
+    };
+    let now = time.elapsed_secs();
+    let flat = Quat::from_rotation_arc(Vec3::Z, Vec3::Y);
+    // The cup glows softly so it can be found from the tee.
+    let pulse = 0.5 + 0.5 * (now * 3.0).sin();
+    gizmos
+        .circle(Isometry3d::new(golf.world(hole.cup) + Vec3::Y * 0.02, flat), CUP_R + 0.1 + 0.05 * pulse, Color::srgba(1.0, 1.0, 1.0, 0.35 + 0.3 * pulse))
+        .resolution(32);
+    if let Some(aim) = &golf.aim {
+        if let Some(ball) = golf.balls.get(&aim.name) {
+            // Before the swing, the guide shows the last putt's power, faintly; while swinging, the live power.
+            let swinging = aim.charging.is_some();
+            let guide = if swinging { aim.power.max(80.0) as i32 } else { LAST_POWER.load(std::sync::atomic::Ordering::Relaxed) };
+            let shot = Shot { angle_t: aim.angle.round() as i32, power_m: guide };
+            let path = golf::simulate_for(hole, ball.pos, shot, golf.phase_now(now), PREVIEW_TICKS);
+            let p = guide as f32 / 1000.0;
+            let col = if swinging { Color::srgba(0.4 + 0.6 * p, 1.0 - 0.7 * p * p, 0.3, 0.95) } else { Color::srgba(1.0, 1.0, 1.0, 0.45) };
+            let pts: Vec<Vec3> = path.frames.iter().step_by(3).map(|f| golf.world(*f) + Vec3::Y * 0.02).collect();
+            for pair in pts.chunks(2) {
+                if let [a, b] = pair {
+                    gizmos.line(*a, *b, col);
+                }
+            }
+            let (s, c) = benilla_mode::detmath::sin_cos_tenths(shot.angle_t);
+            let dir = golf.world_dir(V3::new(s, 0.0, c));
+            let at = golf.world(ball.pos);
+            gizmos.arrow(at + Vec3::Y * 0.02, at + dir * (0.6 + 1.2 * p) + Vec3::Y * 0.02, Color::srgba(1.0, 1.0, 1.0, 0.9));
+            gizmos.circle(Isometry3d::new(at - Vec3::Y * (BALL_R - 0.015), flat), BALL_R * 1.8, Color::srgba(1.0, 0.95, 0.5, 0.9));
+        }
+    }
+    if let Some((t0, at)) = golf.confetti {
+        let age = now - t0;
+        if age < 2.2 {
+            for i in 0..36 {
+                let a = i as f32 * 2.399;
+                let speed = 1.2 + (i % 5) as f32 * 0.35;
+                let r = speed * age;
+                let y = 2.6 * age - 2.2 * age * age + 0.2;
+                let p = at + Vec3::new(a.cos() * r, y.max(0.05), a.sin() * r);
+                let hue = (i as f32 * 37.0) % 360.0;
+                gizmos.sphere(Isometry3d::from_translation(p), 0.04, Color::hsla(hue, 0.9, 0.6, 1.0 - age / 2.2)).resolution(6);
+            }
+        }
+    }
+}
