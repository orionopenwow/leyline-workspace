+// boot.js — the pre-login loading experience, shared by the dev page (web/index.html) and the
+// realm page (crates/wenilla-realm/templates/play.html).
+//
+// Why this exists: the client cannot show its own boot. Everything a fresh tab waits on — the
+// 15 MB (brotli) wasm download, instantiation, and the first update's catalog pile (~100+
+// synchronous XHR chain reads in ONE rAF task, the "unresponsive tab" window) — happens before
+// the first frame the app could draw. So the page owns a DOM overlay, and it does two jobs:
+//
+//   1. SHOW what is happening: a byte-counted wasm download bar (the counting stream is
+//      re-wrapped in a Response so `WebAssembly.compileStreaming` still streams), a
+//      "game data N/M" line for the prefetch, then indeterminate "Starting…" states driven by
+//      the client's own `window.__wenilla_progress(stage)` calls (benilla-app/src/webprogress.rs)
+//      until "ready" — the first glue screen — fades the overlay out.
+//   2. SHRINK the unresponsive window: `/data/*` is served immutable (max-age=1y), and a sync
+//      XHR is served from the HTTP cache when the same URL was fetch()ed first (verified live:
+//      transferSize 0, deliveryType "cache"). So the overlay prefetches the boot read-set — a
+//      checked-in manifest (boot-manifest.json) captured from a traced boot — with a small
+//      fetch pool, in parallel with the wasm download. The catalog pile then costs parse, not
+//      ~100 serial network round trips. Every miss (drift, missing manifest) degrades to
+//      exactly today's behavior, and a warm-cache visitor flies through all of it: progress is
+//      measured, never scripted.
+//
+// Page contract: `const w = await boot(init); bind(w.memory);` — bind must stay immediately
+// after (the Lua WASI shims need the module's linear memory). Query switches: `?boottrace=1`
+// arms window.__wenilla_boottrace and skips the prefetch (a manifest-capture boot must show the
+// true read order); `?noprefetch=1` skips the prefetch only (the A/B lever).
+
+// The wasm travels brotli-compressed: content-length counts .br bytes while the counted stream
+// yields decompressed ones. Dividing the two on a real build gives ~5.0; it drifts a little per
+// build and that is cosmetic — the bar is clamped at 99% until the stream actually ends.
+const BR_RATIO = 5.0;
+const READY_TIMEOUT_MS = 20000;
+// The page's host speaks HTTP/2 behind Caddy, so a deep pool costs no connections: at 190 ms
+// round trips, 8 at a time made the 517-file boot set 15 s of latency alone.
+const PREFETCH_CONCURRENCY = 24;
+
+export async function boot(init, opts = {}) {
+  installTouchAsMouse();
+  installLoadTrace();
+  // A guest pass (the portal's /__env.js `demo: "1"`, with `char`): read before the client
+  // snapshots and the page may delete the env object.
+  try {
+    window.__wenilla_demo = !!(window.__wenilla_env && window.__wenilla_env.demo === '1');
+  } catch (_) {
+    /* no env */
+  }
+  const q = new URLSearchParams(location.search);
+  const ui = createBootUi();
+  if (q.get('boottrace') === '1') window.__wenilla_boottrace = [];
+  const skipPrefetch = q.get('boottrace') === '1' || q.get('noprefetch') === '1';
+  installProgressHook(ui, skipPrefetch);
+
+  // The boot data waits for the wasm's last byte: run together, the 24-wide data pool took most
+  // of the link, and the 20 MB client (the long pole: it compiles as it streams) crawled at half
+  // a megabyte a second. A wasm from the browser's storage finishes at once.
+  let wasmDownloaded;
+  const downloaded = new Promise((r) => (wasmDownloaded = r));
+
+  // Compile immediately: merely fetching a Response leaves its body backpressured until
+  // someone consumes it. Instantiation must still wait for the cache warmup because the
+  // game's Startup performs synchronous reads of the prefetched catalogs.
+  const wasm = compileWasm(
+    new URL('./wenilla_bg.wasm', import.meta.url),
+    (got, total) => ui.setWasmProgress(got, total),
+    wasmDownloaded
+  );
+  wasm.catch(() => {}).finally(wasmDownloaded);
+
+  const prefetch = skipPrefetch
+    ? Promise.resolve()
+    : downloaded
+        .then(() => {
+          mark('client downloaded; boot data prefetch starts');
+          return prefetchManifest('./boot-manifest.json', (done, total) => ui.setData(done, total));
+        })
+        .catch(() => ui.setData(0, 0));
+  let w;
+  try {
+    // Attach rejection handlers to both operations now, including while prefetch is pending.
+    const [module] = await Promise.all([
+      wasm.then((m) => (mark('client compiled'), m)),
+      prefetch.then(() => mark('boot data prefetched')),
+    ]);
+    w = await init({ module_or_path: module });
+    window.__wenilla_wasm = w;
+    mark('client instantiated');
+  } catch (e) {
+    ui.fail('The client failed to start: ' + (e && e.message ? e.message : e));
+    throw e;
+  }
+  // init() resolved = module instantiated and the plugin graph built; the heavy catalog frame
+  // is still ahead. From here the client drives the stages; the timeout is the drift backstop
+  // (an old bundle without webprogress under a new page must not strand the overlay).
+  ui.setStage('Starting…');
+  ui.armTimeout(opts.readyTimeoutMs ?? READY_TIMEOUT_MS);
+  return w;
+}
+
+// Match wasm-bindgen's non-streaming fallback for servers without the WASM MIME type.
+// Choose before consuming the body, avoiding a cloned response buffering the whole module.
+async function compileWasm(url, onBytes, onDownloaded = () => {}) {
+  const response = await fetchWasm(url, onBytes, onDownloaded);
+  if (!response.ok) throw new Error(`Client download failed (HTTP ${response.status})`);
+  if (typeof WebAssembly.compileStreaming === 'function' &&
+      response.headers.get('content-type')?.trim().toLowerCase() === 'application/wasm') {
+    return WebAssembly.compileStreaming(response);
+  }
+  return WebAssembly.compile(await response.arrayBuffer());
+}
+
+/// The client's own files, kept by the page across visits (Cache Storage). Why not the HTTP cache:
+/// Chrome stores no entry over 1/8 of its cache, and with the common 200 MB cache that is 25 MB —
+/// the 27 MB (brotli) wasm was downloaded again on every visit. Cache Storage has no such limit,
+/// and an `ETag` revalidation keeps it exactly the server's current build. The realm list warms
+/// it before the click (`warm.html`, the same partition: both pages are on one site).
+const CLIENT_CACHE = 'wenilla-client-v1';
+
+/// The wasm from Cache Storage when the server says it is still current (304), else from the
+/// network, stored for the next visit as it streams. Any Cache Storage failure (a private window,
+/// no quota) is just the plain fetch.
+async function fetchClientFile(url, { store = true } = {}) {
+  let cache = null;
+  let cached = null;
+  try {
+    if (typeof caches !== 'undefined') {
+      cache = await caches.open(CLIENT_CACHE);
+      cached = await cache.match(url);
+    }
+  } catch (_) {
+    cache = null;
+  }
+  const headers = {};
+  const etag = cached && cached.headers.get('etag');
+  const modified = cached && cached.headers.get('last-modified');
+  if (etag) headers['If-None-Match'] = etag;
+  else if (modified) headers['If-Modified-Since'] = modified;
+  let r;
+  try {
+    // `no-store`: the HTTP cache is not what answers here; the conditional is ours.
+    r = await fetch(url, cached ? { headers, cache: 'no-store' } : undefined);
+  } catch (e) {
+    if (cached) return cached; // offline, and the kept copy is all there is
+    throw e;
+  }
+  if (r.status === 304 && cached) {
+    mark('client from the browser\'s storage (unchanged)');
+    return store ? cached : r;
+  }
+  if (store && r.ok && cache && (r.headers.get('etag') || r.headers.get('last-modified'))) {
+    cache.put(url, r.clone()).catch(() => {});
+  }
+  return r;
+}
+
+/// Fetch and store the client's wasm without compiling it: the realm list's warm-up (`warm.html`).
+/// Resolves once the copy is stored (or found current): the caller may navigate right after.
+export async function warmClient() {
+  const url = new URL('./wenilla_bg.wasm', import.meta.url).href;
+  const r = await fetchClientFile(url, { store: false });
+  if (r.status === 304 || !r.ok) return;
+  try {
+    await (await caches.open(CLIENT_CACHE)).put(url, r);
+  } catch (_) {
+    await r.arrayBuffer().catch(() => {}); // no Cache Storage: the HTTP cache is all there is
+  }
+}
+
+/// Byte-counting fetch of the wasm, re-wrapped so streaming compilation survives. Returns a
+/// Promise<Response> consumed immediately by compileWasm, before game instantiation.
+async function fetchWasm(url, onBytes, onDownloaded = () => {}) {
+  const r = await fetchClientFile(String(url));
+  if (!r.ok || !r.body) {
+    onDownloaded();
+    return r; // compileWasm surfaces HTTP errors / handles a missing stream
+  }
+  const contentLength = Number(r.headers.get('content-length')) || 0;
+  const compressed = !!(r.headers.get('content-encoding') || '').trim();
+  const total = contentLength ? contentLength * (compressed ? BR_RATIO : 1) : 0;
+  let got = 0;
+  const reader = r.body.getReader();
+  const counted = new ReadableStream({
+    async pull(c) {
+      const { done, value } = await reader.read();
+      if (done) {
+        onBytes(got, got); // the honest total, now that we know it
+        onDownloaded();
+        c.close();
+        return;
+      }
+      got += value.byteLength;
+      onBytes(got, total);
+      c.enqueue(value);
+    },
+    cancel(reason) {
+      return reader.cancel(reason);
+    },
+  });
+  // Headers are copied so Content-Type: application/wasm survives — compileStreaming
+  // refuses anything else.
+  return new Response(counted, { status: r.status, statusText: r.statusText, headers: r.headers });
+}
+
+/// Warm the HTTP cache with a manifest's read-set: fetch the manifest, then a fixed-size pool of
+/// full-body fetches. Failures are counted as done and otherwise ignored — a miss just means
+/// that file loads the old way. A missing/invalid manifest resolves immediately (line hides).
+/// Used twice: the boot set before `init()`, the world-entry set after `ready`.
+///
+/// The boot set's bodies are also KEPT (`globalThis.__wenilla_prefetch`, keyed by the chain name
+/// as the chain matches it: [`storeKey`]): the client's synchronous read takes a kept body with no request at all and drops it
+/// (benilla-formats `web.rs`), where a sync XHR from the HTTP cache still costs a cache lookup and
+/// a text decode of the whole body on the main thread. With page credentials (auto-login), the
+/// manifest's `loginOnly` names (the login screen's music, ambience and art, which that path never
+/// shows) are not fetched.
+async function prefetchManifest(manifestUrl, onProgress, opts = {}) {
+  const r = await fetch(manifestUrl);
+  if (!r.ok) return onProgress(0, 0);
+  const manifest = await r.json();
+  let names = Array.isArray(manifest && manifest.names) ? manifest.names : [];
+  // An interface overlay's own boot files (Forever UI), listed beside the stock set.
+  if (Array.isArray(manifest && manifest.foreverui_overlay)) {
+    const overlay = manifest.foreverui_overlay
+      .map((x) => (typeof x === 'string' ? x : x && x.name))
+      .filter(Boolean);
+    names = overlay.concat(names);
+  }
+  const keep = opts.keep ?? manifestUrl.endsWith('boot-manifest.json');
+  if (keep && pageSignsIn() && Array.isArray(manifest.loginOnly)) {
+    const skip = new Set(manifest.loginOnly);
+    names = names.filter((n) => !skip.has(n));
+  }
+  // The chain's name index (`/data/__index`, every name the host serves) is the client's first
+  // read and its largest JSON: kept too, it is fetched beside the wasm instead of after it.
+  const index = keep
+    ? fetch('/data/__index')
+        .then((r) => (r.ok ? r.arrayBuffer() : null))
+        .then((b) => b && (globalThis.__wenilla_prefetch ??= new Map()).set(storeKey('__index'), b))
+        .catch(() => {})
+    : null;
+  await Promise.all([prefetchNames(names, onProgress, { keep, concurrency: opts.concurrency }), index]);
+}
+
+/// The body store's key for a chain name: any case, `/` = `\\` (benilla-formats `web.rs` reads
+/// it the same way), so a body fetched by the host's spelling answers the client's.
+export function storeKey(name) {
+  return String(name).replace(/\//g, '\\').toLowerCase();
+}
+
+/// Did the page sign the player in (window.__wenilla_env with an account and a password)?
+/// The dev page's `?user=&pass=` counts when its env object allows query credentials, as the
+/// client's own reader does (benilla-app `webenv.rs`).
+function pageSignsIn() {
+  const env = window.__wenilla_env;
+  if (!env) return false;
+  if (env.user && env.pass) return true;
+  const q = new URLSearchParams(location.search);
+  return env.dev_query_creds === '1' && !!q.get('user') && !!q.get('pass');
+}
+
+/// The fetch pool behind both prefetches. `keep`: hold each body for the client's read (above).
+/// `low`: low fetch priority, so the glue screens' own reads and art go first.
+async function prefetchNames(names, onProgress, { keep = false, concurrency, low = false, boost = null, alive = null } = {}) {
+  if (!names.length) return onProgress(0, 0);
+  const kept = keep ? (globalThis.__wenilla_prefetch ??= new Map()) : null;
+  let done = 0;
+  onProgress(0, names.length);
+  const queue = names.slice();
+  async function worker() {
+    for (;;) {
+      if (alive && !alive()) return;
+      const name = queue.shift();
+      if (name === undefined) return;
+      const path = '/data/' + encodeURIComponent(name);
+      try {
+        const resp = await fetch(path, low ? { priority: 'low' } : undefined);
+        if (resp.ok) {
+          const body = await resp.arrayBuffer(); // body fully read = body fully cached
+          if (kept) kept.set(storeKey(name), body);
+        }
+      } catch (_) {
+        /* offline blip, 404 drift — the sync XHR path will deal with it */
+      }
+      done += 1;
+      onProgress(done, names.length);
+    }
+  }
