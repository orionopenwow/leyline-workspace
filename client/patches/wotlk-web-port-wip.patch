+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn straight() -> Hole {
+        parse(
+            "course T\nhole 2 Straight\ntee 0 0 0\ncup 0 0 10\nturf 0 -0.25 5 1.5 0.25 7\nwall 1.6 0.15 5 0.1 0.4 7\nwall -1.6 0.15 5 0.1 0.4 7\nwall 0 0.15 12.1 1.7 0.4 0.1\nwall 0 0.15 -2.1 1.7 0.4 0.1\n",
+        )
+        .unwrap()
+        .holes
+        .remove(0)
+    }
+
+    #[test]
+    fn the_shipped_course_parses() {
+        let c = parse(MEADOW_NINE).expect("meadow nine");
+        assert_eq!(c.holes.len(), 9);
+        assert!(c.par() >= 18 && c.par() <= 30, "par {}", c.par());
+    }
+
+    #[test]
+    fn a_gentle_putt_rests_on_the_green() {
+        let h = straight();
+        let o = simulate(&h, h.tee_ball(), Shot { angle_t: 0, power_m: 300 }, 0);
+        assert_eq!(o.end, End::Rest);
+        assert!(o.rest.z > 0.5 && o.rest.z < 10.0, "rest {:?}", o.rest);
+        assert!((o.rest.y - BALL_R).abs() < 0.01, "on the surface: {:?}", o.rest);
+    }
+
+    #[test]
+    fn the_right_putt_drops() {
+        let h = straight();
+        let holed = (200..1000).step_by(10).any(|power_m| {
+            simulate(&h, h.tee_ball(), Shot { angle_t: 0, power_m }, 0).end == End::Holed
+        });
+        assert!(holed, "some power holes a straight putt");
+    }
+
+    #[test]
+    fn a_hard_shot_bounces_off_the_back_wall_and_stays_in() {
+        let h = straight();
+        let o = simulate(&h, h.tee_ball(), Shot { angle_t: 0, power_m: 1000 }, 0);
+        assert!(o.rest.z < 12.0 && o.rest.z > -2.0, "{:?} {:?}", o.end, o.rest);
+    }
+
+    #[test]
+    fn off_the_edge_is_out_and_back_to_the_start() {
+        let h = parse("hole 1\ntee 0 0 0\ncup 0 0 5\nturf 0 -0.25 2 1 0.25 4\n").unwrap().holes.remove(0);
+        let o = simulate(&h, h.tee_ball(), Shot { angle_t: 900, power_m: 900 }, 0);
+        assert_eq!(o.end, End::Out);
+        assert_eq!(o.rest, h.tee_ball());
+    }
+
+    #[test]
+    fn water_costs_a_stroke() {
+        let h = parse("hole 2\ntee 0 0 0\ncup 0 0 9\nturf 0 -0.25 1 1 0.25 2\nturf 0 -0.25 8 1 0.25 2\nwater 0 -0.3 4.5 1 1.5\n").unwrap().holes.remove(0);
+        let o = simulate(&h, h.tee_ball(), Shot { angle_t: 0, power_m: 600 }, 0);
+        assert_eq!(o.end, End::Water);
+        assert!(o.end.penalty());
+    }
+
+    #[test]
+    fn it_is_deterministic_and_the_hash_sees_every_input() {
+        let c = parse(MEADOW_NINE).unwrap();
+        for h in &c.holes {
+            let a = simulate(h, h.tee_ball(), Shot { angle_t: 37, power_m: 640 }, 1234);
+            let b = simulate(h, h.tee_ball(), Shot { angle_t: 37, power_m: 640 }, 1234);
+            assert_eq!(a, b);
+            let other = simulate(h, h.tee_ball(), Shot { angle_t: 38, power_m: 640 }, 1234);
+            assert_ne!(a.hash, other.hash, "hole {}", h.number);
+        }
+    }
+
+    #[test]
+    fn spinners_move_with_the_phase() {
+        let h = parse("hole 3\ntee 0 0 0\ncup 0 0 9\nturf 0 -0.25 4.5 1.5 0.25 6\nspin 0 0.3 4.5 1.4 0.3 0.12 120\n").unwrap().holes.remove(0);
+        let a = simulate(&h, h.tee_ball(), Shot { angle_t: 0, power_m: 700 }, 0);
+        let b = simulate(&h, h.tee_ball(), Shot { angle_t: 0, power_m: 700 }, 90);
+        assert_ne!(a.hash, b.hash);
+    }
+
+    #[test]
+    fn bad_text_says_where() {
+        let e = parse("hole 2\ntee 0 0 0\ncup 0 0 9\nturf 0 0 0 1 1\n").unwrap_err();
+        assert_eq!(e.line, 4);
+        assert!(parse("tee 0 0 0").is_err());
+        assert!(parse("hole 2\ncup 0 0 1\nturf 0 0 0 1 1 1").is_err(), "no tee");
+        assert!(parse("hole 2\ntee 0 0 0\ncup 0 0 1\nturf 0 0 0 1 1 1 0 60").is_err(), "pitch cap");
+    }
+
+    /// Pinned on x86_64; `scripts/golf-determinism.sh` checks the wasm client computes the same.
+    #[test]
+    fn golden_hash() {
+        let all = fingerprint();
+        println!("golden {all:016x}");
+        assert_eq!(format!("{all:016x}"), golden_value());
+    }
+
+    fn golden_value() -> &'static str {
+        include_str!("../courses/golden.txt").trim()
+    }
+}
