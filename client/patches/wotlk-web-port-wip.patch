+/// `GetCurrentScroll` counts lines back from the newest; `SetScrollOffset` moves there, held to
+/// the ring; `GetNumLinesDisplayed` counts what the view holds.
+#[test]
+fn the_scroll_offset_verbs_read_and_move_the_scrollback() {
+    let mut s = script();
