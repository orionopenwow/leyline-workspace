# /opt/wu-discord/discord.env (chmod 600, owner root). The Leyline Discord bridge reads ONLY these settings.
# Fill in the three Discord lines, then:  systemctl enable --now wu-discord   (stop: systemctl disable --now wu-discord)
#
# The bot (Discord Developer Portal > your application > Bot):
#   * turn on "Message Content Intent" (without it Discord sends empty texts and nothing reaches the game)
#   * invite it with View Channel, Read Message History and Send Messages in the two channels; nothing else
#   * name it "Leyline" (that is the name Discord shows above the bridged lines)
DISCORD_BOT_TOKEN=
# Right-click the channel > Copy Channel ID (Discord settings > Advanced > Developer Mode on).
DISCORD_CHAT_CHANNEL_ID=
# The bug-report feed; leave empty for no feed.
DISCORD_BUG_CHANNEL_ID=
# Bug intake: people's own messages in that channel go to the bugs manifest (the GM console's Backlog,
# docs/BUGS-MANIFEST.md). Off while empty. Our own feed posts there too and is skipped (it is the bot).
WU_DISCORD_BUG_INTAKE=
# WU_DISCORD_BUG_INTAKE=/srv/wrath/bugs/intake/discord.jsonl
# DISCORD_BUG_INTAKE_CHANNEL_ID=      (default: DISCORD_BUG_CHANNEL_ID)
# DISCORD_GUILD_ID=                   (optional: the server id, so each report links to its message)

# The realm's SOAP (a GM level 3 account). discord-up.sh copies the signup service's login from /srv/wrath/signup.env.
SOAP_URL=http://127.0.0.1:7878/
SOAP_USER=
SOAP_PASS=

# Links players may post from the game to Discord (host names, comma-separated, subdomains included). Others: "[link removed]".
WU_DISCORD_LINK_ALLOW=
# Muted both ways: Discord user ids and/or character names, comma-separated. Or one per line in the file (re-read live).
WU_DISCORD_MUTE=
WU_DISCORD_MUTE_FILE=/opt/wu-discord/mutes.txt
WU_DISCORD_POLL=3
WU_DISCORD_STATE=/var/lib/wu-discord/state.json
# 1 = log what would be posted / said instead of doing it (a first look at a live realm).
WU_DISCORD_DRY_RUN=0
LOG_LEVEL=INFO

# New-realm announcements: OFF. The owner's choice: people share Discord links themselves; an automated post is only
# made when the owner sets this to 1. On, it posts "New realm listed: <name> — <link>" once per public, claimed realm
# whose name passed the word filter, after it has been listed for 10 minutes.
WU_DISCORD_ANNOUNCE_REALMS=0
# DISCORD_ANNOUNCE_CHANNEL_ID=        (default: the chat channel)
# WU_DISCORD_REALMS_URL=https://play.openvanilla.app/wrath/realms.json
# WU_DISCORD_ANNOUNCE_EVERY=300
