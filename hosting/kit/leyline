#!/usr/bin/env bash
# leyline: host a Beacon (a 3.3.5a realm on Leyline) from this Mac or Linux PC with one command.
# Needs Docker only. No port forwarding: the realm talks out to the Leyline relay, players connect
# to the relay, nobody sees your home address.
#
#   leyline host                 set up and start a Beacon (first time: a few questions); safe to re-run
#   leyline host --config-only   only write the config (state/, .env); start later with: leyline host
#   leyline host --ruleset vanillaplus --public --always-on
#                                answers on the command line (also --name NAME, --private, --gm NAME); --always-on
#                                makes Docker (and so the realm) start again by itself after this machine reboots
#   leyline link                 a server you ALREADY run (any core) on the Leyline realm list: only a small agent
#                                runs next to it; it never changes your server (4 questions). --always-on as for
#                                host. Also: leyline link status | stop | remove
#   leyline status               invite / join link, realm list line, GM account, relay status
#   leyline gm NAME              give GM rights to your own account NAME (you make the account)
#   leyline rules                after editing state/rules.txt or state/beacon.json
#   leyline public | private     listed on the Leyline realm list, or friends-only (invite link)
#   leyline check | stop | logs [service] | new-invite | claim TOKEN | signup invite|open|off
#   leyline herokey on | off     Hero Key sign-in: players from the Leyline website, no join page (off by default)
#   leyline browser on | off     browser players: on (default) turns Warden off so the browser client can join
#   leyline mods [add ID | remove ID]   the mods your realm runs or asks players to have (mod:<id>, up:<slug>, mode:<id>):
#                                shown on the realm list; players' launchers offer the Workshop ones when they join
#   leyline max-players N        the most players at once: the server's cap and the realm list's (0 = default)
#   leyline pack list | show ID | build ID --game DIR   packs for a Den, made from YOUR own game folder (any version):
#                                a zone's land and doodads, mounts, building sets (tools/wuhost/recipes; docs/DEN.md)
#
# Questions can be answered from the environment (no prompts): LEYLINE_NAME, LEYLINE_RULESET
# (dalaran | main | brawl | progression | den, or a profile for another client in profiles/: cmangos-1.12.1, cmangos-2.4.3;
# default dalaran; vanillaplus = the original world only, level 60, made to stay up; den = My Den, a private room to
# build in with friends, no bots; solo = Solo leveling, a private realm for levelling alone with helper bots;
# WU_CLIENT_DIR = that client's game folder), LEYLINE_VISIBILITY (public | private;
# default public, private for den and solo), LEYLINE_GM (your account name),
# LEYLINE_TAGLINE, LEYLINE_RULES_FILE (one rule per line). leyline link: LEYLINE_LINK_NAME, LEYLINE_LINK_AUTH,
# LEYLINE_LINK_WORLD, LEYLINE_LINK_CLIENT (vanilla | tbc | wrath), LEYLINE_LINK_TAGLINE, LEYLINE_LINK_CORE,
# LEYLINE_LINK_TAGS, LEYLINE_LINK_STATUS_URL.
#
# This command never makes game accounts and never sets passwords. You make your own account on
# your join page (your password never leaves your browser) and it gets GM rights by itself.
set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOSTSH="$KIT/host-wrath-realm.sh"
STATE="$KIT/state"
# the website's address (tools/wunet/leyline.env: https://<LEYLINE_DOMAIN>; docs/DOMAIN-MOVE.md)
LEYLINE_DOMAIN="${LEYLINE_DOMAIN:-$(sed -n 's/^LEYLINE_DOMAIN=\([^ #]*\).*/\1/p' "$KIT/tools/wunet/leyline.env" 2>/dev/null | head -1)}"
LEYLINE_SITE="${LEYLINE_SITE:-https://${LEYLINE_DOMAIN:-leylinelauncher.com}}"

if [ -t 1 ]; then B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; N=$'\033[0m'; else B=""; G=""; Y=""; R=""; N=""; fi
say()  { printf '%s\n' "$*"; }
step() { printf '\n%s== %s%s\n' "$B" "$*" "$N"; }
die()  { printf '%sProblem: %s%s\n' "$R" "$*" "$N" >&2; exit 1; }

state_get() {  # a top-level string value from state/host.json (no jq needed)
  [ -f "$STATE/host.json" ] || return 0
  sed -n "s/^ *\"$1\": *\"\{0,1\}\([^\",]*\)\"\{0,1\},\{0,1\}$/\1/p" "$STATE/host.json" | head -1
}

interactive() { [ -t 0 ] && [ "${LEYLINE_NONINTERACTIVE:-0}" != 1 ]; }

ask() {  # ask VAR "question" default [choices...]; an env value or a non-interactive run takes the default
  local var="$1" q="$2" def="$3"; shift 3
  [ -n "${!var:-}" ] && return
  if ! interactive; then printf -v "$var" '%s' "$def"; return; fi
  local a
  while true; do
    read -r -p "$q [$def]: " a || true
    a="${a:-$def}"
    [ $# -eq 0 ] && break
    for c in "$@"; do [ "$a" = "$c" ] && break 2; done
    say "  Please type one of: $*"
  done
  printf -v "$var" '%s' "$a"
}

valid_gm() { [[ "$1" =~ ^[A-Za-z0-9]{3,16}$ ]]; }

host_sh() { bash "$HOSTSH" "$@"; }

show_rules() {
  local n=0 ln
  [ -f "$STATE/rules.txt" ] || return 0
  while IFS= read -r ln || [ -n "$ln" ]; do
    case "$ln" in ''|'#'*) continue ;; esac
    n=$((n + 1)); say "    $n. $ln"
  done < "$STATE/rules.txt"
  [ "$n" -gt 0 ] || say "    (none yet)"
}

write_rules() {  # stdin: one rule per line
  local tmp="$STATE/rules.txt.new" ln n=0
  {
    printf '# Your realm'"'"'s house rules: one per line (up to 10, 120 characters each). Lines starting\n'
    printf '# with # are ignored. Shown on the Leyline realm list and your join page. After editing: leyline rules\n'
    while IFS= read -r ln || [ -n "$ln" ]; do
      ln="$(printf '%s' "$ln" | tr -d '\r')"
      case "$ln" in ''|'#'*) continue ;; esac
      n=$((n + 1)); [ "$n" -le 10 ] || break
      printf '%s\n' "${ln:0:120}"
    done
  } > "$tmp"
  mv "$tmp" "$STATE/rules.txt"
}

house_rules() {
  step "House rules (shown on the realm list and your join page)"
  if [ -n "${LEYLINE_RULES_FILE:-}" ]; then
    [ -f "$LEYLINE_RULES_FILE" ] || die "LEYLINE_RULES_FILE=$LEYLINE_RULES_FILE does not exist."
    write_rules < "$LEYLINE_RULES_FILE"
  elif interactive; then
    show_rules
    local a
    read -r -p "Keep these rules? [Y/n]: " a || true
    case "${a:-y}" in
      n|N|no|NO)
        say "  Type your rules, one per line (up to 10). An empty line ends."
        local lines=() ln
        while IFS= read -r -p "  > " ln && [ -n "$ln" ]; do lines+=("$ln"); [ "${#lines[@]}" -lt 10 ] || break; done
        printf '%s\n' ${lines[@]+"${lines[@]}"} | write_rules ;;
    esac
  fi
  show_rules
  host_sh rules >/dev/null 2>&1 || true
}

# --always-on: the realm's containers already restart by themselves (restart: unless-stopped); this makes sure Docker
# itself starts when the machine boots, so a reboot (a VPS's kernel update, a power cut) brings the realm back.
always_on() {
  step "Always on"
  if [ "$(uname -s)" = Linux ] && command -v systemctl >/dev/null 2>&1; then
    if [ "$(id -u)" = 0 ]; then
      systemctl enable docker >/dev/null 2>&1 && say "  Docker starts when this machine boots." \
        || say "  ${Y}Could not turn on Docker at boot: run  systemctl enable docker${N}"
    elif command -v sudo >/dev/null 2>&1 && sudo -n systemctl enable docker >/dev/null 2>&1; then
      say "  Docker starts when this machine boots."
    else
      say "  ${Y}One more thing, as root: sudo systemctl enable docker${N}  (so Docker, and your realm, start after a reboot)"
    fi
  elif [ "$(uname -s)" = Darwin ]; then
    say "  In Docker Desktop: Settings > General > 'Start Docker Desktop when you sign in'. Keep this Mac awake"
    say "  (System Settings > Energy: 'Prevent automatic sleeping')."
  else
    say "  Make Docker start when this machine boots (Docker Desktop: Settings > General > start when you sign in)."
  fi
  local c pol bad=0
  for c in $(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E '^(wu-host-|wu-link-)' || true); do
    pol="$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$c" 2>/dev/null || true)"
    [ "$pol" = unless-stopped ] || [ "$pol" = always ] || { bad=1; say "  ${Y}$c does not restart by itself ($pol)${N}"; }
  done
  [ "$bad" = 0 ] && say "  Every realm container restarts by itself if it stops."
  say "  After a reboot, check with: leyline status   (or: docker ps)"
}

cmd_host() {
  local config_only=0 keep_on=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --config-only) config_only=1 ;;
      --always-on) keep_on=1 ;;
      --public) LEYLINE_VISIBILITY=public ;;
      --private) LEYLINE_VISIBILITY=private ;;
      --ruleset) [ $# -ge 2 ] || die "--ruleset needs a name"; LEYLINE_RULESET="$2"; shift ;;
      --ruleset=*) LEYLINE_RULESET="${1#*=}" ;;
      --name) [ $# -ge 2 ] || die "--name needs a name"; LEYLINE_NAME="$2"; shift ;;
      --gm) [ $# -ge 2 ] || die "--gm needs your account name"; LEYLINE_GM="$2"; shift ;;
      *) die "Unknown option '$1'. Try: leyline help" ;;
    esac
    shift
  done
  [ -f "$HOSTSH" ] || die "host-wrath-realm.sh is missing next to this script (use the full host kit)."
  local first=1; [ -f "$STATE/host.json" ] && first=0

  LEYLINE_NAME="${LEYLINE_NAME:-$(state_get name)}"
  LEYLINE_RULESET="${LEYLINE_RULESET:-$(state_get profile)}"
  LEYLINE_VISIBILITY="${LEYLINE_VISIBILITY:-$(state_get visibility)}"
  LEYLINE_GM="${LEYLINE_GM:-$(state_get gm_name)}"

  step "Your Beacon"
  ask LEYLINE_NAME "Realm name" "Dalaran Hangout"
  # the profiles offered now (profiles/host-profile.sh profile_list: 4.3.4 is not offered for now)
  local others; others="$( (. "$KIT/profiles/host-profile.sh" && profile_list) 2>/dev/null | tr '\n' ' ' || true)"
  ask LEYLINE_RULESET "Ruleset: dalaran (light hangout, boost to 80, no bots), main, brawl, progression, vanillaplus (the original world to 60, always on), den (My Den: a private room to build in with friends), solo (Solo leveling: just you, with helper bots)${others:+, or for another client: $others}" "dalaran" dalaran main brawl progression vanillaplus den solo $others
  # a Den is a room for you and the friends you invite: private unless you say otherwise (no bots: the kit runs none)
  # Solo leveling is a realm for you alone: private too
  local vis_def=public; case "$LEYLINE_RULESET" in den|solo) vis_def=private ;; esac
  ask LEYLINE_VISIBILITY "public (listed on the Leyline realm list) or private (only people with your invite link)" "$vis_def" public private
  if [ "$first" = 1 ] && [ -z "${LEYLINE_TAGLINE:-}" ] && interactive; then
    read -r -p "One line for the realm list (Enter for the ruleset's default): " LEYLINE_TAGLINE || true
  fi
  while ! valid_gm "${LEYLINE_GM:-}"; do
    if ! interactive; then die "Set LEYLINE_GM to your account name (3-16 letters or digits)."; fi
    [ -n "${LEYLINE_GM:-}" ] && say "  Account names are 3-16 letters or digits."
    read -r -p "Your GM account name (you make this account yourself in a minute; 3-16 letters or digits): " LEYLINE_GM || true
  done

  # 1) the config: realm key, ruleset, house rules, GM name (no accounts, no passwords)
  export WU_NAME="$LEYLINE_NAME" WU_PROFILE="$LEYLINE_RULESET" WU_VISIBILITY="$LEYLINE_VISIBILITY" \
         WU_GM_NAME="$LEYLINE_GM"
  [ -n "${LEYLINE_TAGLINE:-}" ] && export WU_TAGLINE="$LEYLINE_TAGLINE"
  WU_CONFIG_ONLY=1 host_sh up >/dev/null || die "Writing the config failed (see above)."
  house_rules

  # 2) start the realm; its agent registers with the relay and (public) heartbeats to the realm list
  if [ "$config_only" = 1 ]; then
    step "Config written"
    say "  Start the Beacon with: leyline host"
  else
    host_sh up
  fi

  step "Make your GM account (one minute, you do this, not the script)"
  local link invite
  link="$(cat "$STATE/host-link.txt" 2>/dev/null || true)"
  invite="$(cat "$STATE/invite.txt" 2>/dev/null || true)"
  say "  1. Open YOUR link (keep it to yourself): ${link:-(see: leyline status)}"
  say "  2. Make the account ${B}$(printf '%s' "$LEYLINE_GM" | tr '[:lower:]' '[:upper:]')${N} there with a password you choose."
  say "     Your password never leaves your browser; the realm gets only a one-way login key."
  say "  3. Within seconds it has GM rights on this realm (check: leyline status)."
  say "  In game: .gm on, .announce TEXT, .tele dalaran, .kick NAME, .account set gmlevel NAME 2 -1 (make a friend a GM)."
  say ""
  say "Friends: send them ${B}${invite:-the invite link (leyline status)}${N}. They make their own account there."
  if [ "$LEYLINE_VISIBILITY" = public ]; then
    say "Your Beacon shows on the Leyline realm list within a minute of starting."
  fi
  if [ "$keep_on" = 1 ] && [ "$config_only" = 0 ]; then always_on; fi
}

# ------------------------------------------------------------------------------------------------ leyline link
# A server you already run, on the Leyline realm list. Only the agent runs (container wu-link-agent): one outbound
# connection to the relay, the signed realm-list heartbeat, and the relay's players passed on to your login server.
# Your server is never changed: not its realm list, accounts, GM rights or files (the agent has no database login).
LINK_C=wu-link-agent
link_tools() {   # setup.py with the kit folder (this PC's python3 with LEYLINE_LOCAL_TOOLS=1, else the tools image)
  if [ "${LEYLINE_LOCAL_TOOLS:-0}" = 1 ]; then PYTHONPATH="$KIT/tools" WU_KIT="$KIT" python3 -m wuhost.setup "$@"; return; fi
  docker run --rm --user "$(id -u):$(id -g)" -v "$KIT:/kit" -e WU_KIT=/kit "${WU_TOOLS_IMAGE:-wu-host-tools:1}" python -m wuhost.setup "$@"
}
link_image() {
  local img="${WU_TOOLS_IMAGE:-wu-host-tools:1}"
  [ "${LEYLINE_LOCAL_TOOLS:-0}" = 1 ] && return 0
  command -v docker >/dev/null 2>&1 || die "Docker is not installed. Get Docker Desktop (Mac) or Docker Engine (Linux), then run this again."
  docker info >/dev/null 2>&1 || die "Docker is installed but not running. Start it, then run this again."
  if docker pull -q "${WU_TOOLS_PREBUILT:-ghcr.io/orionopenwow/wu-host-tools:1}" >/dev/null 2>&1; then
    docker tag "${WU_TOOLS_PREBUILT:-ghcr.io/orionopenwow/wu-host-tools:1}" "$img"
  elif ! docker image inspect "$img" >/dev/null 2>&1; then
    say "  Building the small helper image (once, about a minute)..."
    docker build -q -t "$img" "$KIT/tools" >/dev/null || die "Building the helper image failed (is this machine online?)."
  fi
}
for_container() {  # an address as the agent's container sees it: on Mac and Windows "this PC" is host.docker.internal
  local a="$1"
  if [ "$(uname -s)" != Linux ]; then
    a="$(printf '%s' "$a" | sed -E 's/^(127\.0\.0\.1|localhost):/host.docker.internal:/')"
  fi
  printf '%s' "$a"
}
link_state() { sed -n "s/^ *\"$1\": *\(true\|false\|[0-9]*\).*/\1/p" "$STATE/relay-state.json" 2>/dev/null | head -1; }

cmd_link() {
  local keep_on=0
  if [ "${1:-}" = --always-on ]; then keep_on=1; shift; fi
  [ "${2:-}" = --always-on ] && keep_on=1
  case "${1:-}" in
    status)
      [ -f "$STATE/host.json" ] || die "Nothing linked yet: run  leyline link"
      say "Linked server: $(state_get name)   realm id $(state_get realm_id)"
      say "Agent:  $(docker ps -a --filter "name=^$LINK_C\$" --format '{{.Status}}' 2>/dev/null | head -1)"
      say "Relay:  $([ "$(link_state connected)" = true ] && echo connected || echo 'not connected yet')   realm list: $(link_state listing_status)"
      say "Page:   ${LEYLINE_SITE}/wrath/r/$(state_get realm_id)"
      return ;;
    stop) docker stop "$LINK_C" >/dev/null 2>&1 || true; say "Stopped. Your server shows as offline on the list at once and leaves it after 6 hours. Start again: leyline link"; return ;;
    remove)
      docker rm -f "$LINK_C" >/dev/null 2>&1 || true
      say "The agent is gone: your server leaves the realm list (offline at once, off the list within 6 hours)."
      say "The realm id is kept in state/ (realm.key): run  leyline link  again to come back as the same realm."
      return ;;
    ""|up|start) ;;
    *) die "Usage: leyline link [status | stop | remove]" ;;
  esac
  if [ -f "$STATE/host.json" ] && ! grep -q '"linked": true' "$STATE/host.json"; then
    die "This kit folder already hosts a realm. Unzip a fresh copy of the host kit to link a server you already run."
  fi
  link_image
  local old_auth old_world
  old_auth="$(state_get auth_service)"; old_world="$(state_get world_service)"
  LEYLINE_LINK_NAME="${LEYLINE_LINK_NAME:-$(state_get name)}"
  step "Link a server you already run"
  ask LEYLINE_LINK_NAME "1. Its name on the realm list" "My Realm"
  ask LEYLINE_LINK_AUTH "2. Its login server, as this machine reaches it" "${old_auth:-127.0.0.1:3724}"
  ask LEYLINE_LINK_WORLD "3. Its world server, as this machine reaches it" "${old_world:-127.0.0.1:8085}"
  ask LEYLINE_LINK_CLIENT "4. The client it's for: vanilla, tbc or wrath" "wrath" vanilla tbc wrath
  local build
  case "$LEYLINE_LINK_CLIENT" in vanilla) build=5875 ;; tbc) build=8606 ;; wrath) build=12340 ;;
    *) die "LEYLINE_LINK_CLIENT: vanilla, tbc or wrath" ;; esac
  if [ -z "${LEYLINE_LINK_TAGLINE:-}" ] && interactive && [ ! -f "$STATE/host.json" ]; then
    read -r -p "One line for the realm list (optional): " LEYLINE_LINK_TAGLINE || true
  fi
  local args=(link --name "$LEYLINE_LINK_NAME" --auth-service "$(for_container "$LEYLINE_LINK_AUTH")"
              --world-service "$(for_container "$LEYLINE_LINK_WORLD")" --build "$build")
  [ -n "${LEYLINE_LINK_TAGLINE:-}" ] && args+=(--tagline "$LEYLINE_LINK_TAGLINE")
  [ -n "${LEYLINE_LINK_CORE:-}" ] && args+=(--core "$LEYLINE_LINK_CORE")
  [ -n "${LEYLINE_LINK_TAGS:-}" ] && args+=(--tags "$LEYLINE_LINK_TAGS")
  [ -n "${LEYLINE_LINK_STATUS_URL:-}" ] && args+=(--status-url "$LEYLINE_LINK_STATUS_URL")
  [ -n "${WU_RELAY:-${LEYLINE_RELAY:-}}" ] && args+=(--relay "${WU_RELAY:-$LEYLINE_RELAY}")
  [ -n "${WU_RELAY_URL:-}" ] && args+=(--relay-url "$WU_RELAY_URL")
  [ -n "${WU_LISTING_URL:-}" ] && args+=(--listing-url "$WU_LISTING_URL")
  mkdir -p "$STATE"
  link_tools "${args[@]}" >/dev/null || die "The link settings were refused (see above)."
  if [ "${LEYLINE_LINK_NO_START:-0}" != 1 ]; then
    step "Starting the agent"
    local net=(--add-host host.docker.internal:host-gateway)
    [ "$(uname -s)" = Linux ] && net=(--network host)
    docker rm -f "$LINK_C" >/dev/null 2>&1 || true
    docker run -d --name "$LINK_C" --restart unless-stopped --read-only --cap-drop ALL \
      --security-opt no-new-privileges --memory 96m --tmpfs /tmp --log-opt max-size=10m --log-opt max-file=3 \
      --user "$(id -u):$(id -g)" -v "$STATE:/state" "${net[@]}" "${WU_TOOLS_IMAGE:-wu-host-tools:1}" \
      python -m wuhost.agent --state /state >/dev/null || die "The agent did not start (docker logs $LINK_C)."
    local i
    for i in $(seq 1 "${LEYLINE_LINK_WAIT:-30}"); do [ "$(link_state connected)" = true ] && break; sleep 2; done
    if [ "$(link_state connected)" = true ]; then say "  ${G}Connected to the Leyline relay.${N}"
    else say "  ${Y}Not connected yet: check this machine is online (docker logs $LINK_C).${N}"; fi
  fi
  step "Done"
  say "  Your server shows on the Leyline realm list within a minute: ${LEYLINE_SITE}/wrath/r/$(state_get realm_id)"
  say "  Nothing on your server was changed. Two things to know:"
  say "  - Players arrive at your login server through the relay; the realm address your server hands out must"
  say "    already work for players (it's the one they use today). Leyline leaves it alone."
  say "  - Relay players all come from the agent's address, so turn off your login server's wrong-password IP ban"
  say "    (AzerothCore/TrinityCore: WrongPass.MaxCount = 0 in authserver.conf; CMaNGOS/vMaNGOS: WrongPass.MaxCount = 0"
  say "    in realmd.conf). The relay limits wrong passwords per player instead."
  say "  It's listed as Unclaimed until you claim it for your Hero Key account: once the site gives you a claim token"
  say "  (its Claim a realm page), run: leyline claim TOKEN"
  say "  Later: leyline link status | stop | remove. The agent restarts by itself whenever Docker runs."
  if [ "$keep_on" = 1 ] && [ "${LEYLINE_LINK_NO_START:-0}" != 1 ]; then always_on; fi
}

cmd_pack() {   # leyline pack list | show ID | build ID [--game DIR] [--client-patch auto|always|never] (tools/wuhost/packs.py)
  local verb="${1:-list}"; shift || true
  case "$verb" in
    list|show) ;;
    build)
      local id="${1:-}"; shift || true
      [[ "$id" =~ ^[a-z0-9][a-z0-9-]{0,23}$ ]] || die "Usage: leyline pack build ID [--game DIR]   (leyline pack list shows the IDs)"
      local game="${WU_GAME_DIR:-}" extra=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --game) [ $# -ge 2 ] || die "--game needs your game folder"; game="$2"; shift ;;
          --client-patch) [ $# -ge 2 ] || die "--client-patch needs auto, always or never"; extra+=(--client-patch "$2"); shift ;;
          *) die "Unknown option '$1'. Try: leyline pack build ID --game DIR" ;;
        esac
        shift
      done
      if [ -z "$game" ] && interactive; then read -r -p "Your game folder (any version you have; the one with Data/ in it): " game || true; fi
      [ -n "$game" ] && [ -d "$game/Data" ] || die "No game folder with a Data folder in it: leyline pack build $id --game /path/to/your/game"
      mkdir -p "$STATE/packs" "$STATE/dens"
      say "Making the $id pack from $game (your own files; nothing is downloaded or shared)..."
      if [ "${LEYLINE_LOCAL_TOOLS:-0}" = 1 ]; then
        PYTHONPATH="$KIT/tools" python3 -m wuhost.packs build "$id" --game "$game" --state "$STATE" ${extra[@]+"${extra[@]}"}
      else
        docker run --rm --user "$(id -u):$(id -g)" -v "$game:/game:ro" -v "$STATE:/state" -v "$KIT/tools:/t:ro" -e PYTHONPATH=/t \
          "${WU_TOOLS_IMAGE:-wu-host-tools:1}" python -m wuhost.packs build "$id" --game /game --state /state ${extra[@]+"${extra[@]}"}
      fi
      return ;;
    *) die "Usage: leyline pack list | show ID | build ID [--game DIR]" ;;
  esac
  if [ "${LEYLINE_LOCAL_TOOLS:-0}" = 1 ]; then PYTHONPATH="$KIT/tools" python3 -m wuhost.packs "$verb" "$@"
  else docker run --rm -v "$KIT/tools:/t:ro" -e PYTHONPATH=/t "${WU_TOOLS_IMAGE:-wu-host-tools:1}" python -m wuhost.packs "$verb" "$@"; fi
}

case "${1:-help}" in
  host|up|start) shift; cmd_host "$@" ;;
  pack|packs) shift; cmd_pack "$@" ;;
  link) shift; cmd_link "$@" ;;
  status|show) host_sh show ;;
  gm)
    [ $# -ge 2 ] && valid_gm "$2" || die "Usage: leyline gm NAME   (your own account, 3-16 letters or digits)"
    if [ "${LEYLINE_LOCAL_TOOLS:-0}" = 1 ]; then PYTHONPATH="$KIT/tools" WU_KIT="$KIT" python3 -m wuhost.setup gm "$2" >/dev/null
    else docker run --rm --user "$(id -u):$(id -g)" -v "$KIT:/kit" -e WU_KIT=/kit "${WU_TOOLS_IMAGE:-wu-host-tools:1}" python -m wuhost.setup gm "$2" >/dev/null; fi
    say "GM account: $(printf '%s' "$2" | tr '[:lower:]' '[:upper:]'). Make it on your join page if you haven't; it gets GM rights by itself." ;;
  rules) shift; [ "${1:-}" = "--edit" ] && { LEYLINE_RULES_FILE="" house_rules; exit 0; }; host_sh rules ;;
  public|private|check|stop|logs|new-invite|claim|signup|herokey|options|browser|max-players|mods) host_sh "$@" ;;
  friend) die "leyline doesn't make accounts. Friends make their own on your join page (leyline status shows the link)." ;;
  -h|--help|help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "Unknown command '$1'. Try: leyline help" ;;
esac
