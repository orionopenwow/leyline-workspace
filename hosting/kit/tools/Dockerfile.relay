# The Leyline community relay (docker-compose.volunteer-relay.yml): the same wu-relay as ours, volunteer profile.
# The Host pack ships tools/wurelay (tools/leyline-repo/hostkit.py copies hosting/relay/wurelay in).
FROM python:3.12-alpine
RUN pip install --no-cache-dir "cryptography==43.0.3" && adduser -D -H -u 10002 relay \
 && mkdir -p /var/lib/wu-relay && chown relay /var/lib/wu-relay
COPY wunet /app/wunet
COPY wurelay /app/wurelay
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 RELAY_STATE=/var/lib/wu-relay/state.json
USER relay
WORKDIR /app
CMD ["python", "-m", "wurelay.relay"]
