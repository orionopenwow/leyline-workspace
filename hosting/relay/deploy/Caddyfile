{
	# No access log: it would hold raw player IPs.
	servers {
		timeouts {
			idle 10m
		}
	}
}

relay.openvanilla.app {
	encode off
	@metrics path /metrics
	handle @metrics {
		@notlocal not remote_ip 127.0.0.1/8 100.64.0.0/10
		respond @notlocal 403
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-For {remote_host}
			flush_interval -1
		}
	}
	header -Server
}
