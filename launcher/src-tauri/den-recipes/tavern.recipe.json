{
 "format": "leyline-recipe",
 "version": 1,
 "name": "tavern",
 "title": "Tavern",
 "about": "A tavern room's furniture: tables in rows with four seats each, a bar of kegs and barrels at the back, lanterns at the corners. Put it inside the room (or inside a building).",
 "params": {
  "x": { "default": 0, "min": -40, "max": 40, "about": "the middle: yards from the room's middle" },
  "y": { "default": 0, "min": -40, "max": 40 },
  "tables": { "default": 4, "min": 1, "max": 12, "whole": true },
  "columns": { "default": 2, "min": 1, "max": 4, "whole": true, "about": "tables side by side in a row" },
  "spacing": { "default": 4.5, "min": 3, "max": 8, "about": "yards between two tables" },
  "table": { "default": "table", "piece": true },
  "seat": { "default": "chair", "piece": true, "about": "chair, stool, highchair, bench..." }
 },
 "let": [
  ["cols", "min(tables, columns)"],
  ["rows", "ceil(tables / columns)"],
  ["back", "x + (rows - 1) / 2 * spacing + spacing * 0.8"],
  ["front", "x - (rows - 1) / 2 * spacing - spacing * 0.6"],
  ["side", "(cols - 1) / 2 * spacing + spacing * 0.6"],
  ["kegs", "max(3, cols * 2)"]
 ],
 "pieces": [
  { "repeat": [["i", "tables"]],
    "let": [["tx", "x + (floor(i / columns) - (rows - 1) / 2) * spacing"], ["ty", "y + (i % columns - (cols - 1) / 2) * spacing"]],
    "key": "$table", "x": "tx", "y": "ty" },
  { "repeat": [["i", "tables"], ["s", "4"]],
    "let": [["tx", "x + (floor(i / columns) - (rows - 1) / 2) * spacing"], ["ty", "y + (i % columns - (cols - 1) / 2) * spacing"],
            ["a", "90 * s"]],
    "key": "$seat", "x": "tx + 1.3 * cos(a)", "y": "ty + 1.3 * sin(a)", "yaw": "a + 180" },
  { "repeat": [["k", "kegs"]],
    "pick": { "keys": ["beerkeg", "innbarrel", "keg"], "by": "k" },
    "x": "back", "y": "y + (k - (kegs - 1) / 2) * 1.4", "yaw": "180" },
  { "repeat": [["q", "4"]],
    "let": [["sy", "(q % 2) * 2 - 1"]],
    "key": "lantern", "x": "floor(q / 2) == 0 ? front : back + 1.2", "y": "y + sy * side" }
 ]
}
