@@ -88,6 +88,23 @@ enum Extract
 
 // Select data for extract
 int   CONF_extract = EXTRACT_MAP | EXTRACT_DBC | EXTRACT_CAMERA;
+// Leyline (realm/custom/patches/core.patch, docs/BOSS-RUSH.md): "-m 631,724,..." reads only these maps, plus the
+// few tiles of the continents that the world server checks at start (World.cpp: the starting areas), so a realm
+// that only ever plays a handful of instances needs a small part of the full extraction.
+std::set<uint32> CONF_only_maps;
+bool OnlyMapsTile(uint32 mapId, uint32 gx, uint32 gy)
+{
+    static float const startTiles[][3] = {
+        { 0, -6240.32f, 331.033f }, { 0, -8949.95f, -132.493f }, { 1, -618.518f, -4251.67f }, { 0, 1676.35f, 1677.45f },
+        { 1, 10311.3f, 832.463f }, { 1, -2917.58f, -257.98f }, { 530, 10349.6f, -6357.29f }, { 530, -3961.64f, -13931.2f } };
+    for (auto const& t : startTiles)
+    {
+        int tx = int(32.0f - t[1] / 533.33333f), ty = int(32.0f - t[2] / 533.33333f);
+        if (uint32(t[0]) == mapId && uint32(tx < 0 ? 0 : tx) == gx && uint32(ty < 0 ? 0 : ty) == gy)
+            return true;
+    }
+    return false;
+}
 // This option allow limit minimum height to some value (Allow save some memory)
 bool  CONF_allow_height_limit = true;
 float CONF_use_minHeight = -500.0f;
