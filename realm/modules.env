# Module settings for the custom realm image (realm\Build custom realm.bat).
# Generated from ini keys; AzerothCore reads AC_* variables as overrides of the matching
# .conf key. Edit here, then restart the world server (docker compose up -d ac-worldserver).

# --- Core settings the modules need -------------------------------------------------------
# Individual progression and challenge modes save per-character state in player settings.
AC_ENABLE_PLAYER_SETTINGS=1
# Lets individual progression give items their Vanilla/TBC stats.
AC_DBC_ENFORCE_ITEM_ATTRIBUTES=0
# Dungeon Finder, raid browser and seasonal bosses (AzerothCore default; 0 turns them off).
AC_DUNGEON_FINDER_OPTIONS_MASK=7

# --- mod-playerbots (bots: labelled, quiet, never in world chat) --------------------------
AC_PLAYERBOTS_ENABLED=1
AC_PLAYERBOTS_DATABASE_INFO=ac-database;3306;root;ov-local-test;acore_playerbots
AC_PLAYERBOTS_RANDOM_BOT_AUTOLOGIN=1
AC_PLAYERBOTS_MIN_RANDOM_BOTS=30
AC_PLAYERBOTS_MAX_RANDOM_BOTS=30
AC_PLAYERBOTS_RANDOM_BOT_TALK=0
AC_PLAYERBOTS_RANDOM_BOT_EMOTE=0
AC_PLAYERBOTS_RANDOM_BOT_SUGGEST_DUNGEONS=0
AC_PLAYERBOTS_ENABLE_BROADCASTS=0
AC_PLAYERBOTS_RANDOM_BOT_JOIN_LFG=1
AC_PLAYERBOTS_RANDOM_BOT_JOIN_BG=1

# --- mod-ale (Lua engine); scripts are mounted from realm\custom\lua_scripts --------------
AC_ALE_ENABLED=true
AC_ALE_SCRIPT_PATH=/azerothcore/lua_scripts

# --- mod-transmog ---------------------------------------------------------------------------
AC_TRANSMOGRIFICATION_ENABLE=1
AC_TRANSMOGRIFICATION_ENABLE_PORTABLE=1

# --- mod-autobalance (scales 5/10/25/40-man content to the group's size) ----------------
AC_AUTO_BALANCE_ENABLE_GLOBAL=1
AC_AUTO_BALANCE_MIN_PLAYERS=1

# --- mod-ah-bot-plus: needs a character to sell as; run realm\set-ahbot.bat NAME -------
AC_AUCTION_HOUSE_BOT_ENABLE_SELLER=false

# --- mod-aoe-loot ---------------------------------------------------------------------------
AC_AOELOOT_ENABLE=1
AC_AOELOOT_MESSAGE=0

# --- mod-solo-lfg ---------------------------------------------------------------------------
AC_SOLO_LFG_ENABLE=1
AC_SOLO_LFG_ANNOUNCE=0

# --- mod-challenge-modes (Hardcore, Semi-Hardcore, Self-Crafted, Slow XP, ...) ------------
AC_CHALLENGE_MODES_ENABLE=1

# --- mod-guildhouse -------------------------------------------------------------------------
# (prices as shipped)

# --- mod-dungeon-master (random dungeon runs from an NPC) ----------------------------------
AC_DUNGEON_MASTER_ENABLE=1

# --- mod-1v1-arena --------------------------------------------------------------------------
AC_ARENA_1_V_1__ENABLE=1
AC_ARENA_1_V_1__MIN_LEVEL=80

# --- mod-mythic-plus (keystones, timer, affixes) -------------------------------------------
AC_MYTHIC_PLUS_ENABLE=1

# --- mod-questie-bridge (feeds the Questie-335 addon live server data) ----------------------
AC_QUESTIE_BRIDGE_ENABLED=1
