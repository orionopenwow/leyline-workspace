# Profile "brawl": Wrath Brawl. New characters start at 80 in Dalaran with every trainable class
# spell, riding, exalted reputations, all flight paths and 5000 gold; vendor gear costs no tokens
# (brawl_world.sql, applied by "Make it Brawl.bat").
AC_START_PLAYER_LEVEL=80
AC_START_HEROIC_PLAYER_LEVEL=80
AC_START_PLAYER_MONEY=50000000
AC_START_HEROIC_PLAYER_MONEY=50000000
AC_PLAYER_START_CUSTOM_SPELLS=1
AC_PLAYER_START_ALL_REPUTATION=1
AC_PLAYER_START_MAPS_EXPLORED=1
AC_ALL_FLIGHT_PATHS=1
AC_ALWAYS_MAX_SKILL_FOR_LEVEL=1
AC_SKIP_CINEMATICS=2
AC_ARENA_AUTO_DISTRIBUTE_POINTS=1
AC_BATTLEGROUND_QUEUE_ANNOUNCER_ENABLE=1
AC_ARENA_QUEUE_ANNOUNCER_ENABLE=1
# Progression gating makes no sense at 80.
AC_INDIVIDUAL_PROGRESSION_ENABLE=0
OV_BOOST_TO_70=0
# Owner decisions 2026-10-24: every profession, free respec, free repairs (brawl_world_2.sql, ov_brawl.lua).
AC_MAX_PRIMARY_TRADE_SKILL=11
AC_NO_RESET_TALENTS_COST=1
AC_RATE_REPAIR_COST=0
# Death Knights for everyone from the first character: AzerothCore otherwise wants a level-55
# character on the account first (CharacterCreating.MinLevelForHeroicCharacter = 55) and allows
# one DK per realm (HeroicCharactersPerRealm = 1).
AC_CHARACTER_CREATING_MIN_LEVEL_FOR_HEROIC_CHARACTER=0
AC_HEROIC_CHARACTERS_PER_REALM=10
OV_BRAWL=1
