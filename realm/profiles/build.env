# Profile "build": the Builders' Realm (TODO(owner): the final name), an official realm just for building, open to
# approved builders (owner 2026-10-31). docs/BUILD-REALM.md is the runbook. It runs on the main realm's box as a
# second, small world server (ov-ac-build-world, hosting/build-realm/build-realm.sh): the same world database (read
# only: no script writes it) and client data, its own characters database (acore_characters_build), and its own
# realm list (acore_auth_build: the same accounts, bans and GM rights, seen through views) so the main realm's list
# keeps exactly one realm. No published port: players come through the Leyline relay.
#
# What it is: a Den (ov_den.lua) on the sealed island, big: everyone who logs in starts in the one shared room and
# builds there with F7 (edit mode) or /builder (ov_build.lua). Who may log in: ov_buildrealm.lua (approved builders
# and GMs; everyone else is told and sent back). Only the room's map area is ever loaded.
#
# build-realm.sh reads this file when it makes the container; a change here takes the build-realm-on step again
# (it restarts only the Builders' Realm, never the main realm). Values are checked against worldserver.conf.dist at
# the pinned core and the OV_ keys against the scripts' own headers. Tests: hosting/tests/test_build_realm.py,
# stream/tests/test_ov_buildrealm.lua.

# --- Who may come in (ov_buildrealm.lua) ---------------------------------------------------------------------
# 1 = on. Approved builders: GMs, every account with a character that has the builder role on the main realm
# (".build grant <name>" there, kept in acore_characters.mod_builder_roles), and accounts the owner allows here
# (".buildrealm allow <account>"). They get the builder role on every character here at login.
OV_BUILDREALM=1
# 0 = everyone else is told "this realm is for approved builders" and logged out after a few seconds.
# 1 = they may look around (no building). Owner decision; 0 is the safe default.
OV_BUILDREALM_VISITORS=0
# The main realm's characters database, read only, for the builder list above.
OV_BUILDREALM_MAIN_CHARS=acore_characters

# --- The room (ov_den.lua) -----------------------------------------------------------------------------------
OV_DEN=1
OV_DEN_THEME=white
# The biggest room ov_den.lua makes: 64 x 64 yards inside its walls.
OV_DEN_SIZE=32
OV_DEN_INSIDE_POINTS=6000
OV_DEN_OUTSIDE_POINTS=2000
# The save files (.den save <name>): /srv/wrath/build-realm/dens on the box, mounted here by build-realm.sh.
OV_DEN_SAVES=/azerothcore/dens

# --- The Builder (ov_build.lua) ------------------------------------------------------------------------------
OV_BUILD=1
OV_BUILD_NEW_HOURS=0
OV_BUILD_PER_PLAYER=800
OV_BUILD_POINTS=3000
OV_BUILD_PER_AREA=2000
OV_BUILD_PLOTS_EACH=0
OV_BUILD_ANY=1
OV_BUILD_MODELS=1
OV_BUILD_BUILDINGS=1
OV_BUILD_SCALE_MIN=0.1
OV_BUILD_SCALE_MAX=5

# --- Everything else off: no events, duels, bots, boosts, Discord, welcome lines ----------------------------
OV_MAIN=0
OV_BRAWL=0
OV_BOOST_TO_70=0
OV_QOL_HUB=0
OV_QOL_BOTHELP=0
OV_FREE_REPAIR=1
OV_DUEL_RESET=0
OV_AUTOLEARN=0
OV_EVENTS=0
OV_EVENTS_STOCK=0
OV_EVENTS_TRIVIA=0
OV_EVENTS_HIDE=0
OV_DUELS=0
OV_COMPANIONS=0
OV_DISCORD=0
OV_WELCOME=0

# --- Characters ----------------------------------------------------------------------------------------------
AC_SKIP_CINEMATICS=2
AC_START_PLAYER_LEVEL=1
AC_START_PLAYER_MONEY=0
AC_PLAYER_START_CUSTOM_SPELLS=0
AC_PLAYER_START_ALL_REPUTATION=0
AC_PLAYER_START_MAPS_EXPLORED=0
AC_ALL_FLIGHT_PATHS=0
AC_INDIVIDUAL_PROGRESSION_ENABLE=0
AC_CHARACTER_CREATING_MIN_LEVEL_FOR_HEROIC_CHARACTER=0
AC_HEROIC_CHARACTERS_PER_REALM=10
AC_CHARACTER_CREATING_DISABLED=0
AC_CHARACTER_CREATING_DISABLED_RACE_MASK=0
AC_CHARACTER_CREATING_DISABLED_CLASS_MASK=0
AC_SOCKET_TIME_OUT_TIME_ACTIVE=600000

# --- Modules: none of the game ones ---------------------------------------------------------------------------
AC_PLAYERBOTS_ENABLED=0
AC_PLAYERBOTS_RANDOM_BOT_AUTOLOGIN=0
AC_PLAYERBOTS_MIN_RANDOM_BOTS=0
AC_PLAYERBOTS_MAX_RANDOM_BOTS=0
AC_PLAYERBOTS_MAX_ADDED_BOTS=0
AC_AUTO_BALANCE_ENABLE_GLOBAL=0
AC_AUCTION_HOUSE_BOT_ENABLE_SELLER=false
AC_DUNGEON_MASTER_ENABLE=0
AC_ARENA_1_V_1__ENABLE=0
AC_CHALLENGE_MODES_ENABLE=0
AC_SOLO_LFG_ENABLE=0
AC_BATTLEGROUND_QUEUE_ANNOUNCER_ENABLE=0
AC_ARENA_QUEUE_ANNOUNCER_ENABLE=0

# --- Small and quiet ------------------------------------------------------------------------------------------
# Idle grids unload after 1 minute; nothing preloaded; short sight; few threads; 20 players at most.
AC_GRID_UNLOAD=1
AC_GRID_CLEAN_UP_DELAY=60000
AC_PRELOAD_ALL_NON_INSTANCED_MAP_GRIDS=0
AC_VISIBILITY_DISTANCE_CONTINENTS=90
AC_MAP_UPDATE_THREADS=1
AC_NETWORK_THREADS=1
AC_CHARACTER_DATABASE_WORKER_THREADS=1
AC_PLAYER_LIMIT=20
# Chat: builders talk freely (only approved builders are here).
AC_CHAT_LEVEL_REQ_SAY=1
AC_CHAT_LEVEL_REQ_CHANNEL=1
AC_CHAT_LEVEL_REQ_WHISPER=1
