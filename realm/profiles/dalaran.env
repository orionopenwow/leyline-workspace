# Profile "dalaran": a lightweight Dalaran hangout for a host and friends (Beacons, hosted from a PC).
# Northrend first: every new character may take the one-time boost to 80 (ov_main.lua: spec kit, professions,
# straight to Dalaran with the hearthstone set there) or start at level 1 as normal. Hub teleports, free
# repairs and the duel reset make Dalaran the place to meet, duel and queue from. Made for a small PC:
# no roaming bots by default (the kit writes WU_BOTS=0, WU_DB_BUFFER=256M, WU_PLAYER_LIMIT=40 into .env),
# idle map areas unload after a minute, so only Dalaran and wherever players are stays in memory.
# The kit applies main_unbrawl.sql, main_world.sql and modern_combos.sql for this profile (as for main).
# The host's own GM login (state/host-login.txt), GM commands and rules text (state/rules.txt): hosting/INSTALL-OPERATE.md 9.2.

# --- Levelling: as main (3x), for whoever starts at 1 --------------------------------------------------
AC_RATE_XP_KILL=3
AC_RATE_XP_QUEST=3
AC_RATE_XP_QUEST_DF=3
AC_RATE_XP_EXPLORE=3
AC_RATE_REPUTATION_GAIN=2
AC_SKILL_GAIN_CRAFTING=2
AC_SKILL_GAIN_GATHERING=2
AC_SKILL_GAIN_WEAPON=2
AC_START_PLAYER_LEVEL=1
AC_START_HEROIC_PLAYER_LEVEL=55
AC_START_PLAYER_MONEY=0
AC_PLAYER_START_CUSTOM_SPELLS=0
AC_PLAYER_START_ALL_REPUTATION=0
AC_PLAYER_START_MAPS_EXPLORED=0
AC_ALL_FLIGHT_PATHS=0
AC_ALWAYS_MAX_SKILL_FOR_LEVEL=0
AC_SKIP_CINEMATICS=2

# --- A hangout, not a grind ----------------------------------------------------------------------------
AC_MAX_PRIMARY_TRADE_SKILL=2
AC_NO_RESET_TALENTS_COST=1
AC_RATE_REPAIR_COST=0
AC_ARENA_AUTO_DISTRIBUTE_POINTS=1
AC_BATTLEGROUND_QUEUE_ANNOUNCER_ENABLE=1
AC_ARENA_QUEUE_ANNOUNCER_ENABLE=1
AC_CHARACTER_CREATING_MIN_LEVEL_FOR_HEROIC_CHARACTER=0
AC_HEROIC_CHARACTERS_PER_REALM=10
AC_INDIVIDUAL_PROGRESSION_ENABLE=0

# --- Low memory ----------------------------------------------------------------------------------------
# Idle map grids unload after 1 minute (stock 5); nothing is preloaded.
AC_GRID_UNLOAD=1
AC_GRID_CLEAN_UP_DELAY=60000
AC_PRELOAD_ALL_NON_INSTANCED_MAP_GRIDS=0

# --- WrathUnleashed Lua (custom/lua_scripts) -----------------------------------------------------------
# ov_main.lua: level 1 or the one-time boost to 80 (Dalaran) on first login, and .boost.
OV_MAIN=1
OV_BOOST_KITS_PER_ACCOUNT=10
OV_BOOST_GOLD=0
OV_BRAWL=0
OV_BOOST_TO_70=0
# ov_qol.lua: .qol hub dalaran (and the other hubs), free .qol repair, duel health/cooldown reset on;
# class spells still come from trainers (the boost teaches them all anyway).
OV_QOL_HUB=1
OV_FREE_REPAIR=1
OV_DUEL_RESET=1
OV_AUTOLEARN=0
AC_SOCKET_TIME_OUT_TIME_ACTIVE=600000
AC_CHARACTER_CREATING_DISABLED=0
AC_CHARACTER_CREATING_DISABLED_RACE_MASK=0
AC_CHARACTER_CREATING_DISABLED_CLASS_MASK=0
