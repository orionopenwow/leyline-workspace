# Profile "den": a Den, your own room to build in, hosted on your PC and shared with friends (docs/DEN.md).
# Owner decisions 2026-10-30: a Den is local and private, invite-only by default (the kit makes it private and
# its join page makes accounts only from the invite link); friends join through the relay with the invite link.
# Every character starts alone in a plain white room and builds it into their Den: F7 (edit mode) places, moves,
# turns, sizes and groups props from the realm's catalog (ov_build.lua), the room itself is ov_den.lua.
# Made for a small PC: no bots (the kit writes WU_BOTS=0, WU_DB_BUFFER=256M, WU_PLAYER_LIMIT=10 into .env), and
# only the room's map area is ever loaded. The kit extracts only the Den's map data from your own game folder (the
# island, the starting areas the server checks, the dbc: hosting/kit/tools/wuhost/denslice.py; docs/DEN.md, "A light
# local Den"). The kit applies modern_combos.sql only (no world changes for a Den).
# Who builds: the realm's owner (the host's GM account) always; friends once the owner runs
# ".den allow <name> build" (or the Den bar's Builders button). Everyone else looks around and copies nothing.
# Values are checked against worldserver.conf.dist at the pinned core; the OV_ keys against the scripts' own
# headers (ov_build.lua, ov_den.lua). Tests: hosting/tests/test_setup.py, stream/tests/test_ov_den.lua.

# --- The Den (ov_den.lua) ------------------------------------------------------------------------------------
# The room: a build area on the sealed island in the far north-east corner of Kalimdor (map 1, AzerothCore
# game_tele 424, more than 5000 yards from any other spawn on that map), so no new client map data is needed.
# New characters start in it; anyone who walks or falls out is put back inside (GMs with .gm on are free).
OV_DEN=1
# The room's look at first start: white (light blocks), stone or wood (the owner changes it: .den room <look>).
OV_DEN_THEME=white
# The room's half width inside its walls, in yards (8-32): 16 is a 32 x 32 yard floor of flat white blocks.
OV_DEN_SIZE=16
# Decor budgets, Midnight-style (build points: a prop's weight in the catalog), for the whole Den, every builder
# together: inside the room's walls, and the yard outside them.
OV_DEN_INSIDE_POINTS=1000
OV_DEN_OUTSIDE_POINTS=300

# --- The Builder (ov_build.lua) in a Den ---------------------------------------------------------------------
# A Den is creative: everyone who may build starts on the full "builder" tier (no "new character" share),
# with room for a whole house of props; plots are not used (the Den is one owner's).
OV_BUILD=1
OV_BUILD_NEW_HOURS=0
OV_BUILD_PER_PLAYER=400
OV_BUILD_POINTS=1500
OV_BUILD_PER_AREA=800
OV_BUILD_PLOTS_EACH=0
# Any object (the world editors' level): every safe gameobject template of the world database (.build find), and
# every model of the server's own GameObjectDisplayInfo (.build models; read from the host's dbc folder, extracted
# from their own game on this PC), not only the catalog. Sizes 0.1 to 5 (mod-sandbox-core's limits).
OV_BUILD_ANY=1
OV_BUILD_MODELS=1
OV_BUILD_SCALE_MIN=0.1
OV_BUILD_SCALE_MAX=5

# --- Nothing else pulls players out of the Den ---------------------------------------------------------------
OV_MAIN=0
OV_BRAWL=0
OV_BOOST_TO_70=0
OV_QOL_HUB=0
OV_FREE_REPAIR=1
OV_DUEL_RESET=1
OV_AUTOLEARN=0

# --- Characters ----------------------------------------------------------------------------------------------
AC_SKIP_CINEMATICS=2
AC_START_PLAYER_MONEY=0
AC_PLAYER_START_CUSTOM_SPELLS=0
AC_PLAYER_START_ALL_REPUTATION=0
AC_PLAYER_START_MAPS_EXPLORED=0
AC_ALL_FLIGHT_PATHS=0
AC_INDIVIDUAL_PROGRESSION_ENABLE=0
AC_CHARACTER_CREATING_MIN_LEVEL_FOR_HEROIC_CHARACTER=0
AC_HEROIC_CHARACTERS_PER_REALM=10
AC_CHARACTER_CREATING_DISABLED=0
AC_CHARACTER_CREATING_DISABLED_RACE_MASK=0
AC_CHARACTER_CREATING_DISABLED_CLASS_MASK=0

# --- Low memory ----------------------------------------------------------------------------------------------
# Idle map grids unload after 1 minute (stock 5); nothing is preloaded, so only the room's grid stays loaded.
AC_GRID_UNLOAD=1
AC_GRID_CLEAN_UP_DELAY=60000
AC_PRELOAD_ALL_NON_INSTANCED_MAP_GRIDS=0
AC_SOCKET_TIME_OUT_TIME_ACTIVE=600000
