# Overlay "sampler": the Leyline Sample Hangout, a temporary, lighter main realm (owner 2026-10-29: "a temp 3.3.5
# server hangout for people to sample"; community-hosted realms are the main Leyline network).
# Not a profile of its own: realm/sampler.sh lays these keys over profiles/main.env (or modules.env, where a key
# lives there, because modules.env is read after the profile and wins) between "# >>> Leyline Sample Hangout"
# markers, and comments the old lines out as "#sampler-was: KEY=value". "sampler off" puts every line back.
# OV_PROFILE stays "main", so the realm, scripts and lean steps (serverpass.sh, lean.sh) keep working.
# Everything main.env has stays as it is: level 1 or the boost to 80, the Dungeon Finder, raids, Companions
# (parties and 10-player raids, 60 on the realm), minigolf, Modes, the Workshop, friends, the admin console.
# Characters keep their level, gear and progress: nothing in a character's rows is changed or deleted.
# Values below are checked against worldserver.conf.dist (AzerothCore at the pinned core) and mod-playerbots
# e88cc40's conf/playerbots.conf.dist and TravelMgr.cpp; tests: stream/tests/test_sampler.py.

# --- The fence (stream/lua/ov_slices.lua) --------------------------------------------------------------
# Streamed browser sessions: Dalaran, their starting area (Ebon Hold for Death Knights) and every streamed
# dungeon, raid, arena and battleground; the capitals close. Own files (desktop, or "Use my game folder") keep
# the whole world. Everyone sees a one-line welcome to the Sample Hangout at login.
OV_SAMPLER=1

# --- Building (ov_build.lua): a build area on Krasus' Landing in Dalaran, inside the fence ----------------
OV_BUILD_DALARAN=1

# --- Random bots: a dozen level-80s that live in Dalaran -------------------------------------------------
# modules.env had 30 (lean.sh), the module default is 500. Random bots roam and keep their grids loaded, so they
# are the biggest open-world cost; Companions (.recruit) are made on demand for parties and raids and are not
# counted here. 12 is enough to see people at the bank and the fountain on a 2-CPU, 8 GB box.
AC_PLAYERBOTS_MIN_RANDOM_BOTS=12
AC_PLAYERBOTS_MAX_RANDOM_BOTS=12
# Level 80 only (module default 1-80): TravelMgr sends bots of 71+ to Dalaran's bankers, and ProbTeleToBankers 1
# (default 0.25) makes that their every teleport; RandomBotMaps 571 (default 0,1,530,571) keeps the rest on
# Northrend. They still join the Dungeon Finder (RandomBotJoinLfg stays 1) and battlegrounds.
AC_PLAYERBOTS_RANDOM_BOT_MIN_LEVEL=80
AC_PLAYERBOTS_RANDOM_BOT_MAX_LEVEL=80
AC_PLAYERBOTS_PROB_TELE_TO_BANKERS=1
AC_PLAYERBOTS_RANDOM_BOT_MAPS=571

# --- Memory and CPU -------------------------------------------------------------------------------------
# Idle map grids unload after 1 minute (stock 5 min); the same values lean.sh writes.
AC_GRID_UNLOAD=1
AC_GRID_CLEAN_UP_DELAY=60000
# Open-world visibility 75 yards (stock Visibility.Distance.Continents 90): Dalaran is small and crowded, and the
# server sends fewer updates. Instances (170) and battlegrounds (533) keep the stock distance.
AC_VISIBILITY_DISTANCE_CONTINENTS=75
