# Profile "vanillaplus": Vanilla+, a realm made to stay up for good on a spare PC or a small VPS (docs/leyline/always-on.md).
# The original world only: every character stays in the first era's content (mod-individual-progression held at
# its Vanilla stage), level cap 60, the races and classes of that era. The "+": 1.5x experience, rested XP builds
# twice as fast, queue announcers for a small population, and the Wrath client's own comforts. It plays on the Wrath
# client, so players join from the browser and the Leyline launcher as on every other ruleset. No bots by default
# (WU_BOTS in .env; leyline options --bots N adds some).
# Warden is not set here: the host kit decides it (WU_WARDEN in .env).

# --- Levelling: 1.5x to 60 -------------------------------------------------------------------------------
AC_RATE_XP_KILL=1.5
AC_RATE_XP_QUEST=1.5
AC_RATE_XP_QUEST_DF=1.5
AC_RATE_XP_EXPLORE=1.5
AC_RATE_REST_IN_GAME=2
AC_RATE_REST_OFFLINE_IN_TAVERN_OR_CITY=2
AC_RATE_REST_OFFLINE_IN_WILDERNESS=2
# MaxPlayerLevel: the first era's cap.
AC_MAX_PLAYER_LEVEL=60
AC_START_PLAYER_LEVEL=1
AC_START_PLAYER_MONEY=0
AC_SKIP_CINEMATICS=2

# --- The first era's content only (mod-individual-progression, pinned in realm/custom/sources.lock) ----------
# IndividualProgression.ProgressionLimit = 7: "a value of 7 will limit players to Vanilla content" (the module's own
# conf/individualProgression.conf.dist at the pinned commit 4933d455). TbcRacesUnlockProgression = 8 (the module's
# own "Vanilla must be completed" stage): with the limit at 7 it is never reached, so the later races stay closed.
# Death Knights stay at the module's default (13: the end of the second era), also never reached here.
AC_INDIVIDUAL_PROGRESSION_ENABLE=1
AC_INDIVIDUAL_PROGRESSION_PROGRESSION_LIMIT=7
AC_INDIVIDUAL_PROGRESSION_TBC_RACES_UNLOCK_PROGRESSION=8
AC_INDIVIDUAL_PROGRESSION_DEATH_KNIGHT_UNLOCK_PROGRESSION=13
OV_BOOST_TO_70=0

# --- A small population ---------------------------------------------------------------------------------
AC_BATTLEGROUND_QUEUE_ANNOUNCER_ENABLE=1
AC_ARENA_QUEUE_ANNOUNCER_ENABLE=1
