# /srv/wrath/backup.env (mode 600). Leave RESTIC_REPOSITORY unset for local-only backups.
# Any restic backend works; examples:
#   RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:/wrath     (Hetzner Storage Box over SSH, port 23: see RUNBOOK)
#   RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/wrath
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=<long random string; losing it means losing the off-site backups>
# For S3-style backends:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Local retention in days (default 14)
# WU_BACKUP_KEEP_DAYS=14
