# /srv/wrath/.env (reference copy; bootstrap.sh creates the real file, mode 600).
# Compose reads it automatically when run from /srv/wrath.
DB_ROOT_PASSWORD=<generated by bootstrap.sh: 48 hex characters>
# Lets a plain `docker compose ...` in /srv/wrath use the production file.
COMPOSE_FILE=docker-compose.prod.yml
# Realm images: ov/ac-wotlk + custom = the module build; acore/ac-wotlk + master = stock.
OV_IMAGE=ov/ac-wotlk
OV_TAG=custom
# Worldserver rules: profiles/<name>.env  (brawl | progression | casual)
OV_PROFILE=brawl
# 1 once vmaps + mmaps are in /srv/wrath/client-data (line of sight + pathing)
OV_PATHING=0
# MySQL InnoDB buffer pool
DB_BUFFER_POOL_SIZE=8G
# Optional cap on simultaneous players
# WU_PLAYER_LIMIT=1000
