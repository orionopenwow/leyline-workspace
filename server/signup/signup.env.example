# /srv/wrath/signup.env (mode 600). bootstrap.sh generates SOAP_PASS; never commit the real file.
SOAP_USER=SOAPSVC
SOAP_PASS=<16 random letters/digits, generated>
SOAP_URL=http://127.0.0.1:7878/
# Cloudflare Turnstile (optional): the check is on only when TURNSTILE_SECRET is set.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Abuse limits
SIGNUP_PER_IP_PER_HOUR=3
# SIGNUP_ATTEMPTS_PER_IP_PER_HOUR=30
# SIGNUP_GLOBAL_PER_MINUTE=60
# SIGNUP_TITLE=Create account
