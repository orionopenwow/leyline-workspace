+/// `md5translate.trs`'s WMO interior tiles grouped by WMO: `wmo\..\name_GGG_XX_YY.blp` →
+/// stem `wmo\..\name` (lower case) → hashed names.
+pub fn wmo_minimap_index(trs: &str) -> HashMap<String, Vec<String>> {
+    let mut out: HashMap<String, Vec<String>> = HashMap::new();
+    for line in trs.lines() {
+        let Some((left, hash)) = line.trim_end_matches('\r').split_once('\t') else {
+            continue;
+        };
+        let left = left.trim().to_ascii_lowercase();
+        let Some(stem) = left.strip_suffix(".blp").filter(|_| left.starts_with("wmo\\")) else {
+            continue;
+        };
+        // strip `_GGG_XX_YY`
+        let mut s = stem;
+        let mut ok = true;
+        for _ in 0..3 {
+            match s.rsplit_once('_') {
+                Some((head, num)) if !num.is_empty() && num.bytes().all(|b| b.is_ascii_digit()) => s = head,
+                _ => ok = false,
+            }
+        }
+        if ok {
+            out.entry(s.to_owned()).or_default().push(hash.trim().to_owned());
+        }
+    }
+    out
+}
