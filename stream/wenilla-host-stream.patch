+
+    struct Fake(HashMap<String, Vec<u8>>);
+
+    impl Fake {
+        fn new(files: &[(&str, Vec<u8>)]) -> Self {
+            Fake(
+                files
+                    .iter()
+                    .map(|(n, b)| (name_key(n), b.clone()))
+                    .collect(),
+            )
+        }
+    }
+
+    impl Source for Fake {
+        fn contains(&self, name: &str) -> bool {
+            self.0.contains_key(&name_key(name))
+        }
+        fn read(&self, name: &str) -> Option<Vec<u8>> {
+            self.0.get(&name_key(name)).cloned()
+        }
+        fn list(&self) -> Vec<String> {
+            let mut v: Vec<String> = self.0.keys().cloned().collect();
+            v.sort();
+            v
+        }
+    }
+
+    fn chunk(magic: &[u8; 4], data: &[u8]) -> Vec<u8> {
+        let mut v = magic.to_vec();
+        v.extend((data.len() as u32).to_le_bytes());
+        v.extend(data);
+        v
+    }
+
+    /// A minimal version-264 M2: `views` skins and one file-named texture.
+    fn m2(views: u32, texture: &str) -> Vec<u8> {
+        let mut b = vec![0u8; 0x130];
+        b[0..4].copy_from_slice(b"MD20");
+        b[4..8].copy_from_slice(&264u32.to_le_bytes());
+        b[0x44..0x48].copy_from_slice(&views.to_le_bytes());
+        let tex_at = b.len() as u32;
+        b[0x50..0x54].copy_from_slice(&1u32.to_le_bytes());
+        b[0x54..0x58].copy_from_slice(&tex_at.to_le_bytes());
+        let name_at = tex_at + 16;
+        let mut e = vec![0u8; 16];
+        e[8..12].copy_from_slice(&((texture.len() + 1) as u32).to_le_bytes());
+        e[12..16].copy_from_slice(&name_at.to_le_bytes());
+        b.extend(e);
+        b.extend(texture.as_bytes());
+        b.push(0);
+        b
+    }
