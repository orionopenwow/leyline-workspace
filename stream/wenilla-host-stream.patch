+
+    #[test]
+    fn tiers_dedupe_count_missing_and_report() {
+        let d = tmp("tiers");
+        let lists = vec![
+            (
+                "base".to_string(),
+                vec!["A.dbc".into(), "a.DBC".into(), "missing.x".into()],
+            ),
+            ("t1".to_string(), vec!["A.dbc".into(), "B\\c.blp".into()]),
+        ];
+        let r = export(&fake, &lists, &d, None, false).unwrap();
+        assert_eq!(r.lists[0].new_files, 1);
+        assert_eq!(r.lists[0].missing, 1);
+        assert_eq!(r.lists[1].new_files, 1);
+        assert_eq!(r.files, 2);
+        assert_eq!(r.bytes, (10 + 5) + (10 + 7));
+        assert!(d.join(".export.json").is_file());
+        assert!(summary(&r).contains("2 files"));
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[test]
+    fn a_tier_over_budget_is_left_out_whole_and_so_is_the_rest() {
+        let d = tmp("budget");
+        let lists = vec![
+            ("base".to_string(), vec!["A.dbc".into()]), // 15 bytes
+            ("t1".to_string(), vec!["B.dbc".into(), "C.dbc".into()]), // 30 more
+            ("t2".to_string(), vec!["D.dbc".into()]),   // never tried
+        ];
+        let r = export(&fake, &lists, &d, Some(30), false).unwrap();
+        assert!(!r.lists[0].over_budget);
+        assert!(r.lists[1].over_budget && r.lists[2].over_budget);
+        assert_eq!(r.bytes, 15);
+        assert!(d.join("A.dbc").is_file());
+        assert!(!d.join("B.dbc").exists() && !d.join("C.dbc").exists());
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    /// An uncompressed (ARGB, compression 3) BLP2 of `w`x`h` with a full mip chain, each level
+    /// filled with its level number.
+    fn blp(w: u32, h: u32) -> Vec<u8> {
+        let mut b = vec![0u8; BLP2_HEADER];
+        b[0..4].copy_from_slice(b"BLP2");
+        b[4..8].copy_from_slice(&1u32.to_le_bytes());
+        b[8] = 3;
+        b[9] = 8;
+        b[11] = 1;
+        b[12..16].copy_from_slice(&w.to_le_bytes());
+        b[16..20].copy_from_slice(&h.to_le_bytes());
+        let (mut lw, mut lh, mut i) = (w, h, 0usize);
+        loop {
+            let at = b.len() as u32;
+            let size = lw * lh * 4;
+            b[20 + i * 4..24 + i * 4].copy_from_slice(&at.to_le_bytes());
+            b[84 + i * 4..88 + i * 4].copy_from_slice(&size.to_le_bytes());
+            b.extend(std::iter::repeat_n(i as u8, size as usize));
+            if lw == 1 && lh == 1 {
+                break;
+            }
+            lw = (lw / 2).max(1);
+            lh = (lh / 2).max(1);
+            i += 1;
+        }
+        b
+    }
+
+    #[test]
+    fn lite_blp_drops_the_big_mips_and_decodes() {
+        let full = blp(1024, 512);
+        let lite = lite_blp(&full, 256).expect("shrinks");
+        let rd = |b: &[u8], at: usize| u32::from_le_bytes([b[at], b[at + 1], b[at + 2], b[at + 3]]);
+        assert_eq!((rd(&lite, 12), rd(&lite, 16)), (256, 128));
+        // level 0 of the lite file is level 2 of the original (filled with 2s)
+        let o0 = rd(&lite, 20) as usize;
+        assert_eq!(rd(&lite, 84) as usize, 256 * 128 * 4);
+        assert_eq!(lite[o0], 2);
+        assert!(lite.len() < full.len() / 10);
+        let d = benilla_blp::decode(&lite).expect("the repo's decoder reads a lite BLP");
+        assert_eq!((d.width, d.height), (256, 128));
+        // already small, or no mips: untouched
+        assert!(lite_blp(&blp(256, 256), 256).is_none());
+        let mut nomip = blp(512, 512);
+        nomip[11] = 0;
+        assert!(lite_blp(&nomip, 256).is_none());
+        assert!(lite_blp(b"not a blp", 256).is_none());
+    }
+
+    #[test]
+    fn export_reports_lite_savings() {
+        let d = tmp("lite");
+        let big = blp(512, 512);
+        let read = move |n: &str| -> Result<Option<Vec<u8>>> {
+            Ok(Some(if n.ends_with(".blp") {
+                big.clone()
+            } else {
+                vec![1; 8]
+            }))
+        };
+        let lite = Lite {
+            max_px: 256,
+            prefixes: vec!["Item\\ObjectComponents\\".into()],
+        };
+        let lists = vec![(
+            "t".to_string(),
+            vec![
+                "Item\\ObjectComponents\\Weapon\\Sword.blp".into(),
+                "Creature\\x.blp".into(),
+            ],
+        )];
+        let r = export_with(&read, &lists, &d, None, false, Some(&lite)).unwrap();
+        assert_eq!(r.lists[0].lite_files, 1);
+        assert!(r.lists[0].lite_saved_bytes > 0);
+        assert!(summary(&r).contains("lite textures: 1 files"));
+        let _ = std::fs::remove_dir_all(&d);
+    }
+
+    #[test]
+    fn dry_run_writes_nothing() {
+        let d = tmp("dry");
+        let lists = vec![("base".to_string(), vec!["A.dbc".into()])];
+        let r = export(&fake, &lists, &d, None, true).unwrap();
+        assert_eq!(r.files, 1);
+        assert!(!d.exists());
+    }
+
+    #[test]
+    fn unsafe_names_are_refused() {
+        let d = tmp("unsafe");
+        std::fs::create_dir_all(&d).unwrap();
+        assert!(place(&d, "..\\etc\\passwd").is_err());
+        assert!(place(&d, "A\\\\b").is_err());
+        assert!(place(&d, "C:\\x").is_err());
+        let lists = vec![("t".to_string(), vec!["..\\x".into(), "ok.dbc".into()])];
+        let r = export(&fake, &lists, &d, None, false).unwrap();
+        assert_eq!(r.files, 1);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+}
