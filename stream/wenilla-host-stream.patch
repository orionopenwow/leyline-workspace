+/// The DBC-derived lookups the walker needs, loaded once from the chain (or faked in tests).
+#[derive(Default)]
+pub struct Catalogs {
+    /// map id → `Map.dbc` directory.
+    pub map_dir: std::collections::HashMap<u32, String>,
+    /// map id → loading-screen file.
+    pub loading_screen: std::collections::HashMap<u32, String>,
+    /// zone (`AreaTable`) id → world rect (left, right, top, bottom: left/right world Y,
+    /// top/bottom world X).
+    pub zone_rect: std::collections::HashMap<u32, (f32, f32, f32, f32)>,
+    /// creature display id → (model path, texture variation names, baked NPC texture).
+    pub creature: std::collections::HashMap<u32, (String, Vec<String>, Option<String>)>,
+    /// game-object display id → model path.
+    pub gameobject: std::collections::HashMap<u32, String>,
+    /// lower-case `<dir>\map<x>_<y>.blp` → hashed minimap file name.
+    pub minimap: Option<benilla_formats::MinimapTranslate>,
+    /// WMO minimap stem (`wmo\northrend\dalaran\nd_dalaran`, lower case) → the hashed files of
+    /// its interior tiles (`<stem>_<group>_<x>_<y>.blp` in `md5translate.trs`).
+    pub wmo_minimap: HashMap<String, Vec<String>>,
+    /// `SoundEntries` id → its files (`DirectoryBase` + `File[i]`, as the client joins them).
+    pub kit_files: HashMap<u32, Vec<String>>,
+    /// `AreaTable` id → the kits of its music (day, night) and intro, and of its ambience (day,
+    /// night), each inherited from the nearest parent that has one.
+    pub area_kits: HashMap<u32, AudioKits>,
+    /// `WMOAreaTable.WMOID` → the kits of all its rows (music and intro, ambience) and the
+    /// `AreaTable` areas those rows count as.
+    pub wmo_kits: HashMap<u32, (AudioKits, Vec<u32>)>,
+    /// game-object display → its non-zero `GameObjectDisplayInfo` sound slots.
+    pub gameobject_kits: HashMap<u32, Vec<u32>>,
+    /// What the base takes whatever it walks: every `LiquidType` loop, the ghost and underwater
+    /// beds.
+    pub base_kits: Vec<u32>,
+    /// `GroundEffectTexture` id (an MCLY layer's `effectId`) → its detail doodads (the grass and
+    /// clover clumps the client scatters over that ground).
+    pub ground_effects: HashMap<u32, Vec<String>>,
+    /// creature display → its footstep kits on every terrain (`CreatureSoundData.FootstepID` ×
+    /// `FootstepTerrainLookup`, dry and splash). Voices are left out: about 1.5 MB per sound-data
+    /// row against a few KB of footsteps.
+    pub creature_footsteps: HashMap<u32, Vec<u32>>,
+    /// Catalogs that failed to load (the walk goes on without them; printed by `--deps`).
+    pub warnings: Vec<String>,
+}
+
+impl Catalogs {
+    pub fn load(chain: &mut Chain) -> Result<Self> {
+        let mut c = Catalogs::default();
+        let maps = benilla_formats::load_map_catalog(chain).context("Map.dbc")?;
+        let screens = match benilla_formats::load_loading_screens(chain) {
+            Ok(s) => Some(s),
+            Err(e) => {
+                c.warnings.push(format!("LoadingScreens.dbc: {e:#}"));
+                None
+            }
+        };
+        // `MapCatalog` has no iterator over every row; ids below 2000 cover 3.3.5a's Map.dbc.
+        for id in 0..2000u32 {
+            if let Some(dir) = maps.directory(id) {
+                c.map_dir.insert(id, dir.to_owned());
+                if let (Some(s), Some(ls)) = (&screens, maps.loading_screen_id(id)) {
+                    if let Some(p) = s.path(ls) {
+                        c.loading_screen.insert(id, p.to_owned());
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_world_map_area_catalog(chain) {
+            Err(e) => c.warnings.push(format!("WorldMapArea.dbc: {e:#}")),
+            Ok(wma) => {
+                for (_, a) in wma.iter() {
+                    if a.area_id != 0 {
+                        c.zone_rect.insert(
+                            a.area_id,
+                            (a.loc_left, a.loc_right, a.loc_top, a.loc_bottom),
+                        );
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_creature_catalog(chain) {
+            Err(e) => c.warnings.push(format!("creature displays: {e:#}")),
+            Ok(cc) => {
+                for (display, _) in cc.display_models() {
+                    if let Some(m) = cc.model(display) {
+                        let bake = m.npc_appearance.as_ref().and_then(|a| a.bake_name.clone());
+                        let tex = m.textures.iter().flatten().cloned().collect();
+                        c.creature.insert(display, (m.model_path, tex, bake));
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_gameobject_catalog(chain) {
+            Err(e) => c.warnings.push(format!("GameObjectDisplayInfo.dbc: {e:#}")),
+            Ok(go) => {
+                for (id, path) in go.iter() {
+                    c.gameobject.insert(id, path.to_owned());
+                }
+            }
+        }
+        match benilla_formats::load_minimap_translate(chain) {
+            Ok(m) => c.minimap = Some(m),
+            Err(e) => c.warnings.push(format!("minimap md5translate: {e:#}")),
+        }
+        if let Ok(b) = chain.read_file("Textures\\Minimap\\md5translate.trs") {
+            c.wmo_minimap = wmo_minimap_index(&String::from_utf8_lossy(&b));
+        }
+        c.load_sounds(chain);
+        Ok(c)
+    }
+
+    /// The sound lookups (see the module doc). Each table that fails is a warning: the walk goes
+    /// on without those sounds.
+    fn load_sounds(&mut self, chain: &mut Chain) {
+        let mut raw = |chain: &mut Chain, name: &str| -> Option<Vec<u8>> {
+            match chain.read_file(&format!("DBFilesClient\\{name}")) {
+                Ok(b) if RawDbc::new(&b).is_some() => Some(b),
+                Ok(_) => {
+                    self.warnings.push(format!("{name}: not a DBC"));
+                    None
+                }
+                Err(e) => {
+                    self.warnings.push(format!("{name}: {e:#}"));
+                    None
+                }
+            }
+        };
+        let entries = raw(chain, "SoundEntries.dbc");
+        let areas = raw(chain, "AreaTable.dbc");
+        let wmo_areas = raw(chain, "WMOAreaTable.dbc");
+        let liquids = raw(chain, "LiquidType.dbc");
+        let ge_rows = raw(chain, "GroundEffectTexture.dbc");
+        match benilla_formats::load_sound_kit_catalog(chain) {
+            Err(e) => self.warnings.push(format!("SoundEntries.dbc: {e:#}")),
+            Ok(kits) => {
+                if let Some(d) = entries.as_deref().and_then(RawDbc::new) {
+                    for r in 0..d.rows() {
+                        let id = d.u32(r, 0);
+                        if let Some(k) = kits.get(id) {
+                            if !k.files.is_empty() {
+                                self.kit_files.insert(id, k.files.iter().map(|(f, _)| f.clone()).collect());
+                            }
+                        }
+                    }
+                }
+                self.base_kits.extend(kits.ghost_bed());
+                self.base_kits.extend(kits.underwater_bed());
+            }
+        }
+        let area_cat = match benilla_formats::load_area_sound_catalog(chain) {
+            Ok(a) => Some(a),
+            Err(e) => {
+                self.warnings.push(format!("area sounds: {e:#}"));
+                None
+            }
+        };
+        if let (Some(cat), Some(d)) = (&area_cat, areas.as_deref().and_then(RawDbc::new)) {
+            for r in 0..d.rows() {
+                let id = d.u32(r, 0);
+                if let Some(a) = cat.resolve(id) {
+                    let mut k = AudioKits::default();
+                    k.music.extend(a.music.map(|m| m.sounds).into_iter().flatten());
+                    k.music.extend(a.intro.map(|i| i.sound_id));
+                    k.ambience.extend(a.ambience.map(|m| m.kits).into_iter().flatten());
+                    k.music.retain(|&x| x != 0);
+                    k.ambience.retain(|&x| x != 0);
+                    if !k.music.is_empty() || !k.ambience.is_empty() {
+                        self.area_kits.insert(id, k);
+                    }
+                }
+            }
+        }
+        // WMOAreaTable (12340, 28 columns): 1 WMOID, 6 AmbienceID, 7 ZoneMusic, 8 IntroSound,
+        // 10 AreaTableID, as benilla_formats::wmo_area reads them.
+        if let (Some(cat), Some(d)) = (&area_cat, wmo_areas.as_deref().and_then(RawDbc::new)) {
+            if d.fields > 10 {
+                for r in 0..d.rows() {
+                    let e = self.wmo_kits.entry(d.u32(r, 1)).or_default();
+                    e.0.ambience.extend(cat.ambience_row(d.u32(r, 6)).map(|a| a.kits).into_iter().flatten());
+                    e.0.music.extend(cat.zone_music(d.u32(r, 7)).map(|m| m.sounds).into_iter().flatten());
+                    e.0.music.extend(cat.intro(d.u32(r, 8)).map(|i| i.sound_id));
+                    e.0.music.retain(|&x| x != 0);
+                    e.0.ambience.retain(|&x| x != 0);
+                    let area = d.u32(r, 10);
+                    if area != 0 && !e.1.contains(&area) {
+                        e.1.push(area);
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_liquid_types(chain) {
+            Err(e) => self.warnings.push(format!("LiquidType.dbc: {e:#}")),
+            Ok(lt) => {
+                if let Some(d) = liquids.as_deref().and_then(RawDbc::new) {
+                    for r in 0..d.rows() {
+                        if let Some((kit, _)) = lt.sound(d.u32(r, 0)) {
+                            self.base_kits.push(kit);
+                        }
+                    }
+                }
+            }
+        }
+        match benilla_formats::load_gameobject_sounds(chain) {
+            Err(e) => self.warnings.push(format!("game object sounds: {e:#}")),
+            Ok(go) => {
+                for &id in self.gameobject.keys() {
+                    if let Some(slots) = go.slots(id) {
+                        self.gameobject_kits.insert(id, slots.iter().copied().filter(|&k| k != 0).collect());
+                    }
+                }
+            }
+        }
+        self.base_kits.sort_unstable();
+        self.base_kits.dedup();
+        match benilla_formats::load_ground_effect_catalog(chain) {
+            Err(e) => self.warnings.push(format!("ground effects: {e:#}")),
+            Ok(ge) => {
+                if let Some(d) = ge_rows.as_deref().and_then(RawDbc::new) {
+                    for r in 0..d.rows() {
+                        let id = d.u32(r, 0);
+                        if let Some(e) = ge.effect(id) {
+                            let m: Vec<String> = e.models().into_iter().map(str::to_owned).collect();
+                            if !m.is_empty() {
+                                self.ground_effects.insert(id, m);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        match (benilla_formats::load_creature_voice_catalog(chain), benilla_formats::load_footstep_catalog(chain)) {
+            (Ok(voices), Ok(steps)) => {
+                for &display in self.creature.keys() {
+                    let Some(class) = voices.for_display(display).map(|v| v.footstep_class).filter(|&c| c != 0) else {
+                        continue;
+                    };
+                    let mut kits = Vec::new();
+                    // TerrainType.SoundID runs 0..9 in 12340; a few spare ids cost nothing.
+                    for terrain in 0..16 {
+                        if let Some((dry, splash)) = steps.resolve_terrain(class, terrain) {
+                            for k in [dry, splash] {
+                                if k != 0 && !kits.contains(&k) {
+                                    kits.push(k);
+                                }
+                            }
+                        }
+                    }
+                    if !kits.is_empty() {
+                        self.creature_footsteps.insert(display, kits);
+                    }
+                }
+            }
+            (Err(e), _) | (_, Err(e)) => self.warnings.push(format!("creature footsteps: {e:#}")),
+        }
+    }
+}
+
+/// A WDBC file's rows read as raw 4-byte columns: only for row ids and plain `u32` columns the
+/// client's own loaders have no iterator for.
+struct RawDbc<'b> {
+    b: &'b [u8],
+    n: usize,
+    fields: usize,
+    size: usize,
+}
+
+impl<'b> RawDbc<'b> {
+    fn new(b: &'b [u8]) -> Option<Self> {
+        if b.get(0..4) != Some(b"WDBC") {
+            return None;
+        }
+        let (n, fields, size) = (u32_at(b, 4)? as usize, u32_at(b, 8)? as usize, u32_at(b, 12)? as usize);
+        (size >= fields * 4 && 20 + n.checked_mul(size)? <= b.len()).then_some(Self { b, n, fields, size })
+    }
+    fn rows(&self) -> usize {
+        self.n
+    }
+    fn u32(&self, row: usize, col: usize) -> u32 {
+        if col >= self.fields {
+            return 0;
+        }
+        u32_at(self.b, 20 + row * self.size + col * 4).unwrap_or(0)
+    }
+}
