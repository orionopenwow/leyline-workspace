+        assert_eq!(size_class("World\\wmo\\Transports\\Transport_Zeppelin\\Z.wmo"), "World\\wmo\\Transports");
+        assert_eq!(size_class("World\\Maps\\Northrend\\Northrend_30_21.adt"), "World\\Maps");
+        assert_eq!(size_class("Creature\\Horse\\Horse.m2"), "Creature");
+        assert_eq!(size_class("Textures\\unitselecttexture.blp"), "Textures");
+        let mut sizes = HashMap::new();
+        sizes.insert(name_key("Creature\\A.m2"), 3 << 20);
+        sizes.insert(name_key("Creature\\B.m2"), 1 << 20);
+        sizes.insert(name_key("Sound\\Music\\M.mp3"), 2 << 20);
+        let b = size_breakdown(&["Creature\\A.m2".into(), "Sound\\Music\\M.mp3".into(), "creature\\b.m2".into()], &sizes);
+        assert_eq!(b, [("Creature".to_string(), 4 << 20, 2), ("Sound\\Music".to_string(), 2 << 20, 1)]);
