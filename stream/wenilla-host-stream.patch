+    /// `m2` plus sound events `(4CC, SoundEntries id)`.
+    fn m2_with_events(views: u32, texture: &str, events: &[(&[u8; 4], u32)]) -> Vec<u8> {
+        let mut b = m2(views, texture);
+        let at = b.len() as u32;
+        b[0x100..0x104].copy_from_slice(&(events.len() as u32).to_le_bytes());
+        b[0x104..0x108].copy_from_slice(&at.to_le_bytes());
+        for (ident, data) in events {
+            let mut e = vec![0u8; 0x24];
+            e[0..4].copy_from_slice(&ident[..]);
+            e[4..8].copy_from_slice(&data.to_le_bytes());
+            b.extend(e);
+        }
+        b
+    }
