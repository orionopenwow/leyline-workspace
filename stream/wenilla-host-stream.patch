+    #[arg(long, value_name = "SLICE_JSON")]
+    deps: Option<PathBuf>,
+    /// Static walk: which tiers (`0-3`, `0,2`). Default: `0` to the slice's `maxTier`.
+    #[arg(long)]
+    tiers: Option<String>,
+    /// Static walk: spawned displays (`kind<TAB>map<TAB>displayId`, from `displays.py`).
+    #[arg(long, value_name = "TSV")]
+    displays: Option<PathBuf>,
+    /// Static walk: folder for `tier-<n>.txt`, one names list per tier. Size report: folder for
+    /// `size-report.md` and `size-report.json`.
+    #[arg(long, value_name = "DIR")]
+    out: Option<PathBuf>,
+    /// Size report: walk the base, every tier of this slice and every instance in Map.dbc, and
+    /// report what each would take on the server (lite and full), beyond the base. Writes no game
+    /// file. Uses --data, --displays (displays.py --instances) and --boot.
+    #[arg(long, value_name = "SLICE_JSON")]
+    size_report: Option<PathBuf>,
+}
+
+fn open_chain(data: &Option<PathBuf>) -> Result<Chain> {
+    let Some(data) = data else {
+        bail!("--data (the game's Data folder) is required here");
+    };
+    Chain::open(data).with_context(|| format!("opening {}", data.display()))
+}
+
+fn read_json(path: &std::path::Path) -> Result<serde_json::Value> {
+    let text =
+        std::fs::read_to_string(path).with_context(|| format!("reading {}", path.display()))?;
+    serde_json::from_str(&text).with_context(|| format!("{} is not valid JSON", path.display()))
+}
+
+fn run_deps(cli: &Cli, spec_path: &std::path::Path) -> Result<()> {
+    let mut chain = open_chain(&cli.data)?;
+    let text = std::fs::read_to_string(spec_path)
+        .with_context(|| format!("reading {}", spec_path.display()))?;
+    let spec = wenilla_host::deps::SliceSpec::parse(&text)?;
+    let max_tier = read_json(spec_path)?
+        .get("maxTier")
+        .and_then(|v| v.as_u64())
+        .unwrap_or(0);
+    let tiers =
+        wenilla_host::deps::parse_tiers(cli.tiers.as_deref().unwrap_or(&format!("0-{max_tier}")))?;
+    let displays = match &cli.displays {
+        Some(p) => wenilla_host::deps::parse_displays(
+            &std::fs::read_to_string(p).with_context(|| format!("reading {}", p.display()))?,
+        ),
+        None => {
+            eprintln!("note: no --displays file, so no creature or object models are walked");
+            Vec::new()
+        }
+    };
+    let Some(out) = &cli.out else {
+        bail!("--deps needs --out <folder>");
+    };
+    std::fs::create_dir_all(out)?;
+    let cats = wenilla_host::deps::Catalogs::load(&mut chain)?;
+    for w in &cats.warnings {
+        eprintln!("warning: {w}");
+    }
+    let result = wenilla_host::deps::walk(&chain, &cats, &spec, &tiers, &displays);
+    // Sizes from the chain listing (as stored, before "lite"): a per-tier breakdown by folder, so
+    // what a class of files costs shows before anything is exported.
+    let sizes: std::collections::HashMap<String, u64> = chain
+        .list()
+        .map(|v| v.into_iter().map(|e| (wenilla_host::data::name_key(&e.name), e.size)).collect())
+        .unwrap_or_default();
+    let budget_mb = read_json(spec_path).ok().and_then(|v| v.get("budgetMB")?.as_u64());
+    let mb = |b: u64| b as f64 / (1024.0 * 1024.0);
+    let mut cumulative = 0u64;
+    let mut totals: std::collections::HashMap<String, (u64, usize)> = std::collections::HashMap::new();
+    let mut fit: Option<u32> = None;
+    for t in &result {
+        let path = out.join(format!("tier-{}.txt", t.tier));
+        let mut body = format!("# tier {} {} (wenilla-host --deps)\n", t.tier, t.name);
+        for n in &t.notes {
+            body.push_str(&format!("# {n}\n"));
+        }
+        let classes = wenilla_host::deps::size_breakdown(&t.names, &sizes);
+        let bytes: u64 = classes.iter().map(|c| c.1).sum();
+        cumulative += bytes;
+        if budget_mb.is_none_or(|b| mb(cumulative) <= b as f64) {
+            fit = Some(t.tier);
+        }
+        let shown: Vec<String> = classes
+            .iter()
+            .filter(|c| mb(c.1) >= 1.0)
+            .take(10)
+            .map(|c| format!("{} {:.1}", c.0, mb(c.1)))
+            .collect();
+        let line = format!("{:.1} MB (cumulative {:.1}): {}", mb(bytes), mb(cumulative), shown.join(", "));
+        body.push_str(&format!("# size {line}\n"));
+        for c in &classes {
+            let e = totals.entry(c.0.clone()).or_default();
+            e.0 += c.1;
+            e.1 += c.2;
+        }
+        for n in &t.names {
+            body.push_str(n);
+            body.push('\n');
+        }
+        std::fs::write(&path, body).with_context(|| format!("writing {}", path.display()))?;
+        println!(
+            "tier {:>2} {:<28} {:>7} files  -> {}",
+            t.tier,
+            t.name,
+            t.names.len(),
+            path.display()
+        );
+        for n in &t.notes {
+            println!("         {n}");
+        }
+        println!("         size {line}");
+    }
+    let mut all: Vec<_> = totals.into_iter().collect();
+    all.sort_by_key(|c| std::cmp::Reverse(c.1 .0));
+    println!("\nall walked tiers: {:.1} MB as stored (lite textures make the export smaller)", mb(cumulative));
+    for (c, (b, n)) in all.iter().filter(|c| mb(c.1 .0) >= 5.0) {
+        println!("  {:<36} {:>9.1} MB {:>7} files", c, mb(*b), n);
+    }
+    if let Some(b) = budget_mb {
+        match fit {
+            Some(t) => println!("budgetMB {b}: tiers up to {t} fit by these sizes"),
+            None => println!("budgetMB {b}: not even the base fits by these sizes"),
+        }
+    }
+    Ok(())
+}
+
+fn lite_of(slice: Option<&serde_json::Value>, cli: &Cli) -> Option<wenilla_host::export::Lite> {
+    let mut prefixes = cli.lite_prefix.clone();
+    let mut max_px = cli.lite_max;
+    if let Some(l) = slice.and_then(|s| s.get("lite")) {
+        if let Some(a) = l.get("prefixes").and_then(|a| a.as_array()) {
+            prefixes.extend(a.iter().filter_map(|p| p.as_str().map(str::to_owned)));
+        }
+        if let Some(m) = l.get("maxPx").and_then(|m| m.as_u64()) {
+            max_px = m as u32;
+        }
+    }
+    (!prefixes.is_empty()).then_some(wenilla_host::export::Lite { max_px, prefixes })
+}
+
+fn run_size_report(cli: &Cli, spec_path: &std::path::Path) -> Result<()> {
+    let mut chain = open_chain(&cli.data)?;
+    let text = std::fs::read_to_string(spec_path)
+        .with_context(|| format!("reading {}", spec_path.display()))?;
+    let slice = read_json(spec_path)?;
+    let displays = match &cli.displays {
+        Some(p) => wenilla_host::deps::parse_displays(
+            &std::fs::read_to_string(p).with_context(|| format!("reading {}", p.display()))?,
+        ),
+        None => {
+            eprintln!("note: no --displays file: creature and object models are not counted");
+            Vec::new()
+        }
+    };
+    let mut boot = Vec::new();
+    for p in &cli.boot {
+        boot.extend(wenilla_host::export::read_names(p)?);
+    }
+    let Some(out) = &cli.out else {
+        bail!("--size-report needs --out <folder>");
+    };
+    let lite = lite_of(Some(&slice), cli);
+    wenilla_host::size::run(&mut chain, &text, &displays, &boot, lite.as_ref(), out)?;
+    println!("\nwritten: {} and {}", out.join("size-report.md").display(), out.join("size-report.json").display());
+    Ok(())
+}
+
+fn run_export(cli: &Cli, args: &[PathBuf]) -> Result<()> {
+    let (out, lists) = args.split_last().expect("clap requires two values");
+    let chain = open_chain(&cli.data)?;
+    let mut sources: Vec<(String, Vec<String>)> = Vec::new();
+    let mut boot = cli.boot.clone();
+    if boot.is_empty() {
+        if let Some(www) = &cli.www {
+            boot = ["boot-manifest.json", "world-manifest.json"]
+                .iter()
+                .map(|m| www.join(m))
+                .filter(|p| p.is_file())
+                .collect();
+        }
+    }
+    if boot.is_empty() {
+        eprintln!(
+            "warning: no boot list (--boot or --www): a slice without the login read-set cannot \
+             reach the login screen"
+        );
+    }
+    for p in boot.iter().chain(lists.iter()) {
+        sources.push((
+            p.display().to_string(),
+            wenilla_host::export::read_names(p)?,
+        ));
+    }
+    let slice = match &cli.slice {
+        Some(p) => Some(read_json(p)?),
+        None => None,
+    };
+    let budget = cli
+        .budget_mb
+        .or_else(|| slice.as_ref()?.get("budgetMB")?.as_u64())
+        .map(|m| m * 1024 * 1024);
+    let lite = lite_of(slice.as_ref(), cli);
+    let reader = wenilla_host::export::layered_reader(Some(&chain), None, cli.patch.as_deref());
+    let report = wenilla_host::export::export_with(
+        &reader,
+        &sources,
+        out,
+        budget,
+        cli.dry_run,
+        lite.as_ref(),
+    )?;
+    print!("{}", wenilla_host::export::summary(&report));
+    if !cli.dry_run {
+        // The per-tier file lists for the browser's "Download this section" (/data/__tier/<n>.txt):
+        // the boot lists are tier 0's, `tier-<n>.txt` lists tier n's; --record captures are not a tier.
+        let names: std::collections::HashMap<u32, String> = match &cli.slice {
+            Some(p) => wenilla_host::deps::SliceSpec::parse(&std::fs::read_to_string(p)?)?
+                .tiers
+                .into_iter()
+                .map(|t| (t.tier, t.name))
+                .collect(),
+            None => Default::default(),
+        };
+        let mut tiers: Vec<wenilla_host::export::TierFiles> = Vec::new();
+        for (i, l) in report.lists.iter().enumerate() {
+            let n = if i < boot.len() { Some(0) } else { wenilla_host::export::tier_of_list(&l.source) };
+            let Some(n) = n else { continue };
+            match tiers.iter_mut().find(|t| t.tier == n) {
+                Some(t) => t.lists.push(l),
+                None => tiers.push(wenilla_host::export::TierFiles {
+                    tier: n,
+                    name: names.get(&n).cloned().unwrap_or_default(),
+                    lists: vec![l],
+                }),
+            }
+        }
+        tiers.sort_by_key(|t| t.tier);
+        wenilla_host::export::write_tier_lists(out, &tiers)?;
+        println!("slice written to {} (tier file lists in .tiers)", out.display());
+    }
+    Ok(())
 }
 
