diff --git a/crates/wenilla-host/src/deps.rs b/crates/wenilla-host/src/deps.rs
new file mode 100644
index 00000000..8e093bf2
--- /dev/null
+++ b/crates/wenilla-host/src/deps.rs
@@ -0,0 +1,1724 @@
+//! `--deps`: work out, without playing, which game files a "mini" slice needs — a static walk of
+//! the game data from a slice description (`slices/mini.json`), tier by tier.
+//!
+//! Per tier:
+//! - `prefixes`: every listed chain name under these folders (the shared base: UI, DBCs, the
+//!   player models, spell effects, interface sounds...).
+//! - `names`: single files.
+//! - `maps`: each map's WDT and WDL, its ADT tiles (all of them; for a `zone` only the tiles
+//!   covering that zone's `WorldMapArea` rect; for a world `box` [x min, x max, y min, y max]
+//!   the tiles under it; for `tiles` [x0, x1, y0, y1] those; each plus `marginTiles`), the map's
+//!   loading screen and the minimap tiles; a WMO-only map's global WMO.
+//!
+//! Tier numbers: with a top-level `order` (a list of tier `key`s), a tier's number is its
+//! position there and tiers left out of it are not walked; without one, each tier's `tier`.
+//! - creature and game-object displays spawned on those maps (`--displays`, from the server's
+//!   database: `stream/displays.py`), resolved through `CreatureDisplayInfo` /
+//!   `CreatureModelData` / `CreatureDisplayInfoExtra` / `GameObjectDisplayInfo`.
+//!
+//! Every model found is followed recursively: an ADT's textures, M2s (MMDX) and WMOs (MWMO); a
+//! WMO's groups, textures, doodads (MODN) and skybox (MOSB); an M2's skin profiles, `.anim`
+//! files and file-named textures. Only names the chain actually holds are emitted.
+//!
+//! Sounds and minimaps are walked the way the client resolves them:
+//! - an ADT's MCNK `areaId`s and a map entry's `zone` → `AreaTable` → `ZoneMusic` (day and night),
+//!   `ZoneIntroMusicTable` and `SoundAmbience` (day and night), parents inherited
+//!   (`AreaSoundCatalog::resolve`) → `SoundEntries` files;
+//! - a WMO root's `MOHD.wmoID` → every `WMOAreaTable` row of that WMO (the whole-WMO row and each
+//!   group's: the Underbelly's ambience and music) → the same tables, and the row's `AreaTableID`;
+//! - an M2's `$DSL`/`$DSO`/`$SND` events (the data is a `SoundEntries` id: a torch's
+//!   `TorchFireLoop`, a waterfall's loop) and a game object display's ten sound slots;
+//! - the base (tier 0) also takes every `LiquidType` loop and the ghost and underwater beds;
+//! - minimap: each streamed tile's `md5translate.trs` entry, and for every WMO root every
+//!   interior tile `wmo\<path>\<name>_<group>_<x>_<y>.blp` (Dalaran's city minimap is the city
+//!   WMO's tiles, not the ADTs').
+//!
+//! A prefix ending in `*` (`Textures\*`) takes only the files directly in that folder.
+//!
+//! Known gaps, which a `--record` session of the slice finds: creature voices and footsteps, the
+//! world-map and dungeon-map art of instances, spell visuals that are not under the tier's
+//! prefixes, creatures summoned by scripts rather than spawned, and textures a model only gets at
+//! run time (equipment on NPCs, through the item prefixes).
+
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::io::Cursor;
+
+use anyhow::{bail, Context, Result};
+use benilla_formats::Chain;
+
+use crate::data::name_key;
+
+/// A slice description (the parts the walker reads).
+pub struct SliceSpec {
+    pub tiers: Vec<TierSpec>,
+}
+
+pub struct TierSpec {
+    pub tier: u32,
+    /// The stable name `order` refers to (empty in an older file without `order`).
+    pub key: String,
+    pub name: String,
+    pub prefixes: Vec<String>,
+    pub names: Vec<String>,
+    pub maps: Vec<MapSpec>,
+    /// Zone music and intros (`"music"`; default: on for the kinds players live in, `base`,
+    /// `home`, `city`, `starter`, off for dungeons, raids, arenas and battlegrounds). Off, the
+    /// tier's music is deferred to the tier with `"collectDeferred": true`.
+    pub music: bool,
+    /// Zone and WMO ambience (`"ambience"`, default on); off, deferred like music.
+    pub ambience: bool,
+    /// This tier takes the music and ambience earlier tiers deferred (`"collectDeferred"`): the
+    /// optional last tier, streamed only if the budget leaves room.
+    pub collect_deferred: bool,
+}
+
+/// Whether a tier of this `kind` takes its zone music unless it says otherwise.
+pub fn music_by_kind(kind: &str) -> bool {
+    matches!(kind, "" | "base" | "home" | "city" | "starter")
+}
+
+pub struct MapSpec {
+    pub id: u32,
+    /// Only the tiles under this `AreaTable` zone's world-map rect.
+    pub zone: Option<u32>,
+    /// Only the tiles under this world rect: x min, x max, y min, y max (a subzone, which has no
+    /// world-map rect of its own: Northshire Valley, the Valley of Trials).
+    pub world_box: Option<[f32; 4]>,
+    /// Only these tiles: x0, x1, y0, y1 (inclusive).
+    pub tiles: Option<[u32; 4]>,
+    pub margin_tiles: u32,
+}
+
+impl MapSpec {
+    /// The whole map.
+    pub fn whole(id: u32) -> Self {
+        Self { id, zone: None, world_box: None, tiles: None, margin_tiles: 0 }
+    }
+}
+
+fn f32x4(v: &serde_json::Value, key: &str) -> Result<Option<[f32; 4]>> {
+    let Some(a) = v.get(key) else { return Ok(None) };
+    let a: Vec<f32> = a
+        .as_array()
+        .map(|a| a.iter().filter_map(|x| x.as_f64()).map(|x| x as f32).collect())
+        .unwrap_or_default();
+    if a.len() < 4 {
+        bail!("\"{key}\" needs four numbers");
+    }
+    Ok(Some([a[0], a[1], a[2], a[3]]))
+}
+
+fn u32_of(v: &serde_json::Value, key: &str) -> Option<u32> {
+    v.get(key).and_then(|x| x.as_u64()).map(|x| x as u32)
+}
+
+fn strings_of(v: &serde_json::Value, key: &str) -> Vec<String> {
+    v.get(key)
+        .and_then(|x| x.as_array())
+        .map(|a| {
+            a.iter()
+                .filter_map(|s| s.as_str().map(str::to_owned))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+impl SliceSpec {
+    pub fn parse(text: &str) -> Result<Self> {
+        let v: serde_json::Value = serde_json::from_str(text).context("slice JSON")?;
+        let Some(tiers) = v.get("tiers").and_then(|t| t.as_array()) else {
+            bail!("the slice has no \"tiers\" array");
+        };
+        // With "order": tier number = position of the tier's key in it.
+        let order: Option<Vec<String>> = v.get("order").map(|o| {
+            o.as_array()
+                .map(|a| a.iter().filter_map(|k| k.as_str().map(str::to_owned)).collect())
+                .unwrap_or_default()
+        });
+        if let Some(order) = &order {
+            for (i, k) in order.iter().enumerate() {
+                if order[..i].contains(k) {
+                    bail!("\"order\" lists {k:?} twice");
+                }
+                if !tiers.iter().any(|t| t.get("key").and_then(|x| x.as_str()) == Some(k)) {
+                    bail!("\"order\" lists {k:?}, but no tier has that key");
+                }
+            }
+        }
+        // "soundPolicy": {"musicKinds": [...], "ambienceKinds": [...]}: the tier kinds that take
+        // their zone music / ambience when the tier does not say; an empty kind is the base's.
+        let sp = v.get("soundPolicy");
+        let policy = |field: &str, default: fn(&str) -> bool| -> Box<dyn Fn(&str) -> bool> {
+            match sp.and_then(|p| p.get(field)).and_then(|a| a.as_array()) {
+                Some(a) => {
+                    let kinds: Vec<String> = a.iter().filter_map(|k| k.as_str().map(str::to_owned)).collect();
+                    Box::new(move |k: &str| kinds.iter().any(|x| x == if k.is_empty() { "base" } else { k }))
+                }
+                None => Box::new(default),
+            }
+        };
+        let mut out = Vec::new();
+        for t in tiers {
+            let key = t.get("key").and_then(|k| k.as_str()).unwrap_or("").to_owned();
+            let tier = match &order {
+                Some(order) => match order.iter().position(|k| *k == key) {
+                    Some(i) => i as u32,
+                    None => continue, // left out of "order": not streamed
+                },
+                None => match u32_of(t, "tier") {
+                    Some(n) => n,
+                    None => bail!("a tier has no numeric \"tier\" (and the slice has no \"order\")"),
+                },
+            };
+            let mut maps = Vec::new();
+            for m in t
+                .get("maps")
+                .and_then(|m| m.as_array())
+                .into_iter()
+                .flatten()
+            {
+                let Some(id) = u32_of(m, "id") else {
+                    bail!("tier {tier}: a map has no numeric \"id\"");
+                };
+                let tiles = f32x4(m, "tiles")
+                    .with_context(|| format!("tier {tier}, map {id}"))?
+                    .map(|t| [t[0] as u32, t[1] as u32, t[2] as u32, t[3] as u32]);
+                let world_box = f32x4(m, "box").with_context(|| format!("tier {tier}, map {id}"))?;
+                if let Some(b) = world_box {
+                    if !(b[0] < b[1] && b[2] < b[3]) {
+                        bail!("tier {tier}, map {id}: box must be [x min, x max, y min, y max]");
+                    }
+                }
+                maps.push(MapSpec {
+                    id,
+                    zone: u32_of(m, "zone"),
+                    world_box,
+                    tiles,
+                    margin_tiles: u32_of(m, "marginTiles").unwrap_or(0),
+                });
+            }
+            out.push(TierSpec {
+                tier,
+                key,
+                name: t
+                    .get("name")
+                    .and_then(|n| n.as_str())
+                    .unwrap_or("")
+                    .to_owned(),
+                prefixes: strings_of(t, "prefixes"),
+                names: strings_of(t, "names"),
+                maps,
+                music: t.get("music").and_then(|v| v.as_bool()).unwrap_or_else(|| {
+                    policy("musicKinds", music_by_kind)(t.get("kind").and_then(|k| k.as_str()).unwrap_or(""))
+                }),
+                ambience: t.get("ambience").and_then(|v| v.as_bool()).unwrap_or_else(|| {
+                    policy("ambienceKinds", |_| true)(t.get("kind").and_then(|k| k.as_str()).unwrap_or(""))
+                }),
+                collect_deferred: t.get("collectDeferred").and_then(|v| v.as_bool()).unwrap_or(false),
+            });
+        }
+        out.sort_by_key(|t| t.tier);
+        Ok(Self { tiers: out })
+    }
+}
+
+/// `"0-3"`, `"2"`, `"0,2-4"` → the tier numbers.
+pub fn parse_tiers(s: &str) -> Result<Vec<u32>> {
+    let mut out = Vec::new();
+    for part in s.split(',').map(str::trim).filter(|p| !p.is_empty()) {
+        let (a, b) = part.split_once('-').unwrap_or((part, part));
+        let (a, b): (u32, u32) = (
+            a.trim().parse().with_context(|| format!("tier {a:?}"))?,
+            b.trim().parse().with_context(|| format!("tier {b:?}"))?,
+        );
+        if a > b {
+            bail!("tier range {part:?} runs backwards");
+        }
+        out.extend(a..=b);
+    }
+    out.sort_unstable();
+    out.dedup();
+    Ok(out)
+}
+
+/// One spawned display from the server: `kind` `c` (creature) or `g` (game object).
+pub struct Display {
+    pub kind: char,
+    pub map: u32,
+    pub id: u32,
+    /// The tier whose map entry holds the spawn (`displays.py`'s fourth column); `None` (`-` or
+    /// no column): any tier with this map.
+    pub tier: Option<u32>,
+}
+
+/// Read `displays.tsv` (`kind<TAB>map<TAB>displayId[<TAB>tier]` per line, as `mysql -N -B`
+/// prints it).
+pub fn parse_displays(text: &str) -> Vec<Display> {
+    text.lines()
+        .filter_map(|l| {
+            let mut f = l.split('\t').map(str::trim);
+            let kind = f.next()?.chars().next()?;
+            let map = f.next()?.parse().ok()?;
+            let id = f.next()?.parse().ok()?;
+            let tier = f.next().and_then(|t| t.parse().ok());
+            (matches!(kind, 'c' | 'g') && id != 0).then_some(Display { kind, map, id, tier })
+        })
+        .collect()
+}
+
+/// What the walker reads the game data through, so it can be tested without an install.
+pub trait Source {
+    fn contains(&self, name: &str) -> bool;
+    fn read(&self, name: &str) -> Option<Vec<u8>>;
+    /// Every listed name (for `prefixes`).
+    fn list(&self) -> Vec<String>;
+}
+
+impl Source for Chain {
+    fn contains(&self, name: &str) -> bool {
+        Chain::contains(self, name)
+    }
+    fn read(&self, name: &str) -> Option<Vec<u8>> {
+        Chain::read(self, name).ok()
+    }
+    fn list(&self) -> Vec<String> {
+        Chain::list(self)
+            .map(|v| v.into_iter().map(|e| e.name).collect())
+            .unwrap_or_default()
+    }
+}
