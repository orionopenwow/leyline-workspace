+//! `--export`: copy a list of chain names out of the game data into loose files — a "slice" that
+//! a host started with `--patch <dir> --only-listed` serves and nothing else.
+//!
+//! The lists come from `--record` capture sessions (one name per line) and from the client's
+//! boot manifests (`{"names": [...]}`); they are exported in the order given, each one a "tier":
+//! a name already exported by an earlier list costs nothing in a later one, so the report says
+//! exactly what each tier adds. With a byte budget, the first tier that does not fit is left out
+//! whole (files it already wrote are removed again) and so is everything after it — a slice is
+//! a prefix of the tier list, never half of a tier.
+//!
+//! Layout: every path component is matched case-insensitively against what is already in the
+//! output folder before a new one is created, so `World\Maps\X` and `world\maps\Y` land in one
+//! `World/Maps/` folder. That is the layout the `--patch` layer's case-insensitive walk
+//! (`data::patch_file`) can find both in; two sibling folders differing only in case would hide
+//! one of them.
+
+use std::collections::HashSet;
+use std::path::{Path, PathBuf};
+
+use anyhow::{bail, Context, Result};
+
+use crate::data::{is_missing, name_key};
+
+/// Read a names file: a JSON manifest (`{"names": [...]}` or a bare array), or plain text with
+/// one name per line (blank lines and `#` comments skipped).
+pub fn read_names(path: &Path) -> Result<Vec<String>> {
+    let text =
+        std::fs::read_to_string(path).with_context(|| format!("reading {}", path.display()))?;
+    let trimmed = text.trim_start();
+    if trimmed.starts_with('{') || trimmed.starts_with('[') {
+        let v: serde_json::Value = serde_json::from_str(trimmed)
+            .with_context(|| format!("{} is not valid JSON", path.display()))?;
+        let list = v.get("names").unwrap_or(&v);
+        let Some(arr) = list.as_array() else {
+            bail!(
+                "{}: expected {{\"names\": [...]}} or an array",
+                path.display()
+            );
+        };
+        return Ok(arr
+            .iter()
+            .filter_map(|n| n.as_str().map(str::to_owned))
+            .filter(|n| !n.trim().is_empty())
+            .collect());
+    }
+    Ok(text
+        .lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty() && !l.starts_with('#'))
+        .map(str::to_owned)
+        .collect())
+}
+
+/// What one list (tier) contributed.
+#[derive(Debug, Clone)]
+pub struct ListReport {
+    pub source: String,
+    /// Names in the list.
+    pub names: usize,
+    /// Files this list added that no earlier list had.
+    pub new_files: usize,
+    /// Bytes of those files.
+    pub new_bytes: u64,
+    /// Running total after this list (or what it would have been, when it was left out).
+    pub cumulative_bytes: u64,
+    /// Names the game data does not have (the client probed for them and got a 404 then too).
+    pub missing: usize,
+    /// Left out because it would have gone over the budget.
+    pub over_budget: bool,
+    /// Textures made "lite", and the bytes that saved (already taken off `new_bytes`).
+    pub lite_files: usize,
+    pub lite_saved_bytes: u64,
+    /// The files this list added (name, bytes written), in order: what `/data/__tier/<n>.txt`
+    /// lists. Empty for a list left out over the budget.
+    pub written: Vec<(String, u64)>,
+}
+
+/// The whole export, also written to `<out>/.export.json` (a dot file: never served).
+#[derive(Debug, Clone)]
+pub struct ExportReport {
+    pub lists: Vec<ListReport>,
+    pub files: usize,
+    pub bytes: u64,
+    pub budget_bytes: Option<u64>,
+    pub dry_run: bool,
+}
+
+impl ExportReport {
+    /// The report as JSON (what `.export.json` holds).
+    pub fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "files": self.files,
+            "bytes": self.bytes,
+            "budget_bytes": self.budget_bytes,
+            "dry_run": self.dry_run,
+            "lists": self.lists.iter().map(|l| serde_json::json!({
+                "source": l.source,
+                "names": l.names,
+                "new_files": l.new_files,
+                "new_bytes": l.new_bytes,
+                "cumulative_bytes": l.cumulative_bytes,
+                "missing": l.missing,
+                "over_budget": l.over_budget,
+                "lite_files": l.lite_files,
+                "lite_saved_bytes": l.lite_saved_bytes,
+            })).collect::<Vec<_>>(),
+        })
+    }
+}
+
+/// Validate a chain name and split it into path components; `None` for anything that could
+/// leave the output folder or that no `--patch` lookup would ever find (empty or dot components).
+fn components(name: &str) -> Option<Vec<&str>> {
+    let comps: Vec<&str> = name.split(['\\', '/']).collect();
+    if comps
+        .iter()
+        .any(|c| c.is_empty() || c.starts_with('.') || c.contains(':') || c.contains('\0'))
+    {
+        return None;
+    }
+    Some(comps)
+}
+
+/// Find `comp` in `dir` ignoring case.
+fn find_ci(dir: &Path, comp: &str) -> Option<PathBuf> {
+    let direct = dir.join(comp);
+    if direct.exists() {
+        return Some(direct);
+    }
+    std::fs::read_dir(dir).ok()?.flatten().find_map(|e| {
+        e.file_name()
+            .to_str()
+            .is_some_and(|n| n.eq_ignore_ascii_case(comp))
+            .then(|| e.path())
+    })
+}
+
+/// Where `name` goes under `root`, creating folders (reusing any that match ignoring case).
+pub fn place(root: &Path, name: &str) -> Result<PathBuf> {
+    let Some(comps) = components(name) else {
+        bail!("refusing an unsafe name: {name:?}");
+    };
+    let (file, dirs) = comps
+        .split_last()
+        .expect("split always yields one component");
+    let mut at = root.to_path_buf();
+    for d in dirs {
+        at = match find_ci(&at, d) {
+            Some(p) if p.is_dir() => p,
+            Some(p) => bail!("{} is a file, wanted a folder for {name}", p.display()),
+            None => {
+                let p = at.join(d);
+                std::fs::create_dir(&p).with_context(|| format!("creating {}", p.display()))?;
+                p
+            }
+        };
+    }
+    Ok(find_ci(&at, file).unwrap_or_else(|| at.join(file)))
+}
+
+/// Export `lists` (source label, names) into `out`, reading each name with `read`
+/// (`Ok(None)` = not in the game data). See the module doc for budget and layout rules.
+pub fn export(
+    read: &dyn Fn(&str) -> Result<Option<Vec<u8>>>,
+    lists: &[(String, Vec<String>)],
+    out: &Path,
+    budget_bytes: Option<u64>,
+    dry_run: bool,
+) -> Result<ExportReport> {
+    export_with(read, lists, out, budget_bytes, dry_run, None)
+}
+
+/// "Lite" textures: BLPs under `prefixes` keep only their mip levels of at most `max_px` on the
+/// long side ([`lite_blp`]).
+#[derive(Debug, Clone)]
+pub struct Lite {
+    pub max_px: u32,
+    pub prefixes: Vec<String>,
+}
+
+impl Lite {
+    /// Is `name` a BLP under one of the lite prefixes?
+    pub fn applies(&self, name: &str) -> bool {
+        let k = name_key(name);
+        k.ends_with(".blp") && self.prefixes.iter().any(|p| k.starts_with(&name_key(p)))
+    }
+}
+
+/// [`export`] with optional [`Lite`] textures.
+pub fn export_with(
+    read: &dyn Fn(&str) -> Result<Option<Vec<u8>>>,
+    lists: &[(String, Vec<String>)],
+    out: &Path,
+    budget_bytes: Option<u64>,
+    dry_run: bool,
+    lite: Option<&Lite>,
+) -> Result<ExportReport> {
+    if !dry_run {
+        std::fs::create_dir_all(out).with_context(|| format!("creating {}", out.display()))?;
+    }
+    let mut seen: HashSet<String> = HashSet::new();
+    let mut total: u64 = 0;
+    let mut files = 0usize;
+    let mut reports = Vec::new();
+    let mut stopped = false;
+    for (source, names) in lists {
+        let mut rep = ListReport {
+            source: source.clone(),
+            names: names.len(),
+            new_files: 0,
+            new_bytes: 0,
+            cumulative_bytes: total,
+            missing: 0,
+            over_budget: false,
+            lite_files: 0,
+            lite_saved_bytes: 0,
+            written: Vec::new(),
+        };
+        if stopped {
+            rep.over_budget = true;
+            reports.push(rep);
+            continue;
+        }
+        let mut written: Vec<PathBuf> = Vec::new();
+        let mut keys: Vec<String> = Vec::new();
+        for name in names {
+            let key = name_key(name);
+            if seen.contains(&key) || keys.contains(&key) {
+                continue;
+            }
+            if components(name).is_none() {
+                tracing::warn!(name, "skipped an unsafe name");
+                continue;
+            }
+            let Some(mut bytes) = read(name)? else {
+                rep.missing += 1;
+                continue;
+            };
+            if let Some(l) = lite.filter(|l| l.applies(name)) {
+                if let Some(small) = lite_blp(&bytes, l.max_px) {
+                    rep.lite_saved_bytes += (bytes.len() - small.len()) as u64;
+                    rep.lite_files += 1;
+                    bytes = small;
+                }
+            }
+            rep.new_files += 1;
+            rep.new_bytes += bytes.len() as u64;
+            rep.written.push((name.clone(), bytes.len() as u64));
+            keys.push(key);
+            if !dry_run {
+                let path = place(out, name)?;
+                let existed = path.exists();
+                std::fs::write(&path, &bytes)
+                    .with_context(|| format!("writing {}", path.display()))?;
+                if !existed {
+                    written.push(path);
+                }
+            }
+        }
+        rep.cumulative_bytes = total + rep.new_bytes;
+        if budget_bytes.is_some_and(|b| rep.cumulative_bytes > b) {
+            // The tier does not fit: take back what it wrote (folders it created stay; they are
+            // empty and harmless) and stop here.
+            for p in &written {
+                let _ = std::fs::remove_file(p);
+            }
+            rep.over_budget = true;
+            rep.written.clear();
+            stopped = true;
+        } else {
+            total = rep.cumulative_bytes;
+            files += rep.new_files;
+            seen.extend(keys);
+        }
+        reports.push(rep);
+    }
+    let report = ExportReport {
+        lists: reports,
+        files,
+        bytes: total,
+        budget_bytes,
+        dry_run,
+    };
+    if !dry_run {
+        std::fs::write(
+            out.join(".export.json"),
+            serde_json::to_vec_pretty(&report.to_json())?,
+        )?;
+    }
+    Ok(report)
+}
+
+/// One tier of a finished export, for the browser's "Download this section".
+pub struct TierFiles<'a> {
+    pub tier: u32,
+    pub name: String,
+    /// Every list of that tier (boot lists belong to tier 0).
+    pub lists: Vec<&'a ListReport>,
+}
+
+/// Write `<out>/.tiers/<n>.txt` (`# tier <n> <name>` then `<bytes>\t<name>` per line) and
+/// `<out>/.tiers/index.json` (`[{tier, name, files, bytes}]`). A dot folder, so `/data/<name>` never
+/// serves it; `/data/__tier/<n>.txt` and `/data/__tier/index.json` do.
+pub fn write_tier_lists(out: &Path, tiers: &[TierFiles]) -> Result<()> {
+    let dir = out.join(".tiers");
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).with_context(|| format!("creating {}", dir.display()))?;
+    let mut index = Vec::new();
+    for t in tiers {
+        let files: Vec<&(String, u64)> = t.lists.iter().flat_map(|l| l.written.iter()).collect();
+        if files.is_empty() {
+            continue;
+        }
+        let bytes: u64 = files.iter().map(|f| f.1).sum();
+        let mut body = format!("# tier {} {}\t{}\t{}\n", t.tier, t.name.replace(['\n', '\t'], " "), files.len(), bytes);
+        for (n, b) in &files {
+            body.push_str(&format!("{b}\t{n}\n"));
+        }
+        std::fs::write(dir.join(format!("{}.txt", t.tier)), body)?;
+        index.push(serde_json::json!({"tier": t.tier, "name": t.name, "files": files.len(), "bytes": bytes}));
+    }
+    std::fs::write(dir.join("index.json"), serde_json::to_vec_pretty(&index)?)?;
+    Ok(())
+}
+
+/// The tier number a names list stands for: `tier-<n>.txt` (what `--deps` writes).
+pub fn tier_of_list(path: &str) -> Option<u32> {
+    let file = path.rsplit(['/', '\\']).next()?;
+    file.strip_prefix("tier-")?.strip_suffix(".txt")?.parse().ok()
+}
+
+/// BLP2 header: magic, type, (compression, alpha depth, alpha type, has mips), width, height,
+/// 16 mip offsets, 16 mip sizes, then the 256-entry palette — 1172 bytes in all.
+const BLP2_HEADER: usize = 148 + 1024;
+
+/// A BLP2 with its larger mip levels dropped so the biggest kept level is at most `max_px` on its
+/// long side: the header names the smaller size and its offset/size tables shift down. `None`
+/// when nothing would change (already small, no mips, or not a BLP2 this understands), so the
+/// caller keeps the original bytes.
+pub fn lite_blp(b: &[u8], max_px: u32) -> Option<Vec<u8>> {
+    if b.len() < BLP2_HEADER || &b[0..4] != b"BLP2" || b[11] == 0 || max_px == 0 {
+        return None;
+    }
+    let rd = |at: usize| u32::from_le_bytes([b[at], b[at + 1], b[at + 2], b[at + 3]]);
+    let (w, h) = (rd(12), rd(16));
+    let mut skip = 0u32;
+    while (w >> skip).max(h >> skip) > max_px {
+        skip += 1;
+    }
+    if skip == 0 || skip >= 16 {
+        return None;
+    }
+    let mips: Vec<(usize, usize)> = (0..16)
+        .map(|i| (rd(20 + i * 4) as usize, rd(84 + i * 4) as usize))
+        .collect();
+    let kept: Vec<(usize, usize)> = mips[skip as usize..]
+        .iter()
+        .copied()
+        .take_while(|&(o, s)| o != 0 && s != 0)
+        .collect();
+    if kept.is_empty()
+        || kept
+            .iter()
+            .any(|&(o, s)| o.checked_add(s).is_none_or(|e| e > b.len()))
+    {
+        return None;
+    }
+    let mut out = b[..BLP2_HEADER].to_vec();
+    out[12..16].copy_from_slice(&(w >> skip).max(1).to_le_bytes());
+    out[16..20].copy_from_slice(&(h >> skip).max(1).to_le_bytes());
+    for i in 0..16 {
+        out[20 + i * 4..24 + i * 4].copy_from_slice(&0u32.to_le_bytes());
+        out[84 + i * 4..88 + i * 4].copy_from_slice(&0u32.to_le_bytes());
+    }
+    for (i, &(o, s)) in kept.iter().enumerate() {
+        let at = out.len() as u32;
+        out[20 + i * 4..24 + i * 4].copy_from_slice(&at.to_le_bytes());
+        out[84 + i * 4..88 + i * 4].copy_from_slice(&(s as u32).to_le_bytes());
+        out.extend_from_slice(&b[o..o + s]);
+    }
+    (out.len() < b.len()).then_some(out)
+}
+
+/// The `read` callback for [`export`] over the same layers `/data` serves.
+pub fn layered_reader<'a>(
+    chain: Option<&'a benilla_formats::Chain>,
+    loose: Option<&'a Path>,
+    patch: Option<&'a Path>,
+) -> impl Fn(&str) -> Result<Option<Vec<u8>>> + 'a {
+    move |name| match crate::data::read_layered(chain, loose, patch, false, name) {
+        Ok((bytes, _)) => Ok(Some(bytes)),
+        Err(e) if is_missing(&e) => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+
+/// A human-readable table of the report.
+pub fn summary(r: &ExportReport) -> String {
+    let mb = |b: u64| b as f64 / (1024.0 * 1024.0);
+    let mut s = String::new();
+    s.push_str(&format!(
+        "{:<40} {:>7} {:>8} {:>10} {:>11} {:>8}\n",
+        "list", "names", "new", "new MB", "total MB", "missing"
+    ));
+    for l in &r.lists {
+        s.push_str(&format!(
+            "{:<40} {:>7} {:>8} {:>10.1} {:>11.1} {:>8}{}\n",
+            l.source
+                .chars()
+                .rev()
+                .take(40)
+                .collect::<Vec<_>>()
+                .into_iter()
+                .rev()
+                .collect::<String>(),
+            l.names,
+            l.new_files,
+            mb(l.new_bytes),
+            mb(l.cumulative_bytes),
+            l.missing,
+            if l.over_budget {
+                "  OVER BUDGET (left out)"
+            } else {
+                ""
+            }
+        ));
+        if l.lite_files > 0 {
+            s.push_str(&format!(
+                "    lite textures: {} files, {:.1} MB saved ({:.1} MB at full size)\n",
+                l.lite_files,
+                mb(l.lite_saved_bytes),
+                mb(l.new_bytes + l.lite_saved_bytes)
+            ));
+        }
+    }
+    s.push_str(&format!(
+        "{} files, {:.1} MB{}{}\n",
+        r.files,
+        mb(r.bytes),
+        r.budget_bytes
+            .map(|b| format!(" (budget {:.0} MB)", mb(b)))
+            .unwrap_or_default(),
+        if r.dry_run {
+            ", dry run: nothing written"
+        } else {
+            ""
+        }
+    ));
+    s
+}
