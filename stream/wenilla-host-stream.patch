+//! The slice host: `--only-listed` serves a patch folder and nothing else, `--record` writes each
+//! served name once. No game install needed: a slice host has none either.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use axum::body::Body;
+use axum::http::{Request, StatusCode};
+use tower::ServiceExt;
+use wenilla_host::data::{router_with_config, DataConfig, Recorder};
+
+fn tmp(tag: &str) -> PathBuf {
+    let p = std::env::temp_dir().join(format!("wh-slice-{tag}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&p);
+    std::fs::create_dir_all(&p).unwrap();
+    p
+}
+
+async fn get(app: &axum::Router, method: &str, uri: &str) -> (StatusCode, Vec<u8>) {
+    let resp = app
+        .clone()
+        .oneshot(
+            Request::builder()
+                .method(method)
+                .uri(uri)
+                .body(Body::empty())
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    let status = resp.status();
+    let body = axum::body::to_bytes(resp.into_body(), 1 << 20)
+        .await
+        .unwrap();
+    (status, body.to_vec())
+}
+
+fn slice_folder(root: &std::path::Path) {
+    std::fs::create_dir_all(root.join("DBFilesClient")).unwrap();
+    std::fs::write(root.join("DBFilesClient").join("Map.dbc"), b"WDBC-map").unwrap();
+    std::fs::create_dir_all(root.join("World").join("Maps")).unwrap();
+    std::fs::write(root.join("World").join("Maps").join("x.adt"), b"adt").unwrap();
+    std::fs::write(root.join(".export.json"), b"{}").unwrap();
+}
+
+#[tokio::test]
+async fn only_listed_serves_the_slice_and_nothing_else() {
+    let root = tmp("only");
+    slice_folder(&root);
+    let app = router_with_config(DataConfig {
+        patch: Some(root.clone()),
+        only_listed: true,
+        ..DataConfig::default()
+    });
+    let (s, b) = get(&app, "GET", "/data/DBFilesClient%5CMap.dbc").await;
+    assert_eq!(s, StatusCode::OK);
+    assert_eq!(b, b"WDBC-map");
+    // any case, either separator
+    let (s, _) = get(&app, "HEAD", "/data/dbfilesclient%5Cmap.DBC").await;
+    assert_eq!(s, StatusCode::OK);
+    let (s, _) = get(&app, "GET", "/data/World/maps/X.adt").await;
+    assert_eq!(s, StatusCode::OK);
+    // not in the slice: 404, never a fallback
+    let (s, _) = get(&app, "GET", "/data/DBFilesClient%5CSpell.dbc").await;
+    assert_eq!(s, StatusCode::NOT_FOUND);
+    // the export report is a dot file: not served, not listed
+    let (s, _) = get(&app, "GET", "/data/.export.json").await;
+    assert_eq!(s, StatusCode::NOT_FOUND);
+    let (s, b) = get(&app, "GET", "/data/__index").await;
+    assert_eq!(s, StatusCode::OK);
+    let mut names: Vec<String> = serde_json::from_slice(&b).unwrap();
+    names.sort();
+    assert_eq!(names, ["DBFilesClient\\Map.dbc", "World\\Maps\\x.adt"]);
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+#[tokio::test]
+async fn only_listed_does_not_escape_the_folder() {
+    let root = tmp("escape");
+    slice_folder(&root);
+    std::fs::write(root.parent().unwrap().join("wh-secret.txt"), b"no").unwrap();
+    let app = router_with_config(DataConfig {
+        patch: Some(root.clone()),
+        only_listed: true,
+        ..DataConfig::default()
+    });
+    for uri in ["/data/..%5Cwh-secret.txt", "/data/%2E%2E%2Fwh-secret.txt"] {
+        let (s, _) = get(&app, "GET", uri).await;
+        assert_eq!(s, StatusCode::NOT_FOUND, "{uri}");
+    }
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+#[tokio::test]
+async fn record_appends_each_served_name_once() {
+    let root = tmp("record");
+    slice_folder(&root);
+    let manifest = root
+        .parent()
+        .unwrap()
+        .join(format!("wh-record-{}.txt", std::process::id()));
+    std::fs::write(&manifest, "# earlier session\nWorld\\Maps\\x.adt\n").unwrap();
+    let app = router_with_config(DataConfig {
+        patch: Some(root.clone()),
+        only_listed: true,
+        record: Some(Arc::new(Recorder::open(&manifest).unwrap())),
+        ..DataConfig::default()
+    });
+    get(&app, "GET", "/data/DBFilesClient%5CMap.dbc").await;
+    get(&app, "GET", "/data/dbfilesclient%5Cmap.dbc").await; // same file, other case
+    get(&app, "HEAD", "/data/DBFilesClient%5CMap.dbc").await;
+    get(&app, "GET", "/data/world%5Cmaps%5Cx.adt").await; // already in the file
+    get(&app, "GET", "/data/Nope.dbc").await; // 404: not recorded
+    get(&app, "GET", "/data/__index").await; // not a name
+    let text = std::fs::read_to_string(&manifest).unwrap();
+    assert_eq!(
+        text,
+        "# earlier session\nWorld\\Maps\\x.adt\nDBFilesClient\\Map.dbc\n"
+    );
+    let _ = std::fs::remove_file(&manifest);
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+#[tokio::test]
+async fn tier_lists_are_served_from_the_dot_folder_only() {
+    let root = tmp("tiers");
+    slice_folder(&root);
+    std::fs::create_dir_all(root.join(".tiers")).unwrap();
+    std::fs::write(root.join(".tiers").join("2.txt"), "# tier 2 Stormwind City\t1\t3\n3\tWorld\\Maps\\x.adt\n").unwrap();
+    std::fs::write(root.join(".tiers").join("index.json"), r#"[{"tier":2,"name":"Stormwind City","files":1,"bytes":3}]"#).unwrap();
+    let app = router_with_config(DataConfig {
+        patch: Some(root.clone()),
+        only_listed: true,
+        ..DataConfig::default()
+    });
+    let (s, b) = get(&app, "GET", "/data/__tier/2.txt").await;
+    assert_eq!(s, StatusCode::OK);
+    assert!(String::from_utf8(b).unwrap().contains("World\\Maps\\x.adt"));
+    let (s, b) = get(&app, "GET", "/data/__tier/index.json").await;
+    assert_eq!(s, StatusCode::OK);
+    let v: serde_json::Value = serde_json::from_slice(&b).unwrap();
+    assert_eq!(v[0]["tier"], 2);
+    for uri in ["/data/__tier/3.txt", "/data/__tier/..%2F.export.json", "/data/__tier/x.txt", "/data/.tiers%5C2.txt", "/data/__tier/1234.txt"] {
+        let (s, _) = get(&app, "GET", uri).await;
+        assert_eq!(s, StatusCode::NOT_FOUND, "{uri}");
+    }
+    // and __index never lists them
+    let (_, b) = get(&app, "GET", "/data/__index").await;
+    assert!(!String::from_utf8(b).unwrap().contains("tier"));
+    let _ = std::fs::remove_dir_all(&root);
+}
+
+#[test]
+fn export_writes_tier_lists_by_tier() {
+    use wenilla_host::export::{export, tier_of_list, write_tier_lists, TierFiles};
+    let out = tmp("tierexport");
+    let read = |n: &str| -> anyhow::Result<Option<Vec<u8>>> { Ok(Some(vec![b'x'; n.len()])) };
+    let lists = vec![
+        ("boot-manifest.json".to_string(), vec!["DBFilesClient\\Map.dbc".to_string()]),
+        ("work\\names\\tier-0.txt".to_string(), vec!["Interface\\A.blp".to_string()]),
+        ("work\\names\\tier-2.txt".to_string(), vec!["World\\Maps\\B.adt".to_string(), "Interface\\A.blp".to_string()]),
+        ("record\\names-dalaran.txt".to_string(), vec!["Sound\\C.wav".to_string()]),
+    ];
+    let r = export(&read, &lists, &out, None, false).unwrap();
+    assert_eq!(tier_of_list("work\\names\\tier-2.txt"), Some(2));
+    assert_eq!(tier_of_list("record/names-dalaran.txt"), None);
+    let tiers = vec![
+        TierFiles { tier: 0, name: "base".into(), lists: vec![&r.lists[0], &r.lists[1]] },
+        TierFiles { tier: 2, name: "Stormwind City".into(), lists: vec![&r.lists[2]] },
+    ];
+    write_tier_lists(&out, &tiers).unwrap();
+    let t0 = std::fs::read_to_string(out.join(".tiers").join("0.txt")).unwrap();
+    assert!(t0.starts_with("# tier 0 base\t2\t"), "{t0}");
+    assert!(t0.contains("\tDBFilesClient\\Map.dbc\n") && t0.contains("\tInterface\\A.blp\n"));
+    let t2 = std::fs::read_to_string(out.join(".tiers").join("2.txt")).unwrap();
+    // a file an earlier tier already holds is not listed again
+    assert_eq!(t2.lines().count(), 2, "{t2}");
+    let idx: serde_json::Value = serde_json::from_slice(&std::fs::read(out.join(".tiers").join("index.json")).unwrap()).unwrap();
+    assert_eq!(idx.as_array().unwrap().len(), 2);
+    assert_eq!(idx[1]["name"], "Stormwind City");
+    let _ = std::fs::remove_dir_all(&out);
+}
