@@ -0,0 +1,541 @@
+//! `--size-report`: how much disk every part of the game would take on the stream server, measured
+//! from the game data without writing any game file. The same static walk as `--deps` (this
+//! module only adds the bookkeeping), so a number here is what `--export` would write.
+//!
+//! Units, each measured separately:
+//! - the **base** (tier 0 of the slice plus the client's boot lists): shared by everything;
+//! - every **tier** of the slice (Dalaran, the capitals, the starter areas, ...);
+//! - every **instance** in `Map.dbc` (instance types 1 dungeon, 2 raid, 3 battleground, 4 arena),
+//!   read from the DBC at run time, whatever the slice holds.
+//!
+//! Every unit after the base is counted **beyond the base**: a file the base already ships (the
+//! UI, player models, item textures, spell effects) costs that unit nothing. Units also share
+//! files with each other (two Northrend dungeons use the same rocks and torches): each unit's
+//! number is what it costs *alone* on top of the base, so the sum of all units is more than they
+//! take together. The report says both: the sum, and the union (everything at once, each file
+//! once), and the difference between them is the sharing.
+//!
+//! Sizes are the bytes `--export` writes: the uncompressed file (the size in the archive's block
+//! table), and for "lite" textures (`lite` in the slice) the cut-down BLP. Both lite and full are
+//! reported per unit.
+
+use std::collections::{HashMap, HashSet};
+
+use anyhow::{Context, Result};
+
+use crate::data::name_key;
+use crate::deps::{Catalogs, Display, MapSpec, RefsCache, SliceSpec, Source, Walker};
+use crate::export::{lite_blp, Lite};
+
+/// One measured unit.
+#[derive(Debug, Clone)]
+pub struct Unit {
+    /// `base`, `tier`, `dungeon`, `raid`, `battleground`, `arena`.
+    pub kind: String,
+    pub name: String,
+    /// Map id for an instance; tier number for a tier.
+    pub id: u32,
+    /// `Classic`, `TBC`, `Wrath` for an instance (from `Map.dbc`'s ExpansionID).
+    pub expansion: String,
+    pub files: usize,
+    pub full_bytes: u64,
+    pub lite_bytes: u64,
+    /// Walk notes (tiles, missing WDT).
+    pub notes: Vec<String>,
+}
+
+pub struct Report {
+    pub units: Vec<Unit>,
+    /// Every unit beyond the base, each file once.
+    pub union_full: u64,
+    pub union_lite: u64,
+    pub union_files: usize,
+}
+
+/// A `Map.dbc` row: what the report needs.
+#[derive(Debug, Clone, PartialEq)]
+pub struct MapRow {
+    pub id: u32,
+    pub instance_type: u32,
+    pub name: String,
+    pub expansion: u32,
+}
+
+/// Map.dbc, 3.3.5a (AzerothCore `MapEntryfmt`, `DBCStructure.h` `MapEntry`): field 0 ID, 2
+/// map_type (0 none, 1 dungeon, 2 raid, 3 battleground, 4 arena), 5 name (enUS), 63 expansionID.
+pub fn parse_map_dbc(b: &[u8]) -> Result<Vec<MapRow>> {
+    if b.len() < 20 || &b[0..4] != b"WDBC" {
+        anyhow::bail!("Map.dbc: not a WDBC file");
+    }
+    let rd = |at: usize| -> u32 { u32::from_le_bytes([b[at], b[at + 1], b[at + 2], b[at + 3]]) };
+    let (records, fields, size, strings) = (rd(4) as usize, rd(8) as usize, rd(12) as usize, rd(16) as usize);
+    let str_at = 20 + records * size;
+    if fields < 6 || size < fields * 4 || b.len() < str_at + strings {
+        anyhow::bail!("Map.dbc: unexpected layout ({fields} fields, {size} bytes a record)");
+    }
+    let string = |ofs: u32| -> String {
+        let s = &b[str_at + (ofs as usize).min(strings)..str_at + strings];
+        String::from_utf8_lossy(s.split(|&c| c == 0).next().unwrap_or(&[])).into_owned()
+    };
+    let mut out = Vec::with_capacity(records);
+    for r in 0..records {
+        let at = 20 + r * size;
+        let f = |i: usize| rd(at + i * 4);
+        out.push(MapRow {
+            id: f(0),
+            instance_type: f(2),
+            name: string(f(5)),
+            expansion: if fields > 63 { f(63) } else { 0 },
+        });
+    }
+    Ok(out)
+}
+
+/// Sizes of names: the listed size when the chain lists the file, else its read length.
+pub struct Sizer<'a, S: Source> {
+    src: &'a S,
+    listed: HashMap<String, u64>,
+    lite: Option<&'a Lite>,
+}
+
+impl<'a, S: Source> Sizer<'a, S> {
+    pub fn new(src: &'a S, listed: HashMap<String, u64>, lite: Option<&'a Lite>) -> Self {
+        Self { src, listed, lite }
+    }
+
+    /// (full bytes, lite bytes) of one name.
+    pub fn size(&self, name: &str) -> (u64, u64) {
+        let key = name_key(name);
+        let lite_applies = self.lite.is_some_and(|l| l.applies(name));
+        if !lite_applies {
+            if let Some(&n) = self.listed.get(&key) {
+                if n > 0 {
+                    return (n, n);
+                }
+            }
+        }
+        let Some(bytes) = self.src.read(name) else {
+            return (0, 0);
+        };
+        let full = bytes.len() as u64;
+        let lite = match self.lite.filter(|_| lite_applies) {
+            Some(l) => lite_blp(&bytes, l.max_px).map_or(full, |s| s.len() as u64),
+            None => full,
+        };
+        (full, lite)
+    }
+
+    fn total(&self, names: &[String]) -> (u64, u64) {
+        names.iter().fold((0, 0), |(a, b), n| {
+            let (f, l) = self.size(n);
+            (a + f, b + l)
+        })
+    }
+}
+
+fn expansion_name(e: u32) -> &'static str {
+    match e {
+        0 => "Classic",
+        1 => "TBC",
+        2 => "Wrath",
+        _ => "?",
+    }
+}
+
+fn kind_name(t: u32) -> &'static str {
+    match t {
+        1 => "dungeon",
+        2 => "raid",
+        3 => "battleground",
+        4 => "arena",
+        _ => "map",
+    }
+}
+
+/// Walk and measure. `boot`: the client's boot read-sets (part of the base). `progress` is told
+/// each unit as it is done.
+#[allow(clippy::too_many_arguments)]
+pub fn measure<S: Source>(
+    src: &S,
+    cat: &Catalogs,
+    spec: &SliceSpec,
+    maps: &[MapRow],
+    displays: &[Display],
+    boot: &[String],
+    sizer: &Sizer<S>,
+    progress: &mut dyn FnMut(&Unit),
+) -> Report {
+    let refs = RefsCache::default();
+    let mut units = Vec::new();
+    // The base: tier 0 + the boot lists.
+    let base_tier = spec.tiers.iter().find(|t| t.tier == 0);
+    let mut w = Walker::seeded(src, &HashSet::new(), Some(&refs)).with_catalogs(cat);
+    for n in boot {
+        w.add(n);
+    }
+    if let Some(t) = base_tier {
+        walk_tier(&mut w, src, cat, t, displays);
+    }
+    w.add_base_sounds(cat);
+    w.drain();
+    let names = w.take();
+    let base_seen = w.seen().clone();
+    let (full, lite) = sizer.total(&names);
+    let u = Unit {
+        kind: "base".into(),
+        name: base_tier.map_or("base".into(), |t| t.name.clone()),
+        id: 0,
+        expansion: String::new(),
+        files: names.len(),
+        full_bytes: full,
+        lite_bytes: lite,
+        notes: std::mem::take(&mut w.notes),
+    };
+    progress(&u);
+    units.push(u);
+    drop(w);
+
+    let mut union: HashSet<String> = HashSet::new();
+    let mut union_names: Vec<String> = Vec::new();
+    let mut keep = |names: &[String]| {
+        for n in names {
+            if union.insert(name_key(n)) {
+                union_names.push(n.clone());
+            }
+        }
+    };
+    // The slice's own tiers (cities, starter areas, Dalaran, and the instance tiers again: the
+    // instance list below measures each instance map once more, alone).
+    for t in spec.tiers.iter().filter(|t| t.tier != 0) {
+        let mut w = Walker::seeded(src, &base_seen, Some(&refs)).with_catalogs(cat);
+        walk_tier(&mut w, src, cat, t, displays);
+        w.drain();
+        let names = w.take();
+        let (full, lite) = sizer.total(&names);
+        keep(&names);
+        let u = Unit {
+            kind: "tier".into(),
+            name: format!("tier {} {}", t.tier, t.name),
+            id: t.tier,
+            expansion: String::new(),
+            files: names.len(),
+            full_bytes: full,
+            lite_bytes: lite,
+            notes: std::mem::take(&mut w.notes),
+        };
+        progress(&u);
+        units.push(u);
+    }
+    // Every instance in Map.dbc.
+    let mut inst: Vec<&MapRow> = maps.iter().filter(|m| (1..=4).contains(&m.instance_type)).collect();
+    inst.sort_by_key(|m| m.id);
+    for m in inst {
+        let mut w = Walker::seeded(src, &base_seen, Some(&refs)).with_catalogs(cat);
+        w.add_map(cat, &MapSpec::whole(m.id));
+        for d in displays.iter().filter(|d| d.map == m.id) {
+            if d.kind == 'c' {
+                w.add_creature(cat, d.id);
+            } else {
+                w.add_gameobject(cat, d.id);
+            }
+        }
+        w.drain();
+        let names = w.take();
+        let (full, lite) = sizer.total(&names);
+        keep(&names);
+        let u = Unit {
+            kind: kind_name(m.instance_type).into(),
+            name: m.name.clone(),
+            id: m.id,
+            expansion: expansion_name(m.expansion).into(),
+            files: names.len(),
+            full_bytes: full,
+            lite_bytes: lite,
+            notes: std::mem::take(&mut w.notes),
+        };
+        progress(&u);
+        units.push(u);
+    }
+    let (union_full, union_lite) = sizer.total(&union_names);
+    Report { units, union_full, union_lite, union_files: union_names.len() }
+}
+
+fn walk_tier<S: Source>(w: &mut Walker<S>, src: &S, cat: &Catalogs, t: &crate::deps::TierSpec, displays: &[Display]) {
+    w.music = t.music;
+    w.ambience = t.ambience;
+    if !t.prefixes.is_empty() {
+        let all = src.list();
+        for p in &t.prefixes {
+            let n = w.add_prefix(&all, p);
+            w.notes.push(format!("prefix {p}: {n} files"));
+        }
+    }
+    for n in &t.names {
+        w.add(n);
+    }
+    for m in &t.maps {
+        w.add_map(cat, m);
+    }
+    let maps: HashSet<u32> = t.maps.iter().map(|m| m.id).collect();
+    for d in displays.iter().filter(|d| match d.tier {
+        Some(n) => n == t.tier,
+        None => maps.contains(&d.map) && t.maps.iter().any(|m| m.id == d.map && m.zone.is_none() && m.world_box.is_none() && m.tiles.is_none()),
+    }) {
+        if d.kind == 'c' {
+            w.add_creature(cat, d.id);
+        } else {
+            w.add_gameobject(cat, d.id);
+        }
+    }
+}
+
+fn mb(b: u64) -> f64 {
+    b as f64 / (1024.0 * 1024.0)
+}
+
+/// The report as Markdown: a table sorted by size (lite), biggest first, then the totals.
+pub fn markdown(r: &Report, title: &str) -> String {
+    let base = &r.units[0];
+    let mut s = format!("# {title}\n\n");
+    s.push_str(&format!(
+        "Measured from the game data by `wenilla-host --size-report`: the bytes `--export` would write \
+         (uncompressed files; \"lite\" = item textures cut to the slice's lite size, \"full\" = as in \
+         the archives). Nothing was exported.\n\n\
+         **The base** ({}: login, character create, the UI, spells, player and item models) is \
+         **{:.1} MB lite / {:.1} MB full**, {} files. Every place below is counted **beyond the \
+         base**: what it adds on top of it, alone. Places also share files with each other, so the \
+         sum of the rows ({:.1} MB lite) is more than all of them together ({:.1} MB lite, {:.1} MB \
+         full, {} files, each file once): {:.1} MB is shared between places.\n\n",
+        base.name,
+        mb(base.lite_bytes),
+        mb(base.full_bytes),
+        base.files,
+        mb(r.units[1..].iter().map(|u| u.lite_bytes).sum()),
+        mb(r.union_lite),
+        mb(r.union_full),
+        r.union_files,
+        mb(r.units[1..].iter().map(|u| u.lite_bytes).sum::<u64>().saturating_sub(r.union_lite)),
+    ));
+    let mut rows: Vec<&Unit> = r.units[1..].iter().collect();
+    rows.sort_by(|a, b| b.lite_bytes.cmp(&a.lite_bytes).then(a.name.cmp(&b.name)));
+    s.push_str("| # | place | kind | expansion | map / tier | files | MB lite | MB full |\n");
+    s.push_str("|---:|---|---|---|---:|---:|---:|---:|\n");
+    for (i, u) in rows.iter().enumerate() {
+        s.push_str(&format!(
+            "| {} | {} | {} | {} | {} | {} | {:.1} | {:.1} |\n",
+            i + 1,
+            u.name.replace('|', "/"),
+            u.kind,
+            u.expansion,
+            u.id,
+            u.files,
+            mb(u.lite_bytes),
+            mb(u.full_bytes)
+        ));
+    }
+    let by = |k: &str| -> (usize, u64) {
+        let v: Vec<&&Unit> = rows.iter().filter(|u| u.kind == k).collect();
+        (v.len(), v.iter().map(|u| u.lite_bytes).sum())
+    };
+    s.push_str("\n## Totals by kind (sum of rows, beyond the base, lite)\n\n| kind | count | MB |\n|---|---:|---:|\n");
+    for k in ["tier", "dungeon", "raid", "battleground", "arena"] {
+        let (n, b) = by(k);
+        s.push_str(&format!("| {k} | {n} | {:.1} |\n", mb(b)));
+    }
+    s.push_str(&format!(
+        "\nEverything (base + every place, each file once): **{:.1} MB lite, {:.1} MB full**.\n",
+        mb(base.lite_bytes + r.union_lite),
+        mb(base.full_bytes + r.union_full)
+    ));
+    let empty: Vec<&&Unit> = rows.iter().filter(|u| u.files == 0).collect();
+    if !empty.is_empty() {
+        s.push_str("\nRows with 0 files have no WDT in this data (test or unused maps in Map.dbc).\n");
+    }
+    s
+}
+
+pub fn to_json(r: &Report) -> serde_json::Value {
+    serde_json::json!({
+        "base": unit_json(&r.units[0]),
+        "union_beyond_base": {"files": r.union_files, "full_bytes": r.union_full, "lite_bytes": r.union_lite},
+        "units": r.units[1..].iter().map(unit_json).collect::<Vec<_>>(),
+    })
+}
+
+fn unit_json(u: &Unit) -> serde_json::Value {
+    serde_json::json!({
+        "kind": u.kind, "name": u.name, "id": u.id, "expansion": u.expansion, "files": u.files,
+        "full_bytes": u.full_bytes, "lite_bytes": u.lite_bytes, "notes": u.notes,
+    })
+}
+
+/// The `--size-report` command: open the chain's catalogs, walk, write `<out>/size-report.md` and
+/// `.json`, print the table.
+pub fn run(
+    chain: &mut benilla_formats::Chain,
+    spec_text: &str,
+    displays: &[Display],
+    boot: &[String],
+    lite: Option<&Lite>,
+    out: &std::path::Path,
+) -> Result<Report> {
+    let spec = SliceSpec::parse(spec_text)?;
+    let cat = Catalogs::load(chain)?;
+    for w in &cat.warnings {
+        eprintln!("warning: {w}");
+    }
+    let map_bytes = chain.read("DBFilesClient\\Map.dbc").context("reading Map.dbc")?;
+    let maps = parse_map_dbc(&map_bytes)?;
+    let listed: HashMap<String, u64> = chain
+        .list()
+        .map(|v| v.into_iter().map(|e| (name_key(&e.name), e.size)).collect())
+        .unwrap_or_default();
+    let chain = &*chain;
+    let sizer = Sizer::new(chain, listed, lite);
+    let n_inst = maps.iter().filter(|m| (1..=4).contains(&m.instance_type)).count();
+    eprintln!(
+        "measuring the base, {} slice tiers and {n_inst} instances from Map.dbc...",
+        spec.tiers.len().saturating_sub(1)
+    );
+    let mut done = 0usize;
+    let report = measure(chain, &cat, &spec, &maps, displays, boot, &sizer, &mut |u| {
+        done += 1;
+        eprintln!(
+            "  [{done:>3}] {:<44} {:>7} files {:>9.1} MB lite {:>9.1} MB full",
+            u.name.chars().take(44).collect::<String>(),
+            u.files,
+            mb(u.lite_bytes),
+            mb(u.full_bytes)
+        );
+    });
+    std::fs::create_dir_all(out)?;
+    let md = markdown(&report, "Stream server disk: every 3.3.5a instance, the base and the slice's tiers");
+    std::fs::write(out.join("size-report.md"), &md)?;
+    std::fs::write(out.join("size-report.json"), serde_json::to_vec_pretty(&to_json(&report))?)?;
+    print!("{md}");
+    Ok(report)
+}
