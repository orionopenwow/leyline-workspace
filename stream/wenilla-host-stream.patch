+
+impl Recorder {
+    /// Open (or create) `path` for appending, remembering the names it already holds.
+    pub fn open(path: &std::path::Path) -> anyhow::Result<Self> {
+        use anyhow::Context;
+        let mut seen = std::collections::HashSet::new();
+        if let Ok(text) = std::fs::read_to_string(path) {
+            for line in text.lines() {
+                let line = line.trim();
+                if !line.is_empty() && !line.starts_with('#') {
+                    seen.insert(name_key(line));
+                }
+            }
+        }
+        let file = std::fs::OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+            .with_context(|| format!("opening {} to record into", path.display()))?;
+        Ok(Self {
+            state: std::sync::Mutex::new((seen, file)),
         })
+    }
+
+    /// Record one served name; `true` when it was new.
+    pub fn note(&self, name: &str) -> bool {
+        use std::io::Write;
+        let mut guard = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let (seen, file) = &mut *guard;
+        if !seen.insert(name_key(name)) {
+            return false;
+        }
+        if let Err(e) = writeln!(file, "{name}").and_then(|_| file.flush()) {
+            tracing::error!(error = %e, "could not append to the record manifest");
+        }
+        true
+    }
+}
