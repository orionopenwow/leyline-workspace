+        assert_eq!(rows.len(), 3);
+        assert_eq!(rows[1], MapRow { id: 389, instance_type: 1, name: "Ragefire Chasm".into(), expansion: 0 });
+        assert_eq!(rows[2].expansion, 2);
+        assert!(parse_map_dbc(b"nope").is_err());
+    }
+}
