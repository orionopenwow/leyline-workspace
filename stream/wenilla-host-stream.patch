+/// Map a chain-style `Interface\...` name onto a file under the loose `Interface` root, each
+/// component matched case-insensitively as on Windows. Any other prefix, an empty or dot
+/// component, is refused, so a request cannot leave the folder.
+fn loose_file(root: &std::path::Path, name: &str) -> Option<std::path::PathBuf> {
+    let (head, rest) = name.split_once('\\')?;
+    if !head.eq_ignore_ascii_case("interface") {
+        return None;
+    }
+    let mut at = root.to_path_buf();
+    for comp in rest.split('\\') {
+        if comp.is_empty() || comp.starts_with('.') {
+            return None;
+        }
+        let direct = at.join(comp);
+        at = if direct.exists() {
+            direct
+        } else {
+            std::fs::read_dir(&at).ok()?.flatten().find(|e| {
+                e.file_name().to_str().is_some_and(|n| n.eq_ignore_ascii_case(comp))
+            })?.path()
+        };
+    }
+    at.is_file().then_some(at)
+}
+
+/// Map any chain name onto a file under the patch root, each component matched
+/// case-insensitively; empty or dot components refused.
+fn patch_file(root: &std::path::Path, name: &str) -> Option<std::path::PathBuf> {
+    let mut at = root.to_path_buf();
+    for comp in name.split('\\') {
+        if comp.is_empty() || comp.starts_with('.') {
+            return None;
+        }
+        let direct = at.join(comp);
+        at = if direct.exists() {
+            direct
+        } else {
+            std::fs::read_dir(&at).ok()?.flatten().find(|e| {
+                e.file_name().to_str().is_some_and(|n| n.eq_ignore_ascii_case(comp))
+            })?.path()
+        };
+    }
+    at.is_file().then_some(at)
+}
+
+/// Every file under `dir`, as `prefix\rel\path` chain names, for the index.
+fn loose_names(dir: &std::path::Path, prefix: &str, out: &mut Vec<String>) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for e in entries.flatten() {
+        let Some(n) = e.file_name().to_str().map(str::to_owned) else {
+            continue;
+        };
+        if n.starts_with('.') {
+            continue;
+        }
+        let name = format!("{prefix}\\{n}");
+        let path = e.path();
+        if path.is_dir() {
+            loose_names(&path, &name, out);
+        } else if path.is_file() {
+            out.push(name);
+        }
+    }
+}
