+
+    fn map_dbc(rows: &[(u32, u32, &str, u32)]) -> Vec<u8> {
+        let fields = 66usize;
+        let mut strings = vec![0u8];
+        let mut body = Vec::new();
+        for &(id, ty, name, exp) in rows {
+            let ofs = strings.len() as u32;
+            strings.extend(name.as_bytes());
+            strings.push(0);
+            let mut rec = vec![0u32; fields];
+            rec[0] = id;
+            rec[2] = ty;
+            rec[5] = ofs;
+            rec[63] = exp;
+            body.extend(rec.iter().flat_map(|v| v.to_le_bytes()));
+        }
+        let mut b = b"WDBC".to_vec();
+        for v in [rows.len() as u32, fields as u32, (fields * 4) as u32, strings.len() as u32] {
+            b.extend(v.to_le_bytes());
+        }
+        b.extend(body);
+        b.extend(strings);
+        b
+    }
+
+    struct Fake(HashMap<String, Vec<u8>>);
+    impl Source for Fake {
+        fn contains(&self, n: &str) -> bool {
+            self.0.contains_key(&name_key(n))
+        }
+        fn read(&self, n: &str) -> Option<Vec<u8>> {
+            self.0.get(&name_key(n)).cloned()
+        }
+        fn list(&self) -> Vec<String> {
+            self.0.keys().cloned().collect()
+        }
+    }
+
+    #[test]
+    fn units_are_counted_beyond_the_base_and_the_union_once() {
+        let mut files = HashMap::new();
+        for (n, len) in [
+            ("interface\\a.blp", 100usize),
+            ("world\\maps\\a\\a.wdl", 10),
+            ("world\\maps\\b\\b.wdl", 20),
+            ("interface\\glues\\loading\\shared.blp", 7),
+            ("dbfilesclient\\map.dbc", 5),
+        ] {
+            files.insert(n.to_string(), vec![0u8; len]);
+        }
+        let src = Fake(files);
+        let mut cat = Catalogs::default();
+        cat.map_dir.insert(1, "A".into());
+        cat.map_dir.insert(2, "B".into());
+        // both instances use one loading screen: shared, counted in each, once in the union
+        cat.loading_screen.insert(1, "Interface\\Glues\\Loading\\Shared.blp".into());
+        cat.loading_screen.insert(2, "Interface\\Glues\\Loading\\Shared.blp".into());
+        let spec = SliceSpec::parse(r#"{"order":["base"],"tiers":[{"key":"base","names":["Interface\\A.blp"]}]}"#).unwrap();
+        let maps = vec![
+            MapRow { id: 1, instance_type: 1, name: "Alpha".into(), expansion: 0 },
+            MapRow { id: 2, instance_type: 2, name: "Beta".into(), expansion: 2 },
+            MapRow { id: 0, instance_type: 0, name: "Continent".into(), expansion: 0 },
+        ];
+        let sizer = Sizer::new(&src, HashMap::new(), None);
+        let boot = vec!["DBFilesClient\\Map.dbc".to_string()];
+        let r = measure(&src, &cat, &spec, &maps, &[], &boot, &sizer, &mut |_| {});
+        assert_eq!(r.units[0].full_bytes, 105);
+        assert_eq!(r.units.len(), 3, "base + two instances (the continent is not one)");
+        let a = r.units.iter().find(|u| u.name == "Alpha").unwrap();
+        let b = r.units.iter().find(|u| u.name == "Beta").unwrap();
+        assert_eq!((a.full_bytes, a.kind.as_str()), (17, "dungeon"));
+        assert_eq!((b.full_bytes, b.kind.as_str(), b.expansion.as_str()), (27, "raid", "Wrath"));
+        assert_eq!(r.union_full, 37, "the shared loading screen once");
+        let md = markdown(&r, "t");
+        assert!(md.contains("| 1 | Beta | raid | Wrath |"), "{md}");
+        assert!(md.contains("7.0") || md.contains("0.0"));
+        assert_eq!(to_json(&r)["units"].as_array().unwrap().len(), 2);
+    }
+
+    #[test]
+    fn lite_sizes_come_from_the_cut_blp() {
+        let mut b = vec![0u8; 1172];
+        b[0..4].copy_from_slice(b"BLP2");
+        b[4] = 1;
+        b[8] = 3;
+        b[9] = 8;
+        b[11] = 1;
+        b[12..16].copy_from_slice(&512u32.to_le_bytes());
+        b[16..20].copy_from_slice(&512u32.to_le_bytes());
+        let (mut w, mut i) = (512u32, 0usize);
+        while w >= 1 {
+            let at = b.len() as u32;
+            let size = w * w * 4;
+            b[20 + i * 4..24 + i * 4].copy_from_slice(&at.to_le_bytes());
+            b[84 + i * 4..88 + i * 4].copy_from_slice(&size.to_le_bytes());
+            b.extend(std::iter::repeat_n(0u8, size as usize));
+            if w == 1 { break; }
+            w /= 2;
+            i += 1;
+        }
+        let full = b.len() as u64;
+        let mut files = HashMap::new();
+        files.insert("item\\objectcomponents\\x.blp".to_string(), b);
+        let src = Fake(files);
+        let lite = Lite { max_px: 256, prefixes: vec!["Item\\ObjectComponents\\".into()] };
+        let sizer = Sizer::new(&src, HashMap::new(), Some(&lite));
+        let (f, l) = sizer.size("Item\\ObjectComponents\\X.blp");
+        assert_eq!(f, full);
+        assert!(l < f / 3, "{l} vs {f}");
+    }
+
+    #[test]
+    fn map_dbc_rows() {
