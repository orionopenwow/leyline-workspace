+/// The walk's result: one ordered list of names per tier, each without the names of earlier
+/// tiers, plus notes on what could not be resolved.
+pub struct TierNames {
+    pub tier: u32,
+    pub name: String,
+    pub names: Vec<String>,
+    pub notes: Vec<String>,
+}
+
+/// The folder class a name is counted under in the `--deps` size breakdown: two levels for
+/// `Sound\`, `Textures\` and `World\` (`Sound\Music`, `Textures\GuildEmblems`, `World\Maps`),
+/// three for `World\wmo\` (`World\wmo\Transports`), else the top folder (`Creature`, `Item`).
+pub fn size_class(name: &str) -> String {
+    let parts: Vec<&str> = name.split(['\\', '/']).collect();
+    let top = parts.first().copied().unwrap_or("").to_ascii_lowercase();
+    let depth = match top.as_str() {
+        "world" if parts.get(1).is_some_and(|p| p.eq_ignore_ascii_case("wmo")) => 3,
+        "sound" | "textures" | "world" => 2,
+        _ => 1,
+    };
+    let n = depth.min(parts.len().saturating_sub(1)).max(1);
+    parts[..n].join("\\")
+}
+
+/// `(class, bytes, files)` of `names` by [`size_class`], biggest first; `sizes` maps a name key
+/// to its size (the chain listing).
+pub fn size_breakdown(names: &[String], sizes: &HashMap<String, u64>) -> Vec<(String, u64, usize)> {
+    let mut by: HashMap<String, (String, u64, usize)> = HashMap::new();
+    for n in names {
+        let c = size_class(n);
+        let e = by.entry(c.to_ascii_lowercase()).or_insert_with(|| (c, 0, 0));
+        e.1 += sizes.get(&name_key(n)).copied().unwrap_or(0);
+        e.2 += 1;
+    }
+    let mut v: Vec<_> = by.into_values().collect();
+    v.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
+    v
+}
+
+/// `.mdx` / `.mdl` (the DBC spelling) → `.m2` (what is in the archives).
+pub fn m2_name(path: &str) -> String {
+    let lower = path.to_ascii_lowercase();
+    if lower.ends_with(".mdx") || lower.ends_with(".mdl") {
+        format!("{}.m2", &path[..path.len() - 4])
+    } else {
+        path.to_owned()
+    }
+}
+
+fn dir_of(path: &str) -> &str {
+    path.rfind(['\\', '/']).map_or("", |i| &path[..=i])
+}
+
+/// The zero-terminated strings of a string block (MOTX, MODN, MTEX...).
+fn strings(block: &[u8]) -> Vec<String> {
+    block
+        .split(|&b| b == 0)
+        .filter(|s| !s.is_empty())
+        .map(|s| String::from_utf8_lossy(s).into_owned())
+        .collect()
+}
+
+/// A chunked file's `(magic as stored, payload)` pairs; stops at the first malformed chunk.
+fn chunks(b: &[u8]) -> Vec<([u8; 4], &[u8])> {
+    let mut out = Vec::new();
+    let mut at = 0usize;
+    while at + 8 <= b.len() {
+        let magic = [b[at], b[at + 1], b[at + 2], b[at + 3]];
+        let size = u32::from_le_bytes([b[at + 4], b[at + 5], b[at + 6], b[at + 7]]) as usize;
+        let Some(end) = (at + 8).checked_add(size).filter(|&e| e <= b.len()) else {
+            break;
+        };
+        out.push((magic, &b[at + 8..end]));
+        at = end;
+    }
+    out
+}
+
+fn u32_at(b: &[u8], at: usize) -> Option<u32> {
+    b.get(at..at + 4)
+        .map(|s| u32::from_le_bytes([s[0], s[1], s[2], s[3]]))
+}
+
+/// An M2's skin-profile count and file-named textures (version 264 header: `nViews` at 0x44,
+/// the texture array at 0x50, 16-byte entries `type, flags, filename (len, ofs)`).
+pub fn m2_refs(m2: &[u8]) -> (u32, Vec<String>) {
+    if m2.get(0..4) != Some(b"MD20") {
+        return (0, Vec::new());
+    }
+    let views = u32_at(m2, 0x44).unwrap_or(0).min(8);
+    let mut tex = Vec::new();
+    if let (Some(n), Some(ofs)) = (u32_at(m2, 0x50), u32_at(m2, 0x54)) {
+        for i in 0..n.min(512) as usize {
+            let e = ofs as usize + i * 16;
+            let (Some(kind), Some(len), Some(at)) =
+                (u32_at(m2, e), u32_at(m2, e + 8), u32_at(m2, e + 12))
+            else {
+                break;
+            };
+            if kind != 0 || len < 2 {
+                continue;
+            }
+            if let Some(s) = m2.get(at as usize..at as usize + len as usize) {
+                let s = s.split(|&b| b == 0).next().unwrap_or(&[]);
+                if !s.is_empty() {
+                    tex.push(String::from_utf8_lossy(s).into_owned());
+                }
+            }
+        }
+    }
+    (views, tex)
+}
+
+/// A WMO root's textures (MOTX), doodads (MODN) plus skybox (MOSB), group count (MOHD +4) and
+/// `wmoID` (MOHD +0x20, the `WMOAreaTable` key; `benilla_formats::wmo_root_id`).
+pub fn wmo_refs(root: &[u8]) -> (Vec<String>, Vec<String>, u32, u32) {
+    let mut tex = Vec::new();
+    let mut doodads = Vec::new();
+    let mut groups = 0;
+    let mut id = 0;
+    for (magic, data) in chunks(root) {
+        match &magic {
+            b"XTOM" => tex.extend(strings(data)),
+            // The skybox model (MOSB) is followed like a doodad.
+            b"NDOM" | b"BSOM" => doodads.extend(strings(data)),
+            b"DHOM" => {
+                groups = u32_at(data, 4).unwrap_or(0).min(512);
+                id = u32_at(data, 0x20).unwrap_or(0);
+            }
+            _ => {}
+        }
+    }
+    (tex, doodads, groups, id)
+}
+
+/// The `SoundEntries` ids of an M2's sound events (version 264: the event array at header
+/// `0x100`, `0x24`-byte records `ident[4], data u32`): `$DSL` (a placed doodad's ambient loop),
+/// `$DSO` and `$SND` (one-shots), as `benilla-app`'s `sound::anim_events` plays them.
+pub fn m2_sound_kits(m2: &[u8]) -> Vec<u32> {
+    let mut out = Vec::new();
+    if m2.get(0..4) != Some(b"MD20") {
+        return out;
+    }
+    let (Some(n), Some(ofs)) = (u32_at(m2, 0x100), u32_at(m2, 0x104)) else {
+        return out;
+    };
+    for i in 0..n.min(4096) as usize {
+        let e = ofs as usize + i * 0x24;
+        let (Some(ident), Some(data)) = (m2.get(e..e + 4), u32_at(m2, e + 4)) else {
+            break;
+        };
+        if data != 0 && matches!(ident, b"$DSL" | b"$DSO" | b"$SND") && !out.contains(&data) {
+            out.push(data);
+        }
+    }
+    out
+}
+
+/// What a model refers to that is not a file, resolved through the catalogs by the walker:
+/// `#kit:<SoundEntries id>`, `#area:<AreaTable id>`, `#wmo:<WMOID>`, `#mm:<WMO minimap stem>`.
+const TOKEN: char = '#';
+
+/// The names a model refers to (candidates: the walker keeps those the data has). M2: skin
+/// profiles, file-named textures, `.anim` files. WMO root: textures, groups, doodads, skybox
+/// (a group file names nothing). ADT: textures (and their `_s` companions), M2s, WMOs.
+pub fn model_refs(name: &str, bytes: &[u8]) -> Vec<String> {
+    let key = name_key(name);
+    let mut out = Vec::new();
+    if key.ends_with(".m2") {
+        let stem = &name[..name.len() - 3];
+        let (views, tex) = m2_refs(bytes);
+        for i in 0..views.max(1) {
+            out.push(format!("{stem}{i:02}.skin"));
+        }
+        out.extend(tex);
+        if let Ok(anims) = benilla_m2::anim_paths(bytes, name) {
+            out.extend(anims.into_iter().map(|(_, a)| a));
+        }
+        out.extend(m2_sound_kits(bytes).into_iter().map(|k| format!("{TOKEN}kit:{k}")));
+    } else if key.ends_with(".wmo") {
+        let stem = &name[..name.len() - 4];
+        let is_group = stem.len() > 4
+            && stem.as_bytes()[stem.len() - 4] == b'_'
+            && stem[stem.len() - 3..].bytes().all(|b| b.is_ascii_digit());
+        if is_group {
+            return out;
+        }
+        let (tex, doodads, groups, wmo_id) = wmo_refs(bytes);
+        if wmo_id != 0 {
+            out.push(format!("{TOKEN}wmo:{wmo_id}"));
+        }
+        // The minimap's interior key: the path without `World\` and `.wmo` (`wmo_minimap_stem`).
+        let lower = stem.replace('/', "\\").to_ascii_lowercase();
+        if let Some((_, rest)) = lower.split_once("world\\") {
+            out.push(format!("{TOKEN}mm:{rest}"));
+        }
+        // The repo's parser agrees on the texture list; it is the one the renderer trusts.
+        if let Ok(benilla_wmo::ParsedWmo::Root(root)) =
+            benilla_wmo::parse_wmo(&mut Cursor::new(bytes))
+        {
+            out.extend(root.textures.iter().cloned());
+        }
+        out.extend(tex);
+        for g in 0..groups {
+            out.push(format!("{stem}_{g:03}.wmo"));
+        }
+        out.extend(doodads.iter().map(|d| m2_name(d)));
+    } else if key.ends_with(".adt") {
+        let Ok(benilla_adt::ParsedAdt::Root(adt)) = benilla_adt::parse_adt(&mut Cursor::new(bytes))
+        else {
+            return out;
+        };
+        for t in &adt.textures {
+            out.push(t.clone());
+            // The specular/height companions some terrain textures ship with.
+            if let Some(stem) = t.strip_suffix(".blp").or_else(|| t.strip_suffix(".BLP")) {
+                out.push(format!("{stem}_s.blp"));
+            }
+        }
+        out.extend(adt.models.iter().map(|m| m2_name(m)));
+        out.extend(adt.wmos.iter().cloned());
+        // The areas its chunks are in: their music and ambience (the client's `CurrentArea`).
+        let mut effects: Vec<u32> = adt
+            .mcnk_chunks
+            .iter()
+            .filter_map(|c| c.layers.as_ref())
+            .flat_map(|l| l.layers.iter().map(|l| l.effect_id))
+            .filter(|&e| e != 0 && e != u32::MAX)
+            .collect();
+        effects.sort_unstable();
+        effects.dedup();
+        out.extend(effects.into_iter().map(|e| format!("{TOKEN}ge:{e}")));
+        let mut areas: Vec<u32> = adt.mcnk_chunks.iter().map(|c| c.header.area_id).filter(|&a| a != 0).collect();
+        areas.sort_unstable();
+        areas.dedup();
+        out.extend(areas.into_iter().map(|a| format!("{TOKEN}area:{a}")));
+    }
+    out
+}
+
+/// What one model names (candidate names, before the existence check), per model key: shared
+/// between walkers so `--size-report` reads and parses each model once however many instances
+/// use it.
+pub type RefsCache = std::cell::RefCell<std::collections::HashMap<String, Vec<String>>>;
+
+/// The ADT tiles `[x0, x1, y0, y1]` (inclusive) a map entry streams: `tiles`, else the tiles
+/// under the world `box`, else under the zone's world-map rect, each widened by `marginTiles`;
+/// else the whole map. The note says when a zone had no rect.
+pub fn tile_rect(cat: &Catalogs, m: &MapSpec) -> ([u32; 4], Option<String>) {
+    let grow = |a: u32, b: u32| {
+        (a.min(b).saturating_sub(m.margin_tiles), (a.max(b) + m.margin_tiles).min(63))
+    };
+    let corners = |a: (u32, u32), b: (u32, u32)| {
+        let (x0, x1) = grow(a.0, b.0);
+        let (y0, y1) = grow(a.1, b.1);
+        [x0, x1, y0, y1]
+    };
+    if let Some([tx0, tx1, ty0, ty1]) = m.tiles {
+        return (corners((tx0.min(63), ty0.min(63)), (tx1.min(63), ty1.min(63))), None);
+    }
+    if let Some([wx0, wx1, wy0, wy1]) = m.world_box {
+        // world_to_tile(world x, world y) -> (tile x from world y, tile y from world x)
+        let a = benilla_formats::world_to_tile(wx0, wy0);
+        let b = benilla_formats::world_to_tile(wx1, wy1);
+        return (corners(a, b), None);
+    }
+    if let Some(zone) = m.zone {
+        return match cat.zone_rect.get(&zone) {
+            // left/right are world Y, top/bottom world X
+            Some(&(left, right, top, bottom)) => (
+                corners(
+                    benilla_formats::world_to_tile(top, left),
+                    benilla_formats::world_to_tile(bottom, right),
+                ),
+                None,
+            ),
+            None => (
+                [0, 63, 0, 63],
+                Some(format!("zone {zone}: no WorldMapArea rect; taking the whole map")),
+            ),
+        };
+    }
+    ([0, 63, 0, 63], None)
+}
+
+/// The walker: collects names in discovery order, each once (MPQ name rules).
+pub struct Walker<'a, S: Source> {
+    src: &'a S,
+    seen: HashSet<String>,
+    current: Vec<String>,
+    queue: VecDeque<String>,
+    refs: Option<&'a RefsCache>,
+    /// Resolves the model tokens (sounds, WMO minimaps); without it they are dropped.
+    cat: Option<&'a Catalogs>,
+    tokens: HashSet<String>,
+    /// Sound files added since the last [`Walker::take`].
+    pub sound_files: usize,
+    /// Whether zone music and ambience are taken now (the tier's `music`/`ambience`); what is
+    /// not is kept in `deferred` for [`Walker::add_deferred`].
+    pub music: bool,
+    pub ambience: bool,
+    deferred: Vec<u32>,
+    /// ADT tiles in a map entry's margin: their areas' music and ambience are not taken (the realm
+    /// keeps players inside the zone or box; their models and emitters still are).
+    quiet: HashSet<String>,
+    pub notes: Vec<String>,
+}
+
+impl<'a, S: Source> Walker<'a, S> {
+    pub fn new(src: &'a S) -> Self {
+        Self {
+            src,
+            seen: HashSet::new(),
+            current: Vec::new(),
+            queue: VecDeque::new(),
+            refs: None,
+            cat: None,
+            tokens: HashSet::new(),
+            sound_files: 0,
+            music: true,
+            ambience: true,
+            deferred: Vec::new(),
+            quiet: HashSet::new(),
+            notes: Vec::new(),
+        }
+    }
+
+    /// Resolve sounds and WMO minimaps through `cat` while walking.
+    pub fn with_catalogs(mut self, cat: &'a Catalogs) -> Self {
+        self.cat = Some(cat);
+        self
+    }
+
+    /// A sound kit's files.
+    pub fn add_kit(&mut self, cat: &Catalogs, kit: u32) {
+        if !self.tokens.insert(format!("kit:{kit}")) {
+            return;
+        }
+        for f in cat.kit_files.get(&kit).into_iter().flatten() {
+            let new = !self.seen.contains(&name_key(f));
+            if self.add(f) && new {
+                self.sound_files += 1;
+            }
+        }
+    }
+
+    /// An area's music, intro and ambience (parents inherited).
+    pub fn add_area(&mut self, cat: &Catalogs, area: u32) {
+        if !self.tokens.insert(format!("area:{area}:{}{}", self.music, self.ambience)) {
+            return;
+        }
+        if let Some(k) = cat.area_kits.get(&area) {
+            self.add_audio(cat, &k.clone());
+        }
+    }
+
+    /// Music and ambience kits, each taken now or deferred by the tier's policy.
+    fn add_audio(&mut self, cat: &Catalogs, k: &AudioKits) {
+        for (kits, now) in [(&k.music, self.music), (&k.ambience, self.ambience)] {
+            for &kit in kits {
+                if now {
+                    self.add_kit(cat, kit);
+                } else if !self.deferred.contains(&kit) {
+                    self.deferred.push(kit);
+                }
+            }
+        }
+    }
+
+    /// Everything earlier tiers deferred (the `collectDeferred` tier).
+    pub fn add_deferred(&mut self, cat: &Catalogs) {
+        for k in std::mem::take(&mut self.deferred) {
+            self.add_kit(cat, k);
+        }
+    }
+
+    /// What the base takes whatever it walks: liquid loops, the ghost and underwater beds.
+    pub fn add_base_sounds(&mut self, cat: &Catalogs) {
+        for &k in &cat.base_kits {
+            self.add_kit(cat, k);
+        }
+    }
+
+    fn token(&mut self, cat: &Catalogs, tok: &str) {
+        let Some((kind, v)) = tok.split_once(':') else { return };
+        match kind {
+            "kit" => {
+                if let Ok(k) = v.parse() {
+                    self.add_kit(cat, k);
+                }
+            }
+            "area" => {
+                if let Ok(a) = v.parse() {
+                    self.add_area(cat, a);
+                }
+            }
+            "wmo" => {
+                if !self.tokens.insert(format!("{tok}:{}{}", self.music, self.ambience)) {
+                    return;
+                }
+                if let Some((kits, areas)) = v.parse().ok().and_then(|id: u32| cat.wmo_kits.get(&id)) {
+                    self.add_audio(cat, kits);
+                    for &a in areas {
+                        self.add_area(cat, a);
+                    }
+                }
+            }
+            "ge" => {
+                if !self.tokens.insert(tok.to_owned()) {
+                    return;
+                }
+                let models = v.parse().ok().and_then(|id: u32| cat.ground_effects.get(&id));
+                for m in models.into_iter().flatten() {
+                    self.add_model(m);
+                }
+            }
+            "mm" => {
+                if !self.tokens.insert(tok.to_owned()) {
+                    return;
+                }
+                for h in cat.wmo_minimap.get(v).into_iter().flatten() {
+                    self.add(&format!("Textures\\Minimap\\{h}"));
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// A walker that already knows `seen` (names a shared base holds: never emitted again) and
+    /// shares parsed model references through `refs`.
+    pub fn seeded(src: &'a S, seen: &HashSet<String>, refs: Option<&'a RefsCache>) -> Self {
+        let mut w = Self::new(src);
+        w.seen = seen.clone();
+        w.refs = refs;
+        w
+    }
+
+    /// Every name key this walker has emitted or was seeded with.
+    pub fn seen(&self) -> &HashSet<String> {
+        &self.seen
+    }
+
+    /// Add one name if the data has it; models are queued for [`Walker::drain`].
+    pub fn add(&mut self, name: &str) -> bool {
+        let name = name.trim().replace('/', "\\");
+        if name.is_empty() {
+            return false;
+        }
+        let key = name_key(&name);
+        if self.seen.contains(&key) {
+            return true;
+        }
+        if !self.src.contains(&name) {
+            return false;
+        }
+        self.seen.insert(key.clone());
+        self.current.push(name.clone());
+        if key.ends_with(".m2") || key.ends_with(".wmo") || key.ends_with(".adt") {
+            self.queue.push_back(name);
+        }
+        true
+    }
+
+    pub fn add_model(&mut self, path: &str) -> bool {
+        self.add(&m2_name(path))
+    }
+
+    /// Follow every queued model's references until nothing new turns up.
+    pub fn drain(&mut self) {
+        while let Some(name) = self.queue.pop_front() {
+            let key = name_key(&name);
+            let quiet = self.quiet.contains(&key);
+            let cached = self.refs.and_then(|c| c.borrow().get(&key).cloned());
+            let refs = match cached {
+                Some(r) => r,
+                None => {
+                    let Some(bytes) = self.src.read(&name) else {
+                        continue;
+                    };
+                    let r = model_refs(&name, &bytes);
+                    if let Some(c) = self.refs {
+                        c.borrow_mut().insert(key, r.clone());
+                    }
+                    r
+                }
+            };
+            for r in refs {
+                match (r.strip_prefix(TOKEN), self.cat) {
+                    (Some(tok), _) if quiet && tok.starts_with("area:") => {}
+                    (Some(tok), Some(cat)) => self.token(cat, tok),
+                    (Some(_), None) => {}
+                    (None, _) => {
+                        self.add(&r);
+                    }
+                }
+            }
+        }
+    }
+
+    /// Everything listed under `prefix` (any case).
+    pub fn add_prefix(&mut self, all: &[String], prefix: &str) -> usize {
+        let p = name_key(prefix);
+        // `Textures\*`: only the files directly in the folder.
+        let (p, flat) = match p.strip_suffix('*') {
+            Some(p) => (p.to_owned(), true),
+            None => (p, false),
+        };
+        let mut n = 0;
+        for name in all {
+            let k = name_key(name);
+            let Some(rest) = k.strip_prefix(&p) else { continue };
+            if flat && rest.contains('\\') {
+                continue;
+            }
+            if self.add(name) {
+                n += 1;
+            }
+        }
+        n
+    }
+
+    /// One map: WDT, WDL, tiles (optionally only a zone's, a box's or a tile rect), loading
+    /// screen, minimap tiles.
+    pub fn add_map(&mut self, cat: &Catalogs, m: &MapSpec) {
+        let Some(dir) = cat.map_dir.get(&m.id).cloned() else {
+            self.notes.push(format!("map {}: not in Map.dbc", m.id));
+            return;
+        };
+        // The zone's own music and ambience (Dalaran's, over the Crystalsong chunks below it).
+        if let Some(zone) = m.zone {
+            self.add_area(cat, zone);
+        }
+        let base = format!("World\\Maps\\{dir}\\{dir}");
+        self.add(&format!("{base}.wdl"));
+        if let Some(ls) = cat.loading_screen.get(&m.id) {
+            self.add(ls);
+        }
+        let wdt_name = format!("{base}.wdt");
+        if !self.add(&wdt_name) {
+            self.notes.push(format!("map {} ({dir}): no WDT", m.id));
+            return;
+        }
+        let Some(bytes) = self.src.read(&wdt_name) else {
+            return;
+        };
+        let wdt = match benilla_formats::WdtReader::new(
+            Cursor::new(bytes.as_slice()),
+            benilla_formats::WowVersion::Classic,
+        )
+        .read()
+        {
+            Ok(w) => w,
+            Err(e) => {
+                self.notes
+                    .push(format!("map {} ({dir}): WDT unreadable: {e}", m.id));
+                return;
+            }
+        };
+        if let Some(g) = wdt.global_wmo() {
+            self.add(&g.model);
+        }
+        let ([x0, x1, y0, y1], note) = tile_rect(cat, m);
+        // The entry's own tiles, without the margin: only their areas give music and ambience.
+        let inner = MapSpec { margin_tiles: 0, zone: m.zone, world_box: m.world_box, tiles: m.tiles, id: m.id };
+        let ([ix0, ix1, iy0, iy1], _) = tile_rect(cat, &inner);
+        if let Some(n) = note {
+            self.notes.push(n);
+        }
+        let mut tiles = 0;
+        for y in y0..=y1 {
+            for x in x0..=x1 {
+                // The minimap tile whether or not the tile has terrain (md5translate lists only
+                // authored art).
+                if let Some(h) = cat.minimap.as_ref().and_then(|t| t.tile(&dir, x, y)) {
+                    self.add(&format!("Textures\\Minimap\\{h}"));
+                }
+                if !wdt
+                    .get_tile(x as usize, y as usize)
+                    .is_some_and(|t| t.has_adt)
+                {
+                    continue;
+                }
+                let adt = format!("{base}_{x}_{y}.adt");
+                if !(ix0..=ix1).contains(&x) || !(iy0..=iy1).contains(&y) {
+                    self.quiet.insert(name_key(&adt));
+                }
+                if self.add(&adt) {
+                    tiles += 1;
+                }
+            }
+        }
+        self.notes.push(format!(
+            "map {} ({dir}): {tiles} tiles x {x0}..{x1} y {y0}..{y1}",
+            m.id
+        ));
+    }
+
+    pub fn add_creature(&mut self, cat: &Catalogs, display: u32) {
+        let Some((model, tex, bake)) = cat.creature.get(&display) else {
+            return;
+        };
+        let m2 = m2_name(model);
+        self.add(&m2);
+        let dir = dir_of(&m2).to_owned();
+        for t in tex {
+            self.add(&format!("{dir}{t}.blp"));
+        }
+        if let Some(b) = bake {
+            let b = if b.contains('.') {
+                b.clone()
+            } else {
+                format!("{b}.blp")
+            };
+            self.add(&format!("Textures\\BakedNpcTextures\\{b}"));
+        }
+        for &k in cat.creature_footsteps.get(&display).into_iter().flatten() {
+            self.add_kit(cat, k);
+        }
+    }
+
+    pub fn add_gameobject(&mut self, cat: &Catalogs, display: u32) {
+        if let Some(model) = cat.gameobject.get(&display) {
+            self.add_model(model);
+        }
+        for &k in cat.gameobject_kits.get(&display).into_iter().flatten() {
+            self.add_kit(cat, k);
+        }
+    }
+
+    /// Close the current tier: its names, in discovery order.
+    pub fn take(&mut self) -> Vec<String> {
+        self.sound_files = 0;
+        std::mem::take(&mut self.current)
+    }
+}
+
+/// Walk `tiers` of `spec` in order; each tier's list excludes earlier tiers' names.
+pub fn walk<S: Source>(
+    src: &S,
+    cat: &Catalogs,
+    spec: &SliceSpec,
+    tiers: &[u32],
+    displays: &[Display],
+) -> Vec<TierNames> {
+    let mut w = Walker::new(src).with_catalogs(cat);
+    let mut listed: Option<Vec<String>> = None;
+    let mut out = Vec::new();
+    for t in spec.tiers.iter().filter(|t| tiers.contains(&t.tier)) {
+        w.music = t.music;
+        w.ambience = t.ambience;
+        if !t.prefixes.is_empty() && listed.is_none() {
+            listed = Some(src.list());
+        }
+        for p in &t.prefixes {
+            let n = w.add_prefix(listed.as_deref().unwrap_or(&[]), p);
+            w.notes.push(format!("prefix {p}: {n} files"));
+        }
+        for n in &t.names {
+            if !w.add(n) {
+                w.notes.push(format!("name not in the data: {n}"));
+            }
+        }
+        for m in &t.maps {
+            w.add_map(cat, m);
+        }
+        let maps: HashSet<u32> = t.maps.iter().map(|m| m.id).collect();
+        let (mut c, mut g) = (0, 0);
+        let mine = |d: &&Display| match d.tier {
+            Some(n) => n == t.tier,
+            None => maps.contains(&d.map),
+        };
+        for d in displays.iter().filter(mine) {
+            if d.kind == 'c' {
+                w.add_creature(cat, d.id);
+                c += 1;
+            } else {
+                w.add_gameobject(cat, d.id);
+                g += 1;
+            }
+        }
+        if c + g > 0 {
+            w.notes
+                .push(format!("{c} creature and {g} object displays"));
+        }
+        if t.tier == 0 {
+            w.add_base_sounds(cat);
+        }
+        w.drain();
+        if t.collect_deferred {
+            let n = w.deferred.len();
+            w.add_deferred(cat);
+            w.notes.push(format!("{n} deferred music and ambience kits"));
+        }
+        if w.sound_files > 0 {
+            w.notes.push(format!("{} sound files (music, ambience, emitters)", w.sound_files));
+        }
+        out.push(TierNames {
+            tier: t.tier,
+            name: t.name.clone(),
+            names: w.take(),
+            notes: std::mem::take(&mut w.notes),
+        });
+    }
+    out
+}
